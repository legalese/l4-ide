DECLARE `tenure` IS ONE OF Owner, Tenant, Lodger

DECLARE Plot HAS
    `tenure` IS A `tenure`

GIVEN p IS A Plot
GIVETH A STRING
`describe` p MEANS CONSIDER p's `tenure`
                     WHEN Owner  THEN "owner"
                     WHEN Tenant THEN "tenant"
                     WHEN Lodger THEN "lodger"

#EVAL `describe` (Plot WITH `tenure` IS Lodger)
