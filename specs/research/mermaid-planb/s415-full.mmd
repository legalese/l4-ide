railroad-beta
cheat = sequence(
  choice(nonterminal("by deceiving"), nonterminal("dishonest concealment")),
  nonterminal("intentionally"),
  terminal("induces an act or omission that"),
  nonterminal("causes harm"),
  terminal("to any person in"),
  choice(nonterminal("body"), nonterminal("mind"), nonterminal("reputation"), nonterminal("property"))
);
