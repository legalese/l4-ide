DECLARE Driver HAS
    name IS A STRING
    f0 IS A NUMBER TYPICALLY 0
    f1 IS A NUMBER TYPICALLY 1
    f2 IS A NUMBER TYPICALLY 2
    f3 IS A NUMBER TYPICALLY 3
    f4 IS A NUMBER TYPICALLY 4
    f5 IS A NUMBER TYPICALLY 5
    f6 IS A NUMBER TYPICALLY 6
    f7 IS A NUMBER TYPICALLY 7
    f8 IS A NUMBER TYPICALLY 8
    f9 IS A NUMBER TYPICALLY 9
    f10 IS A NUMBER TYPICALLY 10
    f11 IS A NUMBER TYPICALLY 11
    f12 IS A NUMBER TYPICALLY 12
    f13 IS A NUMBER TYPICALLY 13
    f14 IS A NUMBER TYPICALLY 14
    f15 IS A NUMBER TYPICALLY 15
    f16 IS A NUMBER TYPICALLY 16
    f17 IS A NUMBER TYPICALLY 17
    f18 IS A NUMBER TYPICALLY 18
    f19 IS A NUMBER TYPICALLY 19

DECLARE Act IS ONE OF
    a0
    a1

GIVEN driver IS A Driver
GIVETH A PROVISION OF Driver, Act
`loop` MEANS
    PARTY driver
    MAY a0
    HENCE `loop` driver

@export default loop only
GIVEN driver IS A Driver
GIVETH A PROVISION OF Driver, Act
`loop only` MEANS `loop` driver

@export default skip only
GIVEN driver IS A Driver
GIVETH A PROVISION OF Driver, Act
`skip only` MEANS
    (PARTY driver MUST a1 WITHIN 100000 HENCE FULFILLED LEST BREACH)
    RAND
    (PARTY driver MUST a1 WITHIN 100000 HENCE FULFILLED LEST BREACH)
