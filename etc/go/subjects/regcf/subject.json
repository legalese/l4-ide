{
  "_comment": [
    "The regcf subject sidecar. Everything the pipeline needs to know about",
    "THIS body of law lives here; everything about the pipeline itself lives in",
    "etc/go/. Validated by etc/go/lib/subject.mjs, which refuses unknown keys",
    "and missing files. Free-prose idiosyncrasies live in NOTES.md, which no",
    "script reads. All paths are repo-root-relative."
  ],
  "id": "regcf",
  "display_name": "SEC Regulation Crowdfunding",
  "citation": "17 CFR Part 227",
  "source_url": "https://www.ecfr.gov/current/title-17/chapter-II/part-227",
  "corpus": {
    "main": "jl4/examples/legal/regcf/regcf.l4",
    "wizard": "jl4/examples/legal/regcf/regcf-wizard.l4"
  },
  "checks": {
    "min_dated_arms": 2,
    "min_assertions": 20
  },
  "legs": {
    "p7-dmn": {
      "golden": "jl4/examples/dmn/expected/regcf-corpus.dmn",
      "fidelity_golden": "jl4/examples/dmn/expected/regcf-corpus.fidelity.txt",
      "cases": "jl4/examples/dmn/regcf-corpus.cases.json"
    },
    "p7-dmn-md": {
      "golden": "jl4/examples/dmn/expected/regcf-corpus.dmn.md",
      "fidelity_golden": "jl4/examples/dmn/expected/regcf-corpus.md.fidelity.txt"
    },
    "p7-bpmn": {
      "expected_dir": "jl4/examples/bpmn/expected",
      "rules": {
        "advertising restriction": "regcf-advertising",
        "ongoing reporting obligation": "regcf-reporting",
        "resale restriction": "regcf-resale"
      }
    },
    "p7-ladder": {
      "npm_dir": "ts-shared/ladder-svg",
      "npm_script": "demo:regcf",
      "demo_entry": "ts-shared/ladder-svg/demo/regcf.ts",
      "figures_dir": "jl4/examples/legal/regcf/figures"
    },
    "p7-lts": {},
    "p7-mcp": {},
    "p7-tnr": {
      "golden": "jl4/examples/legal/regcf/tests/regcf.nlg.golden",
      "wizard_golden": "jl4/examples/legal/regcf/tests/regcf-wizard.nlg.golden"
    },
    "p7-wizard": {},
    "p7-akn": {}
  }
}
