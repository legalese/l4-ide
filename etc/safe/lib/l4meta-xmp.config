#------------------------------------------------------------------------------
# etc/safe/lib/l4meta-xmp.config
#
# Copied VERBATIM (below this header) from smucclaw/l4meta,
# src/l4meta/config/xmp.config — Apache-2.0, © the l4meta authors.
#
# It defines ONE tag, XMP-pdfx:L4 (and PDF:L4 in the Info dictionary), whose value is a
# JSON document as a string. SPEC.md §5.4 (ruling R5) keeps l4meta's tag and this config
# UNCHANGED and defines only the JSON they carry, so a 2021 `l4meta out.pdf` reads a 2026
# SAFE. Do not edit this file to add fields; add them to the payload schema instead.
#
# Measured 2026-09-04:
#   exiftool -config <this file> -q -o out.pdf "-XMP-pdfx:L4<=payload.json" in.pdf
#   exiftool -config <this file> -XMP-pdfx:L4 -b out.pdf
#------------------------------------------------------------------------------
%Image::ExifTool::UserDefined = (
  'Image::ExifTool::PDF::Info' => {
    WRITABLE => 'string', # (default to string-type tags)
    L4 => { }, # stringification of arbitrary JSON
  },
  'Image::ExifTool::XMP::pdfx' => {
    WRITABLE => 'string', # (default to string-type tags)
    L4 => { }, # stringification of arbitrary JSON
  },
    );

#------------------------------------------------------------------------------
1;  #end
