<?xml version="1.0" encoding="UTF-8"?>
<!--
  clean.dmn with the numeric output declared the way `l4 export dmn` declares it:
  typeRef="number", the DMN 1.3 FEEL type. dmn-check 1.4.0 cannot parse that name
  (ExpressionTypeParser in dmn-check-validators-1.4.0-sources.jar knows only
  string, boolean, integer, long, double, date, item definitions and enum class
  names), so OutputTypeDeclarationValidator reports exactly one ERROR. That is a
  limit of dmn-check, not a defect in the table. If a later dmn-check learns
  "number", this fixture starts passing, selftest.sh fails, and README.md's
  account of it is stale.
-->
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="definitions_number" name="number-type" namespace="https://legalese.com/l4/dmn/fixture/number-type">
  <inputData id="input_colour" name="colour">
    <variable id="input_colour_var" name="colour" typeRef="string"/>
  </inputData>
  <decision id="decision_score" name="score">
    <variable id="decision_score_var" name="score" typeRef="number"/>
    <informationRequirement id="decision_score_ir1">
      <requiredInput href="#input_colour"/>
    </informationRequirement>
    <decisionTable id="decision_score_table" hitPolicy="UNIQUE">
      <input id="decision_score_i1" label="colour">
        <inputExpression id="decision_score_i1_expr" typeRef="string">
          <text>colour</text>
        </inputExpression>
      </input>
      <output id="decision_score_o1" name="score" typeRef="number"/>
      <rule id="decision_score_r1">
        <inputEntry id="decision_score_r1_i1">
          <text>"red"</text>
        </inputEntry>
        <outputEntry id="decision_score_r1_o1">
          <text>1</text>
        </outputEntry>
      </rule>
      <rule id="decision_score_r2">
        <inputEntry id="decision_score_r2_i1">
          <text>"blue"</text>
        </inputEntry>
        <outputEntry id="decision_score_r2_o1">
          <text>2</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
