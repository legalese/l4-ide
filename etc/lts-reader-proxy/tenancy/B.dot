digraph {
    graph [rankdir=TB
          ,label=receipts
          ,labelloc=t
          ,fontname=Helvetica
          ,fontsize=14];
    node [fontname=Helvetica
         ,fontsize=11];
    edge [fontname=Helvetica
         ,fontsize=10];
    0 [label=initial
      ,fillcolor=white
      ,style=filled
      ,shape=ellipse
      ,fillcolor="#e8f4fd"];
    1 [label="theLandlord must Receipt theLandlord\nt amount"
      ,fillcolor=white
      ,style=filled
      ,shape=ellipse
      ,fillcolor="#ffffff"];
    2 [label=Fulfilled
      ,fillcolor=white
      ,style=filled
      ,shape=doublecircle
      ,fillcolor="#d4edda"];
    3 [label=Breach
      ,fillcolor=white
      ,style=filled
      ,shape=doublecircle
      ,fillcolor="#f8d7da"];
    0 -> 1 [label="EVERY Tenant t IN tenants MUST Pay t\ntheLandlord `amount` [7]\nUPON EACH"
           ,color="#28a745"
           ,style=solid];
    0 -> 3 [label="timeout [7]"
           ,color="#dc3545"
           ,style=dashed];
    1 -> 2 [label="[5]"
           ,color="#28a745"
           ,style=solid];
    1 -> 3 [label="timeout [5]"
           ,color="#dc3545"
           ,style=dashed];
}
