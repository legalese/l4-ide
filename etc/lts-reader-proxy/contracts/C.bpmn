<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_aContract"
                  targetNamespace="https://l4.legalese.com/bpmn"
                  exporter="jl4 (L4.Bpmn)"
                  exporterVersion="1">
  <bpmn:error id="Error_breach" name="Breach" errorCode="BREACH" />
  <bpmn:collaboration id="Collaboration_aContract">
    <bpmn:participant id="Participant_aContract" name="aContract" processRef="Process_aContract" />
  </bpmn:collaboration>
  <bpmn:process id="Process_aContract" name="aContract" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_1_S" name="S">
        <bpmn:flowNodeRef>Task_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_0</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2_B" name="B">
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_unassigned" name="(unassigned)">
        <bpmn:flowNodeRef>Start_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Split_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_0" />
    <bpmn:task id="Task_0" name="MUST delivery">
      <bpmn:documentation>PARTY S MUST delivery WITHIN 3</bpmn:documentation>
    </bpmn:task>
    <bpmn:boundaryEvent id="Boundary_0" name="after P3D" attachedToRef="Task_0" cancelActivity="true">
      <bpmn:documentation>LEST: the obligation is not discharged within 3</bpmn:documentation>
      <bpmn:timerEventDefinition id="Timer_Boundary_0">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="Task_1" name="MUST payment price">
      <bpmn:documentation>PARTY B MUST payment price WITHIN 3 PROVIDED price AT LEAST 20</bpmn:documentation>
    </bpmn:task>
    <bpmn:boundaryEvent id="Boundary_1" name="after P3D" attachedToRef="Task_1" cancelActivity="true">
      <bpmn:documentation>LEST: the obligation is not discharged within 3</bpmn:documentation>
      <bpmn:timerEventDefinition id="Timer_Boundary_1">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Split_2" name="one of" gatewayDirection="Diverging">
      <bpmn:documentation>ROR: exactly one branch is entered</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_3" name="Fulfilled" />
    <bpmn:task id="Task_4" name="MUST return">
      <bpmn:documentation>PARTY B MUST return WITHIN 10</bpmn:documentation>
    </bpmn:task>
    <bpmn:boundaryEvent id="Boundary_4" name="after P10D" attachedToRef="Task_4" cancelActivity="true">
      <bpmn:documentation>LEST: the obligation is not discharged within 10</bpmn:documentation>
      <bpmn:timerEventDefinition id="Timer_Boundary_4">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P10D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_5" name="Breach">
      <bpmn:errorEventDefinition id="ErrorDef_End_5" errorRef="Error_breach" />
    </bpmn:endEvent>
    <bpmn:task id="Task_6" name="MUST payment fine">
      <bpmn:documentation>PARTY B MUST payment fine WITHIN 3</bpmn:documentation>
    </bpmn:task>
    <bpmn:boundaryEvent id="Boundary_6" name="after P3D" attachedToRef="Task_6" cancelActivity="true">
      <bpmn:documentation>LEST: the obligation is not discharged within 3</bpmn:documentation>
      <bpmn:timerEventDefinition id="Timer_Boundary_6">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_Start_0__Task_0" sourceRef="Start_0" targetRef="Task_0" />
    <bpmn:sequenceFlow id="Flow_Task_0__Task_1" sourceRef="Task_0" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_Boundary_0__End_5" sourceRef="Boundary_0" targetRef="End_5" />
    <bpmn:sequenceFlow id="Flow_Task_1__Split_2" sourceRef="Task_1" targetRef="Split_2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">price AT LEAST 20</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Boundary_1__Task_6" sourceRef="Boundary_1" targetRef="Task_6" />
    <bpmn:sequenceFlow id="Flow_Split_2__End_3" sourceRef="Split_2" targetRef="End_3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">price EQUALS 20</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Split_2__Task_4" sourceRef="Split_2" targetRef="Task_4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">NOT (price EQUALS 20)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Task_4__End_3" sourceRef="Task_4" targetRef="End_3" />
    <bpmn:sequenceFlow id="Flow_Boundary_4__End_5" sourceRef="Boundary_4" targetRef="End_5" />
    <bpmn:sequenceFlow id="Flow_Task_6__End_3" sourceRef="Task_6" targetRef="End_3" />
    <bpmn:sequenceFlow id="Flow_Boundary_6__End_5" sourceRef="Boundary_6" targetRef="End_5" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_aContract">
      <bpmndi:BPMNShape id="Shape_Participant_aContract" bpmnElement="Participant_aContract" isHorizontal="true">
        <dc:Bounds x="130" y="80" width="1130" height="600" />
