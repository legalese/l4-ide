      <bpmndi:BPMNShape id="Shape_End_5" bpmnElement="End_5">
        <dc:Bounds x="1132" y="562" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_6" bpmnElement="Task_6">
        <dc:Bounds x="740" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Boundary_6" bpmnElement="Boundary_6">
        <dc:Bounds x="794" y="322" width="36" height="36" />
      </bpmndi:BPMNShape>
