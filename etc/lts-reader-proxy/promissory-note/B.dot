digraph {
    graph [rankdir=TB
          ,label="Payment Obligations"
          ,labelloc=t
          ,fontname=Helvetica
          ,fontsize=14];
    node [fontname=Helvetica
         ,fontsize=11];
    edge [fontname=Helvetica
         ,fontsize=10];
    0 [label="initial\nONE OF"
      ,fillcolor=white
      ,style=filled
      ,shape=diamond
      ,fillcolor="#fde8cc"];
    1 [label="`The Borrower` must pay monthly installment to ..."
      ,fillcolor=white
      ,style=filled
      ,shape=ellipse
      ,fillcolor="#ffffff"];
    2 [label="`The Borrower` must pay monthly installment to ..."
      ,fillcolor=white
      ,style=filled
      ,shape=ellipse
      ,fillcolor="#ffffff"];
    3 [label=Fulfilled
      ,fillcolor=white
      ,style=filled
      ,shape=doublecircle
      ,fillcolor="#d4edda"];
    4 [label="`The Borrower` must pay monthly installment to ..."
      ,fillcolor=white
      ,style=filled
      ,shape=ellipse
      ,fillcolor="#ffffff"];
    5 [label=Breach
      ,fillcolor=white
      ,style=filled
      ,shape=doublecircle
      ,fillcolor="#f8d7da"];
    0 -> 1 [label=" IF (`Outstanding Payment Amount`'s Value) GREATER THAN 0"
           ,color="#e8850c"
           ,style=dotted];
    0 -> 3 [label=" IF NOT ((`Outstanding Payment Amount`'s Value) GREATER THAN 0)"
           ,color="#e8850c"
           ,style=dotted];
    1 -> 0 [label="`The Borrower` MUST pay monthly installment to ... [`Next Payment Due Date`] IF `is money at least equal within error` OF `Amount Transferred`, (`Next Payment Due`'s Amount)"
           ,color="#28a745"
           ,style=solid];
    1 -> 2 [label=timeout
           ,color="#dc3545"
           ,style=dashed];
    2 -> 3 [label="`The Borrower` MUST pay monthly installment to ... [`Default After Days Beyond Commencement`] IF `is money at least equal within error` OF `Amount Transferred`, `Next Payment Due Amount With Penalty`"
           ,color="#28a745"
           ,style=solid];
    2 -> 4 [label=timeout
           ,color="#dc3545"
           ,style=dashed];
    4 -> 3 [label="`The Borrower` MUST pay monthly installment to ... IF `is money at least equal within error` OF `Amount Transferred`, `All Outstanding Debts`"
           ,color="#28a745"
           ,style=solid];
    4 -> 5 [label="unreachable: no WITHIN"
           ,color="#dc3545"
           ,style=dashed];
}
