<?xml version="1.0" encoding="UTF-8"?>
<!--
  Classpath-only pom for the KIE/Drools DMN checker. Nothing here is part of the
  L4 build: `run.sh` uses it exclusively to resolve a classpath into $TMPDIR, and
  the jars never enter the repo.

  VERSIONS ARE PINNED ON PURPOSE. 8.44.0.Final is the version every claim marked
  EXECUTED in specs/todo/DMN-EXPORT-PROGRAM-MODEL-SPEC.md §13 was measured
  against. Bumping it invalidates those measurements, so bump it and re-measure,
  or not at all.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.legalese.l4</groupId>
  <artifactId>kie-dmn-check</artifactId>
  <version>1.0</version>
  <packaging>jar</packaging>
  <properties>
    <kie.version>8.44.0.Final</kie.version>
    <maven.compiler.release>11</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.kie</groupId>
      <artifactId>kie-dmn-core</artifactId>
      <version>${kie.version}</version>
    </dependency>
    <dependency>
      <!-- also the source of the DMN 1.3 XSD, which therefore needs no download -->
      <groupId>org.kie</groupId>
      <artifactId>kie-dmn-validation</artifactId>
      <version>${kie.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>1.7.36</version>
    </dependency>
  </dependencies>
</project>
