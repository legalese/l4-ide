    </informationRequirement>
    <literalExpression id="decision__5_2_direction_or_control_by_a_listed_person_is_expressly_permitted_literal">
      <text>true and entity.constitution.express_permission_for_the_entity_s_activities_to_be_directed_or_otherwise_controlled_by_a_Minister or (true and entity.constitution.express_permission_for_the_entity_s_activities_to_be_directed_or_otherwise_controlled_by_a_member_of_the_States_Assembly or true and entity.constitution.express_permission_for_the_entity_s_activities_to_be_directed_or_otherwise_controlled_by_any_equivalent_of_such_a_person_in_another_jurisdiction)</text>
    </literalExpression>
  </decision>
  <decision id="decision__5_2_governorship_by_a_listed_person_is_expressly_permitted" name="_5_2_governorship_by_a_listed_person_is_expressly_permitted" label="5(2) — governorship by a listed person is expressly permitted">
    <variable id="decision__5_2_governorship_by_a_listed_person_is_expressly_permitted_var" name="_5_2_governorship_by_a_listed_person_is_expressly_permitted" label="5(2) — governorship by a listed person is expressly permitted" typeRef="boolean"/>
    <informationRequirement id="decision__5_2_governorship_by_a_listed_person_is_expressly_permitted_ir1">
      <requiredInput href="#input_entity"/>
    </informationRequirement>
    <literalExpression id="decision__5_2_governorship_by_a_listed_person_is_expressly_permitted_literal">
      <text>true and entity.constitution.express_permission_for_any_of_the_entity_s_governors_to_be_a_Minister or (true and entity.constitution.express_permission_for_any_of_the_entity_s_governors_to_be_a_member_of_the_States_Assembly or true and entity.constitution.express_permission_for_any_of_the_entity_s_governors_to_be_any_equivalent_of_such_a_person_in_another_jurisdiction)</text>
    </literalExpression>
  </decision>
  <decision id="decision__5_2_a_listed_person_is_expressly_permitted_under_either_mode" name="_5_2_a_listed_person_is_expressly_permitted_under_either_mode" label="5(2) — a listed person is expressly permitted under either mode">
    <variable id="decision__5_2_a_listed_person_is_expressly_permitted_under_either_mode_var" name="_5_2_a_listed_person_is_expressly_permitted_under_either_mode" label="5(2) — a listed person is expressly permitted under either mode" typeRef="boolean"/>
    <informationRequirement id="decision__5_2_a_listed_person_is_expressly_permitted_under_either_mode_ir1">
      <requiredDecision href="#decision__5_2_direction_or_control_by_a_listed_person_is_expressly_permitted"/>
    </informationRequirement>
    <informationRequirement id="decision__5_2_a_listed_person_is_expressly_permitted_under_either_mode_ir2">
      <requiredDecision href="#decision__5_2_governorship_by_a_listed_person_is_expressly_permitted"/>
    </informationRequirement>
    <informationRequirement id="decision__5_2_a_listed_person_is_expressly_permitted_under_either_mode_ir3">
      <requiredInput href="#input_entity"/>
    </informationRequirement>
    <literalExpression id="decision__5_2_a_listed_person_is_expressly_permitted_under_either_mode_literal">
      <text>_5_2_direction_or_control_by_a_listed_person_is_expressly_permitted or _5_2_governorship_by_a_listed_person_is_expressly_permitted</text>
    </literalExpression>
  </decision>
  <decision id="decision__5_2_the_government_control_disqualification_applies" name="_5_2_the_government_control_disqualification_applies" label="5(2) — the government-control disqualification applies">
    <variable id="decision__5_2_the_government_control_disqualification_applies_var" name="_5_2_the_government_control_disqualification_applies" label="5(2) — the government-control disqualification applies" typeRef="boolean"/>
    <informationRequirement id="decision__5_2_the_government_control_disqualification_applies_ir1">
      <requiredDecision href="#decision__5_2_a_listed_person_is_expressly_permitted_under_either_mode"/>
    </informationRequirement>
    <informationRequirement id="decision__5_2_the_government_control_disqualification_applies_ir2">
      <requiredInput href="#input_entity"/>
    </informationRequirement>
    <literalExpression id="decision__5_2_the_government_control_disqualification_applies_literal">
      <text>true and _5_2_a_listed_person_is_expressly_permitted_under_either_mode and (entity.constitution.that_permission_extended_to_such_a_person_acting_in_that_capacity and (true and not(entity.specified_in_an_Order_under_Article_5_3_disapplying_paragraph_2)))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_entity_meets_the_charity_test" name="the_entity_meets_the_charity_test" label="the entity meets the charity test">
    <variable id="decision_the_entity_meets_the_charity_test_var" name="the_entity_meets_the_charity_test" label="the entity meets the charity test" typeRef="boolean"/>
    <informationRequirement id="decision_the_entity_meets_the_charity_test_ir1">
      <requiredDecision href="#decision__5_1_a_all_of_its_purposes_are_charitable_or_ancillary"/>
    </informationRequirement>
    <informationRequirement id="decision_the_entity_meets_the_charity_test_ir2">
      <requiredDecision href="#decision__5_1_b_public_benefit"/>
    </informationRequirement>
    <informationRequirement id="decision_the_entity_meets_the_charity_test_ir3">
      <requiredDecision href="#decision__5_2_the_government_control_disqualification_applies"/>
    </informationRequirement>
    <informationRequirement id="decision_the_entity_meets_the_charity_test_ir4">
      <requiredInput href="#input_entity"/>
    </informationRequirement>
    <literalExpression id="decision_the_entity_meets_the_charity_test_literal">
      <text>_5_1_a_all_of_its_purposes_are_charitable_or_ancillary and (_5_1_b_public_benefit and not(_5_2_the_government_control_disqualification_applies))</text>
    </literalExpression>
  </decision>
  <businessKnowledgeModel id="bkm_the_purpose_is_a_charitable_purpose" name="the_purpose_is_a_charitable_purpose" label="the purpose is a charitable purpose">
    <variable id="bkm_the_purpose_is_a_charitable_purpose_var" name="the_purpose_is_a_charitable_purpose" label="the purpose is a charitable purpose" typeRef="boolean"/>
    <encapsulatedLogic id="bkm_the_purpose_is_a_charitable_purpose_logic">
      <formalParameter id="bkm_the_purpose_is_a_charitable_purpose_p1" name="purpose" typeRef="Purpose"/>
      <formalParameter id="bkm_the_purpose_is_a_charitable_purpose_p2" name="_5_the_purpose_is_excluded_as_political" typeRef="boolean"/>
      <formalParameter id="bkm_the_purpose_is_a_charitable_purpose_p3" name="the_purpose_falls_within_paragraph_1" typeRef="boolean"/>
      <literalExpression id="bkm_the_purpose_is_a_charitable_purpose_literal">
        <text>the_purpose_falls_within_paragraph_1 and not(_5_the_purpose_is_excluded_as_political)</text>
      </literalExpression>
    </encapsulatedLogic>
  </businessKnowledgeModel>
