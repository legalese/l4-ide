<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" id="definitions_charities_jersey_law_2014_the_charity_test" name="Charities (Jersey) Law 2014 — the charity test" namespace="https://legalese.com/l4/dmn/charities_jersey_law_2014_the_charity_test" exporter="jl4">
  <itemDefinition id="itemdef_purpose" name="Purpose">
    <itemComponent id="itemdef_purpose_c1" name="description">
      <typeRef>string</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_purpose_c2" name="the_prevention_or_relief_of_poverty" label="the prevention or relief of poverty">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_purpose_c3" name="the_advancement_of_education" label="the advancement of education">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_purpose_c4" name="the_advancement_of_religion" label="the advancement of religion">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_purpose_c5" name="the_advancement_of_health" label="the advancement of health">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_purpose_c6" name="the_prevention_or_relief_of_sickness_disease_or_human_suffering" label="the prevention or relief of sickness, disease or human suffering">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_purpose_c7" name="the_saving_of_lives" label="the saving of lives">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_purpose_c8" name="the_advancement_of_citizenship_or_community_development" label="the advancement of citizenship or community development">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_purpose_c9" name="rural_or_urban_regeneration" label="rural or urban regeneration">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_purpose_c10" name="the_promotion_of_civic_responsibility_volunteering_the_voluntary_sector_or_the_effectiveness_or_efficiency_of_registered_charities" label="the promotion of civic responsibility, volunteering, the voluntary sector or the effectiveness or efficiency of registered charities">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_purpose_c11" name="the_advancement_of_the_arts_heritage_culture_or_science" label="the advancement of the arts, heritage, culture or science">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_purpose_c12" name="the_advancement_of_public_participation_in_sport" label="the advancement of public participation in sport">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_purpose_c13" name="sport_that_involves_physical_skill_and_exertion" label="sport that involves physical skill and exertion">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_purpose_c14" name="the_provision_of_recreational_facilities_or_the_organisation_of_recreational_activities_with_the_object_of_improving_the_conditions_of_life_for_the_persons_for_whom_they_are_primarily_intended" label="the provision of recreational facilities, or the organisation of recreational activities, with the object of improving the conditions of life for the persons for whom they are primarily intended">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_purpose_c15" name="primarily_intended_for_persons_who_have_need_of_them_by_reason_of_their_age_ill_health_disability_financial_hardship_or_other_disadvantage" label="primarily intended for persons who have need of them by reason of their age, ill-health, disability, financial hardship or other disadvantage">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_purpose_c16" name="available_to_members_of_the_public_at_large_or_to_male_or_female_members_of_the_public_at_large" label="available to members of the public at large or to male or female members of the public at large">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_purpose_c17" name="the_advancement_of_human_rights_conflict_resolution_or_reconciliation" label="the advancement of human rights, conflict resolution or reconciliation">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_purpose_c18" name="the_promotion_of_religious_or_racial_harmony" label="the promotion of religious or racial harmony">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_purpose_c19" name="the_promotion_of_equality_and_diversity" label="the promotion of equality and diversity">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_purpose_c20" name="the_advancement_of_environmental_protection_or_improvement" label="the advancement of environmental protection or improvement">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_purpose_c21" name="the_relief_of_those_in_need_by_reason_of_age_ill_health_disability_financial_hardship_or_other_disadvantage" label="the relief of those in need by reason of age, ill-health, disability, financial hardship or other disadvantage">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_purpose_c22" name="the_advancement_of_animal_welfare" label="the advancement of animal welfare">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_purpose_c23" name="reasonably_regarded_as_analogous_to_any_of_the_purposes_listed_in_sub_paragraphs_a_to_o" label="reasonably regarded as analogous to any of the purposes listed in sub-paragraphs (a) to (o)">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_purpose_c24" name="the_advancement_of_a_philosophical_belief_whether_or_not_involving_belief_in_a_god" label="the advancement of a philosophical belief (whether or not involving belief in a god)">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_purpose_c25" name="for_advancing_a_political_party_or_promoting_a_candidate_for_election_to_any_office_whether_in_Jersey_or_elsewhere" label="for advancing a political party or promoting a candidate for election to any office, whether in Jersey or elsewhere">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_purpose_c26" name="purely_ancillary_or_incidental_to_any_of_the_entity_s_charitable_purposes" label="purely ancillary or incidental to any of the entity&apos;s charitable purposes">
      <typeRef>boolean</typeRef>
    </itemComponent>
  </itemDefinition>
  <itemDefinition id="itemdef_constitution" name="Constitution">
    <itemComponent id="itemdef_constitution_c1" name="description">
      <typeRef>string</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_constitution_c2" name="express_permission_for_the_entity_s_activities_to_be_directed_or_otherwise_controlled_by_a_Minister" label="express permission for the entity&apos;s activities to be directed or otherwise controlled by a Minister">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_constitution_c3" name="express_permission_for_the_entity_s_activities_to_be_directed_or_otherwise_controlled_by_a_member_of_the_States_Assembly" label="express permission for the entity&apos;s activities to be directed or otherwise controlled by a member of the States Assembly">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_constitution_c4" name="express_permission_for_the_entity_s_activities_to_be_directed_or_otherwise_controlled_by_any_equivalent_of_such_a_person_in_another_jurisdiction" label="express permission for the entity&apos;s activities to be directed or otherwise controlled by any equivalent of such a person in another jurisdiction">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_constitution_c5" name="express_permission_for_any_of_the_entity_s_governors_to_be_a_Minister" label="express permission for any of the entity&apos;s governors to be a Minister">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_constitution_c6" name="express_permission_for_any_of_the_entity_s_governors_to_be_a_member_of_the_States_Assembly" label="express permission for any of the entity&apos;s governors to be a member of the States Assembly">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_constitution_c7" name="express_permission_for_any_of_the_entity_s_governors_to_be_any_equivalent_of_such_a_person_in_another_jurisdiction" label="express permission for any of the entity&apos;s governors to be any equivalent of such a person in another jurisdiction">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_constitution_c8" name="that_permission_extended_to_such_a_person_acting_in_that_capacity" label="that permission extended to such a person acting in that capacity">
      <typeRef>boolean</typeRef>
    </itemComponent>
  </itemDefinition>
  <itemDefinition id="itemdef_publicbenefitfinding" name="PublicBenefitFinding">
    <itemComponent id="itemdef_publicbenefitfinding_c1" name="description">
      <typeRef>string</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_publicbenefitfinding_c2" name="public_benefit_in_Jersey_or_elsewhere_to_a_reasonable_degree_provided_in_giving_effect_to_those_purposes" label="public benefit in Jersey or elsewhere, to a reasonable degree, provided in giving effect to those purposes">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_publicbenefitfinding_c3" name="public_benefit_in_Jersey_or_elsewhere_to_a_reasonable_degree_intended_to_be_provided_in_giving_effect_to_those_purposes" label="public benefit in Jersey or elsewhere, to a reasonable degree, intended to be provided in giving effect to those purposes">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_publicbenefitfinding_c4" name="benefit_provided_only_to_one_particular_natural_person_or_to_a_group_of_identified_natural_persons" label="benefit provided only to one particular natural person or to a group of identified natural persons">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_publicbenefitfinding_c5" name="benefit_provided_to_a_section_of_the_public_only" label="benefit provided to a section of the public only">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_publicbenefitfinding_c6" name="any_condition_on_obtaining_that_benefit_including_any_charge_or_fee_unduly_restrictive" label="any condition on obtaining that benefit (including any charge or fee) unduly restrictive">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_publicbenefitfinding_c7" name="regard_had_to_the_comparison_required_by_Article_7_2_a" label="regard had to the comparison required by Article 7(2)(a)">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_publicbenefitfinding_c8" name="regard_had_to_the_question_required_by_Article_7_2_b" label="regard had to the question required by Article 7(2)(b)">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_publicbenefitfinding_c9" name="a_particular_charitable_purpose_presumed_to_be_for_the_public_benefit" label="a particular charitable purpose presumed to be for the public benefit">
      <typeRef>boolean</typeRef>
    </itemComponent>
  </itemDefinition>
  <itemDefinition id="itemdef_entity" name="Entity">
    <itemComponent id="itemdef_entity_c1" name="name">
      <typeRef>string</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_entity_c2" name="purposes">
      <typeRef>Any</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_entity_c3" name="constitution">
      <typeRef>Constitution</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_entity_c4" name="an_applicant" label="an applicant">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_entity_c5" name="the_public_benefit_finding" label="the public benefit finding">
      <typeRef>PublicBenefitFinding</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_entity_c6" name="specified_in_an_Order_under_Article_5_3_disapplying_paragraph_2" label="specified in an Order under Article 5(3) disapplying paragraph (2)">
      <typeRef>boolean</typeRef>
    </itemComponent>
  </itemDefinition>
  <inputData id="input_purpose" name="purpose">
    <variable id="input_purpose_var" name="purpose" typeRef="Purpose"/>
  </inputData>
  <inputData id="input_entity" name="entity">
    <variable id="input_entity_var" name="entity" typeRef="Entity"/>
  </inputData>
  <decision id="decision_article_1_the_definitions_on_which_the_charity_test_depends" name="Article_1_the_definitions_on_which_the_charity_test_depends" label="Article 1 — the definitions on which the charity test depends">
    <variable id="decision_article_1_the_definitions_on_which_the_charity_test_depends_var" name="Article_1_the_definitions_on_which_the_charity_test_depends" label="Article 1 — the definitions on which the charity test depends" typeRef="boolean"/>
    <literalExpression id="decision_article_1_the_definitions_on_which_the_charity_test_depends_literal">
      <text>true and (true and (true and (true and true)))</text>
    </literalExpression>
  </decision>
  <decision id="decision_article_2_4_constitution" name="Article_2_4_constitution" label="Article 2(4) — constitution">
    <variable id="decision_article_2_4_constitution_var" name="Article_2_4_constitution" label="Article 2(4) — constitution" typeRef="boolean"/>
    <literalExpression id="decision_article_2_4_constitution_literal">
      <text>true and (true and (true and (true and true)))</text>
    </literalExpression>
  </decision>
  <decision id="decision_article_2_6_purpose" name="Article_2_6_purpose" label="Article 2(6) — purpose">
    <variable id="decision_article_2_6_purpose_var" name="Article_2_6_purpose" label="Article 2(6) — purpose" typeRef="boolean"/>
    <literalExpression id="decision_article_2_6_purpose_literal">
      <text>true and (true and true)</text>
    </literalExpression>
  </decision>
  <decision id="decision_article_2_7_governor" name="Article_2_7_governor" label="Article 2(7) — governor">
    <variable id="decision_article_2_7_governor_var" name="Article_2_7_governor" label="Article 2(7) — governor" typeRef="boolean"/>
    <literalExpression id="decision_article_2_7_governor_literal">
      <text>true and (true and (true and (true and true)))</text>
    </literalExpression>
  </decision>
  <decision id="decision_a_the_prevention_or_relief_of_poverty" name="a_the_prevention_or_relief_of_poverty" label="(a) — the prevention or relief of poverty">
    <variable id="decision_a_the_prevention_or_relief_of_poverty_var" name="a_the_prevention_or_relief_of_poverty" label="(a) — the prevention or relief of poverty" typeRef="boolean"/>
    <informationRequirement id="decision_a_the_prevention_or_relief_of_poverty_ir1">
      <requiredInput href="#input_purpose"/>
    </informationRequirement>
    <literalExpression id="decision_a_the_prevention_or_relief_of_poverty_literal">
      <text>true and purpose.the_prevention_or_relief_of_poverty</text>
    </literalExpression>
  </decision>
  <decision id="decision_b_the_advancement_of_education" name="b_the_advancement_of_education" label="(b) — the advancement of education">
    <variable id="decision_b_the_advancement_of_education_var" name="b_the_advancement_of_education" label="(b) — the advancement of education" typeRef="boolean"/>
    <informationRequirement id="decision_b_the_advancement_of_education_ir1">
      <requiredInput href="#input_purpose"/>
    </informationRequirement>
    <literalExpression id="decision_b_the_advancement_of_education_literal">
      <text>true and purpose.the_advancement_of_education</text>
    </literalExpression>
  </decision>
  <decision id="decision_c_the_advancement_of_religion" name="c_the_advancement_of_religion" label="(c) — the advancement of religion">
    <variable id="decision_c_the_advancement_of_religion_var" name="c_the_advancement_of_religion" label="(c) — the advancement of religion" typeRef="boolean"/>
    <informationRequirement id="decision_c_the_advancement_of_religion_ir1">
      <requiredInput href="#input_purpose"/>
    </informationRequirement>
    <literalExpression id="decision_c_the_advancement_of_religion_literal">
      <text>true and purpose.the_advancement_of_religion</text>
    </literalExpression>
  </decision>
  <decision id="decision_d_the_advancement_of_health" name="d_the_advancement_of_health" label="(d) — the advancement of health">
    <variable id="decision_d_the_advancement_of_health_var" name="d_the_advancement_of_health" label="(d) — the advancement of health" typeRef="boolean"/>
    <informationRequirement id="decision_d_the_advancement_of_health_ir1">
      <requiredInput href="#input_purpose"/>
    </informationRequirement>
    <literalExpression id="decision_d_the_advancement_of_health_literal">
      <text>true and purpose.the_advancement_of_health or true and purpose.the_prevention_or_relief_of_sickness_disease_or_human_suffering</text>
    </literalExpression>
  </decision>
  <decision id="decision_e_the_saving_of_lives" name="e_the_saving_of_lives" label="(e) — the saving of lives">
    <variable id="decision_e_the_saving_of_lives_var" name="e_the_saving_of_lives" label="(e) — the saving of lives" typeRef="boolean"/>
    <informationRequirement id="decision_e_the_saving_of_lives_ir1">
      <requiredInput href="#input_purpose"/>
    </informationRequirement>
    <literalExpression id="decision_e_the_saving_of_lives_literal">
      <text>true and purpose.the_saving_of_lives</text>
    </literalExpression>
  </decision>
  <decision id="decision_f_the_advancement_of_citizenship_or_community_development" name="f_the_advancement_of_citizenship_or_community_development" label="(f) — the advancement of citizenship or community development">
    <variable id="decision_f_the_advancement_of_citizenship_or_community_development_var" name="f_the_advancement_of_citizenship_or_community_development" label="(f) — the advancement of citizenship or community development" typeRef="boolean"/>
    <informationRequirement id="decision_f_the_advancement_of_citizenship_or_community_development_ir1">
      <requiredInput href="#input_purpose"/>
    </informationRequirement>
    <literalExpression id="decision_f_the_advancement_of_citizenship_or_community_development_literal">
      <text>true and purpose.the_advancement_of_citizenship_or_community_development or (true and purpose.rural_or_urban_regeneration or true and purpose.the_promotion_of_civic_responsibility_volunteering_the_voluntary_sector_or_the_effectiveness_or_efficiency_of_registered_charities)</text>
    </literalExpression>
  </decision>
  <decision id="decision_g_the_advancement_of_the_arts_heritage_culture_or_science" name="g_the_advancement_of_the_arts_heritage_culture_or_science" label="(g) — the advancement of the arts, heritage, culture or science">
    <variable id="decision_g_the_advancement_of_the_arts_heritage_culture_or_science_var" name="g_the_advancement_of_the_arts_heritage_culture_or_science" label="(g) — the advancement of the arts, heritage, culture or science" typeRef="boolean"/>
    <informationRequirement id="decision_g_the_advancement_of_the_arts_heritage_culture_or_science_ir1">
      <requiredInput href="#input_purpose"/>
    </informationRequirement>
    <literalExpression id="decision_g_the_advancement_of_the_arts_heritage_culture_or_science_literal">
      <text>true and purpose.the_advancement_of_the_arts_heritage_culture_or_science</text>
    </literalExpression>
  </decision>
  <decision id="decision_h_the_advancement_of_public_participation_in_sport" name="h_the_advancement_of_public_participation_in_sport" label="(h) — the advancement of public participation in sport">
    <variable id="decision_h_the_advancement_of_public_participation_in_sport_var" name="h_the_advancement_of_public_participation_in_sport" label="(h) — the advancement of public participation in sport" typeRef="boolean"/>
    <informationRequirement id="decision_h_the_advancement_of_public_participation_in_sport_ir1">
      <requiredInput href="#input_purpose"/>
    </informationRequirement>
    <literalExpression id="decision_h_the_advancement_of_public_participation_in_sport_literal">
      <text>true and purpose.the_advancement_of_public_participation_in_sport and (true and purpose.sport_that_involves_physical_skill_and_exertion)</text>
    </literalExpression>
  </decision>
  <decision id="decision__2_d_the_recreational_facilities_restriction_is_satisfied" name="_2_d_the_recreational_facilities_restriction_is_satisfied" label="(2)(d) — the recreational-facilities restriction is satisfied">
    <variable id="decision__2_d_the_recreational_facilities_restriction_is_satisfied_var" name="_2_d_the_recreational_facilities_restriction_is_satisfied" label="(2)(d) — the recreational-facilities restriction is satisfied" typeRef="boolean"/>
    <informationRequirement id="decision__2_d_the_recreational_facilities_restriction_is_satisfied_ir1">
      <requiredInput href="#input_purpose"/>
    </informationRequirement>
    <literalExpression id="decision__2_d_the_recreational_facilities_restriction_is_satisfied_literal">
      <text>false or (true and purpose.primarily_intended_for_persons_who_have_need_of_them_by_reason_of_their_age_ill_health_disability_financial_hardship_or_other_disadvantage or true and purpose.available_to_members_of_the_public_at_large_or_to_male_or_female_members_of_the_public_at_large)</text>
    </literalExpression>
  </decision>
  <decision id="decision_i_the_provision_of_recreational_facilities_or_activities" name="i_the_provision_of_recreational_facilities_or_activities" label="(i) — the provision of recreational facilities or activities">
    <variable id="decision_i_the_provision_of_recreational_facilities_or_activities_var" name="i_the_provision_of_recreational_facilities_or_activities" label="(i) — the provision of recreational facilities or activities" typeRef="boolean"/>
    <informationRequirement id="decision_i_the_provision_of_recreational_facilities_or_activities_ir1">
      <requiredDecision href="#decision__2_d_the_recreational_facilities_restriction_is_satisfied"/>
    </informationRequirement>
    <informationRequirement id="decision_i_the_provision_of_recreational_facilities_or_activities_ir2">
      <requiredInput href="#input_purpose"/>
    </informationRequirement>
    <literalExpression id="decision_i_the_provision_of_recreational_facilities_or_activities_literal">
      <text>true and purpose.the_provision_of_recreational_facilities_or_the_organisation_of_recreational_activities_with_the_object_of_improving_the_conditions_of_life_for_the_persons_for_whom_they_are_primarily_intended and _2_d_the_recreational_facilities_restriction_is_satisfied</text>
    </literalExpression>
  </decision>
  <decision id="decision_j_the_advancement_of_human_rights_conflict_resolution_or_reconciliation" name="j_the_advancement_of_human_rights_conflict_resolution_or_reconciliation" label="(j) — the advancement of human rights, conflict resolution or reconciliation">
    <variable id="decision_j_the_advancement_of_human_rights_conflict_resolution_or_reconciliation_var" name="j_the_advancement_of_human_rights_conflict_resolution_or_reconciliation" label="(j) — the advancement of human rights, conflict resolution or reconciliation" typeRef="boolean"/>
    <informationRequirement id="decision_j_the_advancement_of_human_rights_conflict_resolution_or_reconciliation_ir1">
      <requiredInput href="#input_purpose"/>
    </informationRequirement>
    <literalExpression id="decision_j_the_advancement_of_human_rights_conflict_resolution_or_reconciliation_literal">
      <text>true and purpose.the_advancement_of_human_rights_conflict_resolution_or_reconciliation</text>
    </literalExpression>
  </decision>
  <decision id="decision_k_the_promotion_of_religious_or_racial_harmony" name="k_the_promotion_of_religious_or_racial_harmony" label="(k) — the promotion of religious or racial harmony">
    <variable id="decision_k_the_promotion_of_religious_or_racial_harmony_var" name="k_the_promotion_of_religious_or_racial_harmony" label="(k) — the promotion of religious or racial harmony" typeRef="boolean"/>
    <informationRequirement id="decision_k_the_promotion_of_religious_or_racial_harmony_ir1">
      <requiredInput href="#input_purpose"/>
    </informationRequirement>
    <literalExpression id="decision_k_the_promotion_of_religious_or_racial_harmony_literal">
      <text>true and purpose.the_promotion_of_religious_or_racial_harmony</text>
    </literalExpression>
