    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Decide whether an entity meets the charity test in Article 5 of the Charities (Jersey) Law 2014, applying the charitable-purposes heads in Article 6 (including the political-purposes carve-out), the public-benefit rules in Article 7, and the government-control disqualification in Article 5(2).",
    "properties": {
        "entity": {
            "$ref": "#/$defs/Entity",
            "description": "The entity, its purposes as characterised against the Article 6(1) heads, its constitution as characterised against Article 5(2), and the Article 7 public-benefit finding."
        }
    },
    "required": [
        "entity"
    ],
    "title": "the entity meets the charity test",
    "type": "object"
