                    "type": "boolean"
                },
                "express permission for any of the entity's governors to be any equivalent of such a person in another jurisdiction": {
                    "type": "boolean"
                },
                "express permission for the entity's activities to be directed or otherwise controlled by a Minister": {
                    "type": "boolean"
                },
                "express permission for the entity's activities to be directed or otherwise controlled by a member of the States Assembly": {
                    "type": "boolean"
                },
                "express permission for the entity's activities to be directed or otherwise controlled by any equivalent of such a person in another jurisdiction": {
                    "type": "boolean"
                },
                "that permission extended to such a person acting in that capacity": {
                    "type": "boolean"
                }
