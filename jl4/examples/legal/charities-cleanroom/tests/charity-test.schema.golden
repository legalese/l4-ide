                "a particular charitable purpose presumed to be for the public benefit": {
                    "type": "boolean"
                },
                "any condition on obtaining that benefit (including any charge or fee) unduly restrictive": {
                    "type": "boolean"
                },
                "benefit provided only to one particular natural person or to a group of identified natural persons": {
                    "type": "boolean"
                },
                "benefit provided to a section of the public only": {
                    "type": "boolean"
                },
                "description": {
                    "type": "string"
                },
                "public benefit in Jersey or elsewhere, to a reasonable degree, intended to be provided in giving effect to those purposes": {
                    "type": "boolean"
                },
