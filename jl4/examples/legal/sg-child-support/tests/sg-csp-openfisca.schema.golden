    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "The five lines of the SG Child Support Package added together, for one Singapore Citizen child, birth to 17. The co-matching line is a cap; at full take-up this is the \"up to $62,000\" of the announcement.",
    "properties": {
        "p": {
            "$ref": "#/$defs/Person",
            "description": "The child."
        },
        "period": {
