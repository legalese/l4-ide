{
    "$defs": {
        "Closing": {
            "properties": {
                "amount sold in reliance on section 4(a)(6)": {
                    "type": "number"
                },
                "date": {
                    "format": "date",
                    "type": "string"
                }
            },
            "required": [
                "date",
                "amount sold in reliance on section 4(a)(6)"
            ],
            "type": "object"
        },
        "CoveredPerson": {
            "properties": {
                "class": {
                    "$ref": "#/$defs/covered person class"
                },
                "convicted of a felony or misdemeanor arising out of the conduct of the business of an underwriter, broker, dealer, municipal securities dealer, investment adviser, funding portal or paid solicitor of purchasers of securities": {
                    "type": "boolean"
                },
                "convicted of a felony or misdemeanor in connection with the purchase or sale of any security": {
                    "type": "boolean"
                },
                "convicted of a felony or misdemeanor involving the making of a false filing with the Commission": {
                    "type": "boolean"
                },
                "date of the United States Postal Service false representation order": {
                    "format": "date",
                    "type": "string"
                },
                "date of the conviction": {
                    "format": "date",
                    "type": "string"
                },
                "date of the refusal order, stop order or order suspending the Regulation A exemption": {
                    "format": "date",
                    "type": "string"
                },
                "date of the suspension or expulsion": {
                    "format": "date",
                    "type": "string"
                },
                "date the Commission cease-and-desist order was entered": {
                    "format": "date",
                    "type": "string"
                },
                "date the Commission order under section 15(b), 15B(c) or Advisers Act 203(e) or (f) was entered": {
                    "format": "date",
                    "type": "string"
                },
                "date the court order, judgment or decree was entered": {
                    "format": "date",
                    "type": "string"
                },
                "date the final order was entered": {
                    "format": "date",
                    "type": "string"
                },
                "filed as a registrant or issuer, or was named as an underwriter in, a registration statement or Regulation A offering statement that was the subject of a refusal order, stop order, or order suspending the Regulation A exemption": {
                    "type": "boolean"
                },
                "in control of the issuer": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                },
                "subject to a Commission order to cease and desist from committing or causing a violation of a scienter-based anti-fraud provision of the Federal securities laws": {
                    "type": "boolean"
                },
                "subject to a Commission order to cease and desist from committing or causing a violation of section 5 of the Securities Act": {
                    "type": "boolean"
                },
                "subject to a United States Postal Service false representation order": {
                    "type": "boolean"
                },
                "subject to a court order, judgment or decree restraining or enjoining conduct arising out of the conduct of the business of an underwriter, broker, dealer, municipal securities dealer, investment adviser, funding portal or paid solicitor of purchasers of securities": {
                    "type": "boolean"
                },
                "subject to a court order, judgment or decree restraining or enjoining conduct in connection with the purchase or sale of any security": {
                    "type": "boolean"
                },
                "subject to a court order, judgment or decree restraining or enjoining conduct involving the making of a false filing with the Commission": {
                    "type": "boolean"
                },
                "subject to a final order of a State securities commission, a State bank or credit union supervisor, a State insurance commission, an appropriate Federal banking agency, the U.S. Commodity Futures Trading Commission or the National Credit Union Administration": {
                    "type": "boolean"
                },
                "subject to an order of the Commission under section 15(b) or 15B(c) of the Exchange Act or section 203(e) or (f) of the Investment Advisers Act": {
                    "type": "boolean"
                },
                "subject, at the time of such filing or sale, to a temporary restraining order or preliminary injunction with respect to conduct alleged by the United States Postal Service to constitute a scheme or device for obtaining money or property through the mail by means of false representations": {
                    "type": "boolean"
                },
                "suspended or expelled from membership in, or suspended or barred from association with a member of, a registered national securities exchange or a registered national or affiliated securities association for conduct inconsistent with just and equitable principles of trade": {
                    "type": "boolean"
                },
                "that Commission order bars the person from being associated with any entity or from participating in the offering of any penny stock": {
                    "type": "boolean"
                },
                "that Commission order places limitations on the activities, functions or operations of the person": {
                    "type": "boolean"
                },
                "that Commission order suspends or revokes the person's registration as a broker, dealer, municipal securities dealer, investment adviser or funding portal": {
                    "type": "boolean"
                },
                "that cease-and-desist order is in effect at the time of such filing or sale": {
                    "type": "boolean"
                },
                "that final order bars the person from association with an entity regulated by such commission, authority, agency or officer": {
                    "type": "boolean"
                },
                "that final order bars the person from engaging in savings association or credit union activities": {
                    "type": "boolean"
                },
                "that final order bars the person from engaging in the business of securities, insurance or banking": {
                    "type": "boolean"
                },
                "that final order is based on a violation of a law or regulation prohibiting fraudulent, manipulative or deceptive conduct": {
                    "type": "boolean"
                },
                "the court or regulatory authority that entered the relevant order, judgment or decree advised in writing that disqualification should not arise": {
                    "type": "boolean"
                },
                "the court order, judgment or decree restrains or enjoins the person at the time of such filing or sale": {
                    "type": "boolean"
                },
                "the event occurred before the affiliation with the issuer arose": {
                    "type": "boolean"
                },
                "the subject, at the time of such filing or sale, of an investigation or proceeding to determine whether a stop order or suspension order should be issued": {
                    "type": "boolean"
                },
                "under common control with the issuer by a third party that was in control of the affiliated entity at the time of such events": {
                    "type": "boolean"
                }
            },
            "required": [
                "name",
                "class",
                "convicted of a felony or misdemeanor in connection with the purchase or sale of any security",
                "convicted of a felony or misdemeanor involving the making of a false filing with the Commission",
                "convicted of a felony or misdemeanor arising out of the conduct of the business of an underwriter, broker, dealer, municipal securities dealer, investment adviser, funding portal or paid solicitor of purchasers of securities",
                "date of the conviction",
                "subject to a court order, judgment or decree restraining or enjoining conduct in connection with the purchase or sale of any security",
                "subject to a court order, judgment or decree restraining or enjoining conduct involving the making of a false filing with the Commission",
                "subject to a court order, judgment or decree restraining or enjoining conduct arising out of the conduct of the business of an underwriter, broker, dealer, municipal securities dealer, investment adviser, funding portal or paid solicitor of purchasers of securities",
                "the court order, judgment or decree restrains or enjoins the person at the time of such filing or sale",
                "date the court order, judgment or decree was entered",
                "subject to a final order of a State securities commission, a State bank or credit union supervisor, a State insurance commission, an appropriate Federal banking agency, the U.S. Commodity Futures Trading Commission or the National Credit Union Administration",
                "that final order bars the person from association with an entity regulated by such commission, authority, agency or officer",
                "that final order bars the person from engaging in the business of securities, insurance or banking",
                "that final order bars the person from engaging in savings association or credit union activities",
                "that final order is based on a violation of a law or regulation prohibiting fraudulent, manipulative or deceptive conduct",
                "date the final order was entered",
                "subject to an order of the Commission under section 15(b) or 15B(c) of the Exchange Act or section 203(e) or (f) of the Investment Advisers Act",
                "that Commission order suspends or revokes the person's registration as a broker, dealer, municipal securities dealer, investment adviser or funding portal",
                "that Commission order places limitations on the activities, functions or operations of the person",
                "that Commission order bars the person from being associated with any entity or from participating in the offering of any penny stock",
                "date the Commission order under section 15(b), 15B(c) or Advisers Act 203(e) or (f) was entered",
                "subject to a Commission order to cease and desist from committing or causing a violation of a scienter-based anti-fraud provision of the Federal securities laws",
                "subject to a Commission order to cease and desist from committing or causing a violation of section 5 of the Securities Act",
                "that cease-and-desist order is in effect at the time of such filing or sale",
                "date the Commission cease-and-desist order was entered",
                "suspended or expelled from membership in, or suspended or barred from association with a member of, a registered national securities exchange or a registered national or affiliated securities association for conduct inconsistent with just and equitable principles of trade",
                "date of the suspension or expulsion",
                "filed as a registrant or issuer, or was named as an underwriter in, a registration statement or Regulation A offering statement that was the subject of a refusal order, stop order, or order suspending the Regulation A exemption",
                "the subject, at the time of such filing or sale, of an investigation or proceeding to determine whether a stop order or suspension order should be issued",
                "date of the refusal order, stop order or order suspending the Regulation A exemption",
                "subject to a United States Postal Service false representation order",
                "subject, at the time of such filing or sale, to a temporary restraining order or preliminary injunction with respect to conduct alleged by the United States Postal Service to constitute a scheme or device for obtaining money or property through the mail by means of false representations",
                "date of the United States Postal Service false representation order",
                "the court or regulatory authority that entered the relevant order, judgment or decree advised in writing that disqualification should not arise",
                "the event occurred before the affiliation with the issuer arose",
                "in control of the issuer",
                "under common control with the issuer by a third party that was in control of the affiliated entity at the time of such events"
            ],
            "type": "object"
        },
        "Disclosure": {
