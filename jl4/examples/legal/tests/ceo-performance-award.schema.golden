{
    "$defs": {
        "CEO Award State": {
            "properties": {
                "CEO Succession Framework": {
                    "type": "boolean"
                },
                "Covered Event Occurred": {
                    "type": "boolean"
                },
                "Covered Event Type": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Covered Event Type"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "Current Date": {
                    "format": "date",
                    "type": "string"
                },
                "Earned Dates": {
                    "items": {
                        "format": "date",
                        "type": "string"
                    },
                    "type": "array"
                },
                "Earned Tranches": {
                    "items": {
                        "type": "number"
                    },
                    "type": "array"
                },
                "HSR Waiting Period Expired": {
                    "type": "boolean"
                },
                "Musk Service Status": {
                    "$ref": "#/$defs/Service Status"
                },
                "Performance Metrics": {
                    "$ref": "#/$defs/Tesla Performance Metrics"
                },
                "Shareholder Approval Received": {
                    "type": "boolean"
                },
                "Termination Reason": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Termination Reason"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": [
                "Musk Service Status",
                "Current Date",
                "Performance Metrics",
                "Earned Tranches",
                "Earned Dates",
                "CEO Succession Framework",
                "Covered Event Occurred",
                "HSR Waiting Period Expired",
                "Shareholder Approval Received"
            ],
            "type": "object"
        },
        "Covered Event Type": {
            "enum": [
                "External Event Affecting Product Goals",
                "Other External Event"
            ],
            "type": "string"
        },
        "Service Status": {
            "enum": [
                "Chief Executive Officer",
                "Executive Officer Product Development",
                "Not In Eligible Service"
            ],
            "type": "string"
        },
        "Termination Reason": {
            "enum": [
                "Without Cause",
                "For Cause",
                "Death",
                "Disability",
                "Change In Control",
                "Voluntary Resignation"
            ],
            "type": "string"
        },
        "Tesla Performance Metrics": {
            "properties": {
                "Active FSD Subscriptions": {
                    "type": "number"
                },
                "Bots Delivered": {
                    "type": "number"
                },
                "Current Adjusted EBITDA": {
                    "type": "number"
                },
                "Current Market Cap": {
                    "type": "number"
                },
                "Last Closing Price": {
                    "type": "number"
                },
                "One Year Avg Market Cap": {
                    "type": "number"
                },
                "Outstanding Shares": {
                    "type": "number"
                },
                "Per Share Consideration": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "Robotaxis In Operation": {
                    "type": "number"
                },
                "Six Month Avg Market Cap": {
                    "type": "number"
                },
                "Tesla Vehicles Delivered": {
                    "type": "number"
                },
                "Thirty Day Avg Market Cap": {
                    "type": "number"
                }
            },
            "required": [
                "Current Market Cap",
                "Six Month Avg Market Cap",
                "Thirty Day Avg Market Cap",
                "One Year Avg Market Cap",
                "Tesla Vehicles Delivered",
                "Active FSD Subscriptions",
                "Bots Delivered",
                "Robotaxis In Operation",
                "Current Adjusted EBITDA",
                "Outstanding Shares",
                "Last Closing Price"
            ],
            "type": "object"
        }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Check what service requiremends apply",
    "properties": {
        "award state": {
            "$ref": "#/$defs/CEO Award State"
        }
    },
    "required": [
        "award state"
    ],
    "title": "Eligible Service Requirement",
    "type": "object"
}
