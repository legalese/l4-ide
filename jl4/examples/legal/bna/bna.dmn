  <decision id="decision_section_1_outcome_at_birth" name="section_1_outcome_at_birth" label="section 1 outcome at birth">
    <variable id="decision_section_1_outcome_at_birth_var" name="section_1_outcome_at_birth" label="section 1 outcome at birth" typeRef="BirthOutcome"/>
    <informationRequirement id="decision_section_1_outcome_at_birth_ir1">
      <requiredDecision href="#decision_a_british_citizen_by_virtue_of_subsection_1_or_2"/>
    </informationRequirement>
    <informationRequirement id="decision_section_1_outcome_at_birth_ir2">
      <requiredDecision href="#decision_a_british_citizen_by_virtue_of_subsection_1a"/>
    </informationRequirement>
    <informationRequirement id="decision_section_1_outcome_at_birth_ir3">
      <requiredInput href="#input_person"/>
    </informationRequirement>
    <decisionTable id="decision_section_1_outcome_at_birth_table" hitPolicy="FIRST" preferredOrientation="Rule-as-Row" outputLabel="section 1 outcome at birth">
      <input id="decision_section_1_outcome_at_birth_i1" label="`a British citizen by virtue of subsection (1) or (2)` OF person">
        <inputExpression id="decision_section_1_outcome_at_birth_i1_expr" typeRef="boolean">
          <text>a_British_citizen_by_virtue_of_subsection_1_or_2</text>
        </inputExpression>
      </input>
      <input id="decision_section_1_outcome_at_birth_i2" label="`a British citizen by virtue of subsection (1A)` OF person">
        <inputExpression id="decision_section_1_outcome_at_birth_i2_expr" typeRef="boolean">
          <text>a_British_citizen_by_virtue_of_subsection_1A</text>
        </inputExpression>
      </input>
      <output id="decision_section_1_outcome_at_birth_o1">
        <outputValues>
          <text>"a British citizen from birth under subsection (1)","a British citizen from birth under subsection (1A)","not a British citizen from birth under section 1"</text>
        </outputValues>
      </output>
      <rule id="decision_section_1_outcome_at_birth_r1">
        <description>`a British citizen by virtue of subsection (1) or (2)` OF person</description>
        <inputEntry id="decision_section_1_outcome_at_birth_r1_i1">
          <text>true</text>
        </inputEntry>
        <inputEntry id="decision_section_1_outcome_at_birth_r1_i2">
          <text>-</text>
        </inputEntry>
        <outputEntry id="decision_section_1_outcome_at_birth_r1_o1">
          <text>"a British citizen from birth under subsection (1)"</text>
        </outputEntry>
      </rule>
      <rule id="decision_section_1_outcome_at_birth_r2">
        <description>`a British citizen by virtue of subsection (1A)` OF person</description>
        <inputEntry id="decision_section_1_outcome_at_birth_r2_i1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="decision_section_1_outcome_at_birth_r2_i2">
          <text>true</text>
        </inputEntry>
        <outputEntry id="decision_section_1_outcome_at_birth_r2_o1">
          <text>"a British citizen from birth under subsection (1A)"</text>
        </outputEntry>
      </rule>
      <rule id="decision_section_1_outcome_at_birth_r3">
        <description>OTHERWISE</description>
        <inputEntry id="decision_section_1_outcome_at_birth_r3_i1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="decision_section_1_outcome_at_birth_r3_i2">
          <text>-</text>
        </inputEntry>
        <outputEntry id="decision_section_1_outcome_at_birth_r3_o1">
          <text>"not a British citizen from birth under section 1"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
