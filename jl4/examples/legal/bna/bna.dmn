      <text>found_abandoned_in_the_United_Kingdom_after_commencement or found_abandoned_in_a_qualifying_territory_on_or_after_the_appointed_day</text>
    </literalExpression>
  </decision>
  <decision id="decision_deemed_by_subsection_2_to_satisfy_subsection_1" name="deemed_by_subsection_2_to_satisfy_subsection_1" label="deemed by subsection (2) to satisfy subsection (1)">
