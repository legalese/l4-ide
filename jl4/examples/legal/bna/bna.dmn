  </decision>
  <decision id="decision__1_5a_a_the_adopter_or_one_joint_adopter_a_british_citizen" name="_1_5A_a_the_adopter_or_one_joint_adopter_a_British_citizen" label="1(5A)(a) — the adopter, or one joint adopter, a British citizen">
