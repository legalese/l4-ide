<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" id="definitions_british_nationality_act_1981_section_1_acquisition_by_birth_or_adoption" name="British Nationality Act 1981, section 1 — Acquisition by birth or adoption" namespace="https://legalese.com/l4/dmn/british_nationality_act_1981_section_1_acquisition_by_birth_or_adoption" exporter="jl4">
  <itemDefinition id="itemdef_personprofile" name="PersonProfile">
    <itemComponent id="itemdef_personprofile_c1" name="name">
      <typeRef>string</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_personprofile_c2" name="born_in_the_United_Kingdom" label="born in the United Kingdom">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_personprofile_c3" name="born_in_a_qualifying_territory" label="born in a qualifying territory">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_personprofile_c4" name="date_of_birth" label="date of birth">
      <typeRef>date</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_personprofile_c5" name="father_or_mother_a_British_citizen_at_the_time_of_the_birth" label="father or mother a British citizen at the time of the birth">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_personprofile_c6" name="father_or_mother_settled_in_the_United_Kingdom_or_the_territory_of_birth_at_the_time_of_the_birth" label="father or mother settled in the United Kingdom or the territory of birth at the time of the birth">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_personprofile_c7" name="father_or_mother_a_member_of_the_armed_forces_at_the_time_of_the_birth" label="father or mother a member of the armed forces at the time of the birth">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_personprofile_c8" name="found_abandoned_as_a_new_born_infant_in_the_United_Kingdom" label="found abandoned as a new-born infant in the United Kingdom">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_personprofile_c9" name="found_abandoned_as_a_new_born_infant_in_a_qualifying_territory" label="found abandoned as a new-born infant in a qualifying territory">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_personprofile_c10" name="date_found_abandoned" label="date found abandoned">
      <typeRef>date</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_personprofile_c11" name="the_contrary_shown_rebutting_the_subsection_2_presumption" label="the contrary shown, rebutting the subsection (2) presumption">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_personprofile_c12" name="a_British_citizen_under_section_10A" label="a British citizen under section 10A">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_personprofile_c13" name="while_a_minor_father_or_mother_became_a_British_citizen_or_became_settled_in_the_United_Kingdom" label="while a minor, father or mother became a British citizen or became settled in the United Kingdom">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_personprofile_c14" name="while_a_minor_father_or_mother_became_a_member_of_the_armed_forces" label="while a minor, father or mother became a member of the armed forces">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_personprofile_c15" name="while_a_minor_an_application_made_for_registration_as_a_British_citizen" label="while a minor, an application made for registration as a British citizen">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_personprofile_c16" name="an_application_for_registration_made_after_attaining_the_age_of_ten_years" label="an application for registration made after attaining the age of ten years">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_personprofile_c17" name="greatest_number_of_days_absent_from_the_United_Kingdom_in_any_one_of_the_first_ten_years_of_life" label="greatest number of days absent from the United Kingdom in any one of the first ten years of life">
      <typeRef>number</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_personprofile_c18" name="the_Secretary_of_State_treats_the_subsection_4_residence_requirement_as_fulfilled" label="the Secretary of State treats the subsection (4) residence requirement as fulfilled">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_personprofile_c19" name="of_good_character_where_the_good_character_requirement_applies" label="of good character, where the good character requirement applies">
      <typeRef>boolean</typeRef>
    </itemComponent>
  </itemDefinition>
  <itemDefinition id="itemdef_adoptioncase" name="AdoptionCase">
    <itemComponent id="itemdef_adoptioncase_c1" name="the_adopted_person_a_minor_on_the_date_of_the_order_or_adoption" label="the adopted person a minor on the date of the order or adoption">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_adoptioncase_c2" name="the_adopted_person_already_a_British_citizen" label="the adopted person already a British citizen">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_adoptioncase_c3" name="an_order_of_a_court_in_the_United_Kingdom_authorising_the_adoption" label="an order of a court in the United Kingdom authorising the adoption">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_adoptioncase_c4" name="an_order_of_a_court_in_a_qualifying_territory_authorising_the_adoption" label="an order of a court in a qualifying territory authorising the adoption">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_adoptioncase_c5" name="a_Convention_adoption_effected_under_the_law_of_a_country_or_territory_outside_the_United_Kingdom" label="a Convention adoption effected under the law of a country or territory outside the United Kingdom">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_adoptioncase_c6" name="date_of_the_order_or_Convention_adoption" label="date of the order or Convention adoption">
      <typeRef>date</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_adoptioncase_c7" name="the_adopter_or_in_a_joint_adoption_one_of_the_adopters_a_British_citizen_on_that_date" label="the adopter or, in a joint adoption, one of the adopters a British citizen on that date">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_adoptioncase_c8" name="the_adopter_or_in_a_joint_adoption_both_of_the_adopters_habitually_resident_in_the_United_Kingdom_or_a_designated_territory_on_that_date" label="the adopter or, in a joint adoption, both of the adopters habitually resident in the United Kingdom or a designated territory on that date">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_adoptioncase_c9" name="the_order_or_Convention_adoption_since_ceased_to_have_effect_whether_on_annulment_or_otherwise" label="the order or Convention adoption since ceased to have effect, whether on annulment or otherwise">
      <typeRef>boolean</typeRef>
    </itemComponent>
  </itemDefinition>
  <itemDefinition id="itemdef_birthoutcome" name="BirthOutcome">
    <typeRef>string</typeRef>
    <allowedValues>
      <text>"a British citizen from birth under subsection (1)","a British citizen from birth under subsection (1A)","not a British citizen from birth under section 1"</text>
    </allowedValues>
  </itemDefinition>
  <inputData id="input_person" name="person">
    <variable id="input_person_var" name="person" typeRef="PersonProfile"/>
  </inputData>
  <inputData id="input_entitled_under_subsection_3_3a_or_4" name="entitled_under_subsection_3_3A_or_4" label="entitled under subsection (3), (3A) or (4)">
    <variable id="input_entitled_under_subsection_3_3a_or_4_var" name="entitled_under_subsection_3_3A_or_4" label="entitled under subsection (3), (3A) or (4)" typeRef="boolean"/>
  </inputData>
  <inputData id="input_adoption" name="adoption">
    <variable id="input_adoption_var" name="adoption" typeRef="AdoptionCase"/>
  </inputData>
  <decision id="decision_commencement" name="commencement">
    <variable id="decision_commencement_var" name="commencement" typeRef="date"/>
    <literalExpression id="decision_commencement_literal">
      <text>date("1983-01-01")</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_appointed_day" name="the_appointed_day" label="the appointed day">
    <variable id="decision_the_appointed_day_var" name="the_appointed_day" label="the appointed day" typeRef="date"/>
    <literalExpression id="decision_the_appointed_day_literal">
      <text>date("2002-05-21")</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_relevant_day" name="the_relevant_day" label="the relevant day">
    <variable id="decision_the_relevant_day_var" name="the_relevant_day" label="the relevant day" typeRef="date"/>
    <literalExpression id="decision_the_relevant_day_literal">
      <text>date("2010-01-13")</text>
    </literalExpression>
  </decision>
  <decision id="decision_permitted_days_of_absence_in_each_of_the_first_ten_years" name="permitted_days_of_absence_in_each_of_the_first_ten_years" label="permitted days of absence in each of the first ten years">
    <variable id="decision_permitted_days_of_absence_in_each_of_the_first_ten_years_var" name="permitted_days_of_absence_in_each_of_the_first_ten_years" label="permitted days of absence in each of the first ten years" typeRef="number"/>
    <literalExpression id="decision_permitted_days_of_absence_in_each_of_the_first_ten_years_literal">
      <text>90</text>
    </literalExpression>
  </decision>
  <decision id="decision_born_in_the_united_kingdom_after_commencement" name="born_in_the_United_Kingdom_after_commencement" label="born in the United Kingdom after commencement">
    <variable id="decision_born_in_the_united_kingdom_after_commencement_var" name="born_in_the_United_Kingdom_after_commencement" label="born in the United Kingdom after commencement" typeRef="boolean"/>
    <informationRequirement id="decision_born_in_the_united_kingdom_after_commencement_ir1">
      <requiredDecision href="#decision_commencement"/>
    </informationRequirement>
    <informationRequirement id="decision_born_in_the_united_kingdom_after_commencement_ir2">
      <requiredInput href="#input_person"/>
    </informationRequirement>
    <literalExpression id="decision_born_in_the_united_kingdom_after_commencement_literal">
      <text>person.born_in_the_United_Kingdom and person.date_of_birth &gt;= commencement</text>
    </literalExpression>
  </decision>
  <decision id="decision_born_in_a_qualifying_territory_on_or_after_the_appointed_day" name="born_in_a_qualifying_territory_on_or_after_the_appointed_day" label="born in a qualifying territory on or after the appointed day">
    <variable id="decision_born_in_a_qualifying_territory_on_or_after_the_appointed_day_var" name="born_in_a_qualifying_territory_on_or_after_the_appointed_day" label="born in a qualifying territory on or after the appointed day" typeRef="boolean"/>
    <informationRequirement id="decision_born_in_a_qualifying_territory_on_or_after_the_appointed_day_ir1">
      <requiredDecision href="#decision_the_appointed_day"/>
    </informationRequirement>
    <informationRequirement id="decision_born_in_a_qualifying_territory_on_or_after_the_appointed_day_ir2">
      <requiredInput href="#input_person"/>
    </informationRequirement>
    <literalExpression id="decision_born_in_a_qualifying_territory_on_or_after_the_appointed_day_literal">
      <text>person.born_in_a_qualifying_territory and person.date_of_birth &gt;= the_appointed_day</text>
    </literalExpression>
  </decision>
  <decision id="decision_born_in_the_united_kingdom_or_a_qualifying_territory" name="born_in_the_United_Kingdom_or_a_qualifying_territory" label="born in the United Kingdom or a qualifying territory">
    <variable id="decision_born_in_the_united_kingdom_or_a_qualifying_territory_var" name="born_in_the_United_Kingdom_or_a_qualifying_territory" label="born in the United Kingdom or a qualifying territory" typeRef="boolean"/>
    <informationRequirement id="decision_born_in_the_united_kingdom_or_a_qualifying_territory_ir1">
      <requiredInput href="#input_person"/>
    </informationRequirement>
    <literalExpression id="decision_born_in_the_united_kingdom_or_a_qualifying_territory_literal">
      <text>person.born_in_the_United_Kingdom or person.born_in_a_qualifying_territory</text>
    </literalExpression>
  </decision>
  <decision id="decision_born_in_the_united_kingdom_on_or_after_the_relevant_day" name="born_in_the_United_Kingdom_on_or_after_the_relevant_day" label="born in the United Kingdom on or after the relevant day">
    <variable id="decision_born_in_the_united_kingdom_on_or_after_the_relevant_day_var" name="born_in_the_United_Kingdom_on_or_after_the_relevant_day" label="born in the United Kingdom on or after the relevant day" typeRef="boolean"/>
    <informationRequirement id="decision_born_in_the_united_kingdom_on_or_after_the_relevant_day_ir1">
      <requiredDecision href="#decision_the_relevant_day"/>
    </informationRequirement>
    <informationRequirement id="decision_born_in_the_united_kingdom_on_or_after_the_relevant_day_ir2">
      <requiredInput href="#input_person"/>
    </informationRequirement>
    <literalExpression id="decision_born_in_the_united_kingdom_on_or_after_the_relevant_day_literal">
      <text>person.born_in_the_United_Kingdom and person.date_of_birth &gt;= the_relevant_day</text>
    </literalExpression>
  </decision>
  <decision id="decision__1_1_born_in_the_united_kingdom_after_commencement_or_in_a_qualifying_territory_on_or_after_the_appointed_day" name="_1_1_born_in_the_United_Kingdom_after_commencement_or_in_a_qualifying_territory_on_or_after_the_appointed_day" label="1(1) — born in the United Kingdom after commencement or in a qualifying territory on or after the appointed day">
    <variable id="decision__1_1_born_in_the_united_kingdom_after_commencement_or_in_a_qualifying_territory_on_or_after_the_appointed_day_var" name="_1_1_born_in_the_United_Kingdom_after_commencement_or_in_a_qualifying_territory_on_or_after_the_appointed_day" label="1(1) — born in the United Kingdom after commencement or in a qualifying territory on or after the appointed day" typeRef="boolean"/>
    <informationRequirement id="decision__1_1_born_in_the_united_kingdom_after_commencement_or_in_a_qualifying_territory_on_or_after_the_appointed_day_ir1">
      <requiredDecision href="#decision_born_in_a_qualifying_territory_on_or_after_the_appointed_day"/>
    </informationRequirement>
    <informationRequirement id="decision__1_1_born_in_the_united_kingdom_after_commencement_or_in_a_qualifying_territory_on_or_after_the_appointed_day_ir2">
      <requiredDecision href="#decision_born_in_the_united_kingdom_after_commencement"/>
    </informationRequirement>
    <informationRequirement id="decision__1_1_born_in_the_united_kingdom_after_commencement_or_in_a_qualifying_territory_on_or_after_the_appointed_day_ir3">
      <requiredInput href="#input_person"/>
    </informationRequirement>
    <literalExpression id="decision__1_1_born_in_the_united_kingdom_after_commencement_or_in_a_qualifying_territory_on_or_after_the_appointed_day_literal">
      <text>born_in_the_United_Kingdom_after_commencement or born_in_a_qualifying_territory_on_or_after_the_appointed_day</text>
    </literalExpression>
  </decision>
  <decision id="decision__1_1_a_father_or_mother_a_british_citizen" name="_1_1_a_father_or_mother_a_British_citizen" label="1(1)(a) — father or mother a British citizen">
    <variable id="decision__1_1_a_father_or_mother_a_british_citizen_var" name="_1_1_a_father_or_mother_a_British_citizen" label="1(1)(a) — father or mother a British citizen" typeRef="boolean"/>
    <informationRequirement id="decision__1_1_a_father_or_mother_a_british_citizen_ir1">
      <requiredInput href="#input_person"/>
    </informationRequirement>
    <literalExpression id="decision__1_1_a_father_or_mother_a_british_citizen_literal">
      <text>true and person.father_or_mother_a_British_citizen_at_the_time_of_the_birth</text>
    </literalExpression>
  </decision>
  <decision id="decision__1_1_b_father_or_mother_settled_in_the_united_kingdom_or_that_territory" name="_1_1_b_father_or_mother_settled_in_the_United_Kingdom_or_that_territory" label="1(1)(b) — father or mother settled in the United Kingdom or that territory">
    <variable id="decision__1_1_b_father_or_mother_settled_in_the_united_kingdom_or_that_territory_var" name="_1_1_b_father_or_mother_settled_in_the_United_Kingdom_or_that_territory" label="1(1)(b) — father or mother settled in the United Kingdom or that territory" typeRef="boolean"/>
    <informationRequirement id="decision__1_1_b_father_or_mother_settled_in_the_united_kingdom_or_that_territory_ir1">
      <requiredInput href="#input_person"/>
    </informationRequirement>
    <literalExpression id="decision__1_1_b_father_or_mother_settled_in_the_united_kingdom_or_that_territory_literal">
      <text>true and person.father_or_mother_settled_in_the_United_Kingdom_or_the_territory_of_birth_at_the_time_of_the_birth</text>
    </literalExpression>
  </decision>
  <decision id="decision__1_1_at_the_time_of_the_birth_his_father_or_mother_is_a_citizen_or_settled" name="_1_1_at_the_time_of_the_birth_his_father_or_mother_is_a_citizen_or_settled" label="1(1) — at the time of the birth his father or mother is a citizen or settled">
    <variable id="decision__1_1_at_the_time_of_the_birth_his_father_or_mother_is_a_citizen_or_settled_var" name="_1_1_at_the_time_of_the_birth_his_father_or_mother_is_a_citizen_or_settled" label="1(1) — at the time of the birth his father or mother is a citizen or settled" typeRef="boolean"/>
    <informationRequirement id="decision__1_1_at_the_time_of_the_birth_his_father_or_mother_is_a_citizen_or_settled_ir1">
      <requiredDecision href="#decision__1_1_a_father_or_mother_a_british_citizen"/>
    </informationRequirement>
    <informationRequirement id="decision__1_1_at_the_time_of_the_birth_his_father_or_mother_is_a_citizen_or_settled_ir2">
      <requiredDecision href="#decision__1_1_b_father_or_mother_settled_in_the_united_kingdom_or_that_territory"/>
    </informationRequirement>
    <informationRequirement id="decision__1_1_at_the_time_of_the_birth_his_father_or_mother_is_a_citizen_or_settled_ir3">
      <requiredInput href="#input_person"/>
    </informationRequirement>
    <literalExpression id="decision__1_1_at_the_time_of_the_birth_his_father_or_mother_is_a_citizen_or_settled_literal">
      <text>_1_1_a_father_or_mother_a_British_citizen or _1_1_b_father_or_mother_settled_in_the_United_Kingdom_or_that_territory</text>
    </literalExpression>
  </decision>
  <decision id="decision__1_1_satisfied_on_the_actual_facts_of_the_birth" name="_1_1_satisfied_on_the_actual_facts_of_the_birth" label="1(1) — satisfied on the actual facts of the birth">
    <variable id="decision__1_1_satisfied_on_the_actual_facts_of_the_birth_var" name="_1_1_satisfied_on_the_actual_facts_of_the_birth" label="1(1) — satisfied on the actual facts of the birth" typeRef="boolean"/>
    <informationRequirement id="decision__1_1_satisfied_on_the_actual_facts_of_the_birth_ir1">
      <requiredDecision href="#decision__1_1_at_the_time_of_the_birth_his_father_or_mother_is_a_citizen_or_settled"/>
    </informationRequirement>
    <informationRequirement id="decision__1_1_satisfied_on_the_actual_facts_of_the_birth_ir2">
      <requiredDecision href="#decision__1_1_born_in_the_united_kingdom_after_commencement_or_in_a_qualifying_territory_on_or_after_the_appointed_day"/>
    </informationRequirement>
    <informationRequirement id="decision__1_1_satisfied_on_the_actual_facts_of_the_birth_ir3">
      <requiredInput href="#input_person"/>
    </informationRequirement>
    <literalExpression id="decision__1_1_satisfied_on_the_actual_facts_of_the_birth_literal">
      <text>true and (_1_1_born_in_the_United_Kingdom_after_commencement_or_in_a_qualifying_territory_on_or_after_the_appointed_day and _1_1_at_the_time_of_the_birth_his_father_or_mother_is_a_citizen_or_settled)</text>
    </literalExpression>
  </decision>
  <decision id="decision_found_abandoned_in_the_united_kingdom_after_commencement" name="found_abandoned_in_the_United_Kingdom_after_commencement" label="found abandoned in the United Kingdom after commencement">
    <variable id="decision_found_abandoned_in_the_united_kingdom_after_commencement_var" name="found_abandoned_in_the_United_Kingdom_after_commencement" label="found abandoned in the United Kingdom after commencement" typeRef="boolean"/>
    <informationRequirement id="decision_found_abandoned_in_the_united_kingdom_after_commencement_ir1">
      <requiredDecision href="#decision_commencement"/>
    </informationRequirement>
    <informationRequirement id="decision_found_abandoned_in_the_united_kingdom_after_commencement_ir2">
      <requiredInput href="#input_person"/>
    </informationRequirement>
    <literalExpression id="decision_found_abandoned_in_the_united_kingdom_after_commencement_literal">
      <text>person.found_abandoned_as_a_new_born_infant_in_the_United_Kingdom and person.date_found_abandoned &gt;= commencement</text>
    </literalExpression>
  </decision>
  <decision id="decision_found_abandoned_in_a_qualifying_territory_on_or_after_the_appointed_day" name="found_abandoned_in_a_qualifying_territory_on_or_after_the_appointed_day" label="found abandoned in a qualifying territory on or after the appointed day">
    <variable id="decision_found_abandoned_in_a_qualifying_territory_on_or_after_the_appointed_day_var" name="found_abandoned_in_a_qualifying_territory_on_or_after_the_appointed_day" label="found abandoned in a qualifying territory on or after the appointed day" typeRef="boolean"/>
    <informationRequirement id="decision_found_abandoned_in_a_qualifying_territory_on_or_after_the_appointed_day_ir1">
      <requiredDecision href="#decision_the_appointed_day"/>
    </informationRequirement>
    <informationRequirement id="decision_found_abandoned_in_a_qualifying_territory_on_or_after_the_appointed_day_ir2">
      <requiredInput href="#input_person"/>
    </informationRequirement>
    <literalExpression id="decision_found_abandoned_in_a_qualifying_territory_on_or_after_the_appointed_day_literal">
      <text>person.found_abandoned_as_a_new_born_infant_in_a_qualifying_territory and person.date_found_abandoned &gt;= the_appointed_day</text>
    </literalExpression>
  </decision>
  <decision id="decision__1_2_found_abandoned_in_the_united_kingdom_or_a_qualifying_territory_in_time" name="_1_2_found_abandoned_in_the_United_Kingdom_or_a_qualifying_territory_in_time" label="1(2) — found abandoned in the United Kingdom or a qualifying territory in time">
    <variable id="decision__1_2_found_abandoned_in_the_united_kingdom_or_a_qualifying_territory_in_time_var" name="_1_2_found_abandoned_in_the_United_Kingdom_or_a_qualifying_territory_in_time" label="1(2) — found abandoned in the United Kingdom or a qualifying territory in time" typeRef="boolean"/>
    <informationRequirement id="decision__1_2_found_abandoned_in_the_united_kingdom_or_a_qualifying_territory_in_time_ir1">
      <requiredDecision href="#decision_found_abandoned_in_a_qualifying_territory_on_or_after_the_appointed_day"/>
    </informationRequirement>
    <informationRequirement id="decision__1_2_found_abandoned_in_the_united_kingdom_or_a_qualifying_territory_in_time_ir2">
      <requiredDecision href="#decision_found_abandoned_in_the_united_kingdom_after_commencement"/>
    </informationRequirement>
