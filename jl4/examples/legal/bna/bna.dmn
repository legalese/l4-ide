    <literalExpression id="decision_not_already_a_british_citizen_by_virtue_of_subsection_1_1a_or_2_or_section_10a_literal">
      <text>not(a_British_citizen_by_virtue_of_subsection_1_or_2) and (not(a_British_citizen_by_virtue_of_subsection_1A) and not(person.a_British_citizen_under_section_10A))</text>
    </literalExpression>
  </decision>
  <decision id="decision__1_3_a_father_or_mother_becomes_a_british_citizen_or_settled" name="_1_3_a_father_or_mother_becomes_a_British_citizen_or_settled" label="1(3)(a) — father or mother becomes a British citizen or settled">
