  </decision>
  <decision id="decision_a_british_citizen_by_virtue_of_subsection_1a" name="a_British_citizen_by_virtue_of_subsection_1A" label="a British citizen by virtue of subsection (1A)">
    <variable id="decision_a_british_citizen_by_virtue_of_subsection_1a_var" name="a_British_citizen_by_virtue_of_subsection_1A" label="a British citizen by virtue of subsection (1A)" typeRef="boolean"/>
    <informationRequirement id="decision_a_british_citizen_by_virtue_of_subsection_1a_ir1">
      <requiredDecision href="#decision_born_in_the_united_kingdom_or_a_qualifying_territory"/>
    </informationRequirement>
    <informationRequirement id="decision_a_british_citizen_by_virtue_of_subsection_1a_ir2">
