    <literalExpression id="decision_deemed_by_subsection_2_to_satisfy_subsection_1_literal">
      <text>true and (_1_2_found_abandoned_in_the_United_Kingdom_or_a_qualifying_territory_in_time and (not(person.the_contrary_shown_rebutting_the_subsection_2_presumption) and (true and true)))</text>
    </literalExpression>
  </decision>
  <decision id="decision_a_british_citizen_by_virtue_of_subsection_1_or_2" name="a_British_citizen_by_virtue_of_subsection_1_or_2" label="a British citizen by virtue of subsection (1) or (2)">
