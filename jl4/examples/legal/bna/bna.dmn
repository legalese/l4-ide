    <informationRequirement id="decision_a_british_citizen_by_virtue_of_subsection_1a_ir3">
      <requiredInput href="#input_person"/>
    </informationRequirement>
    <literalExpression id="decision_a_british_citizen_by_virtue_of_subsection_1a_literal">
      <text>true and (born_in_the_United_Kingdom_or_a_qualifying_territory and (person.date_of_birth &gt;= the_relevant_day and person.father_or_mother_a_member_of_the_armed_forces_at_the_time_of_the_birth))</text>
    </literalExpression>
  </decision>
  <decision id="decision_not_already_a_british_citizen_by_virtue_of_subsection_1_1a_or_2_or_section_10a" name="not_already_a_British_citizen_by_virtue_of_subsection_1_1A_or_2_or_section_10A" label="not already a British citizen by virtue of subsection (1), (1A) or (2) or section 10A">
    <variable id="decision_not_already_a_british_citizen_by_virtue_of_subsection_1_1a_or_2_or_section_10a_var" name="not_already_a_British_citizen_by_virtue_of_subsection_1_1A_or_2_or_section_10A" label="not already a British citizen by virtue of subsection (1), (1A) or (2) or section 10A" typeRef="boolean"/>
