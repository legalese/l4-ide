dbs-womans-world.l4:1100:1-126:
  `Rate answer` OF 0.2, 2, Unconfirmed, 0.4, 4, 0.4, TRUE, FALSE, (Cap OF "Woman's World online", TRUE, 1000, `Calendar month`, `By transaction date`), (LIST "DBS rounds the points it awards DOWN to a whole number (cl.10, cl.17(b)); this is the rate before rounding.", "The DBS Rewards Programme Terms and Conditions also apply (cl.6) and are not held here; they may exclude this transaction from earning at all.", "DBS may vary or terminate these programmes at any time without notice (cl.3), and its decision is final (cl.5).", "Whether this is online spend is decided by the merchant and their banker, not by DBS (cl.13).", "The bonus is capped at the first S$1,000 of online spend per calendar month, by transaction date (cl.19(b), cl.19(c)).", "Bonus points on online spend are credited only by the end of the following calendar month (cl.19(a)).", "DBS may exclude any other transaction from online spend from time to time (cl.11(viii)).", "The merchant's online indicator is not known, so both outcomes are shown and the headline figure is the lower one."), (LIST Provenance OF "dbs-womans-card-tnc", "11", "Updated 27 Jul 2026", (DATE OF 27, 7, 2026), "refers to retail transaction for goods and services made via the Internet and processed by the respective merchants/acquirers as an online transaction through Mastercard Worldwide networks, excluding the following transactions", Provenance OF "dbs-womans-card-tnc", "13", "Updated 27 Jul 2026", (DATE OF 27, 7, 2026), "DBS determines an online transaction based on system indicators. These indicators are decided by the merchant and their banker, and passed to DBS when the transaction is posted to the Card.", Provenance OF "dbs-womans-card-tnc", "15", "Updated 27 Jul 2026", (DATE OF 27, 7, 2026), "This is only applicable to DBS Woman's World Card.", Provenance OF "dbs-womans-card-tnc", "17(a)", "Updated 27 Jul 2026", (DATE OF 27, 7, 2026), "Base 1X DBS Point will be awarded for every S$5 of retail spend, awarded on the next working day when transaction is posted to the Card.", Provenance OF "dbs-womans-card-tnc", "19(a)", "Updated 27 Jul 2026", (DATE OF 27, 7, 2026), "Bonus 9X DBS Points (for local online spend) or 7X DBS Points (for overseas online spend) will be awarded for every S$5 of online spend, credited by the end of the following calendar month.", Provenance OF "dbs-womans-card-tnc", "19(b)", "Updated 27 Jul 2026", (DATE OF 27, 7, 2026), "Online spend will be accumulated for the month and awarded bonus points in the following calendar month, capped at the first S$1,000 of online spend per calendar month.", Provenance OF "dbs-womans-card-tnc", "19(c)", "Updated 27 Jul 2026", (DATE OF 27, 7, 2026), "Online spend must be charged to your card within the calendar month, based on transaction date and successfully posted to the Card Account at the time of points computation.", Provenance OF "dbs-womans-card-tnc", "14", "Updated 27 Jul 2026", (DATE OF 27, 7, 2026), "The transaction date is determined based on the merchant settlement date between the merchant and their acquirer"), Verified
dbs-womans-world.l4:1101:1-129:
  `Rate answer` OF 2, 2, Unconfirmed, 4, 4, 4, FALSE, TRUE, (Cap OF "Woman's World online", TRUE, 1000, `Calendar month`, `By transaction date`), (LIST "DBS rounds the points it awards DOWN to a whole number (cl.10, cl.17(b)); this is the rate before rounding.", "The DBS Rewards Programme Terms and Conditions also apply (cl.6) and are not held here; they may exclude this transaction from earning at all.", "DBS may vary or terminate these programmes at any time without notice (cl.3), and its decision is final (cl.5).", "Whether this is online spend is decided by the merchant and their banker, not by DBS (cl.13).", "The bonus is capped at the first S$1,000 of online spend per calendar month, by transaction date (cl.19(b), cl.19(c)).", "Bonus points on online spend are credited only by the end of the following calendar month (cl.19(a)).", "DBS may exclude any other transaction from online spend from time to time (cl.11(viii)).", "Overseas spend is decided by the currency the transaction posted in, not by where you were (cl.12).", "cl.12 excludes whatever the DBS Rewards Programme Terms and Conditions exclude, and those are not held here."), (LIST Provenance OF "dbs-womans-card-tnc", "11", "Updated 27 Jul 2026", (DATE OF 27, 7, 2026), "refers to retail transaction for goods and services made via the Internet and processed by the respective merchants/acquirers as an online transaction through Mastercard Worldwide networks, excluding the following transactions", Provenance OF "dbs-womans-card-tnc", "13", "Updated 27 Jul 2026", (DATE OF 27, 7, 2026), "DBS determines an online transaction based on system indicators. These indicators are decided by the merchant and their banker, and passed to DBS when the transaction is posted to the Card.", Provenance OF "dbs-womans-card-tnc", "15", "Updated 27 Jul 2026", (DATE OF 27, 7, 2026), "This is only applicable to DBS Woman's World Card.", Provenance OF "dbs-womans-card-tnc", "17(a)", "Updated 27 Jul 2026", (DATE OF 27, 7, 2026), "Base 1X DBS Point will be awarded for every S$5 of retail spend, awarded on the next working day when transaction is posted to the Card.", Provenance OF "dbs-womans-card-tnc", "12", "Updated 27 Jul 2026", (DATE OF 27, 7, 2026), "refers to retail transactions for goods and services posted in foreign currencies (other than Singapore dollars), excluding transactions which are excluded from the awarding of DBS Points as set out in the DBS Rewards Programme Terms and Conditions.", Provenance OF "dbs-womans-card-tnc", "18(a)", "Updated 27 Jul 2026", (DATE OF 27, 7, 2026), "Bonus 2X DBS Points will be awarded for every S$5 equivalent in overseas spend, awarded on the next working day when transaction is posted to the Card.", Provenance OF "dbs-womans-card-tnc", "19(a)", "Updated 27 Jul 2026", (DATE OF 27, 7, 2026), "Bonus 9X DBS Points (for local online spend) or 7X DBS Points (for overseas online spend) will be awarded for every S$5 of online spend, credited by the end of the following calendar month.", Provenance OF "dbs-womans-card-tnc", "19(b)", "Updated 27 Jul 2026", (DATE OF 27, 7, 2026), "Online spend will be accumulated for the month and awarded bonus points in the following calendar month, capped at the first S$1,000 of online spend per calendar month.", Provenance OF "dbs-womans-card-tnc", "19(c)", "Updated 27 Jul 2026", (DATE OF 27, 7, 2026), "Online spend must be charged to your card within the calendar month, based on transaction date and successfully posted to the Card Account at the time of points computation.", Provenance OF "dbs-womans-card-tnc", "14", "Updated 27 Jul 2026", (DATE OF 27, 7, 2026), "The transaction date is determined based on the merchant settlement date between the merchant and their acquirer"), Verified
