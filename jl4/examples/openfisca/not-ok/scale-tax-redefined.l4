-- `scale tax` is recognised by name. This one applies the top bracket's rate
-- to the whole income (L4: 15000 * 0.10 = 1500), while OpenFisca's marginal
-- .calc() gives 12000 * 0.03 + 3000 * 0.10 = 660. The export must REFUSE it.
IMPORT prelude

DECLARE Person HAS salary IS A NUMBER
DECLARE Period HAS year IS A NUMBER, month IS A NUMBER
DECLARE Bracket HAS threshold IS A NUMBER, rate IS A NUMBER

GIVEN t IS A NUMBER, r IS A NUMBER
GIVETH A Bracket
`band` MEANS Bracket WITH threshold IS t, rate IS r

GIVEN income IS A NUMBER, brackets IS A LIST OF Bracket
GIVETH A NUMBER
`scale tax` MEANS
    CONSIDER brackets
    WHEN EMPTY THEN 0
    WHEN b FOLLOWED BY rest THEN
        IF income AT LEAST b's threshold
        THEN
            CONSIDER rest
            WHEN EMPTY THEN income TIMES b's rate
            WHEN nb FOLLOWED BY more THEN
                IF income AT LEAST nb's threshold
                THEN `scale tax` OF income, rest
                ELSE income TIMES b's rate
        ELSE 0

@desc scale taxes.flat_scale
GIVETH A LIST OF Bracket
`brackets` MEANS LIST (`band` OF 0, 0.03), (`band` OF 12000, 0.10)

@export Tax
GIVEN p      IS A Person
      period IS A Period
GIVETH A NUMBER
`tax` p period MEANS `scale tax` OF (p's salary), `brackets`

#ASSERT (`tax` OF (Person WITH salary IS 15000), (Period WITH year IS 2026, month IS 1)) EQUALS 1500
