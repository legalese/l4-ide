-- A time-varying @desc scale whose later arm has FEWER brackets than an
-- earlier one. OpenFisca cannot remove a bracket over time, so the 2017 value
-- would keep the 2015 top bracket. The export must REFUSE it.
IMPORT prelude

DECLARE Person HAS salary IS A NUMBER
DECLARE Period HAS year IS A NUMBER, month IS A NUMBER

DECLARE Bracket HAS
    threshold IS A NUMBER
    rate      IS A NUMBER

GIVEN t IS A NUMBER
      r IS A NUMBER
GIVETH A Bracket
`band` MEANS Bracket WITH threshold IS t, rate IS r

GIVEN income   IS A NUMBER
      brackets IS A LIST OF Bracket
GIVETH A NUMBER
`scale tax` MEANS
    CONSIDER brackets
    WHEN EMPTY THEN 0
    WHEN b FOLLOWED BY rest THEN
        CONSIDER rest
        WHEN EMPTY THEN
            b's rate TIMES (max 0 (income MINUS b's threshold))
        WHEN nextB FOLLOWED BY anything THEN
              (b's rate TIMES (max 0 ((min income (nextB's threshold)) MINUS b's threshold)))
            PLUS (`scale tax` OF income, rest)

@desc scale taxes.contribution
GIVEN y IS A NUMBER
GIVETH A LIST OF Bracket
`brackets` MEANS
    BRANCH
        IF y AT LEAST 2017 THEN LIST (`band` OF 0, 0.05)
        IF y AT LEAST 2015 THEN LIST (`band` OF 0, 0.04), (`band` OF 12000, 0.12)
        OTHERWISE EMPTY

@export Contribution
GIVEN p      IS A Person
      period IS A Period
GIVETH A NUMBER
`contribution` p period MEANS `scale tax` OF (p's salary), (`brackets` OF period's year)

#ASSERT (`contribution` OF (Person WITH salary IS 20000), (Period WITH year IS 2018, month IS 1)) EQUALS 1000
