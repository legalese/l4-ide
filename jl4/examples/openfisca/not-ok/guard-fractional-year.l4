-- A year guard against a number that is not a whole year. OpenFisca dates a
-- parameter value by year, so `y AT LEAST 2015.5` has no OpenFisca form. The
-- export must REFUSE it.
IMPORT prelude

DECLARE Person HAS salary IS A NUMBER
DECLARE Period HAS year IS A NUMBER, month IS A NUMBER

@desc parameter taxes.flat
GIVEN y IS A NUMBER
GIVETH A NUMBER
`flat amount` MEANS IF y AT LEAST 2015.5 THEN 200 ELSE 100

@export Tax for a period
GIVEN p      IS A Person
      period IS A Period
GIVETH A NUMBER
`tax` p period MEANS `flat amount` OF period's year

#ASSERT (`tax` OF (Person WITH salary IS 0), (Period WITH year IS 2015, month IS 6)) EQUALS 100
