-- =============================================================================
-- Pattern Matching in Function Definitions (PATTERN-MATCHING-SPEC Phase 1)
--
-- Haskell-style multi-clause DECIDE/MEANS definitions with literal, constructor
-- and wildcard patterns on the left-hand side, desugared to CONSIDER/WHEN.
-- Clauses are tried top-to-bottom; first match wins.
-- =============================================================================

IMPORT prelude

-- Literal patterns + a trailing variable (catch-all) clause.
GIVEN n IS A NUMBER
GIVETH A NUMBER
factorial #EVAL factorial 0    -- 1
#EVAL factorial 5    -- 120

-- Fibonacci: two literal clauses then a recursive catch-all.
GIVEN n IS A NUMBER
GIVETH A NUMBER
fib #EVAL fib 10   -- 55

-- Constructor patterns over an algebraic data type (lists).
GIVEN list IS A LIST OF NUMBER
GIVETH A NUMBER
`list length` #EVAL `list length` EMPTY               -- 0
#EVAL `list length` (LIST 10, 20, 30)   -- 3

-- MAYBE matching. In the JUST clause the fallback is unused; per the spec we
-- reuse its GIVEN name (`fallback`) rather than a bare `_` wildcard (which the
-- lexer does not accept). A variable pattern that reuses its GIVEN name is
-- desugared away entirely, so it introduces no runtime test.
GIVEN fallback IS A NUMBER
      opt IS A MAYBE NUMBER
GIVETH A NUMBER
`from maybe` #EVAL `from maybe` 99 NOTHING     -- 99
#EVAL `from maybe` 99 (JUST 42)   -- 42

-- Decision table: multiple columns mixing constructor, literal and variable
-- patterns. Demonstrates first-match semantics and a default catch-all.
GIVEN is_public_holiday IS A BOOLEAN
      day_of_week IS A STRING
GIVETH A NUMBER
`parking cost` #EVAL `parking cost` TRUE  "Monday"    -- 0
#EVAL `parking cost` FALSE "Saturday"  -- 5
#EVAL `parking cost` FALSE "Sunday"    -- 5
#EVAL `parking cost` FALSE "Monday"    -- 10

-- Nested constructor patterns (parenthesised applied constructors).
GIVEN mmn IS A MAYBE (MAYBE NUMBER)
GIVETH A NUMBER
`deep unwrap` #EVAL `deep unwrap` NOTHING              -- 0
#EVAL `deep unwrap` (JUST NOTHING)       -- 0
#EVAL `deep unwrap` (JUST (JUST 7))      -- 7
