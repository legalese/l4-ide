    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Gebühr für eine Änderung des Antrags — in Euro",
    "properties": {
        "Zahl der Änderungen": {
            "description": "Wie oft der Antrag geändert wurde",
            "type": "number"
        }
    },
    "required": [
        "Zahl der Änderungen"
    ],
    "title": "Gebühr für",
    "type": "object"
}
