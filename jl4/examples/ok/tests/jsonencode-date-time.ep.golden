-- JSONENCODE of a DATE, a TIME and a DATETIME (smucclaw/l4-ide#1083). Each
-- is written as a string, and JSONDECODE reads that string back at the same
-- type. A DATE and a TIME are written as the language prints them; a DATETIME
-- is written as RFC 3339 in UTC, whatever zone it carries. It used to stop
-- with an internal error ("Cannot encode value to JSON").
IMPORT prelude

TIMEZONE IS "Asia/Singapore"

DECLARE Meeting HAS
  day IS A DATE
  starts IS A TIME
  `fixed at` IS A DATETIME

GIVETH A DATE
`the date` MEANS DATE_FROM_DMY 31 1 2026

GIVETH A TIME
`the time` MEANS TIME_FROM_HMS 10 30 0

GIVETH A TIME
`a time with a fraction` MEANS TIME_FROM_HMS 10 30 0.5

-- In the document's timezone, so the zone the value carries is the one
-- JSONDECODE gives it back.
GIVETH A DATETIME
`the datetime` MEANS DATETIME_FROM_DTZ `the date` `the time` "Asia/Singapore"

GIVETH A DATETIME
`the datetime with a fraction` MEANS DATETIME_FROM_DTZ `the date` `a time with a fraction` "Asia/Singapore"

GIVETH A DATETIME
`the datetime in UTC` MEANS DATETIME_FROM_DTZ `the date` `the time` "UTC"

GIVETH A Meeting
`the meeting` MEANS Meeting `the date` `the time` `the datetime`

-- A year before 1000 keeps its four digits, as RFC 3339 has it.
GIVETH A DATETIME
`a datetime in year 99` MEANS DATETIME_FROM_DTZ (DATE_FROM_DMY 31 1 99) `the time` "UTC"

GIVEN s IS A STRING
GIVETH AN EITHER STRING DATE
`decode a date` s MEANS JSONDECODE s

GIVEN s IS A STRING
GIVETH AN EITHER STRING TIME
`decode a time` s MEANS JSONDECODE s

GIVEN s IS A STRING
GIVETH AN EITHER STRING DATETIME
`decode a datetime` s MEANS JSONDECODE s

GIVEN s IS A STRING
GIVETH AN EITHER STRING Meeting
`decode a meeting` s MEANS JSONDECODE s

-- The text
#EVAL JSONENCODE `the date`                    -- "2026-01-31"
#EVAL JSONENCODE `the time`                    -- "10:30:00"
#EVAL JSONENCODE `a time with a fraction`      -- "10:30:00.5"
#EVAL JSONENCODE `the datetime`                -- "2026-01-31T02:30:00Z", in UTC whatever the zone
#EVAL JSONENCODE `the datetime with a fraction` -- "2026-01-31T02:30:00.5Z"
#EVAL JSONENCODE `the datetime in UTC`         -- "2026-01-31T10:30:00Z"
#EVAL JSONENCODE `a datetime in year 99`       -- "0099-01-31T10:30:00Z"
#EVAL JSONENCODE `the meeting`
#EVAL JSONENCODE (LIST `the date`, `the date`)
#EVAL JSONENCODE (JUST `the time`)

-- Read back at the same type
#ASSERT `decode a date` (JSONENCODE `the date`) EQUALS RIGHT `the date`
#ASSERT `decode a time` (JSONENCODE `the time`) EQUALS RIGHT `the time`
#ASSERT `decode a time` (JSONENCODE `a time with a fraction`) EQUALS RIGHT `a time with a fraction`
#ASSERT `decode a datetime` (JSONENCODE `the datetime`) EQUALS RIGHT `the datetime`
#ASSERT `decode a datetime` (JSONENCODE `the datetime with a fraction`) EQUALS RIGHT `the datetime with a fraction`
#ASSERT JSONENCODE `a datetime in year 99` EQUALS "\"0099-01-31T10:30:00Z\""
#ASSERT `decode a datetime` (JSONENCODE `a datetime in year 99`) EQUALS RIGHT `a datetime in year 99`
#ASSERT `decode a meeting` (JSONENCODE `the meeting`) EQUALS RIGHT `the meeting`
