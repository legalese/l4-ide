§ Example
    GIVEN walks IS A BOOLEAN
          drinks IS A BOOLEAN
          eats IS A BOOLEAN

DECLARE Person
    HAS
        name IS A STRING

GIVEN p [person] IS A Person
DECIDE `must sing`
    IF        walks [the person must walk]
       AND    eats [the person must eat]
           OR drinks

#CHECK `must sing`
    WITH p IS A Person
        WITH name IS "Karl"
