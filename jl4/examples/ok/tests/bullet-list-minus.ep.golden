-- Regression guard: offside-hyphen bullets must not disturb subtraction.
-- Binary '-' is only ever parsed as an operator continuation (after a left
-- operand), so a head '-' (a bullet) and an infix '-' (subtraction) never
-- collide.

DECIDE inlineSub IS 7 - 2
#EVAL inlineSub                  -- 5

DECIDE chainSub IS 1 - 2 - 3
#EVAL chainSub                   -- -4  (left-associative subtraction)

-- A subtraction whose operator wraps onto a deeper continuation line stays
-- subtraction — it is an operator continuation of `10`, not a bullet.
DECIDE wrapped IS
  10
    - 3
#EVAL wrapped                    -- 7, NOT LIST 3
