-- JSONDECODE decodes into the type the program uses its result at, even
-- where no GIVETH says that type (smucclaw/l4-ide#1078).
--
-- Every decode below is in a position the type checker INFERS rather than
-- checks: the scrutinee of a CONSIDER, an argument to a polymorphic function,
-- a WHERE local or a top-level DECIDE with no signature. The type is fixed
-- only later, by how the result is used. Before the fix the decoder never saw
-- that type: a JSON object came back as RIGHT OF NOTHING, a string stayed a
-- STRING where an enumeration or a DATE was expected, and a number was not
-- wrapped in JUST. Each assertion here failed or stopped the run.
--
-- The same held for JSONDECODE passed as a function, as in `map JSONDECODE
-- xs`, where the decode happens inside `map`.
--
-- The CONTROLS at the end pin answers that did not change and must not change
-- by accident: a decode whose type nothing fixes, and a decode whose type a
-- signature already gave. A JSONDECODE at a type parameter (GIVEN a IS A
-- TYPE), which is the issue's own repro, is refused before the rules run;
-- those are in not-ok/tc/jsondecode-at-type-parameter.l4 and, for JSONDECODE
-- handed on bare, not-ok/tc/jsondecode-passed-at-type-parameter.l4.

IMPORT prelude

DECLARE Tree HAS
  label IS A NUMBER
  kids IS A LIST OF Tree

DECLARE Colour IS ONE OF Red, Green, Blue

-- A CONSIDER on the decode: the record type comes from the projection.
GIVETH A NUMBER
`decoded label` MEANS
  CONSIDER JSONDECODE "{\"label\":2,\"kids\":[]}"
    WHEN RIGHT v THEN v's label
    WHEN LEFT problem THEN 0 - 1

#ASSERT `decoded label` EQUALS 2

-- An enumeration, with an OTHERWISE that used to catch the undecoded string.
GIVETH A STRING
`colour name` MEANS
  CONSIDER JSONDECODE "\"Red\""
    WHEN RIGHT c THEN
      CONSIDER c
        WHEN Red THEN "it is red"
        OTHERWISE "not red"
    WHEN LEFT problem THEN CONCAT "LEFT: ", problem

#ASSERT `colour name` EQUALS "it is red"

-- An argument to the prelude's polymorphic `either`.
GIVEN t IS A Tree GIVETH A NUMBER
`label of` t MEANS t's label

GIVEN e IS A STRING GIVETH A NUMBER
`minus one` e MEANS 0 - 1

GIVETH A NUMBER
`via either` MEANS either `minus one` `label of` (JSONDECODE "{\"label\":2,\"kids\":[]}")

#ASSERT `via either` EQUALS 2

-- A WHERE local with no signature.
GIVETH A NUMBER
`via where` MEANS
  CONSIDER d
    WHEN RIGHT t THEN t's label
    WHEN LEFT problem THEN 0 - 1
  WHERE
    d MEANS JSONDECODE "{\"label\":2,\"kids\":[]}"

#ASSERT `via where` EQUALS 2

-- A top-level DECIDE with no signature, fixed by a later definition.
DECIDE `decoded tree` IS JSONDECODE "{\"label\":2,\"kids\":[]}"

GIVETH A NUMBER
`label of decoded tree` MEANS
  CONSIDER `decoded tree`
    WHEN RIGHT t THEN t's label
    WHEN LEFT problem THEN 0 - 1

#ASSERT `label of decoded tree` EQUALS 2

-- A DATE.
GIVETH A NUMBER
`decoded day` MEANS
  CONSIDER JSONDECODE "\"2026-03-04\""
    WHEN RIGHT d THEN DATE_DAY d
    WHEN LEFT problem THEN 0 - 1

#ASSERT `decoded day` EQUALS 4

-- A MAYBE: a value that is not null decodes to JUST it.
GIVETH A NUMBER
`decoded maybe` MEANS
  CONSIDER JSONDECODE "5"
    WHEN RIGHT m THEN
      CONSIDER m
        WHEN JUST x THEN x
        WHEN NOTHING THEN 0
    WHEN LEFT problem THEN 0 - 1

#ASSERT `decoded maybe` EQUALS 5

-- A LIST of records.
GIVETH A NUMBER
`decoded labels` MEANS
  CONSIDER JSONDECODE "[{\"label\":2,\"kids\":[]},{\"label\":3,\"kids\":[]}]"
    WHEN RIGHT ts THEN sum (map `label of` ts)
    WHEN LEFT problem THEN 0 - 1

#ASSERT `decoded labels` EQUALS 5

--------------------------------------------------------------------------------
-- JSONDECODE passed as a function. The decode happens where the function is
-- finally applied, inside the prelude's `map`, whose types say nothing about
-- these calls; the type comes from where JSONDECODE is written.
--------------------------------------------------------------------------------

-- At a record.
GIVEN r IS AN EITHER STRING Tree GIVETH A NUMBER
`label or minus one` r MEANS
  CONSIDER r
    WHEN RIGHT t THEN t's label
    WHEN LEFT problem THEN 0 - 1

GIVETH A LIST OF EITHER STRING Tree
`trees via map` MEANS map JSONDECODE (LIST "{\"label\":2,\"kids\":[]}", "{\"label\":3,\"kids\":[]}")

#ASSERT sum (map `label or minus one` `trees via map`) EQUALS 5

-- At an enumeration.
GIVEN r IS AN EITHER STRING Colour GIVETH A BOOLEAN
`is blue` r MEANS
  CONSIDER r
    WHEN RIGHT c THEN c EQUALS Blue
    WHEN LEFT problem THEN FALSE

GIVETH A LIST OF EITHER STRING Colour
`colours via map` MEANS map JSONDECODE (LIST "\"Red\"", "\"Blue\"")

#ASSERT map `is blue` `colours via map` EQUALS (LIST FALSE, TRUE)

-- At a DATE.
GIVEN r IS AN EITHER STRING DATE GIVETH A NUMBER
`day or minus one` r MEANS
  CONSIDER r
    WHEN RIGHT d THEN DATE_DAY d
    WHEN LEFT problem THEN 0 - 1

GIVETH A LIST OF EITHER STRING DATE
`dates via map` MEANS map JSONDECODE (LIST "\"2026-03-04\"")

#ASSERT sum (map `day or minus one` `dates via map`) EQUALS 4

-- Through a definition with no signature, whose type its use fixes.
DECIDE `decode a tree` IS JSONDECODE

GIVETH A NUMBER
`label via named decoder` MEANS
  sum (map `label or minus one` (map `decode a tree` (LIST "{\"label\":6,\"kids\":[]}")))

#ASSERT `label via named decoder` EQUALS 6

--------------------------------------------------------------------------------
-- CONTROLS: answers that did not change.
--------------------------------------------------------------------------------

-- JSONDECODE as the body of a definition whose signature gives the type.
GIVETH A FUNCTION FROM STRING TO EITHER STRING Tree
`decode tree` MEANS JSONDECODE

GIVETH A NUMBER
`label via decode tree` MEANS
  CONSIDER `decode tree` "{\"label\":7,\"kids\":[]}"
    WHEN RIGHT t THEN t's label
    WHEN LEFT problem THEN 0 - 1

#ASSERT `label via decode tree` EQUALS 7

-- A decode whose type nothing fixes: a definition with no signature that
-- nothing here uses. It is not refused. Its type is not a type parameter,
-- only unknown, and a library wrapper written like this is used by its
-- importers, as `parseResponse` in the llm library is.
DECIDE `decode whatever` s IS JSONDECODE s

--------------------------------------------------------------------------------
-- Types declared under a section. This comes last, because everything after a
-- section heading belongs to that section.
--------------------------------------------------------------------------------

§ `Part A`

DECLARE Leaf HAS
  weight IS A NUMBER

DECLARE Shade IS ONE OF Light, Dark

GIVETH A NUMBER
`decoded weight` MEANS
  CONSIDER JSONDECODE "{\"weight\":9}"
    WHEN RIGHT v THEN v's weight
    WHEN LEFT problem THEN 0 - 1

#ASSERT `decoded weight` EQUALS 9

GIVETH A BOOLEAN
`decoded shade is dark` MEANS
  CONSIDER JSONDECODE "\"Dark\""
    WHEN RIGHT s THEN s EQUALS Dark
    WHEN LEFT problem THEN FALSE

#ASSERT `decoded shade is dark`
