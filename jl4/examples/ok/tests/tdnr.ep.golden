§ `Type-directed name resolution`
    GIVEN foo IS A NUMBER
          foo IS A BOOLEAN
          foo IS A STRING

DECIDE bar
  IS foo + 2

DECIDE baz
  IS NOT foo

DECIDE all
  IS IF foo THEN foo ELSE "foo"

-- This should be fine even if it's in a local declaration.
-- This possibly conflicts with local polymorphism.
DECIDE indirect
  IS local OR TRUE
  WHERE
    local MEANS foo
