-- Fixity declarations flow through IMPORT with the mixfix registry:
-- operators declared @infixl in fixity-cross-module-def re-associate
-- in bare chains here, without any local declaration.

IMPORT `fixity-cross-module-def`

-- 1 UNIONX (2 INTERSECTX 3) = 7
#EVAL UNIONX INTERSECTX 1 2 INTERSECTX 3

-- (1 UNIONX 2) UNIONX 3 = 6
#EVAL UNIONX UNIONX 1 2 UNIONX 3
