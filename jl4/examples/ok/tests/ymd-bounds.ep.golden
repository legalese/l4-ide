-- YMD year month day, from the daydate library: the date, with its parts in
-- ISO 8601 order. On a date that exists it gives the same date as
-- `Date day month year`. Where `Date` rolls a month or a day that does not
-- exist forward, YMD refuses, and its reason says which part is wrong.

IMPORT daydate


§ `YMD gives the date Date gives`

-- expected: DATE OF 28, 7, 2026
#EVAL YMD 2026 7 28

#ASSERT YMD 2026 7 28 EQUALS Date 28 7 2026

-- `Year month day` is another name for YMD.
#ASSERT `Year month day` 2026 7 28 EQUALS YMD 2026 7 28

-- expected: DATE OF 1, 1, 2026
#EVAL YMD 2026 1 1


§ `The last day of each month, in a common year and in a leap year`

-- 2023 is a common year.
#EVAL YMD 2023 1 31
#EVAL YMD 2023 2 28
#EVAL YMD 2023 3 31
#EVAL YMD 2023 4 30
#EVAL YMD 2023 5 31
#EVAL YMD 2023 6 30
#EVAL YMD 2023 7 31
#EVAL YMD 2023 8 31
#EVAL YMD 2023 9 30
#EVAL YMD 2023 10 31
#EVAL YMD 2023 11 30
#EVAL YMD 2023 12 31

-- 2024 is a leap year.
#EVAL YMD 2024 1 31
#EVAL YMD 2024 2 29
#EVAL YMD 2024 3 31
#EVAL YMD 2024 4 30
#EVAL YMD 2024 5 31
#EVAL YMD 2024 6 30
#EVAL YMD 2024 7 31
#EVAL YMD 2024 8 31
#EVAL YMD 2024 9 30
#EVAL YMD 2024 10 31
#EVAL YMD 2024 11 30
#EVAL YMD 2024 12 31


§ `The day after the last day of each month refuses`

#ASSERT REFUSED YMD 2023 1 32  BECAUSE "YMD: that month has no such day in that year"
#ASSERT REFUSED YMD 2023 2 29  BECAUSE "YMD: that month has no such day in that year"
#ASSERT REFUSED YMD 2023 3 32  BECAUSE "YMD: that month has no such day in that year"
#ASSERT REFUSED YMD 2023 4 31  BECAUSE "YMD: that month has no such day in that year"
#ASSERT REFUSED YMD 2023 5 32  BECAUSE "YMD: that month has no such day in that year"
#ASSERT REFUSED YMD 2023 6 31  BECAUSE "YMD: that month has no such day in that year"
#ASSERT REFUSED YMD 2023 7 32  BECAUSE "YMD: that month has no such day in that year"
#ASSERT REFUSED YMD 2023 8 32  BECAUSE "YMD: that month has no such day in that year"
#ASSERT REFUSED YMD 2023 9 31  BECAUSE "YMD: that month has no such day in that year"
#ASSERT REFUSED YMD 2023 10 32 BECAUSE "YMD: that month has no such day in that year"
#ASSERT REFUSED YMD 2023 11 31 BECAUSE "YMD: that month has no such day in that year"
#ASSERT REFUSED YMD 2023 12 32 BECAUSE "YMD: that month has no such day in that year"

#ASSERT REFUSED YMD 2024 1 32  BECAUSE "YMD: that month has no such day in that year"
#ASSERT REFUSED YMD 2024 2 30  BECAUSE "YMD: that month has no such day in that year"
#ASSERT REFUSED YMD 2024 3 32  BECAUSE "YMD: that month has no such day in that year"
#ASSERT REFUSED YMD 2024 4 31  BECAUSE "YMD: that month has no such day in that year"
#ASSERT REFUSED YMD 2024 5 32  BECAUSE "YMD: that month has no such day in that year"
#ASSERT REFUSED YMD 2024 6 31  BECAUSE "YMD: that month has no such day in that year"
#ASSERT REFUSED YMD 2024 7 32  BECAUSE "YMD: that month has no such day in that year"
#ASSERT REFUSED YMD 2024 8 32  BECAUSE "YMD: that month has no such day in that year"
#ASSERT REFUSED YMD 2024 9 31  BECAUSE "YMD: that month has no such day in that year"
#ASSERT REFUSED YMD 2024 10 32 BECAUSE "YMD: that month has no such day in that year"
#ASSERT REFUSED YMD 2024 11 31 BECAUSE "YMD: that month has no such day in that year"
#ASSERT REFUSED YMD 2024 12 32 BECAUSE "YMD: that month has no such day in that year"


§ `29 February`

-- 1900 and 2100 are divisible by 100 and not by 400: no 29 February.
#EVAL YMD 1900 2 29
#EVAL YMD 2100 2 29

-- 2000 and 2400 are divisible by 400: 29 February exists.
#EVAL YMD 2000 2 29
#EVAL YMD 2400 2 29

-- 2023 is not divisible by 4.
#EVAL YMD 2023 2 29


§ `Date rolls where YMD refuses`

-- expected: DATE OF 1, 3, 2023, the day after 28 February
#EVAL Date 29 2 2023

-- A transposition: month 28, day 7.
-- expected: DATE OF 7, 4, 2028, month 28 rolls into 2028
#EVAL Date 7 28 2026

#EVAL YMD 2026 28 7


§ `A month that is not a whole number from 1 to 12`

#EVAL YMD 2026 0 7
#EVAL YMD 2026 13 7

-- A fractional month: `Date` reads it as its whole part, and YMD refuses.
-- expected: DATE OF 28, 7, 2026
#EVAL Date 28 7.5 2026
#EVAL YMD 2026 7.5 28

-- When the month and the day are both wrong, the reason is the month's.
#EVAL YMD 2026 13 32

-- A whole date typed into the month's place.
#EVAL YMD 2026 20260728 1

#ASSERT REFUSED YMD 2026 28 7       BECAUSE "YMD: the month is not a whole number from 1 to 12"
#ASSERT REFUSED YMD 2026 0 7        BECAUSE "YMD: the month is not a whole number from 1 to 12"
#ASSERT REFUSED YMD 2026 13 7       BECAUSE "YMD: the month is not a whole number from 1 to 12"
#ASSERT REFUSED YMD 2026 7.5 28     BECAUSE "YMD: the month is not a whole number from 1 to 12"
#ASSERT REFUSED YMD 2026 20260728 1 BECAUSE "YMD: the month is not a whole number from 1 to 12"
#ASSERT REFUSED YMD 2026 13 32      BECAUSE "YMD: the month is not a whole number from 1 to 12"
#ASSERT REFUSED YMD 2026 13 0       BECAUSE "YMD: the month is not a whole number from 1 to 12"
#ASSERT REFUSED YMD 2026 13 7.5     BECAUSE "YMD: the month is not a whole number from 1 to 12"

-- When the month is wrong, the reason is the month's, even for a year that is
-- not a whole number.
#ASSERT REFUSED YMD 2026.5 13 1     BECAUSE "YMD: the month is not a whole number from 1 to 12"
#ASSERT REFUSED YMD 2026.5 0 1      BECAUSE "YMD: the month is not a whole number from 1 to 12"
#ASSERT REFUSED YMD 2026.5 7.5 1    BECAUSE "YMD: the month is not a whole number from 1 to 12"


§ `A day that the month does not have`

#EVAL YMD 2026 7 0
#EVAL YMD 2026 7 32

-- A fractional day: `Date` reads it as its whole part, and YMD refuses.
-- expected: DATE OF 28, 7, 2026
#EVAL Date 28.5 7 2026
#EVAL YMD 2026 7 28.5

#ASSERT REFUSED YMD 2026 7 0    BECAUSE "YMD: that month has no such day in that year"
#ASSERT REFUSED YMD 2026 7 32   BECAUSE "YMD: that month has no such day in that year"
#ASSERT REFUSED YMD 2026 7 28.5 BECAUSE "YMD: that month has no such day in that year"
#ASSERT REFUSED YMD 1900 2 29   BECAUSE "YMD: that month has no such day in that year"
#ASSERT REFUSED YMD 2100 2 29   BECAUSE "YMD: that month has no such day in that year"


§ `YMD does not check the year`

-- expected: DATE OF 1, 1, 0
#EVAL YMD 0 1 1

-- expected: DATE OF 1, 3, -5
#EVAL YMD -5 3 1
