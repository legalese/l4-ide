-- =============================================================================
-- Clause-matrix exhaustiveness, multi-column (§14.7): a Colour × BOOLEAN
-- decision table with 5 of its 6 rows covered. The analysis expands each
-- uncovered value space per column and takes the cartesian product across
-- columns, so the warning must name BOTH columns of the one missing row:
-- DECIDE `f` Blue FALSE IS.
DECLARE Colour IS ONE OF Red, Green, Blue

GIVEN c IS A Colour
      b IS A BOOLEAN
GIVETH A NUMBER
DECIDE f Red   TRUE  IS 1
DECIDE f Red   FALSE IS 2
DECIDE f Green TRUE  IS 3
DECIDE f Green FALSE IS 4
DECIDE f Blue  TRUE  IS 5

#EVAL f Red   TRUE    -- 1
#EVAL f Green FALSE   -- 4
#EVAL f Blue  TRUE    -- 5
