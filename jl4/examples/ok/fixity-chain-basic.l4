-- Fixity declarations (@infixl N) let unparenthesized chains of binary
-- identifier operators re-associate by declared priority, GHC-style:
-- the chain parses flat and the typechecker re-associates it.

@infixl 6
GIVEN p IS A NUMBER
      q IS A NUMBER
GIVETH A NUMBER
p UNIONN q MEANS p + q

@infixl 7
GIVEN p IS A NUMBER
      q IS A NUMBER
GIVETH A NUMBER
p INTERSECTN q MEANS p * q

-- INTERSECTN (priority 7) binds tighter than UNIONN (priority 6):
-- 1 UNIONN (2 INTERSECTN 3) = 1 + 6 = 7
#EVAL 1 UNIONN 2 INTERSECTN 3

-- same operator chains left-associatively: (1 UNIONN 2) UNIONN 3 = 6
#EVAL 1 UNIONN 2 UNIONN 3

-- tighter operator first: (2 INTERSECTN 3) UNIONN 1 = 7
#EVAL 2 INTERSECTN 3 UNIONN 1

-- parenthesized controls agree with the re-associated results
#EVAL 1 UNIONN (2 INTERSECTN 3)
#EVAL (1 UNIONN 2) UNIONN 3

-- explicit parentheses still override declared priorities
#EVAL (1 UNIONN 2) INTERSECTN 3

-- a longer mixed chain: 1 UNIONN (2 INTERSECTN 3) UNIONN 4 = 11
#EVAL 1 UNIONN 2 INTERSECTN 3 UNIONN 4

-- plain binary application is unaffected
#EVAL 1 UNIONN 2
#EVAL 2 INTERSECTN 3
