-- A rule that names itself with a window never open cannot end: every incarnation
-- is already past its deadline when it is entered, and the deadline never moves
-- past the moment the chain began. The machine refuses it after 1,000 hand-offs
-- in a row rather than walking it forever.

DECLARE Person IS ONE OF Alice, Bob
DECLARE Action IS ONE OF
  pay HAS amount IS A NUMBER
  deliver

`names itself, window below zero` MEANS
  PARTY Alice
  MUST pay 1
  WITHIN 0 - 1
  LEST `names itself, window below zero`

#TRACE `names itself, window below zero` AT 0 WITH
  PARTY Bob DOES deliver AT 7

`names itself, no window` MEANS
  PARTY Alice
  MUST pay 1
  WITHIN 0
  LEST `names itself, no window`

#TRACE `names itself, no window` AT 0 WITH
  PARTY Bob DOES deliver AT 7

-- A window of its own lets the deadline advance, so the chain is finite: the
-- layers are due at 3, 6 and 9, and the delivery at 7 is inside the third.
`names itself, with a window` MEANS
  PARTY Alice
  MUST deliver
  WITHIN 3
  LEST `names itself, with a window`

#TRACE `names itself, with a window` AT 0 WITH
  PARTY Alice DOES deliver AT 7
