-- Bitemporal corrections (smucclaw/l4-ide#914 §2B): two writes at the SAME
-- valid time are a correction — the later transaction wins. Within one run
-- every append shares one transaction TIMESTAMP (the root eval clock), so
-- transaction order is log position; the fold must tie-break positionally.
-- Also: an EVAL AS OF SYSTEM TIME bound before every append hides the whole
-- ledger ("what did we know in 2020? nothing") -> NOTHING -> 0.
--
-- Harness clock: JL4_FIXED_NOW = 2025-01-31T15:45:30Z.

IMPORT prelude

-- expected: LIST 1, 2, 2, 0
#EVAL LIST (`EVAL UNDER VALID TIME` (DATE_FROM_DMY 1 1 2024) (RECORD `x` IS 1)), (`EVAL UNDER VALID TIME` (DATE_FROM_DMY 1 1 2024) (RECORD `x` IS 2)), (fromMaybe 0 (`EVAL UNDER VALID TIME` (DATE_FROM_DMY 1 2 2024) (RECALL `x`))), (fromMaybe 0 (`EVAL AS OF SYSTEM TIME` (DATE_FROM_DMY 1 1 2020) (RECALL `x`)))
