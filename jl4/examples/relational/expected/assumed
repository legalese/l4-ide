  input is authorised/1 : (goal)  % assumed.l4:75:1-76:38
    params: Person
    desc: an authorised person within the meaning of section 53
    ref: s 43(1) Anti-social Behaviour, Crime and Policing Act 2014
    (no clauses)
  input has surrendered authority/1 : (goal)  % assumed.l4:79:1-80:50
