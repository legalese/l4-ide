#[description = "Mode A (boolean reference) rendering of `eligible for benefit`."]
declaration scope EligibleForBenefitEqvModeA:
  input row content EligibleForBenefitEqvRow
  output verdict condition

#[description = "Mode B (exception ladder) rendering of `eligible for benefit`."]
declaration scope EligibleForBenefitEqvModeB:
  input row content EligibleForBenefitEqvRow
  output verdict condition

#[description = "True when both renderings agree on this row."]
declaration scope EligibleForBenefitEqvAgree:
  input row content EligibleForBenefitEqvRow
  output agree content boolean

#[description = "Exhaustive 4-row agreement grid for `eligible for benefit`."]
#[test] declaration scope EligibleForBenefitEqvGrid:
