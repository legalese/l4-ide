declaration structure Household:
  data adults content decimal
  data children content decimal

#[description = "The per-head allowance a household is entitled to."]
declaration scope AllowanceFor:
  input h content Household
  output allowance_for content decimal

#[description = "Witness 1 for `allowance for`: p_0 FALSE."]
