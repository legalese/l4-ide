-- One rule written twice: as a CONSIDER over the options of a choice, and as
-- the BRANCH it stands for. Each WHEN of the CONSIDER is a condition the rule
-- branches on, as each IF of the BRANCH is, so the two get the same cover
-- points and the same buckets (smucclaw/l4-ide#1094).
DECLARE Plan IS ONE OF basic, pro, team

GIVEN p IS A Plan
GIVETH A NUMBER
DECIDE `monthly fee` p IS
    CONSIDER p
    WHEN basic THEN 5
    WHEN pro THEN 20
    OTHERWISE 50

GIVEN p IS A Plan
GIVETH A NUMBER
DECIDE `monthly fee by BRANCH` p IS
    BRANCH
        IF p EQUALS basic THEN 5
        IF p EQUALS pro THEN 20
        OTHERWISE 50
