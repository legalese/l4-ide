    </literalExpression>
  </decision>
  <decision id="decision_b_4_all_securities_repurchased" name="b_4_all_securities_repurchased" label="(b)(4) — all securities repurchased">
    <variable id="decision_b_4_all_securities_repurchased_var" name="b_4_all_securities_repurchased" label="(b)(4) — all securities repurchased" typeRef="boolean"/>
    <informationRequirement id="decision_b_4_all_securities_repurchased_ir1">
      <requiredInput href="#input_status_4"/>
    </informationRequirement>
    <literalExpression id="decision_b_4_all_securities_repurchased_literal">
