    </literalExpression>
  </decision>
  <decision id="decision_b_3_three_annual_reports_filed_and_total_assets_not_exceeding_10_000_000" name="b_3_three_annual_reports_filed_and_total_assets_not_exceeding_10_000_000" label="(b)(3) — three annual reports filed and total assets not exceeding $10,000,000">
    <variable id="decision_b_3_three_annual_reports_filed_and_total_assets_not_exceeding_10_000_000_var" name="b_3_three_annual_reports_filed_and_total_assets_not_exceeding_10_000_000" label="(b)(3) — three annual reports filed and total assets not exceeding $10,000,000" typeRef="boolean"/>
    <informationRequirement id="decision_b_3_three_annual_reports_filed_and_total_assets_not_exceeding_10_000_000_ir1">
