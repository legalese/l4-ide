  <decision id="decision_business_days_to_file_a_progress_update" name="business_days_to_file_a_progress_update" label="business days to file a progress update">
    <variable id="decision_business_days_to_file_a_progress_update_var" name="business_days_to_file_a_progress_update" label="business days to file a progress update" typeRef="number"/>
    <literalExpression id="decision_business_days_to_file_a_progress_update_literal">
      <text>5</text>
    </literalExpression>
  </decision>
  <decision id="decision_days_in_the_resale_restricted_period" name="days_in_the_resale_restricted_period" label="days in the resale restricted period">
    <variable id="decision_days_in_the_resale_restricted_period_var" name="days_in_the_resale_restricted_period" label="days in the resale restricted period" typeRef="number"/>
    <literalExpression id="decision_days_in_the_resale_restricted_period_literal">
      <text>365</text>
    </literalExpression>
  </decision>
  <decision id="decision_b_1_not_organized_under_state_or_territorial_law" name="b_1_not_organized_under_State_or_territorial_law" label="(b)(1) — not organized under State or territorial law">
    <variable id="decision_b_1_not_organized_under_state_or_territorial_law_var" name="b_1_not_organized_under_State_or_territorial_law" label="(b)(1) — not organized under State or territorial law" typeRef="boolean"/>
    <informationRequirement id="decision_b_1_not_organized_under_state_or_territorial_law_ir1">
      <requiredInput href="#input_issuer"/>
    </informationRequirement>
    <literalExpression id="decision_b_1_not_organized_under_state_or_territorial_law_literal">
      <text>true and not(issuer.organized_under_and_subject_to_the_laws_of_a_State_or_territory_of_the_United_States_or_the_District_of_Columbia)</text>
    </literalExpression>
  </decision>
  <decision id="decision_b_2_an_exchange_act_reporting_company" name="b_2_an_Exchange_Act_reporting_company" label="(b)(2) — an Exchange Act reporting company">
    <variable id="decision_b_2_an_exchange_act_reporting_company_var" name="b_2_an_Exchange_Act_reporting_company" label="(b)(2) — an Exchange Act reporting company" typeRef="boolean"/>
    <informationRequirement id="decision_b_2_an_exchange_act_reporting_company_ir1">
      <requiredInput href="#input_issuer"/>
    </informationRequirement>
    <literalExpression id="decision_b_2_an_exchange_act_reporting_company_literal">
      <text>true and issuer.subject_to_the_requirement_to_file_reports_pursuant_to_section_13_or_section_15_d_of_the_Exchange_Act</text>
    </literalExpression>
  </decision>
  <decision id="decision_b_3_an_investment_company" name="b_3_an_investment_company" label="(b)(3) — an investment company">
    <variable id="decision_b_3_an_investment_company_var" name="b_3_an_investment_company" label="(b)(3) — an investment company" typeRef="boolean"/>
    <informationRequirement id="decision_b_3_an_investment_company_ir1">
      <requiredInput href="#input_issuer"/>
    </informationRequirement>
    <literalExpression id="decision_b_3_an_investment_company_literal">
      <text>true and issuer.an_investment_company_or_is_excluded_from_the_definition_of_investment_company_by_section_3_b_or_section_3_c</text>
    </literalExpression>
  </decision>
  <decision id="decision_b_4_subject_to_a_bad_actor_disqualification" name="b_4_subject_to_a_bad_actor_disqualification" label="(b)(4) — subject to a bad-actor disqualification">
    <variable id="decision_b_4_subject_to_a_bad_actor_disqualification_var" name="b_4_subject_to_a_bad_actor_disqualification" label="(b)(4) — subject to a bad-actor disqualification" typeRef="boolean"/>
    <informationRequirement id="decision_b_4_subject_to_a_bad_actor_disqualification_ir1">
      <requiredInput href="#input_issuer"/>
    </informationRequirement>
    <literalExpression id="decision_b_4_subject_to_a_bad_actor_disqualification_literal">
      <text>true and issuer.subject_to_a_disqualification_as_specified_in_section_227_503_a</text>
    </literalExpression>
  </decision>
  <decision id="decision_b_5_delinquent_in_ongoing_annual_reports" name="b_5_delinquent_in_ongoing_annual_reports" label="(b)(5) — delinquent in ongoing annual reports">
    <variable id="decision_b_5_delinquent_in_ongoing_annual_reports_var" name="b_5_delinquent_in_ongoing_annual_reports" label="(b)(5) — delinquent in ongoing annual reports" typeRef="boolean"/>
    <informationRequirement id="decision_b_5_delinquent_in_ongoing_annual_reports_ir1">
      <requiredInput href="#input_issuer"/>
    </informationRequirement>
    <literalExpression id="decision_b_5_delinquent_in_ongoing_annual_reports_literal">
      <text>true and issuer.has_sold_securities_in_reliance_on_section_4_a_6_and_has_not_filed_the_ongoing_annual_reports_required_during_the_two_years_immediately_preceding_the_filing_of_the_offering_statement</text>
    </literalExpression>
  </decision>
  <decision id="decision_b_6_no_specific_business_plan_or_a_blank_check_business_plan" name="b_6_no_specific_business_plan_or_a_blank_check_business_plan" label="(b)(6) — no specific business plan, or a blank-check business plan">
    <variable id="decision_b_6_no_specific_business_plan_or_a_blank_check_business_plan_var" name="b_6_no_specific_business_plan_or_a_blank_check_business_plan" label="(b)(6) — no specific business plan, or a blank-check business plan" typeRef="boolean"/>
    <informationRequirement id="decision_b_6_no_specific_business_plan_or_a_blank_check_business_plan_ir1">
      <requiredInput href="#input_issuer"/>
    </informationRequirement>
    <literalExpression id="decision_b_6_no_specific_business_plan_or_a_blank_check_business_plan_literal">
      <text>true and issuer.has_no_specific_business_plan_or_has_indicated_that_its_business_plan_is_to_engage_in_a_merger_or_acquisition_with_an_unidentified_company_or_companies</text>
    </literalExpression>
  </decision>
  <decision id="decision_issuer_is_excluded_by_rule_100_b" name="issuer_is_excluded_by_Rule_100_b" label="issuer is excluded by Rule 100(b)">
    <variable id="decision_issuer_is_excluded_by_rule_100_b_var" name="issuer_is_excluded_by_Rule_100_b" label="issuer is excluded by Rule 100(b)" typeRef="boolean"/>
    <informationRequirement id="decision_issuer_is_excluded_by_rule_100_b_ir1">
      <requiredDecision href="#decision_b_1_not_organized_under_state_or_territorial_law"/>
    </informationRequirement>
    <informationRequirement id="decision_issuer_is_excluded_by_rule_100_b_ir2">
      <requiredDecision href="#decision_b_2_an_exchange_act_reporting_company"/>
    </informationRequirement>
    <informationRequirement id="decision_issuer_is_excluded_by_rule_100_b_ir3">
      <requiredDecision href="#decision_b_3_an_investment_company"/>
    </informationRequirement>
    <informationRequirement id="decision_issuer_is_excluded_by_rule_100_b_ir4">
      <requiredDecision href="#decision_b_4_subject_to_a_bad_actor_disqualification"/>
    </informationRequirement>
    <informationRequirement id="decision_issuer_is_excluded_by_rule_100_b_ir5">
      <requiredDecision href="#decision_b_5_delinquent_in_ongoing_annual_reports"/>
    </informationRequirement>
    <informationRequirement id="decision_issuer_is_excluded_by_rule_100_b_ir6">
      <requiredDecision href="#decision_b_6_no_specific_business_plan_or_a_blank_check_business_plan"/>
    </informationRequirement>
    <informationRequirement id="decision_issuer_is_excluded_by_rule_100_b_ir7">
      <requiredInput href="#input_issuer"/>
    </informationRequirement>
    <literalExpression id="decision_issuer_is_excluded_by_rule_100_b_literal">
      <text>false or (b_1_not_organized_under_State_or_territorial_law or (b_2_an_Exchange_Act_reporting_company or (b_3_an_investment_company or (b_4_subject_to_a_bad_actor_disqualification or (b_5_delinquent_in_ongoing_annual_reports or b_6_no_specific_business_plan_or_a_blank_check_business_plan)))))</text>
    </literalExpression>
  </decision>
  <decision id="decision_issuer_is_eligible" name="issuer_is_eligible" label="issuer is eligible">
    <variable id="decision_issuer_is_eligible_var" name="issuer_is_eligible" label="issuer is eligible" typeRef="boolean"/>
    <informationRequirement id="decision_issuer_is_eligible_ir1">
      <requiredDecision href="#decision_issuer_is_excluded_by_rule_100_b"/>
    </informationRequirement>
    <informationRequirement id="decision_issuer_is_eligible_ir2">
      <requiredInput href="#input_issuer"/>
    </informationRequirement>
    <literalExpression id="decision_issuer_is_eligible_literal">
      <text>not(issuer_is_excluded_by_Rule_100_b)</text>
    </literalExpression>
  </decision>
  <decision id="decision_aggregate_offering_amount" name="aggregate_offering_amount" label="aggregate offering amount">
    <variable id="decision_aggregate_offering_amount_var" name="aggregate_offering_amount" label="aggregate offering amount" typeRef="number"/>
    <informationRequirement id="decision_aggregate_offering_amount_ir1">
      <requiredInput href="#input_offering"/>
    </informationRequirement>
    <literalExpression id="decision_aggregate_offering_amount_literal">
      <text>offering.aggregate_amount_sold_in_reliance_on_section_4_a_6_during_the_preceding_12_months + offering.maximum_offering_amount_the_issuer_will_accept</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_applicable_measure_of_annual_income_or_net_worth" name="the_applicable_measure_of_annual_income_or_net_worth" label="the applicable measure of annual income or net worth">
    <variable id="decision_the_applicable_measure_of_annual_income_or_net_worth_var" name="the_applicable_measure_of_annual_income_or_net_worth" label="the applicable measure of annual income or net worth" typeRef="number"/>
    <informationRequirement id="decision_the_applicable_measure_of_annual_income_or_net_worth_ir1">
      <requiredDecision href="#hydration_investor"/>
    </informationRequirement>
    <informationRequirement id="decision_the_applicable_measure_of_annual_income_or_net_worth_ir2">
      <requiredInput href="#input_no_regulation_crowdfunding_figure_exists_before_commencement_on_2016_05_16"/>
    </informationRequirement>
    <informationRequirement id="decision_the_applicable_measure_of_annual_income_or_net_worth_ir3">
      <requiredInput href="#input_rules_effective_date"/>
    </informationRequirement>
    <decisionTable id="decision_the_applicable_measure_of_annual_income_or_net_worth_table" hitPolicy="UNIQUE" preferredOrientation="Rule-as-Row" outputLabel="the applicable measure of annual income or net worth">
      <input id="decision_the_applicable_measure_of_annual_income_or_net_worth_i1" label="`RULES EFFECTIVE DATE`">
        <inputExpression id="decision_the_applicable_measure_of_annual_income_or_net_worth_i1_expr" typeRef="date">
          <text>RULES_EFFECTIVE_DATE</text>
        </inputExpression>
      </input>
      <output id="decision_the_applicable_measure_of_annual_income_or_net_worth_o1"/>
      <annotation name="regime"/>
      <rule id="decision_the_applicable_measure_of_annual_income_or_net_worth_r1">
        <description>`the rules in force include` OF `the 2021 amendments`</description>
        <inputEntry id="decision_the_applicable_measure_of_annual_income_or_net_worth_r1_i1">
          <text>&gt;= date("2021-03-15")</text>
        </inputEntry>
        <outputEntry id="decision_the_applicable_measure_of_annual_income_or_net_worth_r1_o1">
          <text>investor_hydrated.greater_of_annual_income_or_net_worth</text>
        </outputEntry>
        <annotationEntry>
          <text>the 2021 amendments — 86 FR 3496 (Rel. 33-10884), instr. 3 — the 2020 amendments, eff. 2021-03-15 (main.l4:111:1-112:43)</text>
        </annotationEntry>
      </rule>
      <rule id="decision_the_applicable_measure_of_annual_income_or_net_worth_r2">
        <description>`the rules in force include` OF `Reg CF commenced`</description>
        <inputEntry id="decision_the_applicable_measure_of_annual_income_or_net_worth_r2_i1">
          <text>[date("2016-05-16")..date("2021-03-15"))</text>
        </inputEntry>
        <outputEntry id="decision_the_applicable_measure_of_annual_income_or_net_worth_r2_o1">
          <text>investor_hydrated.lesser_of_annual_income_or_net_worth</text>
        </outputEntry>
        <annotationEntry>
          <text>Reg CF commenced — 80 FR 71388 (Rel. 33-9974), Part 227 text at 71537, instr. 4 — commencement (main.l4:103:1-104:40)</text>
        </annotationEntry>
      </rule>
      <rule id="decision_the_applicable_measure_of_annual_income_or_net_worth_r3">
        <description>OTHERWISE</description>
        <inputEntry id="decision_the_applicable_measure_of_annual_income_or_net_worth_r3_i1">
          <text>&lt; date("2016-05-16")</text>
        </inputEntry>
        <outputEntry id="decision_the_applicable_measure_of_annual_income_or_net_worth_r3_o1">
          <text>no_Regulation_Crowdfunding_figure_exists_before_commencement_on_2016_05_16</text>
        </outputEntry>
        <annotationEntry>
          <text>no Regulation Crowdfunding figure exists before commencement on 2016-05-16</text>
        </annotationEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="decision_either_annual_income_or_net_worth_is_less_than_the_cut_point" name="either_annual_income_or_net_worth_is_less_than_the_cut_point" label="either annual income or net worth is less than the cut point">
    <variable id="decision_either_annual_income_or_net_worth_is_less_than_the_cut_point_var" name="either_annual_income_or_net_worth_is_less_than_the_cut_point" label="either annual income or net worth is less than the cut point" typeRef="boolean"/>
    <informationRequirement id="decision_either_annual_income_or_net_worth_is_less_than_the_cut_point_ir1">
      <requiredDecision href="#decision_income_or_net_worth_cut_point"/>
    </informationRequirement>
    <informationRequirement id="decision_either_annual_income_or_net_worth_is_less_than_the_cut_point_ir2">
      <requiredInput href="#input_investor"/>
    </informationRequirement>
    <literalExpression id="decision_either_annual_income_or_net_worth_is_less_than_the_cut_point_literal">
      <text>investor.annual_income &lt; income_or_net_worth_cut_point or investor.net_worth &lt; income_or_net_worth_cut_point</text>
    </literalExpression>
  </decision>
  <decision id="decision_aggregate_amount_sold_to_this_investor_including_this_transaction" name="aggregate_amount_sold_to_this_investor_including_this_transaction" label="aggregate amount sold to this investor including this transaction">
    <variable id="decision_aggregate_amount_sold_to_this_investor_including_this_transaction_var" name="aggregate_amount_sold_to_this_investor_including_this_transaction" label="aggregate amount sold to this investor including this transaction" typeRef="number"/>
    <informationRequirement id="decision_aggregate_amount_sold_to_this_investor_including_this_transaction_ir1">
      <requiredInput href="#input_amount_to_be_sold_in_this_transaction"/>
    </informationRequirement>
    <informationRequirement id="decision_aggregate_amount_sold_to_this_investor_including_this_transaction_ir2">
      <requiredInput href="#input_investor"/>
    </informationRequirement>
    <literalExpression id="decision_aggregate_amount_sold_to_this_investor_including_this_transaction_literal">
      <text>investor.aggregate_amount_already_sold_to_this_investor_across_all_issuers_in_reliance_on_section_4_a_6_during_the_preceding_12_months + amount_to_be_sold_in_this_transaction</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_accredited_investor_carve_out_applies_to" name="the_accredited_investor_carve_out_applies_to" label="the accredited-investor carve-out applies to">
    <variable id="decision_the_accredited_investor_carve_out_applies_to_var" name="the_accredited_investor_carve_out_applies_to" label="the accredited-investor carve-out applies to" typeRef="boolean"/>
    <informationRequirement id="decision_the_accredited_investor_carve_out_applies_to_ir1">
      <requiredDecision href="#decision_the_2021_amendments"/>
    </informationRequirement>
    <informationRequirement id="decision_the_accredited_investor_carve_out_applies_to_ir2">
      <requiredInput href="#input_investor"/>
    </informationRequirement>
    <informationRequirement id="decision_the_accredited_investor_carve_out_applies_to_ir3">
      <requiredInput href="#input_rules_effective_date"/>
    </informationRequirement>
    <knowledgeRequirement id="decision_the_accredited_investor_carve_out_applies_to_kr1">
      <requiredKnowledge href="#bkm_the_rules_in_force_include"/>
    </knowledgeRequirement>
    <literalExpression id="decision_the_accredited_investor_carve_out_applies_to_literal">
      <text>the_rules_in_force_include(amendment: the_2021_amendments, RULES_EFFECTIVE_DATE: RULES_EFFECTIVE_DATE) and investor.an_accredited_investor_as_defined_in_Rule_501</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_rule_date_is_inside_the_covid_19_temporary_rules_window" name="the_rule_date_is_inside_the_COVID_19_temporary_rules_window" label="the rule date is inside the COVID-19 temporary rules window">
    <variable id="decision_the_rule_date_is_inside_the_covid_19_temporary_rules_window_var" name="the_rule_date_is_inside_the_COVID_19_temporary_rules_window" label="the rule date is inside the COVID-19 temporary rules window" typeRef="boolean"/>
    <informationRequirement id="decision_the_rule_date_is_inside_the_covid_19_temporary_rules_window_ir1">
      <requiredInput href="#input_rules_effective_date"/>
    </informationRequirement>
    <literalExpression id="decision_the_rule_date_is_inside_the_covid_19_temporary_rules_window_literal">
      <text>RULES_EFFECTIVE_DATE &gt;= date("2020-05-04") and RULES_EFFECTIVE_DATE &lt;= date("2022-08-28")</text>
    </literalExpression>
  </decision>
  <decision id="decision_financial_statement_requirement_is_satisfied" name="financial_statement_requirement_is_satisfied" label="financial statement requirement is satisfied">
    <variable id="decision_financial_statement_requirement_is_satisfied_var" name="financial_statement_requirement_is_satisfied" label="financial statement requirement is satisfied" typeRef="boolean"/>
    <informationRequirement id="decision_financial_statement_requirement_is_satisfied_ir1">
      <requiredDecision href="#decision_aggregate_offering_amount"/>
    </informationRequirement>
    <informationRequirement id="decision_financial_statement_requirement_is_satisfied_ir2">
      <requiredDecision href="#decision_first_time_issuer_review_ceiling"/>
    </informationRequirement>
    <informationRequirement id="decision_financial_statement_requirement_is_satisfied_ir3">
      <requiredDecision href="#decision_the_rule_date_is_inside_the_covid_19_temporary_rules_window"/>
    </informationRequirement>
    <informationRequirement id="decision_financial_statement_requirement_is_satisfied_ir4">
      <requiredDecision href="#decision_tier_1_ceiling"/>
    </informationRequirement>
    <informationRequirement id="decision_financial_statement_requirement_is_satisfied_ir5">
      <requiredDecision href="#decision_tier_2_ceiling"/>
    </informationRequirement>
    <informationRequirement id="decision_financial_statement_requirement_is_satisfied_ir6">
      <requiredInput href="#input_offering"/>
    </informationRequirement>
    <informationRequirement id="decision_financial_statement_requirement_is_satisfied_ir7">
      <requiredInput href="#input_supplied"/>
    </informationRequirement>
    <informationRequirement id="decision_financial_statement_requirement_is_satisfied_ir8">
      <requiredInput href="#input_the_covid_19_temporary_rules_rule_201_z_and_bb_are_not_modelled_here"/>
    </informationRequirement>
    <knowledgeRequirement id="decision_financial_statement_requirement_is_satisfied_kr1">
      <requiredKnowledge href="#bkm_assurance_level"/>
    </knowledgeRequirement>
    <knowledgeRequirement id="decision_financial_statement_requirement_is_satisfied_kr2">
      <requiredKnowledge href="#bkm_financial_statements_required"/>
    </knowledgeRequirement>
    <literalExpression id="decision_financial_statement_requirement_is_satisfied_literal">
      <text>assurance_level(required: supplied) &gt;= assurance_level(required: financial_statements_required(offering: offering, aggregate_offering_amount: aggregate_offering_amount, first_time_issuer_review_ceiling: first_time_issuer_review_ceiling, the_COVID_19_temporary_rules_Rule_201_z_and_bb_are_not_modelled_here: the_COVID_19_temporary_rules_Rule_201_z_and_bb_are_not_modelled_here, the_rule_date_is_inside_the_COVID_19_temporary_rules_window: the_rule_date_is_inside_the_COVID_19_temporary_rules_window, tier_1_ceiling: tier_1_ceiling, tier_2_ceiling: tier_2_ceiling))</text>
    </literalExpression>
  </decision>
  <decision id="decision_disclosure_requirements_are_met" name="disclosure_requirements_are_met" label="disclosure requirements are met">
    <variable id="decision_disclosure_requirements_are_met_var" name="disclosure_requirements_are_met" label="disclosure requirements are met" typeRef="boolean"/>
    <informationRequirement id="decision_disclosure_requirements_are_met_ir1">
      <requiredDecision href="#decision_financial_statement_requirement_is_satisfied"/>
    </informationRequirement>
    <informationRequirement id="decision_disclosure_requirements_are_met_ir2">
      <requiredInput href="#input_filing"/>
    </informationRequirement>
    <informationRequirement id="decision_disclosure_requirements_are_met_ir3">
      <requiredInput href="#input_offering"/>
    </informationRequirement>
    <literalExpression id="decision_disclosure_requirements_are_met_literal">
      <text>true and (filing.a_Form_C_offering_statement_was_filed_with_the_Commission_and_provided_to_investors_and_the_relevant_intermediary_prior_to_the_commencement_of_the_offering and (filing.the_Form_C_includes_the_information_required_by_section_227_201 and financial_statement_requirement_is_satisfied))</text>
    </literalExpression>
  </decision>
  <decision id="decision_a_3_conducted_through_a_single_complying_intermediary" name="a_3_conducted_through_a_single_complying_intermediary" label="(a)(3) — conducted through a single complying intermediary">
    <variable id="decision_a_3_conducted_through_a_single_complying_intermediary_var" name="a_3_conducted_through_a_single_complying_intermediary" label="(a)(3) — conducted through a single complying intermediary" typeRef="boolean"/>
    <informationRequirement id="decision_a_3_conducted_through_a_single_complying_intermediary_ir1">
      <requiredInput href="#input_arrangement"/>
    </informationRequirement>
    <literalExpression id="decision_a_3_conducted_through_a_single_complying_intermediary_literal">
      <text>true and (arrangement.the_intermediary_complies_with_section_4A_a_of_the_Securities_Act_and_the_related_requirements_in_this_part and (arrangement.the_transaction_is_conducted_exclusively_through_the_intermediary_s_platform and (true and arrangement.the_number_of_intermediaries_used_for_the_offering = 1)))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_21_day_public_availability_period_has_run" name="the_21_day_public_availability_period_has_run" label="the 21-day public availability period has run">
    <variable id="decision_the_21_day_public_availability_period_has_run_var" name="the_21_day_public_availability_period_has_run" label="the 21-day public availability period has run" typeRef="boolean"/>
    <informationRequirement id="decision_the_21_day_public_availability_period_has_run_ir1">
      <requiredDecision href="#decision_minimum_days_publicly_available_before_any_sale"/>
    </informationRequirement>
    <informationRequirement id="decision_the_21_day_public_availability_period_has_run_ir2">
      <requiredInput href="#input_arrangement"/>
    </informationRequirement>
    <literalExpression id="decision_the_21_day_public_availability_period_has_run_literal">
      <text>true and arrangement.the_days_the_issuer_information_has_been_publicly_available_on_the_intermediary_s_platform_before_any_sale &gt;= minimum_days_publicly_available_before_any_sale</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_intermediary_has_discharged_its_investor_facing_duties" name="the_intermediary_has_discharged_its_investor_facing_duties" label="the intermediary has discharged its investor-facing duties">
