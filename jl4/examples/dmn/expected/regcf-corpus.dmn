  <decision id="decision_investment_limit" name="investment_limit" label="investment limit">
    <variable id="decision_investment_limit_var" name="investment_limit" label="investment limit" typeRef="number"/>
    <informationRequirement id="decision_investment_limit_ir1">
      <requiredDecision href="#decision_either_annual_income_or_net_worth_is_less_than_the_cut_point"/>
    </informationRequirement>
