        </inputExpression>
      </input>
      <input id="decision_financial_statements_required_i2" label="(`aggregate offering amount` OF offering) GREATER THAN `tier 1 ceiling`">
        <inputExpression id="decision_financial_statements_required_i2_expr" typeRef="boolean">
          <text>(`aggregate offering amount` OF offering) GREATER THAN `tier 1 ceiling`</text>
        </inputExpression>
      </input>
      <input id="decision_financial_statements_required_i3" label="`aggregate offering amount` OF offering">
        <inputExpression id="decision_financial_statements_required_i3_expr" typeRef="number">
          <text>`aggregate offering amount` OF offering</text>
        </inputExpression>
      </input>
      <input id="decision_financial_statements_required_i4" label="(`aggregate offering amount` OF offering) AT MOST `tier 1 ceiling`">
        <inputExpression id="decision_financial_statements_required_i4_expr" typeRef="boolean">
          <text>(`aggregate offering amount` OF offering) AT MOST `tier 1 ceiling`</text>
        </inputExpression>
      </input>
      <input id="decision_financial_statements_required_i5" label="(`aggregate offering amount` OF offering) AT MOST `tier 2 ceiling`">
        <inputExpression id="decision_financial_statements_required_i5_expr" typeRef="boolean">
          <text>(`aggregate offering amount` OF offering) AT MOST `tier 2 ceiling`</text>
        </inputExpression>
      </input>
      <input id="decision_financial_statements_required_i6" label="offering&apos;s `the issuer has previously sold securities in reliance on section 4(a)(6)`">
        <inputExpression id="decision_financial_statements_required_i6_expr" typeRef="boolean">
          <text>offering_3.the_issuer_has_previously_sold_securities_in_reliance_on_section_4_a_6</text>
        </inputExpression>
      </input>
      <input id="decision_financial_statements_required_i7" label="(`aggregate offering amount` OF offering) AT MOST `first-time issuer review ceiling`">
        <inputExpression id="decision_financial_statements_required_i7_expr" typeRef="boolean">
          <text>(`aggregate offering amount` OF offering) AT MOST `first-time issuer review ceiling`</text>
        </inputExpression>
      </input>
      <output id="decision_financial_statements_required_o1">
        <outputValues>
          <text>"financial statements certified by the principal executive officer, with tax return information","financial statements reviewed by an independent public accountant","financial statements audited by an independent public accountant"</text>
        </outputValues>
      </output>
      <rule id="decision_financial_statements_required_r1">
        <description>`the rule date is inside the COVID-19 temporary rules window` AND (`aggregate offering amount` OF offering) GREATER THAN `tier 1 ceiling` AND (`aggregate offering amount` OF offering) AT MOST 250000</description>
        <inputEntry id="decision_financial_statements_required_r1_i1">
          <text>true</text>
        </inputEntry>
        <inputEntry id="decision_financial_statements_required_r1_i2">
          <text>true</text>
        </inputEntry>
        <inputEntry id="decision_financial_statements_required_r1_i3">
          <text>&lt;= 250000</text>
        </inputEntry>
        <inputEntry id="decision_financial_statements_required_r1_i4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="decision_financial_statements_required_r1_i5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="decision_financial_statements_required_r1_i6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="decision_financial_statements_required_r1_i7">
          <text>-</text>
        </inputEntry>
        <outputEntry id="decision_financial_statements_required_r1_o1">
          <text>the_COVID_19_temporary_rules_Rule_201_z_and_bb_are_not_modelled_here</text>
