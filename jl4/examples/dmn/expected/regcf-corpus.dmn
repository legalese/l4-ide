  <decision id="decision_a_conforming_notice" name="a conforming notice">
    <variable id="decision_a_conforming_notice_var" name="a conforming notice" typeRef="Any"/>
    <literalExpression id="decision_a_conforming_notice_literal">
      <text>AdvertisingNotice WITH `directs investors to the intermediary's platform` IS TRUE `states that the issuer is conducting an offering pursuant to section 4(a)(6), names the intermediary, and directs the potential investor to its platform` IS TRUE `states the terms of the offering` IS TRUE `states factual information about the legal identity and business location of the issuer` IS TRUE `includes information beyond that permitted by paragraph (b)` IS FALSE</text>
    </literalExpression>
  </decision>
