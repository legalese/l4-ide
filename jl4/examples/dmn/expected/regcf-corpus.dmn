    </literalExpression>
  </decision>
  <decision id="decision_b_2_one_annual_report_filed_and_fewer_than_300_holders_of_record" name="b_2_one_annual_report_filed_and_fewer_than_300_holders_of_record" label="(b)(2) — one annual report filed and fewer than 300 holders of record">
    <variable id="decision_b_2_one_annual_report_filed_and_fewer_than_300_holders_of_record_var" name="b_2_one_annual_report_filed_and_fewer_than_300_holders_of_record" label="(b)(2) — one annual report filed and fewer than 300 holders of record" typeRef="boolean"/>
