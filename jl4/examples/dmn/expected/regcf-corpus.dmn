      <requiredInput href="#input_arrangement_2"/>
    </informationRequirement>
    <literalExpression id="decision_the_21_day_public_availability_period_has_run_literal">
      <text>true and arrangement_2.the_days_the_issuer_information_has_been_publicly_available_on_the_intermediary_s_platform_before_any_sale &gt;= minimum_days_publicly_available_before_any_sale</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_intermediary_has_discharged_its_investor_facing_duties" name="the_intermediary_has_discharged_its_investor_facing_duties" label="the intermediary has discharged its investor-facing duties">
    <variable id="decision_the_intermediary_has_discharged_its_investor_facing_duties_var" name="the_intermediary_has_discharged_its_investor_facing_duties" label="the intermediary has discharged its investor-facing duties" typeRef="boolean"/>
