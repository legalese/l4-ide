    <informationRequirement id="decision_resale_restriction_ir3">
      <requiredInput href="#input_transfer_4"/>
    </informationRequirement>
    <literalExpression id="decision_resale_restriction_literal">
      <text>IF (`transfer falls within an exception in Rule 501(a)` OF transfer) THEN FULFILLED ELSE (PARTY Purchaser MUST NOT `transfer the securities` WITHIN `days in the resale restricted period`)</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_transaction_qualifies_for_the_section_4_a_6_exemption" name="the transaction qualifies for the section 4(a)(6) exemption">
