    <variable id="input_to_accredited_var" name="to accredited" typeRef="boolean"/>
  </inputData>
  <decision id="decision_offering_maximum_in_a_12_month_period" name="offering maximum in a 12-month period">
    <variable id="decision_offering_maximum_in_a_12_month_period_var" name="offering maximum in a 12_month period" typeRef="number"/>
    <literalExpression id="decision_offering_maximum_in_a_12_month_period_literal">
      <text>5000000</text>
    </literalExpression>
  </decision>
  <decision id="decision_income_or_net_worth_cut_point" name="income or net worth cut point">
    <variable id="decision_income_or_net_worth_cut_point_var" name="income or net worth cut point" typeRef="number"/>
    <literalExpression id="decision_income_or_net_worth_cut_point_literal">
      <text>124000</text>
    </literalExpression>
  </decision>
  <decision id="decision_minimum_permitted_investment" name="minimum permitted investment">
    <variable id="decision_minimum_permitted_investment_var" name="minimum permitted investment" typeRef="number"/>
    <literalExpression id="decision_minimum_permitted_investment_literal">
      <text>2500</text>
    </literalExpression>
  </decision>
  <decision id="decision_maximum_amount_sold_to_any_one_investor_in_a_12_month_period" name="maximum amount sold to any one investor in a 12-month period">
    <variable id="decision_maximum_amount_sold_to_any_one_investor_in_a_12_month_period_var" name="maximum amount sold to any one investor in a 12_month period" typeRef="number"/>
    <literalExpression id="decision_maximum_amount_sold_to_any_one_investor_in_a_12_month_period_literal">
      <text>124000</text>
    </literalExpression>
  </decision>
  <decision id="decision_tier_1_ceiling" name="tier 1 ceiling">
    <variable id="decision_tier_1_ceiling_var" name="tier 1 ceiling" typeRef="number"/>
    <literalExpression id="decision_tier_1_ceiling_literal">
      <text>124000</text>
    </literalExpression>
  </decision>
  <decision id="decision_tier_2_ceiling" name="tier 2 ceiling">
    <variable id="decision_tier_2_ceiling_var" name="tier 2 ceiling" typeRef="number"/>
    <literalExpression id="decision_tier_2_ceiling_literal">
      <text>618000</text>
    </literalExpression>
  </decision>
  <decision id="decision_first_time_issuer_review_ceiling" name="first-time issuer review ceiling">
    <variable id="decision_first_time_issuer_review_ceiling_var" name="first_time issuer review ceiling" typeRef="number"/>
    <literalExpression id="decision_first_time_issuer_review_ceiling_literal">
      <text>1235000</text>
    </literalExpression>
  </decision>
  <decision id="decision_holders_of_record_threshold" name="holders of record threshold">
    <variable id="decision_holders_of_record_threshold_var" name="holders of record threshold" typeRef="number"/>
    <literalExpression id="decision_holders_of_record_threshold_literal">
      <text>300</text>
    </literalExpression>
  </decision>
  <decision id="decision_total_assets_threshold" name="total assets threshold">
    <variable id="decision_total_assets_threshold_var" name="total assets threshold" typeRef="number"/>
    <literalExpression id="decision_total_assets_threshold_literal">
      <text>10000000</text>
    </literalExpression>
  </decision>
  <decision id="decision_minimum_days_publicly_available_before_any_sale" name="minimum days publicly available before any sale">
    <variable id="decision_minimum_days_publicly_available_before_any_sale_var" name="minimum days publicly available before any sale" typeRef="number"/>
    <literalExpression id="decision_minimum_days_publicly_available_before_any_sale_literal">
      <text>21</text>
    </literalExpression>
  </decision>
  <decision id="decision_days_to_file_the_annual_report_after_fiscal_year_end" name="days to file the annual report after fiscal year end">
    <variable id="decision_days_to_file_the_annual_report_after_fiscal_year_end_var" name="days to file the annual report after fiscal year end" typeRef="number"/>
    <literalExpression id="decision_days_to_file_the_annual_report_after_fiscal_year_end_literal">
      <text>120</text>
    </literalExpression>
  </decision>
  <decision id="decision_business_days_to_file_form_c_tr" name="business days to file Form C-TR">
    <variable id="decision_business_days_to_file_form_c_tr_var" name="business days to file Form C_TR" typeRef="number"/>
    <literalExpression id="decision_business_days_to_file_form_c_tr_literal">
      <text>5</text>
    </literalExpression>
  </decision>
  <decision id="decision_business_days_to_file_a_progress_update" name="business days to file a progress update">
    <variable id="decision_business_days_to_file_a_progress_update_var" name="business days to file a progress update" typeRef="number"/>
    <literalExpression id="decision_business_days_to_file_a_progress_update_literal">
      <text>5</text>
    </literalExpression>
  </decision>
  <decision id="decision_days_in_the_resale_restricted_period" name="days in the resale restricted period">
    <variable id="decision_days_in_the_resale_restricted_period_var" name="days in the resale restricted period" typeRef="number"/>
    <literalExpression id="decision_days_in_the_resale_restricted_period_literal">
      <text>365</text>
    </literalExpression>
  </decision>
  <decision id="decision_b_1_not_organized_under_state_or_territorial_law" name="(b)(1) — not organized under State or territorial law">
    <variable id="decision_b_1_not_organized_under_state_or_territorial_law_var" name="_b__1_ _ not organized under State or territorial law" typeRef="boolean"/>
    <informationRequirement id="decision_b_1_not_organized_under_state_or_territorial_law_ir1">
      <requiredInput href="#input_issuer"/>
    </informationRequirement>
    <literalExpression id="decision_b_1_not_organized_under_state_or_territorial_law_literal">
      <text>true and not(issuer.is organized under_ and subject to_ the laws of a State or territory of the United States or the District of Columbia)</text>
    </literalExpression>
  </decision>
  <decision id="decision_b_2_an_exchange_act_reporting_company" name="(b)(2) — an Exchange Act reporting company">
    <variable id="decision_b_2_an_exchange_act_reporting_company_var" name="_b__2_ _ an Exchange Act reporting company" typeRef="boolean"/>
    <informationRequirement id="decision_b_2_an_exchange_act_reporting_company_ir1">
      <requiredInput href="#input_issuer_2"/>
    </informationRequirement>
    <literalExpression id="decision_b_2_an_exchange_act_reporting_company_literal">
      <text>true and issuer.is subject to the requirement to file reports pursuant to section 13 or section 15_d_ of the Exchange Act</text>
    </literalExpression>
  </decision>
  <decision id="decision_b_3_an_investment_company" name="(b)(3) — an investment company">
    <variable id="decision_b_3_an_investment_company_var" name="_b__3_ _ an investment company" typeRef="boolean"/>
    <informationRequirement id="decision_b_3_an_investment_company_ir1">
      <requiredInput href="#input_issuer_3"/>
    </informationRequirement>
    <literalExpression id="decision_b_3_an_investment_company_literal">
      <text>true and issuer.is an investment company_ or is excluded from the definition of investment company by section 3_b_ or section 3_c_</text>
    </literalExpression>
  </decision>
  <decision id="decision_b_4_subject_to_a_bad_actor_disqualification" name="(b)(4) — subject to a bad-actor disqualification">
    <variable id="decision_b_4_subject_to_a_bad_actor_disqualification_var" name="_b__4_ _ subject to a bad_actor disqualification" typeRef="boolean"/>
    <informationRequirement id="decision_b_4_subject_to_a_bad_actor_disqualification_ir1">
      <requiredInput href="#input_issuer_4"/>
    </informationRequirement>
    <literalExpression id="decision_b_4_subject_to_a_bad_actor_disqualification_literal">
      <text>true and issuer.is subject to a disqualification as specified in section 227.503_a_</text>
    </literalExpression>
  </decision>
  <decision id="decision_b_5_delinquent_in_ongoing_annual_reports" name="(b)(5) — delinquent in ongoing annual reports">
    <variable id="decision_b_5_delinquent_in_ongoing_annual_reports_var" name="_b__5_ _ delinquent in ongoing annual reports" typeRef="boolean"/>
    <informationRequirement id="decision_b_5_delinquent_in_ongoing_annual_reports_ir1">
      <requiredInput href="#input_issuer_5"/>
    </informationRequirement>
    <literalExpression id="decision_b_5_delinquent_in_ongoing_annual_reports_literal">
      <text>true and issuer.has sold securities in reliance on section 4_a__6_ and has not filed the ongoing annual reports required during the two years immediately preceding the filing of the offering statement</text>
    </literalExpression>
  </decision>
  <decision id="decision_b_6_no_specific_business_plan_or_a_blank_check_business_plan" name="(b)(6) — no specific business plan, or a blank-check business plan">
    <variable id="decision_b_6_no_specific_business_plan_or_a_blank_check_business_plan_var" name="_b__6_ _ no specific business plan_ or a blank_check business plan" typeRef="boolean"/>
    <informationRequirement id="decision_b_6_no_specific_business_plan_or_a_blank_check_business_plan_ir1">
      <requiredInput href="#input_issuer_6"/>
    </informationRequirement>
    <literalExpression id="decision_b_6_no_specific_business_plan_or_a_blank_check_business_plan_literal">
      <text>true and issuer.has no specific business plan_ or has indicated that its business plan is to engage in a merger or acquisition with an unidentified company or companies</text>
    </literalExpression>
  </decision>
  <decision id="decision_issuer_is_excluded_by_rule_100_b" name="issuer is excluded by Rule 100(b)">
    <variable id="decision_issuer_is_excluded_by_rule_100_b_var" name="issuer is excluded by Rule 100_b_" typeRef="boolean"/>
    <informationRequirement id="decision_issuer_is_excluded_by_rule_100_b_ir1">
      <requiredDecision href="#decision_b_1_not_organized_under_state_or_territorial_law"/>
    </informationRequirement>
    <informationRequirement id="decision_issuer_is_excluded_by_rule_100_b_ir2">
      <requiredDecision href="#decision_b_2_an_exchange_act_reporting_company"/>
    </informationRequirement>
    <informationRequirement id="decision_issuer_is_excluded_by_rule_100_b_ir3">
      <requiredDecision href="#decision_b_3_an_investment_company"/>
    </informationRequirement>
    <informationRequirement id="decision_issuer_is_excluded_by_rule_100_b_ir4">
      <requiredDecision href="#decision_b_4_subject_to_a_bad_actor_disqualification"/>
    </informationRequirement>
    <informationRequirement id="decision_issuer_is_excluded_by_rule_100_b_ir5">
      <requiredDecision href="#decision_b_5_delinquent_in_ongoing_annual_reports"/>
    </informationRequirement>
    <informationRequirement id="decision_issuer_is_excluded_by_rule_100_b_ir6">
      <requiredDecision href="#decision_b_6_no_specific_business_plan_or_a_blank_check_business_plan"/>
    </informationRequirement>
    <informationRequirement id="decision_issuer_is_excluded_by_rule_100_b_ir7">
      <requiredInput href="#input_issuer_7"/>
    </informationRequirement>
    <literalExpression id="decision_issuer_is_excluded_by_rule_100_b_literal">
      <text>... "(b) Applicability. The crowdfunding exemption shall not apply to transactions involving the offer or sale of securities by any issuer that:" OR `(b)(1) — not organized under State or territorial law` OF issuer OR `(b)(2) — an Exchange Act reporting company` OF issuer OR `(b)(3) — an investment company` OF issuer OR `(b)(4) — subject to a bad-actor disqualification` OF issuer OR `(b)(5) — delinquent in ongoing annual reports` OF issuer OR `(b)(6) — no specific business plan, or a blank-check business plan` OF issuer</text>
    </literalExpression>
  </decision>
  <decision id="decision_issuer_is_eligible" name="issuer is eligible">
    <variable id="decision_issuer_is_eligible_var" name="issuer is eligible" typeRef="boolean"/>
    <informationRequirement id="decision_issuer_is_eligible_ir1">
      <requiredDecision href="#decision_issuer_is_excluded_by_rule_100_b"/>
    </informationRequirement>
    <informationRequirement id="decision_issuer_is_eligible_ir2">
      <requiredInput href="#input_issuer_8"/>
    </informationRequirement>
    <literalExpression id="decision_issuer_is_eligible_literal">
      <text>NOT `issuer is excluded by Rule 100(b)` OF issuer</text>
    </literalExpression>
  </decision>
  <decision id="decision_aggregate_offering_amount" name="aggregate offering amount">
    <variable id="decision_aggregate_offering_amount_var" name="aggregate offering amount" typeRef="number"/>
    <informationRequirement id="decision_aggregate_offering_amount_ir1">
      <requiredInput href="#input_offering"/>
    </informationRequirement>
    <literalExpression id="decision_aggregate_offering_amount_literal">
      <text>offering.aggregate amount sold in reliance on section 4_a__6_ during the preceding 12 months + offering.maximum offering amount the issuer will accept</text>
    </literalExpression>
  </decision>
  <decision id="decision_offering_is_within_the_offering_limit" name="offering is within the offering limit">
    <variable id="decision_offering_is_within_the_offering_limit_var" name="offering is within the offering limit" typeRef="boolean"/>
    <informationRequirement id="decision_offering_is_within_the_offering_limit_ir1">
      <requiredDecision href="#decision_aggregate_offering_amount"/>
    </informationRequirement>
    <informationRequirement id="decision_offering_is_within_the_offering_limit_ir2">
      <requiredDecision href="#decision_offering_maximum_in_a_12_month_period"/>
    </informationRequirement>
    <informationRequirement id="decision_offering_is_within_the_offering_limit_ir3">
      <requiredInput href="#input_offering_2"/>
    </informationRequirement>
    <literalExpression id="decision_offering_is_within_the_offering_limit_literal">
      <text>... "(1) The aggregate amount of securities sold to all investors by the issuer in reliance on section 4(a)(6) of the Securities Act during the 12-month period preceding the date of such offer or sale, including the securities offered in such transaction, shall not exceed $5,000,000;" AND (`aggregate offering amount` OF offering) AT MOST `offering maximum in a 12-month period`</text>
    </literalExpression>
  </decision>
  <decision id="decision_greater_of_annual_income_or_net_worth" name="greater of annual income or net worth">
    <variable id="decision_greater_of_annual_income_or_net_worth_var" name="greater of annual income or net worth" typeRef="number"/>
    <informationRequirement id="decision_greater_of_annual_income_or_net_worth_ir1">
      <requiredInput href="#input_investor"/>
    </informationRequirement>
    <literalExpression id="decision_greater_of_annual_income_or_net_worth_literal">
      <text>max(investor.annual income, investor.net worth)</text>
    </literalExpression>
  </decision>
  <decision id="decision_either_annual_income_or_net_worth_is_less_than_the_cut_point" name="either annual income or net worth is less than the cut point">
    <variable id="decision_either_annual_income_or_net_worth_is_less_than_the_cut_point_var" name="either annual income or net worth is less than the cut point" typeRef="boolean"/>
    <informationRequirement id="decision_either_annual_income_or_net_worth_is_less_than_the_cut_point_ir1">
      <requiredDecision href="#decision_income_or_net_worth_cut_point"/>
    </informationRequirement>
    <informationRequirement id="decision_either_annual_income_or_net_worth_is_less_than_the_cut_point_ir2">
      <requiredInput href="#input_investor_2"/>
    </informationRequirement>
    <literalExpression id="decision_either_annual_income_or_net_worth_is_less_than_the_cut_point_literal">
      <text>investor.annual income &lt; income or net worth cut point or investor.net worth &lt; income or net worth cut point</text>
    </literalExpression>
  </decision>
  <decision id="decision_investment_limit" name="investment limit">
    <variable id="decision_investment_limit_var" name="investment limit" typeRef="number"/>
    <informationRequirement id="decision_investment_limit_ir1">
      <requiredDecision href="#decision_either_annual_income_or_net_worth_is_less_than_the_cut_point"/>
    </informationRequirement>
    <informationRequirement id="decision_investment_limit_ir2">
      <requiredDecision href="#decision_greater_of_annual_income_or_net_worth"/>
    </informationRequirement>
    <informationRequirement id="decision_investment_limit_ir3">
      <requiredDecision href="#decision_maximum_amount_sold_to_any_one_investor_in_a_12_month_period"/>
    </informationRequirement>
    <informationRequirement id="decision_investment_limit_ir4">
      <requiredDecision href="#decision_minimum_permitted_investment"/>
    </informationRequirement>
    <informationRequirement id="decision_investment_limit_ir5">
      <requiredInput href="#input_investor_3"/>
    </informationRequirement>
    <decisionTable id="decision_investment_limit_table" hitPolicy="UNIQUE" preferredOrientation="Rule-as-Row" outputLabel="investment limit">
      <input id="decision_investment_limit_i1" label="`either annual income or net worth is less than the cut point` OF investor">
        <inputExpression id="decision_investment_limit_i1_expr" typeRef="boolean">
          <text>`either annual income or net worth is less than the cut point` OF investor</text>
        </inputExpression>
      </input>
      <output id="decision_investment_limit_o1" name="investment limit" typeRef="number">
        <defaultOutputEntry id="decision_investment_limit_o1_default">
          <text>IF ((0.1 TIMES (`greater of annual income or net worth` OF investor)) AT MOST `maximum amount sold to any one investor in a 12-month period`) THEN (0.1 TIMES (`greater of annual income or net worth` OF investor)) ELSE `maximum amount sold to any one investor in a 12-month period`</text>
        </defaultOutputEntry>
      </output>
      <rule id="decision_investment_limit_r1">
        <description>`either annual income or net worth is less than the cut point` OF investor</description>
        <inputEntry id="decision_investment_limit_r1_i1">
          <text>true</text>
        </inputEntry>
        <outputEntry id="decision_investment_limit_r1_o1">
          <text>IF (`minimum permitted investment` AT LEAST (0.05 TIMES (`greater of annual income or net worth` OF investor))) THEN `minimum permitted investment` ELSE (0.05 TIMES (`greater of annual income or net worth` OF investor))</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="decision_aggregate_amount_sold_to_this_investor_including_this_transaction" name="aggregate amount sold to this investor including this transaction">
    <variable id="decision_aggregate_amount_sold_to_this_investor_including_this_transaction_var" name="aggregate amount sold to this investor including this transaction" typeRef="number"/>
    <informationRequirement id="decision_aggregate_amount_sold_to_this_investor_including_this_transaction_ir1">
      <requiredInput href="#input_amount_to_be_sold_in_this_transaction"/>
    </informationRequirement>
    <informationRequirement id="decision_aggregate_amount_sold_to_this_investor_including_this_transaction_ir2">
      <requiredInput href="#input_investor_4"/>
    </informationRequirement>
    <literalExpression id="decision_aggregate_amount_sold_to_this_investor_including_this_transaction_literal">
      <text>investor.aggregate amount already sold to this investor across all issuers in reliance on section 4_a__6_ during the preceding 12 months + amount to be sold in this transaction</text>
    </literalExpression>
  </decision>
  <decision id="decision_investor_is_within_the_investment_limit" name="investor is within the investment limit">
    <variable id="decision_investor_is_within_the_investment_limit_var" name="investor is within the investment limit" typeRef="boolean"/>
    <informationRequirement id="decision_investor_is_within_the_investment_limit_ir1">
      <requiredDecision href="#decision_aggregate_amount_sold_to_this_investor_including_this_transaction"/>
    </informationRequirement>
    <informationRequirement id="decision_investor_is_within_the_investment_limit_ir2">
      <requiredDecision href="#decision_investment_limit"/>
    </informationRequirement>
    <informationRequirement id="decision_investor_is_within_the_investment_limit_ir3">
      <requiredInput href="#input_amount_to_be_sold_in_this_transaction_2"/>
    </informationRequirement>
    <informationRequirement id="decision_investor_is_within_the_investment_limit_ir4">
      <requiredInput href="#input_investor_5"/>
    </informationRequirement>
    <literalExpression id="decision_investor_is_within_the_investment_limit_literal">
      <text>... "(2) Where the purchaser is not an accredited investor (as defined in Rule 501), the aggregate amount of securities sold to such an investor across all issuers in reliance on section 4(a)(6) of the Securities Act during the 12-month period preceding the date of such transaction, including the securities sold to such investor in such transaction, shall not exceed:" OR investor's `is an accredited investor as defined in Rule 501` OR (`aggregate amount sold to this investor including this transaction` OF investor, `amount to be sold in this transaction`) AT MOST (`investment limit` OF investor)</text>
    </literalExpression>
  </decision>
  <decision id="decision_financial_statements_required" name="financial statements required">
    <variable id="decision_financial_statements_required_var" name="financial statements required" typeRef="string"/>
    <informationRequirement id="decision_financial_statements_required_ir1">
      <requiredDecision href="#decision_aggregate_offering_amount"/>
    </informationRequirement>
    <informationRequirement id="decision_financial_statements_required_ir2">
      <requiredDecision href="#decision_first_time_issuer_review_ceiling"/>
    </informationRequirement>
    <informationRequirement id="decision_financial_statements_required_ir3">
      <requiredDecision href="#decision_tier_1_ceiling"/>
    </informationRequirement>
    <informationRequirement id="decision_financial_statements_required_ir4">
      <requiredDecision href="#decision_tier_2_ceiling"/>
    </informationRequirement>
    <informationRequirement id="decision_financial_statements_required_ir5">
      <requiredInput href="#input_offering_3"/>
    </informationRequirement>
    <decisionTable id="decision_financial_statements_required_table" hitPolicy="FIRST" preferredOrientation="Rule-as-Row" outputLabel="financial statements required">
      <input id="decision_financial_statements_required_i1" label="(`aggregate offering amount` OF offering) AT MOST `tier 1 ceiling`">
        <inputExpression id="decision_financial_statements_required_i1_expr" typeRef="boolean">
          <text>(`aggregate offering amount` OF offering) AT MOST `tier 1 ceiling`</text>
        </inputExpression>
      </input>
      <input id="decision_financial_statements_required_i2" label="(`aggregate offering amount` OF offering) AT MOST `tier 2 ceiling`">
        <inputExpression id="decision_financial_statements_required_i2_expr" typeRef="boolean">
          <text>(`aggregate offering amount` OF offering) AT MOST `tier 2 ceiling`</text>
        </inputExpression>
      </input>
      <input id="decision_financial_statements_required_i3" label="offering&apos;s `the issuer has previously sold securities in reliance on section 4(a)(6)`">
        <inputExpression id="decision_financial_statements_required_i3_expr" typeRef="boolean">
          <text>offering.the issuer has previously sold securities in reliance on section 4_a__6_</text>
        </inputExpression>
      </input>
      <input id="decision_financial_statements_required_i4" label="(`aggregate offering amount` OF offering) AT MOST `first-time issuer review ceiling`">
        <inputExpression id="decision_financial_statements_required_i4_expr" typeRef="boolean">
          <text>(`aggregate offering amount` OF offering) AT MOST `first-time issuer review ceiling`</text>
        </inputExpression>
      </input>
      <output id="decision_financial_statements_required_o1" name="financial statements required" typeRef="string"/>
      <rule id="decision_financial_statements_required_r1">
        <description>(`aggregate offering amount` OF offering) AT MOST `tier 1 ceiling`</description>
        <inputEntry id="decision_financial_statements_required_r1_i1">
          <text>true</text>
        </inputEntry>
        <inputEntry id="decision_financial_statements_required_r1_i2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="decision_financial_statements_required_r1_i3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="decision_financial_statements_required_r1_i4">
          <text>-</text>
        </inputEntry>
        <outputEntry id="decision_financial_statements_required_r1_o1">
          <text>"financial statements certified by the principal executive officer, with tax return information"</text>
        </outputEntry>
      </rule>
      <rule id="decision_financial_statements_required_r2">
        <description>(`aggregate offering amount` OF offering) AT MOST `tier 2 ceiling`</description>
        <inputEntry id="decision_financial_statements_required_r2_i1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="decision_financial_statements_required_r2_i2">
          <text>true</text>
        </inputEntry>
        <inputEntry id="decision_financial_statements_required_r2_i3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="decision_financial_statements_required_r2_i4">
          <text>-</text>
        </inputEntry>
        <outputEntry id="decision_financial_statements_required_r2_o1">
          <text>"financial statements reviewed by an independent public accountant"</text>
        </outputEntry>
      </rule>
      <rule id="decision_financial_statements_required_r3">
        <description>NOT offering's `the issuer has previously sold securities in reliance on section 4(a)(6)` AND (`aggregate offering amount` OF offering) AT MOST `first-time issuer review ceiling`</description>
        <inputEntry id="decision_financial_statements_required_r3_i1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="decision_financial_statements_required_r3_i2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="decision_financial_statements_required_r3_i3">
          <text>false</text>
        </inputEntry>
        <inputEntry id="decision_financial_statements_required_r3_i4">
          <text>true</text>
        </inputEntry>
        <outputEntry id="decision_financial_statements_required_r3_o1">
          <text>"financial statements reviewed by an independent public accountant"</text>
        </outputEntry>
      </rule>
      <rule id="decision_financial_statements_required_r4">
        <description>OTHERWISE</description>
        <inputEntry id="decision_financial_statements_required_r4_i1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="decision_financial_statements_required_r4_i2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="decision_financial_statements_required_r4_i3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="decision_financial_statements_required_r4_i4">
          <text>-</text>
        </inputEntry>
        <outputEntry id="decision_financial_statements_required_r4_o1">
          <text>"financial statements audited by an independent public accountant"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="decision_assurance_level" name="assurance level">
    <variable id="decision_assurance_level_var" name="assurance level" typeRef="number"/>
    <informationRequirement id="decision_assurance_level_ir1">
      <requiredInput href="#input_required"/>
    </informationRequirement>
    <decisionTable id="decision_assurance_level_table" hitPolicy="UNIQUE" preferredOrientation="Rule-as-Row" outputLabel="assurance level">
      <input id="decision_assurance_level_i1" label="required">
        <inputExpression id="decision_assurance_level_i1_expr" typeRef="string">
          <text>required</text>
        </inputExpression>
      </input>
      <output id="decision_assurance_level_o1" name="assurance level" typeRef="number"/>
      <rule id="decision_assurance_level_r1">
        <description>required EQUALS `financial statements certified by the principal executive officer, with tax return information`</description>
        <inputEntry id="decision_assurance_level_r1_i1">
          <text>"financial statements certified by the principal executive officer, with tax return information"</text>
        </inputEntry>
        <outputEntry id="decision_assurance_level_r1_o1">
          <text>1</text>
        </outputEntry>
      </rule>
      <rule id="decision_assurance_level_r2">
        <description>required EQUALS `financial statements reviewed by an independent public accountant`</description>
        <inputEntry id="decision_assurance_level_r2_i1">
          <text>"financial statements reviewed by an independent public accountant"</text>
        </inputEntry>
        <outputEntry id="decision_assurance_level_r2_o1">
          <text>2</text>
        </outputEntry>
      </rule>
      <rule id="decision_assurance_level_r3">
        <description>required EQUALS `financial statements audited by an independent public accountant`</description>
        <inputEntry id="decision_assurance_level_r3_i1">
          <text>"financial statements audited by an independent public accountant"</text>
        </inputEntry>
        <outputEntry id="decision_assurance_level_r3_o1">
          <text>3</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="decision_financial_statement_requirement_is_satisfied" name="financial statement requirement is satisfied">
    <variable id="decision_financial_statement_requirement_is_satisfied_var" name="financial statement requirement is satisfied" typeRef="boolean"/>
    <informationRequirement id="decision_financial_statement_requirement_is_satisfied_ir1">
      <requiredDecision href="#decision_assurance_level"/>
    </informationRequirement>
    <informationRequirement id="decision_financial_statement_requirement_is_satisfied_ir2">
      <requiredDecision href="#decision_financial_statements_required"/>
    </informationRequirement>
    <informationRequirement id="decision_financial_statement_requirement_is_satisfied_ir3">
      <requiredInput href="#input_offering_4"/>
    </informationRequirement>
    <informationRequirement id="decision_financial_statement_requirement_is_satisfied_ir4">
      <requiredInput href="#input_supplied"/>
    </informationRequirement>
    <literalExpression id="decision_financial_statement_requirement_is_satisfied_literal">
      <text>(`assurance level` OF supplied) AT LEAST (`assurance level` OF (`financial statements required` OF offering))</text>
    </literalExpression>
  </decision>
  <decision id="decision_disclosure_requirements_are_met" name="disclosure requirements are met">
    <variable id="decision_disclosure_requirements_are_met_var" name="disclosure requirements are met" typeRef="boolean"/>
    <informationRequirement id="decision_disclosure_requirements_are_met_ir1">
      <requiredDecision href="#decision_financial_statement_requirement_is_satisfied"/>
    </informationRequirement>
    <informationRequirement id="decision_disclosure_requirements_are_met_ir2">
      <requiredInput href="#input_filing"/>
    </informationRequirement>
    <informationRequirement id="decision_disclosure_requirements_are_met_ir3">
      <requiredInput href="#input_offering_5"/>
    </informationRequirement>
    <literalExpression id="decision_disclosure_requirements_are_met_literal">
      <text>... "(1) Offering statement. ... an issuer offering or selling securities in reliance on section 4(a)(6) of the Securities Act ... must file with the Commission and provide to investors and the relevant intermediary a Form C: Offering Statement prior to the commencement of the offering of securities. ... Every Form C must include the information required by section 227.201." AND filing's `a Form C offering statement was filed with the Commission and provided to investors and the relevant intermediary prior to the commencement of the offering` AND filing's `the Form C includes the information required by section 227.201` AND `financial statement requirement is satisfied` OF offering, (filing's `the financial statements supplied`)</text>
    </literalExpression>
  </decision>
  <decision id="decision_a_3_conducted_through_a_single_complying_intermediary" name="(a)(3) — conducted through a single complying intermediary">
    <variable id="decision_a_3_conducted_through_a_single_complying_intermediary_var" name="_a__3_ _ conducted through a single complying intermediary" typeRef="boolean"/>
    <informationRequirement id="decision_a_3_conducted_through_a_single_complying_intermediary_ir1">
      <requiredInput href="#input_arrangement"/>
    </informationRequirement>
    <literalExpression id="decision_a_3_conducted_through_a_single_complying_intermediary_literal">
      <text>true and (arrangement.the intermediary complies with section 4A_a_ of the Securities Act and the related requirements in this part and (arrangement.the transaction is conducted exclusively through the intermediary_s platform and (true and arrangement.the number of intermediaries used for the offering = 1)))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_21_day_public_availability_period_has_run" name="the 21-day public availability period has run">
    <variable id="decision_the_21_day_public_availability_period_has_run_var" name="the 21_day public availability period has run" typeRef="boolean"/>
    <informationRequirement id="decision_the_21_day_public_availability_period_has_run_ir1">
      <requiredDecision href="#decision_minimum_days_publicly_available_before_any_sale"/>
    </informationRequirement>
    <informationRequirement id="decision_the_21_day_public_availability_period_has_run_ir2">
      <requiredInput href="#input_arrangement_2"/>
    </informationRequirement>
    <literalExpression id="decision_the_21_day_public_availability_period_has_run_literal">
      <text>true and arrangement.the days the issuer information has been publicly available on the intermediary_s platform before any sale &gt;= minimum days publicly available before any sale</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_intermediary_has_discharged_its_investor_facing_duties" name="the intermediary has discharged its investor-facing duties">
    <variable id="decision_the_intermediary_has_discharged_its_investor_facing_duties_var" name="the intermediary has discharged its investor_facing duties" typeRef="boolean"/>
    <informationRequirement id="decision_the_intermediary_has_discharged_its_investor_facing_duties_ir1">
      <requiredInput href="#input_arrangement_3"/>
    </informationRequirement>
    <literalExpression id="decision_the_intermediary_has_discharged_its_investor_facing_duties_literal">
      <text>true and (arrangement.the intermediary delivered educational materials in connection with establishing the investor_s account and (true and arrangement.the intermediary has a reasonable basis for believing that the investor satisfies the investment limitations))</text>
    </literalExpression>
  </decision>
  <decision id="decision_intermediary_obligations_are_met" name="intermediary obligations are met">
    <variable id="decision_intermediary_obligations_are_met_var" name="intermediary obligations are met" typeRef="boolean"/>
    <informationRequirement id="decision_intermediary_obligations_are_met_ir1">
      <requiredDecision href="#decision_a_3_conducted_through_a_single_complying_intermediary"/>
    </informationRequirement>
    <informationRequirement id="decision_intermediary_obligations_are_met_ir2">
      <requiredDecision href="#decision_the_21_day_public_availability_period_has_run"/>
    </informationRequirement>
    <informationRequirement id="decision_intermediary_obligations_are_met_ir3">
      <requiredDecision href="#decision_the_intermediary_has_discharged_its_investor_facing_duties"/>
    </informationRequirement>
    <informationRequirement id="decision_intermediary_obligations_are_met_ir4">
      <requiredInput href="#input_arrangement_4"/>
    </informationRequirement>
    <literalExpression id="decision_intermediary_obligations_are_met_literal">
      <text>`(a)(3) — conducted through a single complying intermediary` OF arrangement AND `the 21-day public availability period has run` OF arrangement AND `the intermediary has discharged its investor-facing duties` OF arrangement</text>
    </literalExpression>
  </decision>
  <decision id="decision_notice_complies_with_rule_204_b" name="notice complies with Rule 204(b)">
    <variable id="decision_notice_complies_with_rule_204_b_var" name="notice complies with Rule 204_b_" typeRef="boolean"/>
    <informationRequirement id="decision_notice_complies_with_rule_204_b_ir1">
      <requiredInput href="#input_notice"/>
    </informationRequirement>
    <literalExpression id="decision_notice_complies_with_rule_204_b_literal">
      <text>true and (notice.directs investors to the intermediary_s platform and (true and (true and (true and not(notice.includes information beyond that permitted by paragraph _b_)))))</text>
    </literalExpression>
  </decision>
  <decision id="decision_definition_terms_of_the_offering" name="definition — terms of the offering">
    <variable id="decision_definition_terms_of_the_offering_var" name="definition _ terms of the offering" typeRef="boolean"/>
    <literalExpression id="decision_definition_terms_of_the_offering_literal">
      <text>true and true</text>
    </literalExpression>
  </decision>
  <decision id="decision_advertising_restriction" name="advertising restriction">
    <variable id="decision_advertising_restriction_var" name="advertising restriction" typeRef="Any"/>
    <informationRequirement id="decision_advertising_restriction_ir1">
      <requiredDecision href="#decision_days_in_the_resale_restricted_period"/>
    </informationRequirement>
    <informationRequirement id="decision_advertising_restriction_ir2">
      <requiredDecision href="#decision_notice_complies_with_rule_204_b"/>
    </informationRequirement>
    <informationRequirement id="decision_advertising_restriction_ir3">
      <requiredInput href="#input_notice_2"/>
    </informationRequirement>
    <literalExpression id="decision_advertising_restriction_literal">
      <text>IF (`notice complies with Rule 204(b)` OF notice) THEN FULFILLED ELSE (PARTY Issuer MUST NOT `advertise the terms of the offering` WITHIN `days in the resale restricted period`)</text>
    </literalExpression>
  </decision>
  <decision id="decision_b_1_became_an_exchange_act_reporting_company" name="(b)(1) — became an Exchange Act reporting company">
    <variable id="decision_b_1_became_an_exchange_act_reporting_company_var" name="_b__1_ _ became an Exchange Act reporting company" typeRef="boolean"/>
    <informationRequirement id="decision_b_1_became_an_exchange_act_reporting_company_ir1">
      <requiredInput href="#input_status"/>
    </informationRequirement>
    <literalExpression id="decision_b_1_became_an_exchange_act_reporting_company_literal">
      <text>true and status.the issuer is required to file reports under section 13_a_ or section 15_d_ of the Exchange Act</text>
    </literalExpression>
  </decision>
  <decision id="decision_b_2_one_annual_report_filed_and_fewer_than_300_holders_of_record" name="(b)(2) — one annual report filed and fewer than 300 holders of record">
    <variable id="decision_b_2_one_annual_report_filed_and_fewer_than_300_holders_of_record_var" name="_b__2_ _ one annual report filed and fewer than 300 holders of record" typeRef="boolean"/>
    <informationRequirement id="decision_b_2_one_annual_report_filed_and_fewer_than_300_holders_of_record_ir1">
      <requiredDecision href="#decision_holders_of_record_threshold"/>
    </informationRequirement>
    <informationRequirement id="decision_b_2_one_annual_report_filed_and_fewer_than_300_holders_of_record_ir2">
      <requiredInput href="#input_status_2"/>
    </informationRequirement>
    <literalExpression id="decision_b_2_one_annual_report_filed_and_fewer_than_300_holders_of_record_literal">
      <text>true and (status.annual reports filed since the most recent sale of securities pursuant to this part &gt;= 1 and status.holders of record &lt; holders of record threshold)</text>
    </literalExpression>
  </decision>
  <decision id="decision_b_3_three_annual_reports_filed_and_total_assets_not_exceeding_10_000_000" name="(b)(3) — three annual reports filed and total assets not exceeding $10,000,000">
    <variable id="decision_b_3_three_annual_reports_filed_and_total_assets_not_exceeding_10_000_000_var" name="_b__3_ _ three annual reports filed and total assets not exceeding _10_000_000" typeRef="boolean"/>
    <informationRequirement id="decision_b_3_three_annual_reports_filed_and_total_assets_not_exceeding_10_000_000_ir1">
      <requiredDecision href="#decision_total_assets_threshold"/>
    </informationRequirement>
    <informationRequirement id="decision_b_3_three_annual_reports_filed_and_total_assets_not_exceeding_10_000_000_ir2">
      <requiredInput href="#input_status_3"/>
    </informationRequirement>
    <literalExpression id="decision_b_3_three_annual_reports_filed_and_total_assets_not_exceeding_10_000_000_literal">
      <text>true and (status.annual reports filed since the most recent sale of securities pursuant to this part &gt;= 3 and status.total assets &lt;= total assets threshold)</text>
    </literalExpression>
  </decision>
  <decision id="decision_b_4_all_securities_repurchased" name="(b)(4) — all securities repurchased">
    <variable id="decision_b_4_all_securities_repurchased_var" name="_b__4_ _ all securities repurchased" typeRef="boolean"/>
    <informationRequirement id="decision_b_4_all_securities_repurchased_ir1">
      <requiredInput href="#input_status_4"/>
    </informationRequirement>
    <literalExpression id="decision_b_4_all_securities_repurchased_literal">
      <text>true and status.the issuer or another party has repurchased all of the securities issued in reliance on section 4_a__6_</text>
    </literalExpression>
  </decision>
  <decision id="decision_b_5_liquidated_or_dissolved" name="(b)(5) — liquidated or dissolved">
    <variable id="decision_b_5_liquidated_or_dissolved_var" name="_b__5_ _ liquidated or dissolved" typeRef="boolean"/>
    <informationRequirement id="decision_b_5_liquidated_or_dissolved_ir1">
      <requiredInput href="#input_status_5"/>
    </informationRequirement>
    <literalExpression id="decision_b_5_liquidated_or_dissolved_literal">
      <text>true and status.the issuer has liquidated or dissolved its business in accordance with state law</text>
    </literalExpression>
  </decision>
  <decision id="decision_ongoing_reporting_obligation_may_terminate" name="ongoing reporting obligation may terminate">
    <variable id="decision_ongoing_reporting_obligation_may_terminate_var" name="ongoing reporting obligation may terminate" typeRef="boolean"/>
    <informationRequirement id="decision_ongoing_reporting_obligation_may_terminate_ir1">
      <requiredDecision href="#decision_b_1_became_an_exchange_act_reporting_company"/>
    </informationRequirement>
    <informationRequirement id="decision_ongoing_reporting_obligation_may_terminate_ir2">
      <requiredDecision href="#decision_b_2_one_annual_report_filed_and_fewer_than_300_holders_of_record"/>
    </informationRequirement>
    <informationRequirement id="decision_ongoing_reporting_obligation_may_terminate_ir3">
      <requiredDecision href="#decision_b_3_three_annual_reports_filed_and_total_assets_not_exceeding_10_000_000"/>
    </informationRequirement>
    <informationRequirement id="decision_ongoing_reporting_obligation_may_terminate_ir4">
      <requiredDecision href="#decision_b_4_all_securities_repurchased"/>
    </informationRequirement>
    <informationRequirement id="decision_ongoing_reporting_obligation_may_terminate_ir5">
      <requiredDecision href="#decision_b_5_liquidated_or_dissolved"/>
    </informationRequirement>
    <informationRequirement id="decision_ongoing_reporting_obligation_may_terminate_ir6">
      <requiredInput href="#input_status_6"/>
    </informationRequirement>
    <literalExpression id="decision_ongoing_reporting_obligation_may_terminate_literal">
      <text>... "(b) An issuer must continue to comply with the ongoing reporting requirements until one of the following occurs:" OR `(b)(1) — became an Exchange Act reporting company` OF status OR `(b)(2) — one annual report filed and fewer than 300 holders of record` OF status OR `(b)(3) — three annual reports filed and total assets not exceeding $10,000,000` OF status OR `(b)(4) — all securities repurchased` OF status OR `(b)(5) — liquidated or dissolved` OF status</text>
    </literalExpression>
  </decision>
  <decision id="decision_ongoing_reporting_obligation" name="ongoing reporting obligation">
    <variable id="decision_ongoing_reporting_obligation_var" name="ongoing reporting obligation" typeRef="Any"/>
    <informationRequirement id="decision_ongoing_reporting_obligation_ir1">
      <requiredDecision href="#decision_business_days_to_file_form_c_tr"/>
    </informationRequirement>
    <informationRequirement id="decision_ongoing_reporting_obligation_ir2">
      <requiredDecision href="#decision_days_to_file_the_annual_report_after_fiscal_year_end"/>
    </informationRequirement>
    <informationRequirement id="decision_ongoing_reporting_obligation_ir3">
      <requiredDecision href="#decision_ongoing_reporting_obligation_may_terminate"/>
    </informationRequirement>
    <informationRequirement id="decision_ongoing_reporting_obligation_ir4">
      <requiredInput href="#input_annual_cycles"/>
    </informationRequirement>
    <informationRequirement id="decision_ongoing_reporting_obligation_ir5">
      <requiredInput href="#input_status_7"/>
    </informationRequirement>
    <literalExpression id="decision_ongoing_reporting_obligation_literal">
      <text>IF (`ongoing reporting obligation may terminate` OF status) THEN (PARTY Issuer MUST `file a Form C-TR termination of reporting` WITHIN `business days to file Form C-TR`) ELSE (IF (`annual cycles` AT MOST 0) THEN FULFILLED ELSE (PARTY Issuer MUST `file a Form C-AR annual report` WITHIN `days to file the annual report after fiscal year end` HENCE `ongoing reporting obligation` OF status, (`annual cycles` MINUS 1)))</text>
    </literalExpression>
  </decision>
  <decision id="decision_transfer_is_within_the_one_year_restricted_period" name="transfer is within the one-year restricted period">
    <variable id="decision_transfer_is_within_the_one_year_restricted_period_var" name="transfer is within the one_year restricted period" typeRef="boolean"/>
    <informationRequirement id="decision_transfer_is_within_the_one_year_restricted_period_ir1">
      <requiredDecision href="#decision_days_in_the_resale_restricted_period"/>
    </informationRequirement>
    <informationRequirement id="decision_transfer_is_within_the_one_year_restricted_period_ir2">
      <requiredInput href="#input_transfer"/>
    </informationRequirement>
    <literalExpression id="decision_transfer_is_within_the_one_year_restricted_period_literal">
      <text>true and transfer.days since the securities were issued &lt; days in the resale restricted period</text>
    </literalExpression>
  </decision>
  <decision id="decision_transfer_falls_within_an_exception_in_rule_501_a" name="transfer falls within an exception in Rule 501(a)">
    <variable id="decision_transfer_falls_within_an_exception_in_rule_501_a_var" name="transfer falls within an exception in Rule 501_a_" typeRef="boolean"/>
    <informationRequirement id="decision_transfer_falls_within_an_exception_in_rule_501_a_ir1">
      <requiredInput href="#input_transfer_2"/>
    </informationRequirement>
    <literalExpression id="decision_transfer_falls_within_an_exception_in_rule_501_a_literal">
      <text>false or (false or (transfer.is to the issuer of the securities or (false or (transfer.is to an accredited investor or (false or (transfer.is as part of an offering registered with the Commission or (false or transfer.is to a member of the family of the purchaser or the equivalent_ to a trust controlled by the purchaser_ to a trust created for the benefit of a member of the family of the purchaser or the equivalent_ or in connection with the death or divorce of the purchaser or other similar circumstance)))))))</text>
    </literalExpression>
  </decision>
  <decision id="decision_transfer_is_permitted" name="transfer is permitted">
    <variable id="decision_transfer_is_permitted_var" name="transfer is permitted" typeRef="boolean"/>
    <informationRequirement id="decision_transfer_is_permitted_ir1">
      <requiredDecision href="#decision_transfer_falls_within_an_exception_in_rule_501_a"/>
    </informationRequirement>
    <informationRequirement id="decision_transfer_is_permitted_ir2">
