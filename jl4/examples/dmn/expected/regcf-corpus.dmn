  <decision id="decision_ongoing_reporting_obligation_may_terminate" name="ongoing_reporting_obligation_may_terminate" label="ongoing reporting obligation may terminate">
    <variable id="decision_ongoing_reporting_obligation_may_terminate_var" name="ongoing_reporting_obligation_may_terminate" label="ongoing reporting obligation may terminate" typeRef="boolean"/>
    <informationRequirement id="decision_ongoing_reporting_obligation_may_terminate_ir1">
      <requiredDecision href="#decision_b_1_became_an_exchange_act_reporting_company"/>
    </informationRequirement>
    <informationRequirement id="decision_ongoing_reporting_obligation_may_terminate_ir2">
      <requiredDecision href="#decision_b_2_one_annual_report_filed_and_fewer_than_300_holders_of_record"/>
    </informationRequirement>
    <informationRequirement id="decision_ongoing_reporting_obligation_may_terminate_ir3">
      <requiredDecision href="#decision_b_3_three_annual_reports_filed_and_total_assets_not_exceeding_10_000_000"/>
    </informationRequirement>
    <informationRequirement id="decision_ongoing_reporting_obligation_may_terminate_ir4">
      <requiredDecision href="#decision_b_4_all_securities_repurchased"/>
    </informationRequirement>
    <informationRequirement id="decision_ongoing_reporting_obligation_may_terminate_ir5">
      <requiredDecision href="#decision_b_5_liquidated_or_dissolved"/>
    </informationRequirement>
    <informationRequirement id="decision_ongoing_reporting_obligation_may_terminate_ir6">
      <requiredInput href="#input_status"/>
    </informationRequirement>
    <literalExpression id="decision_ongoing_reporting_obligation_may_terminate_literal">
      <text>false or (b_1_became_an_Exchange_Act_reporting_company or (b_2_one_annual_report_filed_and_fewer_than_300_holders_of_record or (b_3_three_annual_reports_filed_and_total_assets_not_exceeding_10_000_000 or (b_4_all_securities_repurchased or b_5_liquidated_or_dissolved))))</text>
    </literalExpression>
  </decision>
  <decision id="decision_ongoing_reporting_obligation" name="ongoing_reporting_obligation" label="ongoing reporting obligation">
    <variable id="decision_ongoing_reporting_obligation_var" name="ongoing_reporting_obligation" label="ongoing reporting obligation" typeRef="string"/>
    <informationRequirement id="decision_ongoing_reporting_obligation_ir1">
      <requiredDecision href="#decision_ongoing_reporting_obligation_may_terminate"/>
    </informationRequirement>
    <informationRequirement id="decision_ongoing_reporting_obligation_ir2">
      <requiredInput href="#input_annual_cycles"/>
    </informationRequirement>
    <decisionTable id="decision_ongoing_reporting_obligation_table" hitPolicy="FIRST" preferredOrientation="Rule-as-Row" outputLabel="ongoing reporting obligation">
      <input id="decision_ongoing_reporting_obligation_i1" label="`ongoing reporting obligation may terminate` OF status">
        <inputExpression id="decision_ongoing_reporting_obligation_i1_expr" typeRef="boolean">
          <text>ongoing_reporting_obligation_may_terminate</text>
        </inputExpression>
      </input>
      <input id="decision_ongoing_reporting_obligation_i2" label="`annual cycles`">
        <inputExpression id="decision_ongoing_reporting_obligation_i2_expr" typeRef="number">
          <text>annual_cycles</text>
        </inputExpression>
      </input>
      <output id="decision_ongoing_reporting_obligation_o1">
        <outputValues>
          <text>"file a Form C-TR termination of reporting","fulfilled","file a Form C-AR annual report and continue"</text>
        </outputValues>
      </output>
      <rule id="decision_ongoing_reporting_obligation_r1">
        <description>`ongoing reporting obligation may terminate` OF status</description>
        <inputEntry id="decision_ongoing_reporting_obligation_r1_i1">
          <text>true</text>
        </inputEntry>
        <inputEntry id="decision_ongoing_reporting_obligation_r1_i2">
          <text>-</text>
        </inputEntry>
        <outputEntry id="decision_ongoing_reporting_obligation_r1_o1">
          <text>"file a Form C-TR termination of reporting"</text>
        </outputEntry>
      </rule>
      <rule id="decision_ongoing_reporting_obligation_r2">
        <description>`annual cycles` AT MOST 0</description>
        <inputEntry id="decision_ongoing_reporting_obligation_r2_i1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="decision_ongoing_reporting_obligation_r2_i2">
          <text>&lt;= 0</text>
        </inputEntry>
        <outputEntry id="decision_ongoing_reporting_obligation_r2_o1">
          <text>"fulfilled"</text>
        </outputEntry>
      </rule>
      <rule id="decision_ongoing_reporting_obligation_r3">
        <description>OTHERWISE</description>
        <inputEntry id="decision_ongoing_reporting_obligation_r3_i1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="decision_ongoing_reporting_obligation_r3_i2">
          <text>-</text>
        </inputEntry>
        <outputEntry id="decision_ongoing_reporting_obligation_r3_o1">
          <text>"file a Form C-AR annual report and continue"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="decision_transfer_is_within_the_one_year_restricted_period" name="transfer_is_within_the_one_year_restricted_period" label="transfer is within the one-year restricted period">
    <variable id="decision_transfer_is_within_the_one_year_restricted_period_var" name="transfer_is_within_the_one_year_restricted_period" label="transfer is within the one-year restricted period" typeRef="boolean"/>
