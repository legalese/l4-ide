    <informationRequirement id="decision_the_transaction_qualifies_for_the_section_4_a_6_exemption_ir11">
      <requiredInput href="#input_offering_6"/>
    </informationRequirement>
    <literalExpression id="decision_the_transaction_qualifies_for_the_section_4_a_6_exemption_literal">
      <text>... "(a) Exemption. An issuer may offer or sell securities in reliance on section 4(a)(6) of the Securities Act of 1933, provided that:" AND `issuer is eligible` OF issuer AND `offering is within the offering limit` OF offering AND `investor is within the investment limit` OF investor, amount AND `intermediary obligations are met` OF arrangement AND `disclosure requirements are met` OF filing, offering</text>
    </literalExpression>
  </decision>
  <decision id="decision_a_clean_issuer" name="a clean issuer">
    <variable id="decision_a_clean_issuer_var" name="a clean issuer" typeRef="Any"/>
    <literalExpression id="decision_a_clean_issuer_literal">
      <text>IssuerProfile WITH name IS "Clean Co" `is organized under, and subject to, the laws of a State or territory of the United States or the District of Columbia` IS TRUE `is subject to the requirement to file reports pursuant to section 13 or section 15(d) of the Exchange Act` IS FALSE `is an investment company, or is excluded from the definition of investment company by section 3(b) or section 3(c)` IS FALSE `is subject to a disqualification as specified in section 227.503(a)` IS FALSE `has sold securities in reliance on section 4(a)(6) and has not filed the ongoing annual reports required during the two years immediately preceding the filing of the offering statement` IS FALSE `has no specific business plan, or has indicated that its business plan is to engage in a merger or acquisition with an unidentified company or companies` IS FALSE</text>
    </literalExpression>
  </decision>
  <decision id="decision_a_foreign_issuer" name="a foreign issuer">
    <variable id="decision_a_foreign_issuer_var" name="a foreign issuer" typeRef="Any"/>
    <literalExpression id="decision_a_foreign_issuer_literal">
      <text>IssuerProfile WITH name IS "Ausland GmbH" `is organized under, and subject to, the laws of a State or territory of the United States or the District of Columbia` IS FALSE `is subject to the requirement to file reports pursuant to section 13 or section 15(d) of the Exchange Act` IS FALSE `is an investment company, or is excluded from the definition of investment company by section 3(b) or section 3(c)` IS FALSE `is subject to a disqualification as specified in section 227.503(a)` IS FALSE `has sold securities in reliance on section 4(a)(6) and has not filed the ongoing annual reports required during the two years immediately preceding the filing of the offering statement` IS FALSE `has no specific business plan, or has indicated that its business plan is to engage in a merger or acquisition with an unidentified company or companies` IS FALSE</text>
    </literalExpression>
  </decision>
  <decision id="decision_a_delinquent_issuer" name="a delinquent issuer">
    <variable id="decision_a_delinquent_issuer_var" name="a delinquent issuer" typeRef="Any"/>
    <literalExpression id="decision_a_delinquent_issuer_literal">
      <text>IssuerProfile WITH name IS "Late Filer Inc" `is organized under, and subject to, the laws of a State or territory of the United States or the District of Columbia` IS TRUE `is subject to the requirement to file reports pursuant to section 13 or section 15(d) of the Exchange Act` IS FALSE `is an investment company, or is excluded from the definition of investment company by section 3(b) or section 3(c)` IS FALSE `is subject to a disqualification as specified in section 227.503(a)` IS FALSE `has sold securities in reliance on section 4(a)(6) and has not filed the ongoing annual reports required during the two years immediately preceding the filing of the offering statement` IS TRUE `has no specific business plan, or has indicated that its business plan is to engage in a merger or acquisition with an unidentified company or companies` IS FALSE</text>
    </literalExpression>
  </decision>
  <decision id="decision_a_blank_check_issuer" name="a blank-check issuer">
    <variable id="decision_a_blank_check_issuer_var" name="a blank_check issuer" typeRef="Any"/>
    <literalExpression id="decision_a_blank_check_issuer_literal">
      <text>IssuerProfile WITH name IS "SPAC-ish LLC" `is organized under, and subject to, the laws of a State or territory of the United States or the District of Columbia` IS TRUE `is subject to the requirement to file reports pursuant to section 13 or section 15(d) of the Exchange Act` IS FALSE `is an investment company, or is excluded from the definition of investment company by section 3(b) or section 3(c)` IS FALSE `is subject to a disqualification as specified in section 227.503(a)` IS FALSE `has sold securities in reliance on section 4(a)(6) and has not filed the ongoing annual reports required during the two years immediately preceding the filing of the offering statement` IS FALSE `has no specific business plan, or has indicated that its business plan is to engage in a merger or acquisition with an unidentified company or companies` IS TRUE</text>
    </literalExpression>
  </decision>
  <decision id="decision_an_offering_of" name="an offering of">
    <variable id="decision_an_offering_of_var" name="an offering of" typeRef="Any"/>
    <informationRequirement id="decision_an_offering_of_ir1">
      <requiredInput href="#input_maximum"/>
    </informationRequirement>
    <informationRequirement id="decision_an_offering_of_ir2">
