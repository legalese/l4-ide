    <informationRequirement id="decision_an_offering_of_ir3">
      <requiredInput href="#input_prior_sales"/>
    </informationRequirement>
    <literalExpression id="decision_an_offering_of_literal">
      <text>Offering WITH `target offering amount` IS maximum `maximum offering amount the issuer will accept` IS maximum `aggregate amount sold in reliance on section 4(a)(6) during the preceding 12 months` IS `prior sales` `the issuer has previously sold securities in reliance on section 4(a)(6)` IS `previously sold`</text>
    </literalExpression>
  </decision>
  <decision id="decision_an_investor_with" name="an investor with">
    <variable id="decision_an_investor_with_var" name="an investor with" typeRef="Any"/>
    <informationRequirement id="decision_an_investor_with_ir1">
      <requiredInput href="#input_accredited"/>
