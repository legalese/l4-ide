    <literalExpression id="decision_b_5_liquidated_or_dissolved_literal">
      <text>true and status_5.the_issuer_has_liquidated_or_dissolved_its_business_in_accordance_with_state_law</text>
    </literalExpression>
  </decision>
  <decision id="decision_ongoing_reporting_obligation_may_terminate" name="ongoing_reporting_obligation_may_terminate" label="ongoing reporting obligation may terminate">
    <variable id="decision_ongoing_reporting_obligation_may_terminate_var" name="ongoing_reporting_obligation_may_terminate" label="ongoing reporting obligation may terminate" typeRef="boolean"/>
    <informationRequirement id="decision_ongoing_reporting_obligation_may_terminate_ir1">
      <requiredDecision href="#decision_b_1_became_an_exchange_act_reporting_company"/>
    </informationRequirement>
    <informationRequirement id="decision_ongoing_reporting_obligation_may_terminate_ir2">
      <requiredDecision href="#decision_b_2_one_annual_report_filed_and_fewer_than_300_holders_of_record"/>
    </informationRequirement>
    <informationRequirement id="decision_ongoing_reporting_obligation_may_terminate_ir3">
      <requiredDecision href="#decision_b_3_three_annual_reports_filed_and_total_assets_not_exceeding_10_000_000"/>
    </informationRequirement>
    <informationRequirement id="decision_ongoing_reporting_obligation_may_terminate_ir4">
      <requiredDecision href="#decision_b_4_all_securities_repurchased"/>
    </informationRequirement>
    <informationRequirement id="decision_ongoing_reporting_obligation_may_terminate_ir5">
      <requiredDecision href="#decision_b_5_liquidated_or_dissolved"/>
    </informationRequirement>
    <informationRequirement id="decision_ongoing_reporting_obligation_may_terminate_ir6">
      <requiredInput href="#input_status_6"/>
    </informationRequirement>
    <literalExpression id="decision_ongoing_reporting_obligation_may_terminate_literal">
      <text>... "(b) An issuer must continue to comply with the ongoing reporting requirements until one of the following occurs:" OR `(b)(1) — became an Exchange Act reporting company` OF status OR `(b)(2) — one annual report filed and fewer than 300 holders of record` OF status OR `(b)(3) — three annual reports filed and total assets not exceeding $10,000,000` OF status OR `(b)(4) — all securities repurchased` OF status OR `(b)(5) — liquidated or dissolved` OF status</text>
    </literalExpression>
  </decision>
  <decision id="decision_ongoing_reporting_obligation" name="ongoing_reporting_obligation" label="ongoing reporting obligation">
    <variable id="decision_ongoing_reporting_obligation_var" name="ongoing_reporting_obligation" label="ongoing reporting obligation" typeRef="Any"/>
    <informationRequirement id="decision_ongoing_reporting_obligation_ir1">
      <requiredDecision href="#decision_business_days_to_file_form_c_tr"/>
    </informationRequirement>
    <informationRequirement id="decision_ongoing_reporting_obligation_ir2">
      <requiredDecision href="#decision_days_to_file_the_annual_report_after_fiscal_year_end"/>
    </informationRequirement>
    <informationRequirement id="decision_ongoing_reporting_obligation_ir3">
      <requiredDecision href="#decision_ongoing_reporting_obligation_may_terminate"/>
    </informationRequirement>
    <informationRequirement id="decision_ongoing_reporting_obligation_ir4">
      <requiredInput href="#input_annual_cycles"/>
    </informationRequirement>
    <informationRequirement id="decision_ongoing_reporting_obligation_ir5">
      <requiredInput href="#input_status_7"/>
    </informationRequirement>
    <literalExpression id="decision_ongoing_reporting_obligation_literal">
      <text>IF (`ongoing reporting obligation may terminate` OF status) THEN (PARTY Issuer MUST `file a Form C-TR termination of reporting` WITHIN `business days to file Form C-TR`) ELSE (IF (`annual cycles` AT MOST 0) THEN FULFILLED ELSE (PARTY Issuer MUST `file a Form C-AR annual report` WITHIN `days to file the annual report after fiscal year end` HENCE `ongoing reporting obligation` OF status, (`annual cycles` MINUS 1)))</text>
    </literalExpression>
  </decision>
  <decision id="decision_transfer_is_within_the_one_year_restricted_period" name="transfer_is_within_the_one_year_restricted_period" label="transfer is within the one-year restricted period">
    <variable id="decision_transfer_is_within_the_one_year_restricted_period_var" name="transfer_is_within_the_one_year_restricted_period" label="transfer is within the one-year restricted period" typeRef="boolean"/>
    <informationRequirement id="decision_transfer_is_within_the_one_year_restricted_period_ir1">
      <requiredDecision href="#decision_days_in_the_resale_restricted_period"/>
    </informationRequirement>
    <informationRequirement id="decision_transfer_is_within_the_one_year_restricted_period_ir2">
      <requiredInput href="#input_transfer"/>
    </informationRequirement>
    <literalExpression id="decision_transfer_is_within_the_one_year_restricted_period_literal">
      <text>true and transfer.days_since_the_securities_were_issued &lt; days_in_the_resale_restricted_period</text>
    </literalExpression>
  </decision>
  <decision id="decision_transfer_falls_within_an_exception_in_rule_501_a" name="transfer_falls_within_an_exception_in_Rule_501_a" label="transfer falls within an exception in Rule 501(a)">
    <variable id="decision_transfer_falls_within_an_exception_in_rule_501_a_var" name="transfer_falls_within_an_exception_in_Rule_501_a" label="transfer falls within an exception in Rule 501(a)" typeRef="boolean"/>
    <informationRequirement id="decision_transfer_falls_within_an_exception_in_rule_501_a_ir1">
      <requiredInput href="#input_transfer_2"/>
    </informationRequirement>
    <literalExpression id="decision_transfer_falls_within_an_exception_in_rule_501_a_literal">
      <text>false or (false or (transfer_2.is_to_the_issuer_of_the_securities or (false or (transfer_2.is_to_an_accredited_investor or (false or (transfer_2.is_as_part_of_an_offering_registered_with_the_Commission or (false or transfer_2.is_to_a_member_of_the_family_of_the_purchaser_or_the_equivalent_to_a_trust_controlled_by_the_purchaser_to_a_trust_created_for_the_benefit_of_a_member_of_the_family_of_the_purchaser_or_the_equivalent_or_in_connection_with_the_death_or_divorce_of_the_purchaser_or_other_similar_circumstance)))))))</text>
    </literalExpression>
  </decision>
  <decision id="decision_transfer_is_permitted" name="transfer_is_permitted" label="transfer is permitted">
    <variable id="decision_transfer_is_permitted_var" name="transfer_is_permitted" label="transfer is permitted" typeRef="boolean"/>
    <informationRequirement id="decision_transfer_is_permitted_ir1">
      <requiredDecision href="#decision_transfer_falls_within_an_exception_in_rule_501_a"/>
    </informationRequirement>
    <informationRequirement id="decision_transfer_is_permitted_ir2">
      <requiredDecision href="#decision_transfer_is_within_the_one_year_restricted_period"/>
    </informationRequirement>
    <informationRequirement id="decision_transfer_is_permitted_ir3">
      <requiredInput href="#input_transfer_3"/>
    </informationRequirement>
    <literalExpression id="decision_transfer_is_permitted_literal">
      <text>NOT `transfer is within the one-year restricted period` OF transfer OR `transfer falls within an exception in Rule 501(a)` OF transfer</text>
    </literalExpression>
  </decision>
  <decision id="decision_resale_restriction" name="resale_restriction" label="resale restriction">
    <variable id="decision_resale_restriction_var" name="resale_restriction" label="resale restriction" typeRef="Any"/>
    <informationRequirement id="decision_resale_restriction_ir1">
      <requiredDecision href="#decision_days_in_the_resale_restricted_period"/>
    </informationRequirement>
    <informationRequirement id="decision_resale_restriction_ir2">
      <requiredDecision href="#decision_transfer_falls_within_an_exception_in_rule_501_a"/>
    </informationRequirement>
    <informationRequirement id="decision_resale_restriction_ir3">
      <requiredInput href="#input_transfer_4"/>
    </informationRequirement>
    <literalExpression id="decision_resale_restriction_literal">
      <text>IF (`transfer falls within an exception in Rule 501(a)` OF transfer) THEN FULFILLED ELSE (PARTY Purchaser MUST NOT `transfer the securities` WITHIN `days in the resale restricted period`)</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_transaction_qualifies_for_the_section_4_a_6_exemption" name="the_transaction_qualifies_for_the_section_4_a_6_exemption" label="the transaction qualifies for the section 4(a)(6) exemption">
    <variable id="decision_the_transaction_qualifies_for_the_section_4_a_6_exemption_var" name="the_transaction_qualifies_for_the_section_4_a_6_exemption" label="the transaction qualifies for the section 4(a)(6) exemption" typeRef="boolean"/>
    <informationRequirement id="decision_the_transaction_qualifies_for_the_section_4_a_6_exemption_ir1">
      <requiredDecision href="#decision_disclosure_requirements_are_met"/>
    </informationRequirement>
    <informationRequirement id="decision_the_transaction_qualifies_for_the_section_4_a_6_exemption_ir2">
      <requiredDecision href="#decision_intermediary_obligations_are_met"/>
    </informationRequirement>
    <informationRequirement id="decision_the_transaction_qualifies_for_the_section_4_a_6_exemption_ir3">
      <requiredDecision href="#decision_investor_is_within_the_investment_limit"/>
    </informationRequirement>
    <informationRequirement id="decision_the_transaction_qualifies_for_the_section_4_a_6_exemption_ir4">
      <requiredDecision href="#decision_issuer_is_eligible"/>
    </informationRequirement>
    <informationRequirement id="decision_the_transaction_qualifies_for_the_section_4_a_6_exemption_ir5">
      <requiredDecision href="#decision_offering_is_within_the_offering_limit"/>
    </informationRequirement>
    <informationRequirement id="decision_the_transaction_qualifies_for_the_section_4_a_6_exemption_ir6">
      <requiredInput href="#input_amount"/>
    </informationRequirement>
    <informationRequirement id="decision_the_transaction_qualifies_for_the_section_4_a_6_exemption_ir7">
      <requiredInput href="#input_arrangement_5"/>
    </informationRequirement>
    <informationRequirement id="decision_the_transaction_qualifies_for_the_section_4_a_6_exemption_ir8">
      <requiredInput href="#input_filing_2"/>
    </informationRequirement>
    <informationRequirement id="decision_the_transaction_qualifies_for_the_section_4_a_6_exemption_ir9">
      <requiredInput href="#input_investor_9"/>
    </informationRequirement>
    <informationRequirement id="decision_the_transaction_qualifies_for_the_section_4_a_6_exemption_ir10">
      <requiredInput href="#input_issuer_9"/>
    </informationRequirement>
    <informationRequirement id="decision_the_transaction_qualifies_for_the_section_4_a_6_exemption_ir11">
      <requiredInput href="#input_offering_6"/>
    </informationRequirement>
    <literalExpression id="decision_the_transaction_qualifies_for_the_section_4_a_6_exemption_literal">
      <text>... "(a) Exemption. An issuer may offer or sell securities in reliance on section 4(a)(6) of the Securities Act of 1933, provided that:" AND `issuer is eligible` OF issuer AND `offering is within the offering limit` OF offering AND `investor is within the investment limit` OF investor, amount AND `intermediary obligations are met` OF arrangement AND `disclosure requirements are met` OF filing, offering</text>
    </literalExpression>
  </decision>
  <decision id="decision_a_clean_issuer" name="a_clean_issuer" label="a clean issuer">
    <variable id="decision_a_clean_issuer_var" name="a_clean_issuer" label="a clean issuer" typeRef="IssuerProfile"/>
    <literalExpression id="decision_a_clean_issuer_literal">
      <text>IssuerProfile WITH name IS "Clean Co" `is organized under, and subject to, the laws of a State or territory of the United States or the District of Columbia` IS TRUE `is subject to the requirement to file reports pursuant to section 13 or section 15(d) of the Exchange Act` IS FALSE `is an investment company, or is excluded from the definition of investment company by section 3(b) or section 3(c)` IS FALSE `is subject to a disqualification as specified in section 227.503(a)` IS FALSE `has sold securities in reliance on section 4(a)(6) and has not filed the ongoing annual reports required during the two years immediately preceding the filing of the offering statement` IS FALSE `has no specific business plan, or has indicated that its business plan is to engage in a merger or acquisition with an unidentified company or companies` IS FALSE</text>
    </literalExpression>
  </decision>
  <decision id="decision_a_foreign_issuer" name="a_foreign_issuer" label="a foreign issuer">
    <variable id="decision_a_foreign_issuer_var" name="a_foreign_issuer" label="a foreign issuer" typeRef="IssuerProfile"/>
    <literalExpression id="decision_a_foreign_issuer_literal">
      <text>IssuerProfile WITH name IS "Ausland GmbH" `is organized under, and subject to, the laws of a State or territory of the United States or the District of Columbia` IS FALSE `is subject to the requirement to file reports pursuant to section 13 or section 15(d) of the Exchange Act` IS FALSE `is an investment company, or is excluded from the definition of investment company by section 3(b) or section 3(c)` IS FALSE `is subject to a disqualification as specified in section 227.503(a)` IS FALSE `has sold securities in reliance on section 4(a)(6) and has not filed the ongoing annual reports required during the two years immediately preceding the filing of the offering statement` IS FALSE `has no specific business plan, or has indicated that its business plan is to engage in a merger or acquisition with an unidentified company or companies` IS FALSE</text>
    </literalExpression>
  </decision>
  <decision id="decision_a_delinquent_issuer" name="a_delinquent_issuer" label="a delinquent issuer">
    <variable id="decision_a_delinquent_issuer_var" name="a_delinquent_issuer" label="a delinquent issuer" typeRef="IssuerProfile"/>
    <literalExpression id="decision_a_delinquent_issuer_literal">
      <text>IssuerProfile WITH name IS "Late Filer Inc" `is organized under, and subject to, the laws of a State or territory of the United States or the District of Columbia` IS TRUE `is subject to the requirement to file reports pursuant to section 13 or section 15(d) of the Exchange Act` IS FALSE `is an investment company, or is excluded from the definition of investment company by section 3(b) or section 3(c)` IS FALSE `is subject to a disqualification as specified in section 227.503(a)` IS FALSE `has sold securities in reliance on section 4(a)(6) and has not filed the ongoing annual reports required during the two years immediately preceding the filing of the offering statement` IS TRUE `has no specific business plan, or has indicated that its business plan is to engage in a merger or acquisition with an unidentified company or companies` IS FALSE</text>
    </literalExpression>
  </decision>
  <decision id="decision_a_blank_check_issuer" name="a_blank_check_issuer" label="a blank-check issuer">
    <variable id="decision_a_blank_check_issuer_var" name="a_blank_check_issuer" label="a blank-check issuer" typeRef="IssuerProfile"/>
    <literalExpression id="decision_a_blank_check_issuer_literal">
      <text>IssuerProfile WITH name IS "SPAC-ish LLC" `is organized under, and subject to, the laws of a State or territory of the United States or the District of Columbia` IS TRUE `is subject to the requirement to file reports pursuant to section 13 or section 15(d) of the Exchange Act` IS FALSE `is an investment company, or is excluded from the definition of investment company by section 3(b) or section 3(c)` IS FALSE `is subject to a disqualification as specified in section 227.503(a)` IS FALSE `has sold securities in reliance on section 4(a)(6) and has not filed the ongoing annual reports required during the two years immediately preceding the filing of the offering statement` IS FALSE `has no specific business plan, or has indicated that its business plan is to engage in a merger or acquisition with an unidentified company or companies` IS TRUE</text>
    </literalExpression>
  </decision>
  <decision id="decision_an_offering_of" name="an_offering_of" label="an offering of">
    <variable id="decision_an_offering_of_var" name="an_offering_of" label="an offering of" typeRef="Offering"/>
    <informationRequirement id="decision_an_offering_of_ir1">
      <requiredInput href="#input_maximum"/>
    </informationRequirement>
    <informationRequirement id="decision_an_offering_of_ir2">
      <requiredInput href="#input_previously_sold"/>
    </informationRequirement>
    <informationRequirement id="decision_an_offering_of_ir3">
      <requiredInput href="#input_prior_sales"/>
    </informationRequirement>
    <literalExpression id="decision_an_offering_of_literal">
      <text>Offering WITH `target offering amount` IS maximum `maximum offering amount the issuer will accept` IS maximum `aggregate amount sold in reliance on section 4(a)(6) during the preceding 12 months` IS `prior sales` `the issuer has previously sold securities in reliance on section 4(a)(6)` IS `previously sold`</text>
    </literalExpression>
  </decision>
  <decision id="decision_an_investor_with" name="an_investor_with" label="an investor with">
    <variable id="decision_an_investor_with_var" name="an_investor_with" label="an investor with" typeRef="InvestorProfile"/>
    <informationRequirement id="decision_an_investor_with_ir1">
      <requiredInput href="#input_accredited"/>
    </informationRequirement>
    <informationRequirement id="decision_an_investor_with_ir2">
      <requiredInput href="#input_already"/>
    </informationRequirement>
    <informationRequirement id="decision_an_investor_with_ir3">
      <requiredInput href="#input_income"/>
    </informationRequirement>
    <informationRequirement id="decision_an_investor_with_ir4">
      <requiredInput href="#input_worth"/>
    </informationRequirement>
    <literalExpression id="decision_an_investor_with_literal">
      <text>InvestorProfile WITH name IS "Test Investor" `is an accredited investor as defined in Rule 501` IS accredited `annual income` IS income `net worth` IS worth `aggregate amount already sold to this investor across all issuers in reliance on section 4(a)(6) during the preceding 12 months` IS already</text>
    </literalExpression>
  </decision>
  <decision id="decision_an_arrangement_with" name="an_arrangement_with" label="an arrangement with">
    <variable id="decision_an_arrangement_with_var" name="an_arrangement_with" label="an arrangement with" typeRef="IntermediaryArrangement"/>
    <informationRequirement id="decision_an_arrangement_with_ir1">
      <requiredInput href="#input_days_available"/>
    </informationRequirement>
    <informationRequirement id="decision_an_arrangement_with_ir2">
      <requiredInput href="#input_intermediaries"/>
    </informationRequirement>
    <literalExpression id="decision_an_arrangement_with_literal">
      <text>IntermediaryArrangement WITH `the intermediary complies with section 4A(a) of the Securities Act and the related requirements in this part` IS TRUE `the transaction is conducted exclusively through the intermediary's platform` IS TRUE `the number of intermediaries used for the offering` IS intermediaries `the intermediary delivered educational materials in connection with establishing the investor's account` IS TRUE `the intermediary has a reasonable basis for believing that the investor satisfies the investment limitations` IS TRUE `the days the issuer information has been publicly available on the intermediary's platform before any sale` IS `days available`</text>
    </literalExpression>
  </decision>
  <decision id="decision_a_reporting_status_with" name="a_reporting_status_with" label="a reporting status with">
    <variable id="decision_a_reporting_status_with_var" name="a_reporting_status_with" label="a reporting status with" typeRef="ReportingStatus"/>
    <informationRequirement id="decision_a_reporting_status_with_ir1">
      <requiredInput href="#input_annual_reports"/>
    </informationRequirement>
    <informationRequirement id="decision_a_reporting_status_with_ir2">
      <requiredInput href="#input_assets"/>
    </informationRequirement>
    <informationRequirement id="decision_a_reporting_status_with_ir3">
      <requiredInput href="#input_holders"/>
    </informationRequirement>
    <literalExpression id="decision_a_reporting_status_with_literal">
      <text>ReportingStatus WITH `the issuer is required to file reports under section 13(a) or section 15(d) of the Exchange Act` IS FALSE `annual reports filed since the most recent sale of securities pursuant to this part` IS `annual reports` `holders of record` IS holders `total assets` IS assets `the issuer or another party has repurchased all of the securities issued in reliance on section 4(a)(6)` IS FALSE `the issuer has liquidated or dissolved its business in accordance with state law` IS FALSE</text>
    </literalExpression>
  </decision>
  <decision id="decision_a_transfer_at" name="a_transfer_at" label="a transfer at">
    <variable id="decision_a_transfer_at_var" name="a_transfer_at" label="a transfer at" typeRef="Transfer"/>
    <informationRequirement id="decision_a_transfer_at_ir1">
      <requiredInput href="#input_days_since_issue"/>
    </informationRequirement>
    <informationRequirement id="decision_a_transfer_at_ir2">
      <requiredInput href="#input_to_accredited"/>
    </informationRequirement>
    <literalExpression id="decision_a_transfer_at_literal">
      <text>Transfer WITH `days since the securities were issued` IS `days since issue` `is to the issuer of the securities` IS FALSE `is to an accredited investor` IS `to accredited` `is as part of an offering registered with the Commission` IS FALSE `is to a member of the family of the purchaser or the equivalent, to a trust controlled by the purchaser, to a trust created for the benefit of a member of the family of the purchaser or the equivalent, or in connection with the death or divorce of the purchaser or other similar circumstance` IS FALSE</text>
    </literalExpression>
  </decision>
  <decision id="decision_certified" name="certified">
    <variable id="decision_certified_var" name="certified" typeRef="FinancialStatementRequirement"/>
    <literalExpression id="decision_certified_literal">
      <text>"financial statements certified by the principal executive officer, with tax return information"</text>
    </literalExpression>
  </decision>
  <decision id="decision_reviewed" name="reviewed">
    <variable id="decision_reviewed_var" name="reviewed" typeRef="FinancialStatementRequirement"/>
    <literalExpression id="decision_reviewed_literal">
      <text>"financial statements reviewed by an independent public accountant"</text>
    </literalExpression>
  </decision>
  <decision id="decision_audited" name="audited">
    <variable id="decision_audited_var" name="audited" typeRef="FinancialStatementRequirement"/>
    <literalExpression id="decision_audited_literal">
      <text>"financial statements audited by an independent public accountant"</text>
    </literalExpression>
  </decision>
  <decision id="decision_a_conforming_notice" name="a_conforming_notice" label="a conforming notice">
    <variable id="decision_a_conforming_notice_var" name="a_conforming_notice" label="a conforming notice" typeRef="AdvertisingNotice"/>
    <literalExpression id="decision_a_conforming_notice_literal">
      <text>AdvertisingNotice WITH `directs investors to the intermediary's platform` IS TRUE `states that the issuer is conducting an offering pursuant to section 4(a)(6), names the intermediary, and directs the potential investor to its platform` IS TRUE `states the terms of the offering` IS TRUE `states factual information about the legal identity and business location of the issuer` IS TRUE `includes information beyond that permitted by paragraph (b)` IS FALSE</text>
    </literalExpression>
  </decision>
  <decision id="decision_an_overreaching_notice" name="an_overreaching_notice" label="an overreaching notice">
    <variable id="decision_an_overreaching_notice_var" name="an_overreaching_notice" label="an overreaching notice" typeRef="AdvertisingNotice"/>
    <literalExpression id="decision_an_overreaching_notice_literal">
      <text>AdvertisingNotice WITH `directs investors to the intermediary's platform` IS TRUE `states that the issuer is conducting an offering pursuant to section 4(a)(6), names the intermediary, and directs the potential investor to its platform` IS TRUE `states the terms of the offering` IS TRUE `states factual information about the legal identity and business location of the issuer` IS TRUE `includes information beyond that permitted by paragraph (b)` IS TRUE</text>
    </literalExpression>
  </decision>
  <decision id="decision_a_notice_with_no_platform_link" name="a_notice_with_no_platform_link" label="a notice with no platform link">
    <variable id="decision_a_notice_with_no_platform_link_var" name="a_notice_with_no_platform_link" label="a notice with no platform link" typeRef="AdvertisingNotice"/>
    <literalExpression id="decision_a_notice_with_no_platform_link_literal">
      <text>AdvertisingNotice WITH `directs investors to the intermediary's platform` IS FALSE `states that the issuer is conducting an offering pursuant to section 4(a)(6), names the intermediary, and directs the potential investor to its platform` IS FALSE `states the terms of the offering` IS TRUE `states factual information about the legal identity and business location of the issuer` IS TRUE `includes information beyond that permitted by paragraph (b)` IS FALSE</text>
    </literalExpression>
  </decision>
  <decision id="decision_a_conforming_filing" name="a_conforming_filing" label="a conforming filing">
    <variable id="decision_a_conforming_filing_var" name="a_conforming_filing" label="a conforming filing" typeRef="FormCFiling"/>
    <informationRequirement id="decision_a_conforming_filing_ir1">
      <requiredDecision href="#decision_reviewed"/>
    </informationRequirement>
    <literalExpression id="decision_a_conforming_filing_literal">
      <text>FormCFiling WITH `a Form C offering statement was filed with the Commission and provided to investors and the relevant intermediary prior to the commencement of the offering` IS TRUE `the Form C includes the information required by section 227.201` IS TRUE `the financial statements supplied` IS reviewed</text>
    </literalExpression>
  </decision>
