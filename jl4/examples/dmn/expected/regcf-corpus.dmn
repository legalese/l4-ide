          <text>investor.an_accredited_investor_as_defined_in_Rule_501</text>
        </literalExpression>
      </contextEntry>
      <contextEntry id="hydration_investor_ce3">
        <variable id="hydration_investor_ce3_var" name="annual_income" label="annual income" typeRef="number"/>
        <literalExpression id="hydration_investor_ce3_lit">
          <text>investor.annual_income</text>
        </literalExpression>
      </contextEntry>
      <contextEntry id="hydration_investor_ce4">
        <variable id="hydration_investor_ce4_var" name="net_worth" label="net worth" typeRef="number"/>
        <literalExpression id="hydration_investor_ce4_lit">
          <text>investor.net_worth</text>
        </literalExpression>
      </contextEntry>
      <contextEntry id="hydration_investor_ce5">
        <variable id="hydration_investor_ce5_var" name="aggregate_amount_already_sold_to_this_investor_across_all_issuers_in_reliance_on_section_4_a_6_during_the_preceding_12_months" label="aggregate amount already sold to this investor across all issuers in reliance on section 4(a)(6) during the preceding 12 months" typeRef="number"/>
        <literalExpression id="hydration_investor_ce5_lit">
          <text>investor.aggregate_amount_already_sold_to_this_investor_across_all_issuers_in_reliance_on_section_4_a_6_during_the_preceding_12_months</text>
        </literalExpression>
      </contextEntry>
      <contextEntry id="hydration_investor_ce6">
        <variable id="hydration_investor_ce6_var" name="greater_of_annual_income_or_net_worth" label="greater of annual income or net worth" typeRef="number"/>
        <literalExpression id="hydration_investor_ce6_lit">
          <text>(if annual_income &gt;= net_worth then annual_income else net_worth)</text>
        </literalExpression>
      </contextEntry>
      <contextEntry id="hydration_investor_ce7">
        <variable id="hydration_investor_ce7_var" name="lesser_of_annual_income_or_net_worth" label="lesser of annual income or net worth" typeRef="number"/>
        <literalExpression id="hydration_investor_ce7_lit">
          <text>(if annual_income &lt;= net_worth then annual_income else net_worth)</text>
        </literalExpression>
      </contextEntry>
    </context>
  </decision>
  <businessKnowledgeModel id="bkm_the_rules_in_force_include" name="the_rules_in_force_include" label="the rules in force include">
    <variable id="bkm_the_rules_in_force_include_var" name="the_rules_in_force_include" label="the rules in force include" typeRef="boolean"/>
    <encapsulatedLogic id="bkm_the_rules_in_force_include_logic">
      <formalParameter id="bkm_the_rules_in_force_include_p1" name="amendment" typeRef="date"/>
      <formalParameter id="bkm_the_rules_in_force_include_p2" name="RULES_EFFECTIVE_DATE" typeRef="date"/>
      <literalExpression id="bkm_the_rules_in_force_include_literal">
        <text>RULES_EFFECTIVE_DATE &gt;= amendment</text>
      </literalExpression>
    </encapsulatedLogic>
  </businessKnowledgeModel>
  <businessKnowledgeModel id="bkm_offering_is_within_the_offering_limit" name="offering_is_within_the_offering_limit" label="offering is within the offering limit">
    <variable id="bkm_offering_is_within_the_offering_limit_var" name="offering_is_within_the_offering_limit" label="offering is within the offering limit" typeRef="boolean"/>
    <encapsulatedLogic id="bkm_offering_is_within_the_offering_limit_logic">
      <formalParameter id="bkm_offering_is_within_the_offering_limit_p1" name="offering" typeRef="Offering"/>
      <formalParameter id="bkm_offering_is_within_the_offering_limit_p2" name="aggregate_offering_amount" typeRef="number"/>
      <formalParameter id="bkm_offering_is_within_the_offering_limit_p3" name="offering_maximum_in_a_12_month_period" typeRef="number"/>
      <literalExpression id="bkm_offering_is_within_the_offering_limit_literal">
        <text>true and aggregate_offering_amount &lt;= offering_maximum_in_a_12_month_period</text>
      </literalExpression>
    </encapsulatedLogic>
  </businessKnowledgeModel>
  <businessKnowledgeModel id="bkm_investment_limit" name="investment_limit" label="investment limit">
    <variable id="bkm_investment_limit_var" name="investment_limit" label="investment limit" typeRef="number"/>
    <encapsulatedLogic id="bkm_investment_limit_logic">
      <formalParameter id="bkm_investment_limit_p1" name="investor" typeRef="InvestorProfile"/>
      <formalParameter id="bkm_investment_limit_p2" name="either_annual_income_or_net_worth_is_less_than_the_cut_point" typeRef="boolean"/>
      <formalParameter id="bkm_investment_limit_p3" name="maximum_amount_sold_to_any_one_investor_in_a_12_month_period" typeRef="number"/>
      <formalParameter id="bkm_investment_limit_p4" name="minimum_permitted_investment" typeRef="number"/>
      <formalParameter id="bkm_investment_limit_p5" name="the_applicable_measure_of_annual_income_or_net_worth" typeRef="number"/>
      <decisionTable id="bkm_investment_limit_table" hitPolicy="UNIQUE" preferredOrientation="Rule-as-Row" outputLabel="investment limit">
        <input id="bkm_investment_limit_i1" label="`either annual income or net worth is less than the cut point` OF investor">
          <inputExpression id="bkm_investment_limit_i1_expr" typeRef="boolean">
            <text>either_annual_income_or_net_worth_is_less_than_the_cut_point</text>
          </inputExpression>
        </input>
        <output id="bkm_investment_limit_o1">
          <defaultOutputEntry id="bkm_investment_limit_o1_default">
            <text>min(0.1 * the_applicable_measure_of_annual_income_or_net_worth, maximum_amount_sold_to_any_one_investor_in_a_12_month_period)</text>
          </defaultOutputEntry>
        </output>
        <rule id="bkm_investment_limit_r1">
          <description>`either annual income or net worth is less than the cut point` OF investor</description>
          <inputEntry id="bkm_investment_limit_r1_i1">
            <text>true</text>
          </inputEntry>
          <outputEntry id="bkm_investment_limit_r1_o1">
            <text>max(minimum_permitted_investment, 0.05 * the_applicable_measure_of_annual_income_or_net_worth)</text>
          </outputEntry>
        </rule>
      </decisionTable>
    </encapsulatedLogic>
  </businessKnowledgeModel>
  <businessKnowledgeModel id="bkm_investor_is_within_the_investment_limit" name="investor_is_within_the_investment_limit" label="investor is within the investment limit">
    <variable id="bkm_investor_is_within_the_investment_limit_var" name="investor_is_within_the_investment_limit" label="investor is within the investment limit" typeRef="boolean"/>
    <encapsulatedLogic id="bkm_investor_is_within_the_investment_limit_logic">
      <formalParameter id="bkm_investor_is_within_the_investment_limit_p1" name="investor" typeRef="InvestorProfile"/>
      <formalParameter id="bkm_investor_is_within_the_investment_limit_p2" name="amount_to_be_sold_in_this_transaction" label="amount to be sold in this transaction" typeRef="number"/>
      <formalParameter id="bkm_investor_is_within_the_investment_limit_p3" name="aggregate_amount_sold_to_this_investor_including_this_transaction" typeRef="number"/>
      <formalParameter id="bkm_investor_is_within_the_investment_limit_p4" name="either_annual_income_or_net_worth_is_less_than_the_cut_point" typeRef="boolean"/>
      <formalParameter id="bkm_investor_is_within_the_investment_limit_p5" name="maximum_amount_sold_to_any_one_investor_in_a_12_month_period" typeRef="number"/>
      <formalParameter id="bkm_investor_is_within_the_investment_limit_p6" name="minimum_permitted_investment" typeRef="number"/>
      <formalParameter id="bkm_investor_is_within_the_investment_limit_p7" name="the_accredited_investor_carve_out_applies_to" typeRef="boolean"/>
      <formalParameter id="bkm_investor_is_within_the_investment_limit_p8" name="the_applicable_measure_of_annual_income_or_net_worth" typeRef="number"/>
      <literalExpression id="bkm_investor_is_within_the_investment_limit_literal">
        <text>false or (the_accredited_investor_carve_out_applies_to or aggregate_amount_sold_to_this_investor_including_this_transaction &lt;= investment_limit(investor: investor, either_annual_income_or_net_worth_is_less_than_the_cut_point: either_annual_income_or_net_worth_is_less_than_the_cut_point, maximum_amount_sold_to_any_one_investor_in_a_12_month_period: maximum_amount_sold_to_any_one_investor_in_a_12_month_period, minimum_permitted_investment: minimum_permitted_investment, the_applicable_measure_of_annual_income_or_net_worth: the_applicable_measure_of_annual_income_or_net_worth))</text>
      </literalExpression>
    </encapsulatedLogic>
    <knowledgeRequirement id="bkm_investor_is_within_the_investment_limit_kr1">
      <requiredKnowledge href="#bkm_investment_limit"/>
    </knowledgeRequirement>
  </businessKnowledgeModel>
  <businessKnowledgeModel id="bkm_financial_statements_required" name="financial_statements_required" label="financial statements required">
    <variable id="bkm_financial_statements_required_var" name="financial_statements_required" label="financial statements required" typeRef="FinancialStatementRequirement"/>
    <encapsulatedLogic id="bkm_financial_statements_required_logic">
      <formalParameter id="bkm_financial_statements_required_p1" name="offering" typeRef="Offering"/>
      <formalParameter id="bkm_financial_statements_required_p2" name="aggregate_offering_amount" typeRef="number"/>
      <formalParameter id="bkm_financial_statements_required_p3" name="first_time_issuer_review_ceiling" typeRef="number"/>
      <formalParameter id="bkm_financial_statements_required_p4" name="the_COVID_19_temporary_rules_Rule_201_z_and_bb_are_not_modelled_here" typeRef="FinancialStatementRequirement"/>
      <formalParameter id="bkm_financial_statements_required_p5" name="the_rule_date_is_inside_the_COVID_19_temporary_rules_window" typeRef="boolean"/>
      <formalParameter id="bkm_financial_statements_required_p6" name="tier_1_ceiling" typeRef="number"/>
      <formalParameter id="bkm_financial_statements_required_p7" name="tier_2_ceiling" typeRef="number"/>
      <decisionTable id="bkm_financial_statements_required_table" hitPolicy="FIRST" preferredOrientation="Rule-as-Row" outputLabel="financial statements required">
        <input id="bkm_financial_statements_required_i1" label="`the rule date is inside the COVID-19 temporary rules window`">
          <inputExpression id="bkm_financial_statements_required_i1_expr" typeRef="boolean">
            <text>the_rule_date_is_inside_the_COVID_19_temporary_rules_window</text>
          </inputExpression>
        </input>
        <input id="bkm_financial_statements_required_i2" label="(`aggregate offering amount` OF offering) GREATER THAN `tier 1 ceiling`">
          <inputExpression id="bkm_financial_statements_required_i2_expr" typeRef="boolean">
            <text>aggregate_offering_amount &gt; tier_1_ceiling</text>
          </inputExpression>
        </input>
        <input id="bkm_financial_statements_required_i3" label="`aggregate offering amount` OF offering">
          <inputExpression id="bkm_financial_statements_required_i3_expr" typeRef="number">
            <text>aggregate_offering_amount</text>
          </inputExpression>
        </input>
        <input id="bkm_financial_statements_required_i4" label="(`aggregate offering amount` OF offering) AT MOST `tier 1 ceiling`">
          <inputExpression id="bkm_financial_statements_required_i4_expr" typeRef="boolean">
            <text>aggregate_offering_amount &lt;= tier_1_ceiling</text>
          </inputExpression>
        </input>
        <input id="bkm_financial_statements_required_i5" label="(`aggregate offering amount` OF offering) AT MOST `tier 2 ceiling`">
          <inputExpression id="bkm_financial_statements_required_i5_expr" typeRef="boolean">
            <text>aggregate_offering_amount &lt;= tier_2_ceiling</text>
          </inputExpression>
        </input>
        <input id="bkm_financial_statements_required_i6" label="offering&apos;s `the issuer has previously sold securities in reliance on section 4(a)(6)`">
          <inputExpression id="bkm_financial_statements_required_i6_expr" typeRef="boolean">
            <text>offering.the_issuer_has_previously_sold_securities_in_reliance_on_section_4_a_6</text>
          </inputExpression>
        </input>
        <input id="bkm_financial_statements_required_i7" label="(`aggregate offering amount` OF offering) AT MOST `first-time issuer review ceiling`">
          <inputExpression id="bkm_financial_statements_required_i7_expr" typeRef="boolean">
            <text>aggregate_offering_amount &lt;= first_time_issuer_review_ceiling</text>
          </inputExpression>
        </input>
        <output id="bkm_financial_statements_required_o1">
          <outputValues>
            <text>"financial statements certified by the principal executive officer, with tax return information","financial statements reviewed by an independent public accountant","financial statements audited by an independent public accountant"</text>
          </outputValues>
        </output>
        <rule id="bkm_financial_statements_required_r1">
          <description>`the rule date is inside the COVID-19 temporary rules window` AND (`aggregate offering amount` OF offering) GREATER THAN `tier 1 ceiling` AND (`aggregate offering amount` OF offering) AT MOST 250000</description>
          <inputEntry id="bkm_financial_statements_required_r1_i1">
            <text>true</text>
          </inputEntry>
          <inputEntry id="bkm_financial_statements_required_r1_i2">
            <text>true</text>
          </inputEntry>
          <inputEntry id="bkm_financial_statements_required_r1_i3">
            <text>&lt;= 250000</text>
          </inputEntry>
          <inputEntry id="bkm_financial_statements_required_r1_i4">
            <text>-</text>
          </inputEntry>
          <inputEntry id="bkm_financial_statements_required_r1_i5">
            <text>-</text>
          </inputEntry>
          <inputEntry id="bkm_financial_statements_required_r1_i6">
            <text>-</text>
          </inputEntry>
          <inputEntry id="bkm_financial_statements_required_r1_i7">
            <text>-</text>
          </inputEntry>
          <outputEntry id="bkm_financial_statements_required_r1_o1">
            <text>the_COVID_19_temporary_rules_Rule_201_z_and_bb_are_not_modelled_here</text>
          </outputEntry>
        </rule>
        <rule id="bkm_financial_statements_required_r2">
          <description>(`aggregate offering amount` OF offering) AT MOST `tier 1 ceiling`</description>
          <inputEntry id="bkm_financial_statements_required_r2_i1">
            <text>-</text>
          </inputEntry>
          <inputEntry id="bkm_financial_statements_required_r2_i2">
            <text>-</text>
          </inputEntry>
          <inputEntry id="bkm_financial_statements_required_r2_i3">
            <text>-</text>
          </inputEntry>
          <inputEntry id="bkm_financial_statements_required_r2_i4">
            <text>true</text>
          </inputEntry>
          <inputEntry id="bkm_financial_statements_required_r2_i5">
            <text>-</text>
          </inputEntry>
          <inputEntry id="bkm_financial_statements_required_r2_i6">
            <text>-</text>
          </inputEntry>
          <inputEntry id="bkm_financial_statements_required_r2_i7">
            <text>-</text>
          </inputEntry>
          <outputEntry id="bkm_financial_statements_required_r2_o1">
            <text>"financial statements certified by the principal executive officer, with tax return information"</text>
          </outputEntry>
        </rule>
        <rule id="bkm_financial_statements_required_r3">
          <description>(`aggregate offering amount` OF offering) AT MOST `tier 2 ceiling`</description>
          <inputEntry id="bkm_financial_statements_required_r3_i1">
            <text>-</text>
          </inputEntry>
          <inputEntry id="bkm_financial_statements_required_r3_i2">
            <text>-</text>
          </inputEntry>
          <inputEntry id="bkm_financial_statements_required_r3_i3">
            <text>-</text>
          </inputEntry>
          <inputEntry id="bkm_financial_statements_required_r3_i4">
            <text>-</text>
          </inputEntry>
          <inputEntry id="bkm_financial_statements_required_r3_i5">
            <text>true</text>
          </inputEntry>
          <inputEntry id="bkm_financial_statements_required_r3_i6">
            <text>-</text>
          </inputEntry>
          <inputEntry id="bkm_financial_statements_required_r3_i7">
            <text>-</text>
          </inputEntry>
          <outputEntry id="bkm_financial_statements_required_r3_o1">
            <text>"financial statements reviewed by an independent public accountant"</text>
          </outputEntry>
        </rule>
        <rule id="bkm_financial_statements_required_r4">
          <description>NOT offering's `the issuer has previously sold securities in reliance on section 4(a)(6)` AND (`aggregate offering amount` OF offering) AT MOST `first-time issuer review ceiling`</description>
          <inputEntry id="bkm_financial_statements_required_r4_i1">
            <text>-</text>
          </inputEntry>
          <inputEntry id="bkm_financial_statements_required_r4_i2">
            <text>-</text>
          </inputEntry>
          <inputEntry id="bkm_financial_statements_required_r4_i3">
            <text>-</text>
          </inputEntry>
          <inputEntry id="bkm_financial_statements_required_r4_i4">
            <text>-</text>
          </inputEntry>
          <inputEntry id="bkm_financial_statements_required_r4_i5">
            <text>-</text>
          </inputEntry>
          <inputEntry id="bkm_financial_statements_required_r4_i6">
            <text>false</text>
          </inputEntry>
          <inputEntry id="bkm_financial_statements_required_r4_i7">
            <text>true</text>
          </inputEntry>
          <outputEntry id="bkm_financial_statements_required_r4_o1">
            <text>"financial statements reviewed by an independent public accountant"</text>
          </outputEntry>
        </rule>
        <rule id="bkm_financial_statements_required_r5">
          <description>OTHERWISE</description>
          <inputEntry id="bkm_financial_statements_required_r5_i1">
            <text>-</text>
          </inputEntry>
          <inputEntry id="bkm_financial_statements_required_r5_i2">
            <text>-</text>
          </inputEntry>
          <inputEntry id="bkm_financial_statements_required_r5_i3">
            <text>-</text>
          </inputEntry>
          <inputEntry id="bkm_financial_statements_required_r5_i4">
            <text>-</text>
          </inputEntry>
          <inputEntry id="bkm_financial_statements_required_r5_i5">
            <text>-</text>
          </inputEntry>
          <inputEntry id="bkm_financial_statements_required_r5_i6">
            <text>-</text>
          </inputEntry>
          <inputEntry id="bkm_financial_statements_required_r5_i7">
            <text>-</text>
          </inputEntry>
          <outputEntry id="bkm_financial_statements_required_r5_o1">
            <text>"financial statements audited by an independent public accountant"</text>
          </outputEntry>
        </rule>
      </decisionTable>
    </encapsulatedLogic>
  </businessKnowledgeModel>
  <businessKnowledgeModel id="bkm_assurance_level" name="assurance_level" label="assurance level">
    <variable id="bkm_assurance_level_var" name="assurance_level" label="assurance level" typeRef="number"/>
    <encapsulatedLogic id="bkm_assurance_level_logic">
      <formalParameter id="bkm_assurance_level_p1" name="required" typeRef="FinancialStatementRequirement"/>
      <decisionTable id="bkm_assurance_level_table" hitPolicy="UNIQUE" preferredOrientation="Rule-as-Row" outputLabel="assurance level">
        <input id="bkm_assurance_level_i1" label="required">
          <inputExpression id="bkm_assurance_level_i1_expr" typeRef="FinancialStatementRequirement">
            <text>required</text>
          </inputExpression>
          <inputValues>
            <text>"financial statements certified by the principal executive officer, with tax return information","financial statements reviewed by an independent public accountant","financial statements audited by an independent public accountant"</text>
          </inputValues>
        </input>
        <output id="bkm_assurance_level_o1"/>
        <rule id="bkm_assurance_level_r1">
          <description>required EQUALS `financial statements certified by the principal executive officer, with tax return information`</description>
          <inputEntry id="bkm_assurance_level_r1_i1">
            <text>"financial statements certified by the principal executive officer, with tax return information"</text>
          </inputEntry>
          <outputEntry id="bkm_assurance_level_r1_o1">
            <text>1</text>
          </outputEntry>
        </rule>
        <rule id="bkm_assurance_level_r2">
          <description>required EQUALS `financial statements reviewed by an independent public accountant`</description>
          <inputEntry id="bkm_assurance_level_r2_i1">
            <text>"financial statements reviewed by an independent public accountant"</text>
          </inputEntry>
          <outputEntry id="bkm_assurance_level_r2_o1">
            <text>2</text>
          </outputEntry>
        </rule>
        <rule id="bkm_assurance_level_r3">
          <description>required EQUALS `financial statements audited by an independent public accountant`</description>
          <inputEntry id="bkm_assurance_level_r3_i1">
            <text>"financial statements audited by an independent public accountant"</text>
          </inputEntry>
          <outputEntry id="bkm_assurance_level_r3_o1">
            <text>3</text>
          </outputEntry>
        </rule>
      </decisionTable>
    </encapsulatedLogic>
  </businessKnowledgeModel>
  <businessKnowledgeModel id="bkm_the_transaction_qualifies_for_the_section_4_a_6_exemption" name="the_transaction_qualifies_for_the_section_4_a_6_exemption" label="the transaction qualifies for the section 4(a)(6) exemption">
    <variable id="bkm_the_transaction_qualifies_for_the_section_4_a_6_exemption_var" name="the_transaction_qualifies_for_the_section_4_a_6_exemption" label="the transaction qualifies for the section 4(a)(6) exemption" typeRef="boolean"/>
    <encapsulatedLogic id="bkm_the_transaction_qualifies_for_the_section_4_a_6_exemption_logic">
      <formalParameter id="bkm_the_transaction_qualifies_for_the_section_4_a_6_exemption_p1" name="issuer" typeRef="IssuerProfile"/>
      <formalParameter id="bkm_the_transaction_qualifies_for_the_section_4_a_6_exemption_p2" name="offering" typeRef="Offering"/>
      <formalParameter id="bkm_the_transaction_qualifies_for_the_section_4_a_6_exemption_p3" name="investor" typeRef="InvestorProfile"/>
      <formalParameter id="bkm_the_transaction_qualifies_for_the_section_4_a_6_exemption_p4" name="amount" typeRef="number"/>
      <formalParameter id="bkm_the_transaction_qualifies_for_the_section_4_a_6_exemption_p5" name="arrangement" typeRef="IntermediaryArrangement"/>
      <formalParameter id="bkm_the_transaction_qualifies_for_the_section_4_a_6_exemption_p6" name="filing" typeRef="FormCFiling"/>
      <formalParameter id="bkm_the_transaction_qualifies_for_the_section_4_a_6_exemption_p7" name="aggregate_amount_sold_to_this_investor_including_this_transaction" typeRef="number"/>
      <formalParameter id="bkm_the_transaction_qualifies_for_the_section_4_a_6_exemption_p8" name="aggregate_offering_amount" typeRef="number"/>
      <formalParameter id="bkm_the_transaction_qualifies_for_the_section_4_a_6_exemption_p9" name="disclosure_requirements_are_met" typeRef="boolean"/>
      <formalParameter id="bkm_the_transaction_qualifies_for_the_section_4_a_6_exemption_p10" name="either_annual_income_or_net_worth_is_less_than_the_cut_point" typeRef="boolean"/>
      <formalParameter id="bkm_the_transaction_qualifies_for_the_section_4_a_6_exemption_p11" name="intermediary_obligations_are_met" typeRef="boolean"/>
      <formalParameter id="bkm_the_transaction_qualifies_for_the_section_4_a_6_exemption_p12" name="issuer_is_eligible" typeRef="boolean"/>
      <formalParameter id="bkm_the_transaction_qualifies_for_the_section_4_a_6_exemption_p13" name="maximum_amount_sold_to_any_one_investor_in_a_12_month_period" typeRef="number"/>
      <formalParameter id="bkm_the_transaction_qualifies_for_the_section_4_a_6_exemption_p14" name="minimum_permitted_investment" typeRef="number"/>
      <formalParameter id="bkm_the_transaction_qualifies_for_the_section_4_a_6_exemption_p15" name="offering_maximum_in_a_12_month_period" typeRef="number"/>
      <formalParameter id="bkm_the_transaction_qualifies_for_the_section_4_a_6_exemption_p16" name="the_accredited_investor_carve_out_applies_to" typeRef="boolean"/>
      <formalParameter id="bkm_the_transaction_qualifies_for_the_section_4_a_6_exemption_p17" name="the_applicable_measure_of_annual_income_or_net_worth" typeRef="number"/>
      <literalExpression id="bkm_the_transaction_qualifies_for_the_section_4_a_6_exemption_literal">
        <text>true and (issuer_is_eligible and (offering_is_within_the_offering_limit(offering: offering, aggregate_offering_amount: aggregate_offering_amount, offering_maximum_in_a_12_month_period: offering_maximum_in_a_12_month_period) and (investor_is_within_the_investment_limit(investor: investor, amount_to_be_sold_in_this_transaction: amount, aggregate_amount_sold_to_this_investor_including_this_transaction: aggregate_amount_sold_to_this_investor_including_this_transaction, either_annual_income_or_net_worth_is_less_than_the_cut_point: either_annual_income_or_net_worth_is_less_than_the_cut_point, maximum_amount_sold_to_any_one_investor_in_a_12_month_period: maximum_amount_sold_to_any_one_investor_in_a_12_month_period, minimum_permitted_investment: minimum_permitted_investment, the_accredited_investor_carve_out_applies_to: the_accredited_investor_carve_out_applies_to, the_applicable_measure_of_annual_income_or_net_worth: the_applicable_measure_of_annual_income_or_net_worth) and (intermediary_obligations_are_met and disclosure_requirements_are_met))))</text>
      </literalExpression>
    </encapsulatedLogic>
    <knowledgeRequirement id="bkm_the_transaction_qualifies_for_the_section_4_a_6_exemption_kr1">
      <requiredKnowledge href="#bkm_investor_is_within_the_investment_limit"/>
    </knowledgeRequirement>
    <knowledgeRequirement id="bkm_the_transaction_qualifies_for_the_section_4_a_6_exemption_kr2">
      <requiredKnowledge href="#bkm_offering_is_within_the_offering_limit"/>
    </knowledgeRequirement>
  </businessKnowledgeModel>
