<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" id="definitions_sec_regulation_crowdfunding_17_cfr_part_227" name="SEC Regulation Crowdfunding — 17 CFR Part 227" namespace="https://legalese.com/l4/dmn/sec_regulation_crowdfunding_17_cfr_part_227" exporter="jl4">
  <itemDefinition id="itemdef_actor" name="Actor">
    <typeRef>string</typeRef>
    <allowedValues>
      <text>"Issuer","Intermediary","Investor","Purchaser"</text>
    </allowedValues>
  </itemDefinition>
  <itemDefinition id="itemdef_action" name="Action">
    <typeRef>string</typeRef>
    <allowedValues>
      <text>"file a Form C offering statement","file a Form C-U progress update","file a Form C-AR annual report","file a Form C-TR termination of reporting","advertise the terms of the offering","transmit funds to the issuer","transfer the securities"</text>
    </allowedValues>
  </itemDefinition>
  <itemDefinition id="itemdef_issuerprofile" name="IssuerProfile">
    <itemComponent id="itemdef_issuerprofile_c1" name="name">
      <typeRef>string</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_issuerprofile_c2" name="organized_under_and_subject_to_the_laws_of_a_State_or_territory_of_the_United_States_or_the_District_of_Columbia" label="organized under, and subject to, the laws of a State or territory of the United States or the District of Columbia">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_issuerprofile_c3" name="subject_to_the_requirement_to_file_reports_pursuant_to_section_13_or_section_15_d_of_the_Exchange_Act" label="subject to the requirement to file reports pursuant to section 13 or section 15(d) of the Exchange Act">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_issuerprofile_c4" name="an_investment_company_or_is_excluded_from_the_definition_of_investment_company_by_section_3_b_or_section_3_c" label="an investment company, or is excluded from the definition of investment company by section 3(b) or section 3(c)">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_issuerprofile_c5" name="subject_to_a_disqualification_as_specified_in_section_227_503_a" label="subject to a disqualification as specified in section 227.503(a)">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_issuerprofile_c6" name="has_sold_securities_in_reliance_on_section_4_a_6_and_has_not_filed_the_ongoing_annual_reports_required_during_the_two_years_immediately_preceding_the_filing_of_the_offering_statement" label="has sold securities in reliance on section 4(a)(6) and has not filed the ongoing annual reports required during the two years immediately preceding the filing of the offering statement">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_issuerprofile_c7" name="has_no_specific_business_plan_or_has_indicated_that_its_business_plan_is_to_engage_in_a_merger_or_acquisition_with_an_unidentified_company_or_companies" label="has no specific business plan, or has indicated that its business plan is to engage in a merger or acquisition with an unidentified company or companies">
      <typeRef>boolean</typeRef>
    </itemComponent>
  </itemDefinition>
  <itemDefinition id="itemdef_offering" name="Offering">
    <itemComponent id="itemdef_offering_c1" name="target_offering_amount" label="target offering amount">
      <typeRef>number</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_offering_c2" name="maximum_offering_amount_the_issuer_will_accept" label="maximum offering amount the issuer will accept">
      <typeRef>number</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_offering_c3" name="aggregate_amount_sold_in_reliance_on_section_4_a_6_during_the_preceding_12_months" label="aggregate amount sold in reliance on section 4(a)(6) during the preceding 12 months">
      <typeRef>number</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_offering_c4" name="the_issuer_has_previously_sold_securities_in_reliance_on_section_4_a_6" label="the issuer has previously sold securities in reliance on section 4(a)(6)">
      <typeRef>boolean</typeRef>
    </itemComponent>
  </itemDefinition>
  <itemDefinition id="itemdef_investorprofile" name="InvestorProfile">
    <itemComponent id="itemdef_investorprofile_c1" name="name">
      <typeRef>string</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_investorprofile_c2" name="an_accredited_investor_as_defined_in_Rule_501" label="an accredited investor as defined in Rule 501">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_investorprofile_c3" name="annual_income" label="annual income">
      <typeRef>number</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_investorprofile_c4" name="net_worth" label="net worth">
      <typeRef>number</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_investorprofile_c5" name="aggregate_amount_already_sold_to_this_investor_across_all_issuers_in_reliance_on_section_4_a_6_during_the_preceding_12_months" label="aggregate amount already sold to this investor across all issuers in reliance on section 4(a)(6) during the preceding 12 months">
      <typeRef>number</typeRef>
    </itemComponent>
  </itemDefinition>
  <itemDefinition id="itemdef_financialstatementrequirement" name="FinancialStatementRequirement">
    <typeRef>string</typeRef>
    <allowedValues>
      <text>"financial statements certified by the principal executive officer, with tax return information","financial statements reviewed by an independent public accountant","financial statements audited by an independent public accountant"</text>
    </allowedValues>
  </itemDefinition>
  <itemDefinition id="itemdef_formcfiling" name="FormCFiling">
    <itemComponent id="itemdef_formcfiling_c1" name="a_Form_C_offering_statement_was_filed_with_the_Commission_and_provided_to_investors_and_the_relevant_intermediary_prior_to_the_commencement_of_the_offering" label="a Form C offering statement was filed with the Commission and provided to investors and the relevant intermediary prior to the commencement of the offering">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_formcfiling_c2" name="the_Form_C_includes_the_information_required_by_section_227_201" label="the Form C includes the information required by section 227.201">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_formcfiling_c3" name="the_financial_statements_supplied" label="the financial statements supplied">
      <typeRef>FinancialStatementRequirement</typeRef>
    </itemComponent>
  </itemDefinition>
  <itemDefinition id="itemdef_intermediaryarrangement" name="IntermediaryArrangement">
    <itemComponent id="itemdef_intermediaryarrangement_c1" name="the_intermediary_complies_with_section_4A_a_of_the_Securities_Act_and_the_related_requirements_in_this_part" label="the intermediary complies with section 4A(a) of the Securities Act and the related requirements in this part">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_intermediaryarrangement_c2" name="the_transaction_is_conducted_exclusively_through_the_intermediary_s_platform" label="the transaction is conducted exclusively through the intermediary&apos;s platform">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_intermediaryarrangement_c3" name="the_number_of_intermediaries_used_for_the_offering" label="the number of intermediaries used for the offering">
      <typeRef>number</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_intermediaryarrangement_c4" name="the_intermediary_delivered_educational_materials_in_connection_with_establishing_the_investor_s_account" label="the intermediary delivered educational materials in connection with establishing the investor&apos;s account">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_intermediaryarrangement_c5" name="the_intermediary_has_a_reasonable_basis_for_believing_that_the_investor_satisfies_the_investment_limitations" label="the intermediary has a reasonable basis for believing that the investor satisfies the investment limitations">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_intermediaryarrangement_c6" name="the_days_the_issuer_information_has_been_publicly_available_on_the_intermediary_s_platform_before_any_sale" label="the days the issuer information has been publicly available on the intermediary&apos;s platform before any sale">
      <typeRef>number</typeRef>
    </itemComponent>
  </itemDefinition>
  <itemDefinition id="itemdef_advertisingnotice" name="AdvertisingNotice">
    <itemComponent id="itemdef_advertisingnotice_c1" name="directs_investors_to_the_intermediary_s_platform" label="directs investors to the intermediary&apos;s platform">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_advertisingnotice_c2" name="states_that_the_issuer_is_conducting_an_offering_pursuant_to_section_4_a_6_names_the_intermediary_and_directs_the_potential_investor_to_its_platform" label="states that the issuer is conducting an offering pursuant to section 4(a)(6), names the intermediary, and directs the potential investor to its platform">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_advertisingnotice_c3" name="states_the_terms_of_the_offering" label="states the terms of the offering">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_advertisingnotice_c4" name="states_factual_information_about_the_legal_identity_and_business_location_of_the_issuer" label="states factual information about the legal identity and business location of the issuer">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_advertisingnotice_c5" name="includes_information_beyond_that_permitted_by_paragraph_b" label="includes information beyond that permitted by paragraph (b)">
      <typeRef>boolean</typeRef>
    </itemComponent>
  </itemDefinition>
  <itemDefinition id="itemdef_reportingstatus" name="ReportingStatus">
    <itemComponent id="itemdef_reportingstatus_c1" name="the_issuer_is_required_to_file_reports_under_section_13_a_or_section_15_d_of_the_Exchange_Act" label="the issuer is required to file reports under section 13(a) or section 15(d) of the Exchange Act">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_reportingstatus_c2" name="annual_reports_filed_since_the_most_recent_sale_of_securities_pursuant_to_this_part" label="annual reports filed since the most recent sale of securities pursuant to this part">
      <typeRef>number</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_reportingstatus_c3" name="holders_of_record" label="holders of record">
      <typeRef>number</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_reportingstatus_c4" name="total_assets" label="total assets">
      <typeRef>number</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_reportingstatus_c5" name="the_issuer_or_another_party_has_repurchased_all_of_the_securities_issued_in_reliance_on_section_4_a_6" label="the issuer or another party has repurchased all of the securities issued in reliance on section 4(a)(6)">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_reportingstatus_c6" name="the_issuer_has_liquidated_or_dissolved_its_business_in_accordance_with_state_law" label="the issuer has liquidated or dissolved its business in accordance with state law">
      <typeRef>boolean</typeRef>
    </itemComponent>
  </itemDefinition>
  <itemDefinition id="itemdef_transfer" name="Transfer">
    <itemComponent id="itemdef_transfer_c1" name="days_since_the_securities_were_issued" label="days since the securities were issued">
      <typeRef>number</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_transfer_c2" name="to_the_issuer_of_the_securities" label="to the issuer of the securities">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_transfer_c3" name="to_an_accredited_investor" label="to an accredited investor">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_transfer_c4" name="as_part_of_an_offering_registered_with_the_Commission" label="as part of an offering registered with the Commission">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_transfer_c5" name="to_a_member_of_the_family_of_the_purchaser_or_the_equivalent_to_a_trust_controlled_by_the_purchaser_to_a_trust_created_for_the_benefit_of_a_member_of_the_family_of_the_purchaser_or_the_equivalent_or_in_connection_with_the_death_or_divorce_of_the_purchaser_or_other_similar_circumstance" label="to a member of the family of the purchaser or the equivalent, to a trust controlled by the purchaser, to a trust created for the benefit of a member of the family of the purchaser or the equivalent, or in connection with the death or divorce of the purchaser or other similar circumstance">
      <typeRef>boolean</typeRef>
    </itemComponent>
  </itemDefinition>
  <itemDefinition id="itemdef_investorprofile_hydrated" name="InvestorProfile_hydrated" label="InvestorProfile">
    <itemComponent id="itemdef_investorprofile_hydrated_c1" name="name">
      <typeRef>string</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_investorprofile_hydrated_c2" name="an_accredited_investor_as_defined_in_Rule_501" label="an accredited investor as defined in Rule 501">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_investorprofile_hydrated_c3" name="annual_income" label="annual income">
      <typeRef>number</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_investorprofile_hydrated_c4" name="net_worth" label="net worth">
      <typeRef>number</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_investorprofile_hydrated_c5" name="aggregate_amount_already_sold_to_this_investor_across_all_issuers_in_reliance_on_section_4_a_6_during_the_preceding_12_months" label="aggregate amount already sold to this investor across all issuers in reliance on section 4(a)(6) during the preceding 12 months">
      <typeRef>number</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_investorprofile_hydrated_c6" name="greater_of_annual_income_or_net_worth" label="greater of annual income or net worth">
      <typeRef>number</typeRef>
    </itemComponent>
    <itemComponent id="itemdef_investorprofile_hydrated_c7" name="lesser_of_annual_income_or_net_worth" label="lesser of annual income or net worth">
      <typeRef>number</typeRef>
    </itemComponent>
  </itemDefinition>
  <inputData id="input_no_regulation_crowdfunding_figure_exists_before_commencement_on_2016_05_16" name="no_Regulation_Crowdfunding_figure_exists_before_commencement_on_2016_05_16" label="no Regulation Crowdfunding figure exists before commencement on 2016-05-16">
    <variable id="input_no_regulation_crowdfunding_figure_exists_before_commencement_on_2016_05_16_var" name="no_Regulation_Crowdfunding_figure_exists_before_commencement_on_2016_05_16" label="no Regulation Crowdfunding figure exists before commencement on 2016-05-16" typeRef="number"/>
  </inputData>
  <inputData id="input_issuer" name="issuer">
    <variable id="input_issuer_var" name="issuer" typeRef="IssuerProfile"/>
  </inputData>
  <inputData id="input_offering" name="offering">
    <variable id="input_offering_var" name="offering" typeRef="Offering"/>
  </inputData>
  <inputData id="input_investor" name="investor">
    <variable id="input_investor_var" name="investor" typeRef="InvestorProfile"/>
  </inputData>
  <inputData id="input_amount_to_be_sold_in_this_transaction" name="amount_to_be_sold_in_this_transaction" label="amount to be sold in this transaction">
    <variable id="input_amount_to_be_sold_in_this_transaction_var" name="amount_to_be_sold_in_this_transaction" label="amount to be sold in this transaction" typeRef="number"/>
  </inputData>
  <inputData id="input_the_covid_19_temporary_rules_rule_201_z_and_bb_are_not_modelled_here" name="the_COVID_19_temporary_rules_Rule_201_z_and_bb_are_not_modelled_here" label="the COVID-19 temporary rules, Rule 201(z) and (bb), are not modelled here">
    <variable id="input_the_covid_19_temporary_rules_rule_201_z_and_bb_are_not_modelled_here_var" name="the_COVID_19_temporary_rules_Rule_201_z_and_bb_are_not_modelled_here" label="the COVID-19 temporary rules, Rule 201(z) and (bb), are not modelled here" typeRef="FinancialStatementRequirement"/>
  </inputData>
  <inputData id="input_supplied" name="supplied">
    <variable id="input_supplied_var" name="supplied" typeRef="FinancialStatementRequirement"/>
  </inputData>
  <inputData id="input_filing" name="filing">
    <variable id="input_filing_var" name="filing" typeRef="FormCFiling"/>
  </inputData>
  <inputData id="input_arrangement" name="arrangement">
    <variable id="input_arrangement_var" name="arrangement" typeRef="IntermediaryArrangement"/>
  </inputData>
  <inputData id="input_notice" name="notice">
    <variable id="input_notice_var" name="notice" typeRef="AdvertisingNotice"/>
  </inputData>
  <inputData id="input_status" name="status">
    <variable id="input_status_var" name="status" typeRef="ReportingStatus"/>
  </inputData>
  <inputData id="input_status_2" name="status_2" label="status">
    <variable id="input_status_2_var" name="status_2" label="status" typeRef="ReportingStatus"/>
  </inputData>
  <inputData id="input_annual_cycles" name="annual_cycles" label="annual cycles">
    <variable id="input_annual_cycles_var" name="annual_cycles" label="annual cycles" typeRef="number"/>
  </inputData>
  <inputData id="input_transfer" name="transfer">
    <variable id="input_transfer_var" name="transfer" typeRef="Transfer"/>
  </inputData>
  <inputData id="input_rules_effective_date" name="RULES_EFFECTIVE_DATE" label="RULES EFFECTIVE DATE">
    <variable id="input_rules_effective_date_var" name="RULES_EFFECTIVE_DATE" label="RULES EFFECTIVE DATE" typeRef="date"/>
  </inputData>
  <decision id="decision_reg_cf_commenced" name="Reg_CF_commenced" label="Reg CF commenced">
    <variable id="decision_reg_cf_commenced_var" name="Reg_CF_commenced" label="Reg CF commenced" typeRef="date"/>
    <literalExpression id="decision_reg_cf_commenced_literal">
      <text>date("2016-05-16")</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_2017_inflation_adjustment" name="the_2017_inflation_adjustment" label="the 2017 inflation adjustment">
    <variable id="decision_the_2017_inflation_adjustment_var" name="the_2017_inflation_adjustment" label="the 2017 inflation adjustment" typeRef="date"/>
    <literalExpression id="decision_the_2017_inflation_adjustment_literal">
      <text>date("2017-04-12")</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_2021_amendments" name="the_2021_amendments" label="the 2021 amendments">
    <variable id="decision_the_2021_amendments_var" name="the_2021_amendments" label="the 2021 amendments" typeRef="date"/>
    <literalExpression id="decision_the_2021_amendments_literal">
      <text>date("2021-03-15")</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_2022_inflation_adjustment" name="the_2022_inflation_adjustment" label="the 2022 inflation adjustment">
    <variable id="decision_the_2022_inflation_adjustment_var" name="the_2022_inflation_adjustment" label="the 2022 inflation adjustment" typeRef="date"/>
    <literalExpression id="decision_the_2022_inflation_adjustment_literal">
      <text>date("2022-09-20")</text>
    </literalExpression>
  </decision>
  <decision id="decision_offering_maximum_in_a_12_month_period" name="offering_maximum_in_a_12_month_period" label="offering maximum in a 12-month period">
    <variable id="decision_offering_maximum_in_a_12_month_period_var" name="offering_maximum_in_a_12_month_period" label="offering maximum in a 12-month period" typeRef="number"/>
    <informationRequirement id="decision_offering_maximum_in_a_12_month_period_ir1">
      <requiredInput href="#input_no_regulation_crowdfunding_figure_exists_before_commencement_on_2016_05_16"/>
    </informationRequirement>
    <informationRequirement id="decision_offering_maximum_in_a_12_month_period_ir2">
      <requiredInput href="#input_rules_effective_date"/>
    </informationRequirement>
    <decisionTable id="decision_offering_maximum_in_a_12_month_period_table" hitPolicy="UNIQUE" preferredOrientation="Rule-as-Row" outputLabel="offering maximum in a 12-month period">
      <input id="decision_offering_maximum_in_a_12_month_period_i1" label="`RULES EFFECTIVE DATE`">
        <inputExpression id="decision_offering_maximum_in_a_12_month_period_i1_expr" typeRef="date">
          <text>RULES_EFFECTIVE_DATE</text>
        </inputExpression>
      </input>
      <output id="decision_offering_maximum_in_a_12_month_period_o1"/>
      <annotation name="regime"/>
      <rule id="decision_offering_maximum_in_a_12_month_period_r1">
        <description>`the rules in force include` OF `the 2021 amendments`</description>
        <inputEntry id="decision_offering_maximum_in_a_12_month_period_r1_i1">
          <text>&gt;= date("2021-03-15")</text>
        </inputEntry>
        <outputEntry id="decision_offering_maximum_in_a_12_month_period_r1_o1">
          <text>5000000</text>
        </outputEntry>
        <annotationEntry>
          <text>the 2021 amendments — 86 FR 3496 (Rel. 33-10884), instr. 3 — the 2020 amendments, eff. 2021-03-15 (main.l4:111:1-112:43)</text>
        </annotationEntry>
      </rule>
      <rule id="decision_offering_maximum_in_a_12_month_period_r2">
        <description>`the rules in force include` OF `the 2017 inflation adjustment`</description>
        <inputEntry id="decision_offering_maximum_in_a_12_month_period_r2_i1">
          <text>[date("2017-04-12")..date("2021-03-15"))</text>
        </inputEntry>
        <outputEntry id="decision_offering_maximum_in_a_12_month_period_r2_o1">
          <text>1070000</text>
        </outputEntry>
        <annotationEntry>
          <text>the 2017 inflation adjustment — 82 FR 17545 (Rel. 33-10332), instrs. 5-6 — inflation adjustment eff. 2017-04-12 (main.l4:107:1-108:53)</text>
        </annotationEntry>
      </rule>
      <rule id="decision_offering_maximum_in_a_12_month_period_r3">
        <description>`the rules in force include` OF `Reg CF commenced`</description>
        <inputEntry id="decision_offering_maximum_in_a_12_month_period_r3_i1">
          <text>[date("2016-05-16")..date("2017-04-12"))</text>
        </inputEntry>
        <outputEntry id="decision_offering_maximum_in_a_12_month_period_r3_o1">
          <text>1000000</text>
        </outputEntry>
        <annotationEntry>
          <text>Reg CF commenced — 80 FR 71388 (Rel. 33-9974), Part 227 text at 71537, instr. 4 — commencement (main.l4:103:1-104:40)</text>
        </annotationEntry>
      </rule>
      <rule id="decision_offering_maximum_in_a_12_month_period_r4">
        <description>OTHERWISE</description>
        <inputEntry id="decision_offering_maximum_in_a_12_month_period_r4_i1">
          <text>&lt; date("2016-05-16")</text>
        </inputEntry>
        <outputEntry id="decision_offering_maximum_in_a_12_month_period_r4_o1">
          <text>no_Regulation_Crowdfunding_figure_exists_before_commencement_on_2016_05_16</text>
        </outputEntry>
        <annotationEntry>
          <text>no Regulation Crowdfunding figure exists before commencement on 2016-05-16</text>
        </annotationEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="decision_income_or_net_worth_cut_point" name="income_or_net_worth_cut_point" label="income or net worth cut point">
    <variable id="decision_income_or_net_worth_cut_point_var" name="income_or_net_worth_cut_point" label="income or net worth cut point" typeRef="number"/>
    <informationRequirement id="decision_income_or_net_worth_cut_point_ir1">
      <requiredInput href="#input_no_regulation_crowdfunding_figure_exists_before_commencement_on_2016_05_16"/>
    </informationRequirement>
    <informationRequirement id="decision_income_or_net_worth_cut_point_ir2">
      <requiredInput href="#input_rules_effective_date"/>
    </informationRequirement>
    <decisionTable id="decision_income_or_net_worth_cut_point_table" hitPolicy="UNIQUE" preferredOrientation="Rule-as-Row" outputLabel="income or net worth cut point">
      <input id="decision_income_or_net_worth_cut_point_i1" label="`RULES EFFECTIVE DATE`">
        <inputExpression id="decision_income_or_net_worth_cut_point_i1_expr" typeRef="date">
          <text>RULES_EFFECTIVE_DATE</text>
