<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" id="definitions_gst_rate" name="GST rate" namespace="https://legalese.com/l4/dmn/gst_rate" exporter="jl4">
  <inputData id="input_no_gst_rate_exists_before_commencement_on_1994_04_01" name="no_GST_rate_exists_before_commencement_on_1994_04_01" label="no GST rate exists before commencement on 1994-04-01">
    <variable id="input_no_gst_rate_exists_before_commencement_on_1994_04_01_var" name="no_GST_rate_exists_before_commencement_on_1994_04_01" label="no GST rate exists before commencement on 1994-04-01" typeRef="number"/>
  </inputData>
  <inputData id="input_supply_value" name="supply_value" label="supply value">
    <variable id="input_supply_value_var" name="supply_value" label="supply value" typeRef="number"/>
  </inputData>
  <inputData id="input_rules_effective_date" name="RULES_EFFECTIVE_DATE" label="RULES EFFECTIVE DATE">
    <variable id="input_rules_effective_date_var" name="RULES_EFFECTIVE_DATE" label="RULES EFFECTIVE DATE" typeRef="date"/>
  </inputData>
  <decision id="decision_the_2024_rate_change" name="the_2024_rate_change" label="the 2024 rate change">
    <variable id="decision_the_2024_rate_change_var" name="the_2024_rate_change" label="the 2024 rate change" typeRef="date"/>
    <literalExpression id="decision_the_2024_rate_change_literal">
      <text>date("2024-01-01")</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_2023_rate_change" name="the_2023_rate_change" label="the 2023 rate change">
    <variable id="decision_the_2023_rate_change_var" name="the_2023_rate_change" label="the 2023 rate change" typeRef="date"/>
    <literalExpression id="decision_the_2023_rate_change_literal">
      <text>date("2023-01-01")</text>
    </literalExpression>
  </decision>
  <decision id="decision_gst_commenced" name="GST_commenced" label="GST commenced">
    <variable id="decision_gst_commenced_var" name="GST_commenced" label="GST commenced" typeRef="date"/>
    <literalExpression id="decision_gst_commenced_literal">
      <text>date("1994-04-01")</text>
    </literalExpression>
  </decision>
  <decision id="decision_gst_rate_percent" name="GST_rate_percent" label="GST rate percent">
    <variable id="decision_gst_rate_percent_var" name="GST_rate_percent" label="GST rate percent" typeRef="number"/>
    <informationRequirement id="decision_gst_rate_percent_ir1">
      <requiredInput href="#input_no_gst_rate_exists_before_commencement_on_1994_04_01"/>
    </informationRequirement>
    <informationRequirement id="decision_gst_rate_percent_ir2">
      <requiredInput href="#input_rules_effective_date"/>
    </informationRequirement>
    <decisionTable id="decision_gst_rate_percent_table" hitPolicy="UNIQUE" preferredOrientation="Rule-as-Row" outputLabel="GST rate percent">
      <input id="decision_gst_rate_percent_i1" label="`RULES EFFECTIVE DATE`">
        <inputExpression id="decision_gst_rate_percent_i1_expr" typeRef="date">
          <text>RULES_EFFECTIVE_DATE</text>
        </inputExpression>
      </input>
      <output id="decision_gst_rate_percent_o1"/>
      <annotation name="regime"/>
      <rule id="decision_gst_rate_percent_r1">
        <description>`the rules in force include` OF `the 2024 rate change`</description>
        <inputEntry id="decision_gst_rate_percent_r1_i1">
          <text>&gt;= date("2024-01-01")</text>
        </inputEntry>
        <outputEntry id="decision_gst_rate_percent_r1_o1">
          <text>9</text>
        </outputEntry>
        <annotationEntry>
          <text>the 2024 rate change — Goods and Services Tax (Amendment) Act 2022 — second step of the Budget 2022 increase (main.l4:51:1-52:43)</text>
        </annotationEntry>
      </rule>
      <rule id="decision_gst_rate_percent_r2">
        <description>`the rules in force include` OF `the 2023 rate change`</description>
        <inputEntry id="decision_gst_rate_percent_r2_i1">
          <text>[date("2023-01-01")..date("2024-01-01"))</text>
        </inputEntry>
        <outputEntry id="decision_gst_rate_percent_r2_o1">
          <text>8</text>
        </outputEntry>
        <annotationEntry>
          <text>the 2023 rate change — Goods and Services Tax (Amendment) Act 2022 — first step of the Budget 2022 increase (main.l4:55:1-56:43)</text>
        </annotationEntry>
      </rule>
      <rule id="decision_gst_rate_percent_r3">
        <description>`the rules in force include` OF `GST commenced`</description>
        <inputEntry id="decision_gst_rate_percent_r3_i1">
          <text>[date("1994-04-01")..date("2023-01-01"))</text>
        </inputEntry>
        <outputEntry id="decision_gst_rate_percent_r3_o1">
          <text>3</text>
        </outputEntry>
        <annotationEntry>
          <text>GST commenced — Goods and Services Tax Act 1993, s 16 — commencement (main.l4:59:1-60:36)</text>
        </annotationEntry>
      </rule>
      <rule id="decision_gst_rate_percent_r4">
        <description>OTHERWISE</description>
        <inputEntry id="decision_gst_rate_percent_r4_i1">
          <text>&lt; date("1994-04-01")</text>
        </inputEntry>
        <outputEntry id="decision_gst_rate_percent_r4_o1">
          <text>no_GST_rate_exists_before_commencement_on_1994_04_01</text>
        </outputEntry>
        <annotationEntry>
          <text>no GST rate exists before commencement on 1994-04-01</text>
        </annotationEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="decision_tourist_refund_minimum_spend" name="tourist_refund_minimum_spend" label="tourist refund minimum spend">
    <variable id="decision_tourist_refund_minimum_spend_var" name="tourist_refund_minimum_spend" label="tourist refund minimum spend" typeRef="number"/>
    <informationRequirement id="decision_tourist_refund_minimum_spend_ir1">
      <requiredInput href="#input_no_gst_rate_exists_before_commencement_on_1994_04_01"/>
    </informationRequirement>
    <informationRequirement id="decision_tourist_refund_minimum_spend_ir2">
      <requiredInput href="#input_rules_effective_date"/>
    </informationRequirement>
    <decisionTable id="decision_tourist_refund_minimum_spend_table" hitPolicy="UNIQUE" preferredOrientation="Rule-as-Row" outputLabel="tourist refund minimum spend">
      <input id="decision_tourist_refund_minimum_spend_i1" label="`RULES EFFECTIVE DATE`">
        <inputExpression id="decision_tourist_refund_minimum_spend_i1_expr" typeRef="date">
          <text>RULES_EFFECTIVE_DATE</text>
        </inputExpression>
      </input>
      <output id="decision_tourist_refund_minimum_spend_o1"/>
      <annotation name="regime"/>
      <rule id="decision_tourist_refund_minimum_spend_r1">
        <description>`RULES EFFECTIVE DATE` AT LEAST `the 2024 rate change`</description>
        <inputEntry id="decision_tourist_refund_minimum_spend_r1_i1">
          <text>&gt;= date("2024-01-01")</text>
        </inputEntry>
        <outputEntry id="decision_tourist_refund_minimum_spend_r1_o1">
          <text>100</text>
        </outputEntry>
        <annotationEntry>
          <text>the 2024 rate change — Goods and Services Tax (Amendment) Act 2022 — second step of the Budget 2022 increase (main.l4:51:1-52:43)</text>
        </annotationEntry>
      </rule>
      <rule id="decision_tourist_refund_minimum_spend_r2">
        <description>`RULES EFFECTIVE DATE` AT LEAST (Date OF 1, 4, 1994)</description>
        <inputEntry id="decision_tourist_refund_minimum_spend_r2_i1">
          <text>[date("1994-04-01")..date("2024-01-01"))</text>
        </inputEntry>
        <outputEntry id="decision_tourist_refund_minimum_spend_r2_o1">
          <text>300</text>
        </outputEntry>
        <annotationEntry>
          <text>from 1994-04-01</text>
        </annotationEntry>
      </rule>
      <rule id="decision_tourist_refund_minimum_spend_r3">
        <description>OTHERWISE</description>
        <inputEntry id="decision_tourist_refund_minimum_spend_r3_i1">
          <text>&lt; date("1994-04-01")</text>
        </inputEntry>
        <outputEntry id="decision_tourist_refund_minimum_spend_r3_o1">
          <text>no_GST_rate_exists_before_commencement_on_1994_04_01</text>
        </outputEntry>
        <annotationEntry>
          <text>no GST rate exists before commencement on 1994-04-01</text>
        </annotationEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="decision_gst_payable_on" name="GST_payable_on" label="GST payable on">
    <variable id="decision_gst_payable_on_var" name="GST_payable_on" label="GST payable on" typeRef="number"/>
    <informationRequirement id="decision_gst_payable_on_ir1">
      <requiredDecision href="#decision_gst_rate_percent"/>
    </informationRequirement>
    <informationRequirement id="decision_gst_payable_on_ir2">
      <requiredInput href="#input_supply_value"/>
    </informationRequirement>
    <literalExpression id="decision_gst_payable_on_literal">
      <text>supply_value * GST_rate_percent / 100</text>
    </literalExpression>
  </decision>
  <businessKnowledgeModel id="bkm_the_rules_in_force_include" name="the_rules_in_force_include" label="the rules in force include">
    <variable id="bkm_the_rules_in_force_include_var" name="the_rules_in_force_include" label="the rules in force include" typeRef="boolean"/>
    <encapsulatedLogic id="bkm_the_rules_in_force_include_logic">
      <formalParameter id="bkm_the_rules_in_force_include_p1" name="change" typeRef="date"/>
      <formalParameter id="bkm_the_rules_in_force_include_p2" name="RULES_EFFECTIVE_DATE" typeRef="date"/>
      <literalExpression id="bkm_the_rules_in_force_include_literal">
        <text>RULES_EFFECTIVE_DATE &gt;= change</text>
      </literalExpression>
    </encapsulatedLogic>
  </businessKnowledgeModel>
  <decisionService id="service_gst_rate" name="GST_rate" label="GST rate">
    <variable id="service_gst_rate_var" name="GST_rate" label="GST rate" typeRef="Any"/>
    <outputDecision href="#decision_the_2024_rate_change"/>
    <outputDecision href="#decision_the_2023_rate_change"/>
    <outputDecision href="#decision_gst_commenced"/>
    <outputDecision href="#decision_tourist_refund_minimum_spend"/>
    <outputDecision href="#decision_gst_payable_on"/>
    <encapsulatedDecision href="#decision_gst_rate_percent"/>
    <inputData href="#input_no_gst_rate_exists_before_commencement_on_1994_04_01"/>
    <inputData href="#input_rules_effective_date"/>
    <inputData href="#input_supply_value"/>
  </decisionService>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="definitions_gst_rate_diagram" name="GST rate">
      <dmndi:DMNShape id="input_no_gst_rate_exists_before_commencement_on_1994_04_01_shape" dmnElementRef="input_no_gst_rate_exists_before_commencement_on_1994_04_01">
        <dc:Bounds x="60" y="540" width="180" height="80"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="input_supply_value_shape" dmnElementRef="input_supply_value">
        <dc:Bounds x="280" y="540" width="180" height="80"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="input_rules_effective_date_shape" dmnElementRef="input_rules_effective_date">
        <dc:Bounds x="500" y="540" width="180" height="80"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="decision_the_2024_rate_change_shape" dmnElementRef="decision_the_2024_rate_change">
        <dc:Bounds x="60" y="380" width="180" height="80"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="decision_the_2023_rate_change_shape" dmnElementRef="decision_the_2023_rate_change">
        <dc:Bounds x="280" y="380" width="180" height="80"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="decision_gst_commenced_shape" dmnElementRef="decision_gst_commenced">
        <dc:Bounds x="500" y="380" width="180" height="80"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="decision_gst_rate_percent_shape" dmnElementRef="decision_gst_rate_percent">
        <dc:Bounds x="720" y="380" width="180" height="80"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="decision_tourist_refund_minimum_spend_shape" dmnElementRef="decision_tourist_refund_minimum_spend">
        <dc:Bounds x="940" y="380" width="180" height="80"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="decision_gst_payable_on_shape" dmnElementRef="decision_gst_payable_on">
        <dc:Bounds x="60" y="220" width="180" height="80"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="bkm_the_rules_in_force_include_shape" dmnElementRef="bkm_the_rules_in_force_include">
        <dc:Bounds x="60" y="60" width="180" height="80"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="service_gst_rate_shape" dmnElementRef="service_gst_rate">
        <dc:Bounds x="40" y="200" width="1100" height="280"/>
      </dmndi:DMNShape>
      <dmndi:DMNEdge id="decision_gst_rate_percent_ir1_edge" dmnElementRef="decision_gst_rate_percent_ir1">
        <di:waypoint x="150" y="540"/>
        <di:waypoint x="810" y="460"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="decision_gst_rate_percent_ir2_edge" dmnElementRef="decision_gst_rate_percent_ir2">
        <di:waypoint x="590" y="540"/>
        <di:waypoint x="810" y="460"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="decision_tourist_refund_minimum_spend_ir1_edge" dmnElementRef="decision_tourist_refund_minimum_spend_ir1">
        <di:waypoint x="150" y="540"/>
        <di:waypoint x="1030" y="460"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="decision_tourist_refund_minimum_spend_ir2_edge" dmnElementRef="decision_tourist_refund_minimum_spend_ir2">
        <di:waypoint x="590" y="540"/>
        <di:waypoint x="1030" y="460"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="decision_gst_payable_on_ir1_edge" dmnElementRef="decision_gst_payable_on_ir1">
        <di:waypoint x="810" y="380"/>
        <di:waypoint x="150" y="300"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="decision_gst_payable_on_ir2_edge" dmnElementRef="decision_gst_payable_on_ir2">
        <di:waypoint x="370" y="540"/>
        <di:waypoint x="150" y="300"/>
      </dmndi:DMNEdge>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
