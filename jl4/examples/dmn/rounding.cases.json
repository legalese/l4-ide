{
  "note": [
    "Engine cases for rounding.l4 (smucclaw/l4-ide#1103). Every expected value",
    "is what `l4 run` prints for the #EVAL lines at the end of that file, in",
    "order. The x values are the edges where FEEL could differ from L4: halves",
    "on both sides of zero for ROUND (which rounds a half to the even",
    "neighbour), negatives for FLOOR and CEILING, and an empty list for sum",
    "and count (L4 answers 0 for both; FEEL's own sum([]) answers null, which",
    "is why the export adds a leading 0)."
  ],
  "cases": [
    {
      "name": "A. x = 2.5, cap = 1, amounts = []",
      "context": {
        "x": 2.5,
        "cap": 1,
        "amounts": []
      },
      "expect": {
        "rounded_down": 2,
        "rounded_up": 3,
        "rounded": 2,
        "band": "low",
        "capped": 1,
        "at_least_the_cap": 2.5,
        "total": 0,
        "how_many": 0
      }
    },
    {
      "name": "B. x = 3.5, cap = 4, amounts = [3, 1, 2]",
      "context": {
        "x": 3.5,
        "cap": 4,
        "amounts": [
          3,
          1,
          2
        ]
      },
      "expect": {
        "rounded_down": 3,
        "rounded_up": 4,
        "rounded": 4,
        "band": "high",
        "capped": 3.5,
        "at_least_the_cap": 4,
        "total": 6,
        "how_many": 3
      }
    },
    {
