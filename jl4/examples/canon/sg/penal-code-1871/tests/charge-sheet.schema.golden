                    "description": "The threat meant to alarm, if any"
                },
                "misappropriation": {
                    "$ref": "#/$defs/Misappropriation Facts",
                    "description": "The dishonest dealing with movable property that was never taken wrongfully, if any"
                },
                "robbery": {
                    "$ref": "#/$defs/Robbery Facts",
                    "description": "The theft or extortion with violence, if any"
                },
                "theft": {
