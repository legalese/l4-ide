-- A field declared MAYBE with no TYPICALLY is a field with no default, and
-- WITHAL does not infer one from its type (TYPICALLY-ONE-BEHAVIOUR-SPEC.md T1,
-- ruled by Meng 2026-10-09, section 4.3). A decode of "{}" fills it NOTHING
-- (D7.3; ok/withal-decode.l4), so the decode succeeds where `Settings WITHAL`
-- is refused. A WITH that leaves the field out is refused for the same reason.

DECLARE Settings
  HAS limit IS A NUMBER TYPICALLY 10
      note  IS A MAYBE STRING

#EVAL Settings WITHAL

#EVAL Settings WITH limit IS 10

-- the repair: say what the field is
#EVAL Settings WITH note IS NOTHING

-- or give it a default, where the record is declared:
--   note IS A MAYBE STRING TYPICALLY NOTHING
