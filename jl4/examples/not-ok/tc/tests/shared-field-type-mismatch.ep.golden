-- SUM-TYPE-FIELDS-SPEC §3 S1: the same field name at DIFFERENT types across
-- the constructors of one type is an error at the declaration, naming every
-- constructor and the type it gives the field. The read below then gets
-- today's per-arm selectors — and today's ambiguity — rather than a cascade
-- of out-of-scope errors.

DECLARE Actor IS ONE OF
    Landlord HAS name IS A STRING
    Tenant   HAS name IS A NUMBER
    Agent    HAS name IS A STRING

theLandlord MEANS Landlord OF "L"

#EVAL theLandlord's name
