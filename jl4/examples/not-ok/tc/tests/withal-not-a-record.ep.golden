-- WITHAL builds a RECORD from its defaults. It is not offered on anything
-- else, and each refusal says what the name is instead
-- (TYPICALLY-ONE-BEHAVIOUR-SPEC.md T1, ruled by Meng 2026-10-09).
-- The name of a type that is not a record (`Shape WITHAL`) is the ordinary
-- "could not find a definition" error and nothing more, since only terms
-- resolve; its message carries the checker's inference counter, so l4-cli-test
-- pins it (withal-type-name.l4 in tests-cli/fixtures) and not a golden here.

DECLARE Shape IS ONE OF
  Rect HAS width IS A NUMBER, height IS A NUMBER TYPICALLY 1
  Dot

-- an alternative that carries data: its fields stay required, a TYPICALLY on
-- them or not (TYPICALLY-ONE-BEHAVIOUR-SPEC.md, "Not built here")
#EVAL Rect WITHAL

-- an alternative that carries nothing
#EVAL Dot WITHAL

-- a rule, even one whose every input has a default
GIVEN rate IS A NUMBER TYPICALLY 3
GIVETH A NUMBER
scaled MEANS rate TIMES 2

#EVAL scaled WITHAL

-- a field selector
DECLARE Paint HAS coats IS A NUMBER TYPICALLY 2

#EVAL coats WITHAL

-- a built-in alternative
#EVAL NOTHING WITHAL
