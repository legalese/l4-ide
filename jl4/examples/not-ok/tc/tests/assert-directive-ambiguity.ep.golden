-- T4 regression test: an ambiguous-but-well-typed expression under #ASSERT
-- must produce an AmbiguousTermError diagnostic (like #EVAL in
-- error-directive-ambiguity.l4), not crash the typechecker with
-- "internal error: expected unique result, got several".

ASSUME foo IS A FUNCTION FROM BOOLEAN TO BOOLEAN

GIVEN p IS A BOOLEAN
DECIDE foo OF p
  IF p

#ASSERT foo TRUE
