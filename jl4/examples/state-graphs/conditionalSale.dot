digraph {
    graph [rankdir=TB
          ,label=conditionalSale
          ,labelloc=t
          ,fontname=Helvetica
          ,fontsize=14];
    node [fontname=Helvetica
         ,fontsize=11];
    edge [fontname=Helvetica
         ,fontsize=10];
    0 [label="initial\nONE OF"
      ,fillcolor=white
      ,style=filled
      ,shape=diamond
      ,fillcolor="#fde8cc"];
    1 [label="seller must DeliverGoods ..."
      ,fillcolor=white
      ,style=filled
      ,shape=ellipse
      ,fillcolor="#ffffff"];
    2 [label=Fulfilled
      ,fillcolor=white
      ,style=filled
      ,shape=doublecircle
      ,fillcolor="#d4edda"];
    3 [label=Breach
      ,fillcolor=white
      ,style=filled
      ,shape=doublecircle
      ,fillcolor="#f8d7da"];
    0 -> 1 [label=" IF condition"
           ,color="#e8850c"
           ,style=dotted];
    0 -> 2 [label=" IF NOT (condition)"
           ,color="#e8850c"
           ,style=dotted];
    1 -> 2 [label="seller MUST DeliverGoods ... [14]"
           ,color="#28a745"
           ,style=solid];
    1 -> 3 [label=timeout
           ,color="#dc3545"
           ,style=dashed];
}
