digraph {
    graph [rankdir=TB
          ,label="Series A Financing"
          ,labelloc=t
          ,fontname=Helvetica
          ,fontsize=14];
    node [fontname=Helvetica
         ,fontsize=11];
    edge [fontname=Helvetica
         ,fontsize=10];
    0 [label=initial
      ,fillcolor=white
      ,style=filled
      ,shape=ellipse
      ,fillcolor="#e8f4fd"];
    1 [label="Series A Issue"
      ,fillcolor=white
      ,style=filled
      ,shape=ellipse
      ,fillcolor="#ffffff"];
    2 [label="HENCE of company must issue (shares\n300)"
      ,fillcolor=white
      ,style=filled
      ,shape=ellipse
      ,fillcolor="#ffffff"];
    3 [label=Breach
      ,fillcolor=white
      ,style=filled
      ,shape=doublecircle
      ,fillcolor="#f8d7da"];
    0 -> 1 [label="investor MUST pay 200 [10]"
           ,color="#28a745"
           ,style=solid];
    0 -> 3 [label="timeout [10]"
           ,color="#dc3545"
           ,style=dashed];
    1 -> 2 [label="company MUST issue (shares 300) [5]"
           ,color="#28a745"
           ,style=solid];
    1 -> 3 [label="timeout [5]"
           ,color="#dc3545"
           ,style=dashed];
}
