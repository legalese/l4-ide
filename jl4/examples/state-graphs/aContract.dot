digraph {
    graph [rankdir=TB
          ,label=aContract
          ,labelloc=t
          ,fontname=Helvetica
          ,fontsize=14];
    node [fontname=Helvetica
         ,fontsize=11];
    edge [fontname=Helvetica
         ,fontsize=10];
    0 [label=initial
      ,fillcolor=white
      ,style=filled
      ,shape=ellipse
      ,fillcolor="#e8f4fd"];
    1 [label="B must payment ..."
      ,fillcolor=white
      ,style=filled
      ,shape=ellipse
      ,fillcolor="#ffffff"];
    2 [label="next\nONE OF"
      ,fillcolor=white
      ,style=filled
      ,shape=diamond
      ,fillcolor="#fde8cc"];
    3 [label=Fulfilled
      ,fillcolor=white
      ,style=filled
      ,shape=doublecircle
      ,fillcolor="#d4edda"];
    4 [label="B must return"
      ,fillcolor=white
      ,style=filled
      ,shape=ellipse
      ,fillcolor="#ffffff"];
    5 [label=Breach
      ,fillcolor=white
      ,style=filled
      ,shape=doublecircle
      ,fillcolor="#f8d7da"];
    6 [label="B must payment ..."
      ,fillcolor=white
      ,style=filled
      ,shape=ellipse
      ,fillcolor="#ffffff"];
    0 -> 1 [label="S MUST delivery [3]"
           ,color="#28a745"
           ,style=solid];
    0 -> 5 [label=timeout
           ,color="#dc3545"
           ,style=dashed];
    1 -> 2 [label="B MUST payment ... [3] IF price AT LEAST 20"
           ,color="#28a745"
           ,style=solid];
    1 -> 6 [label=timeout
           ,color="#dc3545"
           ,style=dashed];
    2 -> 3 [label=" IF price EQUALS 20"
           ,color="#e8850c"
           ,style=dotted];
    2 -> 4 [label=" IF NOT (price EQUALS 20)"
           ,color="#e8850c"
           ,style=dotted];
    4 -> 3 [label="B MUST return [10]"
           ,color="#28a745"
           ,style=solid];
    4 -> 5 [label=timeout
           ,color="#dc3545"
           ,style=dashed];
    6 -> 3 [label="B MUST payment ... [3]"
           ,color="#28a745"
           ,style=solid];
    6 -> 5 [label=timeout
           ,color="#dc3545"
           ,style=dashed];
}
