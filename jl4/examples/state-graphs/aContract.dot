digraph {
    graph [rankdir=TB
          ,label=aContract
          ,labelloc=t
          ,fontname=Helvetica
          ,fontsize=14];
    node [fontname=Helvetica
         ,fontsize=11];
    edge [fontname=Helvetica
         ,fontsize=10];
    0 [label=initial
      ,fillcolor=white
      ,style=filled
      ,shape=ellipse
      ,fillcolor="#e8f4fd"];
    1 [label="B must payment price WITHIN 3"
      ,fillcolor=white
      ,style=filled
      ,shape=ellipse
      ,fillcolor="#ffffff"];
    2 [label="HENCE of B must payment price\nIF: ONE OF"
      ,fillcolor=white
      ,style=filled
      ,shape=diamond
      ,fillcolor="#fde8cc"];
    3 [label=Fulfilled
      ,fillcolor=white
      ,style=filled
      ,shape=doublecircle
      ,fillcolor="#d4edda"];
    4 [label="B must return WITHIN 10"
      ,fillcolor=white
      ,style=filled
      ,shape=ellipse
      ,fillcolor="#ffffff"];
    5 [label=Breach
      ,fillcolor=white
      ,style=filled
      ,shape=doublecircle
      ,fillcolor="#f8d7da"];
    6 [label="B must payment fine WITHIN 3"
      ,fillcolor=white
      ,style=filled
      ,shape=ellipse
      ,fillcolor="#ffffff"];
    0 -> 1 [label="S MUST delivery [3]"
           ,color="#28a745"
           ,style=solid];
    0 -> 5 [label="timeout [3]"
           ,color="#dc3545"
           ,style=dashed];
    1 -> 2 [label="IF price AT LEAST 20\nthe rule binds `price`"
           ,color="#28a745"
           ,style=solid];
    1 -> 6 [label="timeout [3]"
           ,color="#dc3545"
           ,style=dashed];
    2 -> 3 [label="IF price EQUALS 20"
           ,color="#e8850c"
           ,style=dotted];
    2 -> 4 [label="IF NOT (price EQUALS 20)"
           ,color="#e8850c"
           ,style=dotted];
    4 -> 3 [label="the rule binds `return`"
           ,color="#28a745"
           ,style=solid];
    4 -> 5 [label="timeout [10]"
           ,color="#dc3545"
           ,style=dashed];
    6 -> 3 [label="B MUST payment fine [3]"
           ,color="#28a745"
           ,style=solid];
    6 -> 5 [label="timeout [3]"
           ,color="#dc3545"
           ,style=dashed];
}
