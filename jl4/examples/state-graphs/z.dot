digraph {
    graph [rankdir=TB
          ,label=z
          ,labelloc=t
          ,fontname=Helvetica
          ,fontsize=14];
    node [fontname=Helvetica
         ,fontsize=11];
    edge [fontname=Helvetica
         ,fontsize=10];
    0 [label="initial\nROR: ONE OF"
      ,fillcolor=white
      ,style=filled
      ,shape=diamond
      ,fillcolor="#fde8cc"];
    1 [label=x
      ,fillcolor=white
      ,style=filled
      ,shape=ellipse
      ,fillcolor="#ffffff"];
    2 [label=Fulfilled
      ,fillcolor=white
      ,style=filled
      ,shape=doublecircle
      ,fillcolor="#d4edda"];
    3 [label=Breach
      ,fillcolor=white
      ,style=filled
      ,shape=doublecircle
      ,fillcolor="#f8d7da"];
    4 [label=y
      ,fillcolor=white
      ,style=filled
      ,shape=ellipse
      ,fillcolor="#ffffff"];
    0 -> 1 [label=""
           ,color="#e8850c"
           ,style=dotted];
    0 -> 4 [label=""
           ,color="#e8850c"
           ,style=dotted];
    1 -> 2 [label="S MUST delivery [3]"
           ,color="#28a745"
           ,style=solid];
    1 -> 3 [label="timeout [3]"
           ,color="#dc3545"
           ,style=dashed];
    4 -> 2 [label="B MUST payment n [5]"
           ,color="#28a745"
           ,style=solid];
    4 -> 3 [label="timeout [5]"
           ,color="#dc3545"
           ,style=dashed];
}
