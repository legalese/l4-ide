digraph {
    graph [rankdir=TB
          ,label="Equity Financing Conversion"
          ,labelloc=t
          ,fontname=Helvetica
          ,fontsize=14];
    node [fontname=Helvetica
         ,fontsize=11];
    edge [fontname=Helvetica
         ,fontsize=10];
    0 [label=initial
      ,fillcolor=white
      ,style=filled
      ,shape=ellipse
      ,fillcolor="#e8f4fd"];
    1 [label="ActorCompany OF startup must\n`Equity Financing Transaction` efts"
      ,fillcolor=white
      ,style=filled
      ,shape=ellipse
      ,fillcolor="#ffffff"];
    2 [label=Fulfilled
      ,fillcolor=white
      ,style=filled
      ,shape=doublecircle
      ,fillcolor="#d4edda"];
    3 [label=Breach
      ,fillcolor=white
      ,style=filled
      ,shape=doublecircle
      ,fillcolor="#f8d7da"];
    0 -> 1 [label="ActorCompany OF startup MUST\n`Convert SAFE` issue IF issue EQUALS\n(`Cap Table Entry` OF\n(`SAFE investment`'s Holder),\n(Security WITH Instrument IS\n\"Preference Shares\"\nName IS \"Class A (converted from\nSAFE)\"\nQuantity IS Shares OF numShares,\n`SAFE Purchase Amount`))\nthe rule binds `issue`"
           ,color="#28a745"
           ,style=solid];
    0 -> 3 [label="unreachable: no WITHIN"
           ,color="#dc3545"
           ,style=dashed];
    1 -> 2 [label="IF all OF (GIVEN eft YIELD ((eft's\nsecurity)'s Instrument) EQUALS\n\"Preference Shares\"), efts\nthe rule binds `efts`"
           ,color="#28a745"
           ,style=solid];
    1 -> 3 [label="unreachable: no WITHIN"
           ,color="#dc3545"
           ,style=dashed];
}
