digraph {
    graph [rankdir=TB
          ,label="Pay Until Zero"
          ,labelloc=t
          ,fontname=Helvetica
          ,fontsize=14];
    node [fontname=Helvetica
         ,fontsize=11];
    edge [fontname=Helvetica
         ,fontsize=10];
    0 [label="initial\nIF: ONE OF"
      ,fillcolor=white
      ,style=filled
      ,shape=diamond
      ,fillcolor="#fde8cc"];
    1 [label=Fulfilled
      ,fillcolor=white
      ,style=filled
      ,shape=doublecircle
      ,fillcolor="#d4edda"];
    2 [label="Buyer must pay 50 WITHIN 30"
      ,fillcolor=white
      ,style=filled
      ,shape=ellipse
      ,fillcolor="#ffffff"];
    3 [label=Breach
      ,fillcolor=white
      ,style=filled
      ,shape=doublecircle
      ,fillcolor="#f8d7da"];
    0 -> 1 [label="IF (symtab's total) EQUALS (symtab's\npaid)"
           ,color="#e8850c"
           ,style=dotted];
    0 -> 2 [label="IF NOT ((symtab's total) EQUALS\n(symtab's paid))"
           ,color="#e8850c"
           ,style=dotted];
    2 -> 0 [label="Buyer MUST pay 50 [30]"
           ,color="#28a745"
           ,style=solid];
    2 -> 3 [label="timeout [30]"
           ,color="#dc3545"
           ,style=dashed];
}
