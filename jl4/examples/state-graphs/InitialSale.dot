digraph {
    graph [rankdir=TB
          ,label="Initial Sale"
          ,labelloc=t
          ,fontname=Helvetica
          ,fontsize=14];
    node [fontname=Helvetica
         ,fontsize=11];
    edge [fontname=Helvetica
         ,fontsize=10];
    0 [label=initial
      ,fillcolor=white
      ,style=filled
      ,shape=ellipse
      ,fillcolor="#e8f4fd"];
    1 [label="Pay Until Zero\nONE OF"
      ,fillcolor=white
      ,style=filled
      ,shape=diamond
      ,fillcolor="#fde8cc"];
    2 [label=Fulfilled
      ,fillcolor=white
      ,style=filled
      ,shape=doublecircle
      ,fillcolor="#d4edda"];
    3 [label="Buyer must pay ..."
      ,fillcolor=white
      ,style=filled
      ,shape=ellipse
      ,fillcolor="#ffffff"];
    4 [label=Breach
      ,fillcolor=white
      ,style=filled
      ,shape=doublecircle
      ,fillcolor="#f8d7da"];
    0 -> 1 [label="Seller MUST deliver ... [10]"
           ,color="#28a745"
           ,style=solid];
    0 -> 4 [label=timeout
           ,color="#dc3545"
           ,style=dashed];
    1 -> 2 [label=" IF (symtab's total) EQUALS (symtab's paid)"
           ,color="#e8850c"
           ,style=dotted];
    1 -> 3 [label=" IF NOT ((symtab's total) EQUALS (symtab's paid))"
           ,color="#e8850c"
           ,style=dotted];
    3 -> 1 [label="Buyer MUST pay ... [30]"
           ,color="#28a745"
           ,style=solid];
    3 -> 4 [label=timeout
           ,color="#dc3545"
           ,style=dashed];
}
