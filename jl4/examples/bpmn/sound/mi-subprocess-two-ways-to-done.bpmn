<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_twoways"
                  targetNamespace="https://l4.legalese.com/bpmn"
                  exporter="jl4 (L4.Bpmn)"
                  exporterVersion="1">
  <bpmn:itemDefinition id="Item_board" structureRef="java.util.List" />
  <bpmn:itemDefinition id="Item_d" structureRef="String" />
  <bpmn:process id="Process_twoways" name="an instance with two ways to be finished" isExecutable="false">
    <bpmn:property id="board" name="board" itemSubjectRef="Item_board" />
    <bpmn:startEvent id="Start_0" />
    <bpmn:subProcess id="Sub_0" name="EVERY Director d IN board">
      <bpmn:documentation>A permission under UPON EACH. Each director MAY approve within
P30D; a director who approves creates the chair's duty to publish, and a director
who lets the permission lapse ends their own instance FULFILLED. Both are ways of
being finished, and they meet at the one end event inside the scope.</bpmn:documentation>
      <bpmn:ioSpecification id="IO_Sub_0">
        <bpmn:dataInput id="Sub_0_input" name="MultiInstanceInput" itemSubjectRef="Item_board" />
        <bpmn:inputSet id="InputSet_Sub_0">
          <bpmn:dataInputRefs>Sub_0_input</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="OutputSet_Sub_0" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="DIA_Sub_0">
        <bpmn:sourceRef>board</bpmn:sourceRef>
        <bpmn:targetRef>Sub_0_input</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:multiInstanceLoopCharacteristics id="MultiInstance_Sub_0" isSequential="false">
        <bpmn:loopDataInputRef>Sub_0_input</bpmn:loopDataInputRef>
        <bpmn:inputDataItem id="d" name="d" itemSubjectRef="Item_d" />
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="Start_Sub_0" />
      <bpmn:task id="Task_0" name="MAY Approve ..." />
      <bpmn:boundaryEvent id="Boundary_0" name="lapses" attachedToRef="Task_0" cancelActivity="true">
        <bpmn:timerEventDefinition id="Timer_Boundary_0">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:task id="Task_1" name="MUST Publish ..." />
      <bpmn:endEvent id="End_Sub_ok" name="Fulfilled" />
      <bpmn:sequenceFlow id="Flow_s0" sourceRef="Start_Sub_0" targetRef="Task_0" />
      <bpmn:sequenceFlow id="Flow_s1" sourceRef="Task_0" targetRef="Task_1" />
      <bpmn:sequenceFlow id="Flow_s2" sourceRef="Task_1" targetRef="End_Sub_ok" />
      <bpmn:sequenceFlow id="Flow_s3" sourceRef="Boundary_0" targetRef="End_Sub_ok" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_2" name="Fulfilled" />
    <bpmn:sequenceFlow id="Flow_t0" sourceRef="Start_0" targetRef="Sub_0" />
    <bpmn:sequenceFlow id="Flow_t1" sourceRef="Sub_0" targetRef="End_2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_0">
    <bpmndi:BPMNPlane id="Plane_0" bpmnElement="Process_twoways">
      <bpmndi:BPMNShape id="Shape_Start_0" bpmnElement="Start_0">
        <dc:Bounds x="160" y="160" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Sub_0" bpmnElement="Sub_0" isExpanded="true">
        <dc:Bounds x="250" y="80" width="520" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_Sub_0" bpmnElement="Start_Sub_0">
        <dc:Bounds x="280" y="160" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_0" bpmnElement="Task_0">
        <dc:Bounds x="360" y="138" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Boundary_0" bpmnElement="Boundary_0">
        <dc:Bounds x="414" y="200" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_1" bpmnElement="Task_1">
        <dc:Bounds x="520" y="138" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Sub_ok" bpmnElement="End_Sub_ok">
        <dc:Bounds x="680" y="160" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_2" bpmnElement="End_2">
        <dc:Bounds x="830" y="160" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_t0" bpmnElement="Flow_t0">
        <di:waypoint x="196" y="178" />
        <di:waypoint x="250" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_t1" bpmnElement="Flow_t1">
        <di:waypoint x="770" y="178" />
        <di:waypoint x="830" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_s0" bpmnElement="Flow_s0">
        <di:waypoint x="316" y="178" />
        <di:waypoint x="360" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_s1" bpmnElement="Flow_s1">
        <di:waypoint x="460" y="178" />
        <di:waypoint x="520" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_s2" bpmnElement="Flow_s2">
        <di:waypoint x="620" y="178" />
        <di:waypoint x="680" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_s3" bpmnElement="Flow_s3">
        <di:waypoint x="432" y="236" />
        <di:waypoint x="432" y="258" />
        <di:waypoint x="698" y="258" />
        <di:waypoint x="698" y="196" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
