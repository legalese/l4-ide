<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_fork"
                  targetNamespace="https://l4.legalese.com/bpmn"
                  exporter="jl4 (L4.Bpmn)"
                  exporterVersion="1">
  <bpmn:error id="Error_breach" name="Breach" errorCode="BREACH" />
  <bpmn:escalation id="Escalation_breach" name="Breach" escalationCode="BREACH" />
  <bpmn:itemDefinition id="Item_tenants" structureRef="java.util.List" />
  <bpmn:itemDefinition id="Item_t" structureRef="String" />
  <bpmn:process id="Process_fork" name="a fork drawn as a multi-instance sub-process" isExecutable="false">
    <bpmn:property id="tenants" name="tenants" itemSubjectRef="Item_tenants" />
    <bpmn:startEvent id="Start_0" />
    <bpmn:subProcess id="Sub_0" name="EVERY Tenant t IN tenants">
      <bpmn:ioSpecification id="IO_Sub_0">
        <bpmn:dataInput id="Sub_0_input" name="MultiInstanceInput" itemSubjectRef="Item_tenants" />
        <bpmn:inputSet id="InputSet_Sub_0">
          <bpmn:dataInputRefs>Sub_0_input</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="OutputSet_Sub_0" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="DIA_Sub_0">
        <bpmn:sourceRef>tenants</bpmn:sourceRef>
        <bpmn:targetRef>Sub_0_input</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:multiInstanceLoopCharacteristics id="MultiInstance_Sub_0" isSequential="false">
        <bpmn:loopDataInputRef>Sub_0_input</bpmn:loopDataInputRef>
        <bpmn:inputDataItem id="t" name="t" itemSubjectRef="Item_t" />
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="Start_Sub_0" />
      <bpmn:task id="Task_0" name="MUST Pay ...">
        <bpmn:documentation>one instance per member, bound to t</bpmn:documentation>
      </bpmn:task>
      <bpmn:boundaryEvent id="Boundary_0" name="after P7D" attachedToRef="Task_0" cancelActivity="true">
        <bpmn:timerEventDefinition id="Timer_Boundary_0">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:task id="Task_1" name="MUST Receipt ..." />
      <bpmn:boundaryEvent id="Boundary_1" name="after P5D" attachedToRef="Task_1" cancelActivity="true">
        <bpmn:timerEventDefinition id="Timer_Boundary_1">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:endEvent id="End_Sub_ok" name="Fulfilled" />
      <bpmn:endEvent id="End_Sub_breach_0" name="Breach">
        <bpmn:escalationEventDefinition id="EscDef_End_Sub_breach_0" escalationRef="Escalation_breach" />
      </bpmn:endEvent>
      <bpmn:endEvent id="End_Sub_breach_1" name="Breach">
        <bpmn:escalationEventDefinition id="EscDef_End_Sub_breach_1" escalationRef="Escalation_breach" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_s0" sourceRef="Start_Sub_0" targetRef="Task_0" />
      <bpmn:sequenceFlow id="Flow_s1" sourceRef="Task_0" targetRef="Task_1" />
      <bpmn:sequenceFlow id="Flow_s2" sourceRef="Task_1" targetRef="End_Sub_ok" />
      <bpmn:sequenceFlow id="Flow_s3" sourceRef="Boundary_0" targetRef="End_Sub_breach_0" />
      <bpmn:sequenceFlow id="Flow_s4" sourceRef="Boundary_1" targetRef="End_Sub_breach_1" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Boundary_Sub_0_esc" name="a member breached" attachedToRef="Sub_0" cancelActivity="false">
      <bpmn:escalationEventDefinition id="EscDef_Boundary_Sub_0" escalationRef="Escalation_breach" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_2" name="Fulfilled" />
    <bpmn:endEvent id="End_3" name="Breach">
      <bpmn:documentation>Reaching this end stops the run for every member, including the members who did nothing wrong: an error end here ends every active thread in the process, so the instances still going are cancelled along with the one that breached. This fixture keeps that shape on purpose — the exporter stopped emitting it on 2026-09-19 and now gives a fork its own plain breach end instead (see P-FORK-BREACH-UNMARKED) — because what this file pins is how the soundness checker plays a multi-instance scope, not how the exporter draws one.</bpmn:documentation>
      <bpmn:errorEventDefinition id="ErrorDef_End_3" errorRef="Error_breach" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_t0" sourceRef="Start_0" targetRef="Sub_0" />
    <bpmn:sequenceFlow id="Flow_t1" sourceRef="Sub_0" targetRef="End_2" />
    <bpmn:sequenceFlow id="Flow_t2" sourceRef="Boundary_Sub_0_esc" targetRef="End_3" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_0">
    <bpmndi:BPMNPlane id="Plane_0" bpmnElement="Process_fork">
      <bpmndi:BPMNShape id="Shape_Start_0" bpmnElement="Start_0">
        <dc:Bounds x="140" y="257" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Sub_0" bpmnElement="Sub_0" isExpanded="true">
        <dc:Bounds x="220" y="170" width="520" height="210" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_Sub_0" bpmnElement="Start_Sub_0">
        <dc:Bounds x="250" y="257" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_0" bpmnElement="Task_0">
        <dc:Bounds x="320" y="235" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Boundary_0" bpmnElement="Boundary_0">
        <dc:Bounds x="362" y="297" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_1" bpmnElement="Task_1">
        <dc:Bounds x="480" y="235" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Boundary_1" bpmnElement="Boundary_1">
        <dc:Bounds x="522" y="297" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Sub_ok" bpmnElement="End_Sub_ok">
        <dc:Bounds x="650" y="257" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Sub_breach_0" bpmnElement="End_Sub_breach_0">
        <dc:Bounds x="362" y="340" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Sub_breach_1" bpmnElement="End_Sub_breach_1">
        <dc:Bounds x="522" y="340" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Boundary_Sub_0_esc" bpmnElement="Boundary_Sub_0_esc">
        <dc:Bounds x="462" y="362" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_2" bpmnElement="End_2">
        <dc:Bounds x="820" y="257" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_3" bpmnElement="End_3">
        <dc:Bounds x="820" y="460" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_s0" bpmnElement="Flow_s0">
        <di:waypoint x="286" y="275" />
        <di:waypoint x="320" y="275" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_s1" bpmnElement="Flow_s1">
        <di:waypoint x="440" y="275" />
        <di:waypoint x="480" y="275" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_s2" bpmnElement="Flow_s2">
        <di:waypoint x="600" y="275" />
        <di:waypoint x="650" y="275" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_s3" bpmnElement="Flow_s3">
        <di:waypoint x="380" y="333" />
        <di:waypoint x="380" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_s4" bpmnElement="Flow_s4">
        <di:waypoint x="540" y="333" />
        <di:waypoint x="540" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_t0" bpmnElement="Flow_t0">
        <di:waypoint x="176" y="275" />
        <di:waypoint x="220" y="275" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_t1" bpmnElement="Flow_t1">
        <di:waypoint x="740" y="275" />
        <di:waypoint x="820" y="275" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_t2" bpmnElement="Flow_t2">
        <di:waypoint x="480" y="398" />
        <di:waypoint x="480" y="478" />
        <di:waypoint x="820" y="478" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
