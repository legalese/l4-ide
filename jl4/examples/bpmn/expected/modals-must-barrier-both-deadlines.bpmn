<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_quorum_by_ten"
                  targetNamespace="https://l4.legalese.com/bpmn"
                  exporter="jl4 (L4.Bpmn)"
                  exporterVersion="1">
  <bpmn:error id="Error_breach" name="Breach" errorCode="BREACH" />
  <bpmn:itemDefinition id="Item_quorum_by_ten_d_cast" structureRef="java.util.List" />
  <bpmn:itemDefinition id="Item_quorum_by_ten_d_cast_member" structureRef="java.lang.Object" />
  <bpmn:collaboration id="Collaboration_quorum_by_ten">
    <bpmn:participant id="Participant_quorum_by_ten" name="quorum by ten" processRef="Process_quorum_by_ten" />
  </bpmn:collaboration>
  <bpmn:process id="Process_quorum_by_ten" name="quorum by ten" isExecutable="false">
    <bpmn:property id="quorum_by_ten_d_cast" name="quorum_by_ten_d_cast" itemSubjectRef="Item_quorum_by_ten_d_cast" />
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_1_EVERY_Director_d_IN_board" name="EVERY Director d IN board">
        <bpmn:flowNodeRef>Task_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_0</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_unassigned" name="(unassigned)">
        <bpmn:flowNodeRef>Start_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_0" />
    <bpmn:task id="Task_0" name="MUST Approve ...">
      <bpmn:documentation>EVERY Director d IN board MUST Approve ... WITHIN 30 ONCE ALL HAVE WITHIN 10 — one instance per member of the cast, each bound to ‘d’; the cast is fixed only when the rule runs, so the activity carries no cardinality (P-CAST). ONCE ALL HAVE: the outgoing flow fires once, when every instance has completed — which is what a parallel multi-instance activity&apos;s completion means, so this barrier is drawn faithfully.</bpmn:documentation>
      <bpmn:ioSpecification id="IoSpec_Task_0">
        <bpmn:dataInput id="DataInput_Task_0" name="quorum_by_ten_d_cast" itemSubjectRef="Item_quorum_by_ten_d_cast" isCollection="true" />
        <bpmn:inputSet id="InputSet_Task_0">
          <bpmn:dataInputRefs>DataInput_Task_0</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="OutputSet_Task_0" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="DataInputAssoc_Task_0">
        <bpmn:sourceRef>quorum_by_ten_d_cast</bpmn:sourceRef>
        <bpmn:targetRef>DataInput_Task_0</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:multiInstanceLoopCharacteristics id="MultiInstance_Task_0" isSequential="false">
        <bpmn:loopDataInputRef>DataInput_Task_0</bpmn:loopDataInputRef>
        <bpmn:inputDataItem id="DataItem_Task_0" name="d" itemSubjectRef="Item_quorum_by_ten_d_cast_member" />
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:task>
    <bpmn:boundaryEvent id="Boundary_0" name="after P30D" attachedToRef="Task_0" cancelActivity="true">
      <bpmn:documentation>LEST: the obligation is not discharged within 30</bpmn:documentation>
      <bpmn:timerEventDefinition id="Timer_Boundary_0">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_1" name="Fulfilled" />
    <bpmn:endEvent id="End_2" name="Breach">
      <bpmn:errorEventDefinition id="ErrorDef_End_2" errorRef="Error_breach" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_0__Task_0" sourceRef="Start_0" targetRef="Task_0" />
    <bpmn:sequenceFlow id="Flow_Task_0__End_1" sourceRef="Task_0" targetRef="End_1" />
    <bpmn:sequenceFlow id="Flow_Boundary_0__End_2" sourceRef="Boundary_0" targetRef="End_2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_quorum_by_ten">
      <bpmndi:BPMNShape id="Shape_Participant_quorum_by_ten" bpmnElement="Participant_quorum_by_ten" isHorizontal="true">
        <dc:Bounds x="130" y="80" width="590" height="440" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_1_EVERY_Director_d_IN_board" bpmnElement="Lane_1_EVERY_Director_d_IN_board" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="560" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_unassigned" bpmnElement="Lane_unassigned" isHorizontal="true">
        <dc:Bounds x="160" y="240" width="560" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_0" bpmnElement="Start_0">
        <dc:Bounds x="232" y="282" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_0" bpmnElement="Task_0">
        <dc:Bounds x="380" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Boundary_0" bpmnElement="Boundary_0">
        <dc:Bounds x="434" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_1" bpmnElement="End_1">
        <dc:Bounds x="592" y="282" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_2" bpmnElement="End_2">
        <dc:Bounds x="592" y="402" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_Start_0__Task_0" bpmnElement="Flow_Start_0__Task_0">
        <di:waypoint x="268" y="300" />
        <di:waypoint x="314" y="300" />
        <di:waypoint x="314" y="140" />
        <di:waypoint x="380" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Task_0__End_1" bpmnElement="Flow_Task_0__End_1">
        <di:waypoint x="480" y="140" />
        <di:waypoint x="494" y="140" />
        <di:waypoint x="494" y="300" />
        <di:waypoint x="592" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Boundary_0__End_2" bpmnElement="Flow_Boundary_0__End_2">
        <di:waypoint x="452" y="198" />
        <di:waypoint x="546" y="198" />
        <di:waypoint x="546" y="420" />
        <di:waypoint x="592" y="420" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
