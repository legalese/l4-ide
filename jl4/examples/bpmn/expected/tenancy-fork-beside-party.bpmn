        <dc:Bounds x="130" y="80" width="770" height="1028" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_1_EVERY_Tenant_t_IN_tenants" bpmnElement="Lane_1_EVERY_Tenant_t_IN_tenants" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="740" height="348" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_2_theLandlord" bpmnElement="Lane_2_theLandlord" isHorizontal="true">
        <dc:Bounds x="160" y="428" width="740" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_unassigned" bpmnElement="Lane_unassigned" isHorizontal="true">
        <dc:Bounds x="160" y="588" width="740" height="520" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_0" bpmnElement="Start_0">
        <dc:Bounds x="232" y="630" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Split_0" bpmnElement="Split_0">
        <dc:Bounds x="405" y="623" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_1" bpmnElement="Task_1">
        <dc:Bounds x="380" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Boundary_1" bpmnElement="Boundary_1">
        <dc:Bounds x="434" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_2" bpmnElement="End_2">
        <dc:Bounds x="772" y="630" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_3" bpmnElement="End_3">
        <dc:Bounds x="772" y="750" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_4" bpmnElement="Task_4">
        <dc:Bounds x="560" y="448" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Boundary_4" bpmnElement="Boundary_4">
        <dc:Bounds x="614" y="510" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Scope_1" bpmnElement="Scope_1" isExpanded="true">
        <dc:Bounds x="208" y="76" width="444" height="246" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndGroup_1" bpmnElement="EndGroup_1">
        <dc:Bounds x="772" y="870" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartScope_1" bpmnElement="StartScope_1">
        <dc:Bounds x="232" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndScope_1" bpmnElement="EndScope_1">
        <dc:Bounds x="592" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EscScope_1" bpmnElement="EscScope_1">
        <dc:Bounds x="592" y="242" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndBreach_1" bpmnElement="EndBreach_1">
        <dc:Bounds x="772" y="990" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_BoundaryEsc_1" bpmnElement="BoundaryEsc_1">
        <dc:Bounds x="606" y="304" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_Start_0__Split_0" bpmnElement="Flow_Start_0__Split_0">
        <di:waypoint x="268" y="648" />
        <di:waypoint x="314" y="648" />
        <di:waypoint x="405" y="648" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Split_0__Scope_1" bpmnElement="Flow_Split_0__Scope_1">
        <di:waypoint x="455" y="648" />
        <di:waypoint x="494" y="648" />
        <di:waypoint x="494" y="199" />
        <di:waypoint x="208" y="199" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Split_0__Task_4" bpmnElement="Flow_Split_0__Task_4">
        <di:waypoint x="455" y="648" />
        <di:waypoint x="511" y="648" />
        <di:waypoint x="511" y="488" />
        <di:waypoint x="560" y="488" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Task_1__EndScope_1" bpmnElement="Flow_Task_1__EndScope_1">
        <di:waypoint x="480" y="140" />
