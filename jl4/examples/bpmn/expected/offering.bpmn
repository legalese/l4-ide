<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_the_offering"
                  targetNamespace="https://l4.legalese.com/bpmn"
                  exporter="jl4 (L4.Bpmn)"
                  exporterVersion="1">
  <bpmn:error id="Error_breach" name="Breach" errorCode="BREACH" />
  <bpmn:collaboration id="Collaboration_the_offering">
    <bpmn:participant id="Participant_the_offering" name="the offering" processRef="Process_the_offering" />
  </bpmn:collaboration>
  <bpmn:process id="Process_the_offering" name="the offering" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_1_Issuer" name="Issuer">
        <bpmn:flowNodeRef>Task_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2_Intermediary" name="Intermediary">
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3_Investor" name="Investor">
        <bpmn:flowNodeRef>Task_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_unassigned" name="(unassigned)">
        <bpmn:flowNodeRef>Start_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Split_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_0" />
    <bpmn:task id="Task_0" name="MUST file the offering statement">
      <bpmn:documentation>PARTY Issuer MUST file the offering statement WITHIN 21</bpmn:documentation>
    </bpmn:task>
    <bpmn:boundaryEvent id="Boundary_0" name="after P21D" attachedToRef="Task_0" cancelActivity="true">
      <bpmn:documentation>LEST: the obligation is not discharged within 21</bpmn:documentation>
      <bpmn:timerEventDefinition id="Timer_Boundary_0">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P21D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:parallelGateway id="Split_1" name="all of" gatewayDirection="Diverging">
      <bpmn:documentation>RAND: every branch is entered</bpmn:documentation>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_2" name="MUST check the investor limit">
      <bpmn:documentation>PARTY Intermediary MUST check the investor limit WITHIN 7</bpmn:documentation>
    </bpmn:task>
    <bpmn:boundaryEvent id="Boundary_2" name="after P7D" attachedToRef="Task_2" cancelActivity="true">
      <bpmn:documentation>LEST: the obligation is not discharged within 7</bpmn:documentation>
      <bpmn:timerEventDefinition id="Timer_Boundary_2">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_3" name="Fulfilled" />
    <bpmn:endEvent id="End_4" name="Breach">
      <bpmn:errorEventDefinition id="ErrorDef_End_4" errorRef="Error_breach" />
    </bpmn:endEvent>
    <bpmn:task id="Task_5" name="SHANT advertise the terms">
      <bpmn:documentation>PARTY Issuer SHANT advertise the terms WITHIN 30 — completing this activity means the prohibited act was performed, which is the LEST arm</bpmn:documentation>
    </bpmn:task>
    <bpmn:boundaryEvent id="Boundary_5" name="after P30D, not performed" attachedToRef="Task_5" cancelActivity="true">
      <bpmn:documentation>the deadline passes (30) with the prohibited act not performed: the prohibition is respected, so this is the HENCE arm</bpmn:documentation>
      <bpmn:timerEventDefinition id="Timer_Boundary_5">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="Task_6" name="MUST file the annual report">
      <bpmn:documentation>PARTY Issuer MUST file the annual report WITHIN 120</bpmn:documentation>
    </bpmn:task>
    <bpmn:boundaryEvent id="Boundary_6" name="after P120D" attachedToRef="Task_6" cancelActivity="true">
      <bpmn:documentation>LEST: the obligation is not discharged within 120</bpmn:documentation>
      <bpmn:timerEventDefinition id="Timer_Boundary_6">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P120D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="Task_7" name="SHANT resell the securities">
      <bpmn:documentation>PARTY Investor SHANT resell the securities WITHIN 365 — completing this activity means the prohibited act was performed, which is the LEST arm</bpmn:documentation>
    </bpmn:task>
    <bpmn:boundaryEvent id="Boundary_7" name="after P365D, not performed" attachedToRef="Task_7" cancelActivity="true">
      <bpmn:documentation>the deadline passes (365) with the prohibited act not performed: the prohibition is respected, so this is the HENCE arm</bpmn:documentation>
      <bpmn:timerEventDefinition id="Timer_Boundary_7">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P365D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_Start_0__Task_0" sourceRef="Start_0" targetRef="Task_0" />
    <bpmn:sequenceFlow id="Flow_Task_0__Split_1" sourceRef="Task_0" targetRef="Split_1" />
    <bpmn:sequenceFlow id="Flow_Boundary_0__End_4" sourceRef="Boundary_0" targetRef="End_4" />
    <bpmn:sequenceFlow id="Flow_Split_1__Task_2" sourceRef="Split_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_Split_1__Task_5" sourceRef="Split_1" targetRef="Task_5" />
    <bpmn:sequenceFlow id="Flow_Split_1__Task_6" sourceRef="Split_1" targetRef="Task_6" />
    <bpmn:sequenceFlow id="Flow_Split_1__Task_7" sourceRef="Split_1" targetRef="Task_7" />
    <bpmn:sequenceFlow id="Flow_Task_2__End_3" sourceRef="Task_2" targetRef="End_3" />
    <bpmn:sequenceFlow id="Flow_Boundary_2__End_4" sourceRef="Boundary_2" targetRef="End_4" />
    <bpmn:sequenceFlow id="Flow_Boundary_5__End_3" sourceRef="Boundary_5" targetRef="End_3" />
    <bpmn:sequenceFlow id="Flow_Task_5__End_4" sourceRef="Task_5" targetRef="End_4" />
    <bpmn:sequenceFlow id="Flow_Task_6__End_3" sourceRef="Task_6" targetRef="End_3" />
    <bpmn:sequenceFlow id="Flow_Boundary_6__End_4" sourceRef="Boundary_6" targetRef="End_4" />
    <bpmn:sequenceFlow id="Flow_Boundary_7__End_3" sourceRef="Boundary_7" targetRef="End_3" />
    <bpmn:sequenceFlow id="Flow_Task_7__End_4" sourceRef="Task_7" targetRef="End_4" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_the_offering">
      <bpmndi:BPMNShape id="Shape_Participant_the_offering" bpmnElement="Participant_the_offering" isHorizontal="true">
        <dc:Bounds x="130" y="80" width="950" height="880" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_1_Issuer" bpmnElement="Lane_1_Issuer" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="920" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_2_Intermediary" bpmnElement="Lane_2_Intermediary" isHorizontal="true">
