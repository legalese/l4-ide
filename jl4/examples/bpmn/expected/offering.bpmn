      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Boundary_7" bpmnElement="Boundary_7">
        <dc:Bounds x="794" y="602" width="36" height="36" />
      </bpmndi:BPMNShape>
