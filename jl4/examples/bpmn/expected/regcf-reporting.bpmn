      <bpmndi:BPMNShape id="Shape_End_2" bpmnElement="End_2">
        <dc:Bounds x="1852" y="522" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_3" bpmnElement="End_3">
        <dc:Bounds x="1672" y="402" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_4" bpmnElement="Task_4">
        <dc:Bounds x="1820" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Boundary_4" bpmnElement="Boundary_4">
        <dc:Bounds x="1874" y="282" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Decide_0" bpmnElement="Decide_0">
        <dc:Bounds x="1820" y="620" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_Start_0__Decide_0" bpmnElement="Flow_Start_0__Decide_0">
        <di:waypoint x="268" y="420" />
        <di:waypoint x="314" y="420" />
        <di:waypoint x="314" y="480" />
        <di:waypoint x="1754" y="480" />
        <di:waypoint x="1754" y="660" />
        <di:waypoint x="1820" y="660" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Split_0__Task_1" bpmnElement="Flow_Split_0__Task_1">
        <di:waypoint x="1895" y="420" />
        <di:waypoint x="1934" y="420" />
        <di:waypoint x="1934" y="140" />
        <di:waypoint x="1820" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Split_0__End_2" bpmnElement="Flow_Split_0__End_2">
        <di:waypoint x="1895" y="420" />
        <di:waypoint x="1944" y="420" />
        <di:waypoint x="1944" y="540" />
        <di:waypoint x="1852" y="540" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Split_0__Task_4" bpmnElement="Flow_Split_0__Task_4">
        <di:waypoint x="1895" y="420" />
        <di:waypoint x="1954" y="420" />
        <di:waypoint x="1954" y="260" />
        <di:waypoint x="1820" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Task_1__End_2" bpmnElement="Flow_Task_1__End_2">
        <di:waypoint x="1920" y="140" />
