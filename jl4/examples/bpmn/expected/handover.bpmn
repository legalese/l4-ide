<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_the_handover"
                  targetNamespace="https://l4.legalese.com/bpmn"
                  exporter="jl4 (L4.Bpmn)"
                  exporterVersion="1">
  <bpmn:collaboration id="Collaboration_the_handover">
    <bpmn:participant id="Participant_the_handover" name="the handover" processRef="Process_the_handover" />
  </bpmn:collaboration>
  <bpmn:process id="Process_the_handover" name="the handover" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_1_Tenant" name="Tenant">
        <bpmn:flowNodeRef>Task_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_0</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2_Landlord" name="Landlord">
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_unassigned" name="(unassigned)">
        <bpmn:flowNodeRef>Start_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Split_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Split_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_0" />
    <bpmn:task id="Task_0" name="MUST give vacant possession">
      <bpmn:documentation>PARTY Tenant MUST give vacant possession WITHIN `grace period`</bpmn:documentation>
    </bpmn:task>
    <bpmn:boundaryEvent id="Boundary_0" name="timeout" attachedToRef="Task_0" cancelActivity="true">
      <bpmn:documentation>LEST: the obligation is not discharged within `grace period`</bpmn:documentation>
      <bpmn:conditionalEventDefinition id="Cond_Boundary_0">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">`grace period`</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:parallelGateway id="Split_1" name="all of" gatewayDirection="Diverging">
      <bpmn:documentation>RAND: every branch is entered</bpmn:documentation>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_2" name="MAY inspect the premises">
      <bpmn:documentation>PARTY Landlord MAY inspect the premises WITHIN 7</bpmn:documentation>
    </bpmn:task>
    <bpmn:endEvent id="End_3" name="Fulfilled" />
    <bpmn:task id="Task_4" name="MAY photograph the premises">
      <bpmn:documentation>PARTY Landlord MAY photograph the premises WITHIN 7</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Split_5" name="one of" gatewayDirection="Diverging">
      <bpmn:documentation>ROR: exactly one branch is entered</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_6" name="MAY retain the deposit">
      <bpmn:documentation>PARTY Landlord MAY retain the deposit WITHIN 30</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="Task_7" name="MAY apply to the tribunal">
      <bpmn:documentation>PARTY Landlord MAY apply to the tribunal WITHIN 30</bpmn:documentation>
    </bpmn:task>
    <bpmn:parallelGateway id="Join_1" gatewayDirection="Converging">
      <bpmn:documentation>every branch of the RAND must complete</bpmn:documentation>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_Start_0__Task_0" sourceRef="Start_0" targetRef="Task_0" />
    <bpmn:sequenceFlow id="Flow_Task_0__Split_1" sourceRef="Task_0" targetRef="Split_1" />
    <bpmn:sequenceFlow id="Flow_Boundary_0__Split_5" sourceRef="Boundary_0" targetRef="Split_5" />
    <bpmn:sequenceFlow id="Flow_Split_1__Task_2" sourceRef="Split_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_Split_1__Task_4" sourceRef="Split_1" targetRef="Task_4" />
    <bpmn:sequenceFlow id="Flow_Task_2__Join_1" sourceRef="Task_2" targetRef="Join_1" />
    <bpmn:sequenceFlow id="Flow_Task_4__Join_1" sourceRef="Task_4" targetRef="Join_1" />
    <bpmn:sequenceFlow id="Flow_Split_5__Task_6" sourceRef="Split_5" targetRef="Task_6" />
    <bpmn:sequenceFlow id="Flow_Split_5__Task_7" sourceRef="Split_5" targetRef="Task_7" />
    <bpmn:sequenceFlow id="Flow_Task_6__End_3" sourceRef="Task_6" targetRef="End_3" />
    <bpmn:sequenceFlow id="Flow_Task_7__End_3" sourceRef="Task_7" targetRef="End_3" />
    <bpmn:sequenceFlow id="Flow_Join_1__End_3" sourceRef="Join_1" targetRef="End_3" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_the_handover">
      <bpmndi:BPMNShape id="Shape_Participant_the_handover" bpmnElement="Participant_the_handover" isHorizontal="true">
        <dc:Bounds x="130" y="80" width="1130" height="960" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_1_Tenant" bpmnElement="Lane_1_Tenant" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1100" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_2_Landlord" bpmnElement="Lane_2_Landlord" isHorizontal="true">
        <dc:Bounds x="160" y="240" width="1100" height="520" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_unassigned" bpmnElement="Lane_unassigned" isHorizontal="true">
        <dc:Bounds x="160" y="760" width="1100" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_0" bpmnElement="Start_0">
        <dc:Bounds x="232" y="802" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_0" bpmnElement="Task_0">
        <dc:Bounds x="380" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Boundary_0" bpmnElement="Boundary_0">
        <dc:Bounds x="434" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Split_1" bpmnElement="Split_1">
        <dc:Bounds x="585" y="795" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_2" bpmnElement="Task_2">
        <dc:Bounds x="740" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_3" bpmnElement="End_3">
        <dc:Bounds x="1132" y="802" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_4" bpmnElement="Task_4">
        <dc:Bounds x="740" y="380" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Split_5" bpmnElement="Split_5">
        <dc:Bounds x="585" y="915" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_6" bpmnElement="Task_6">
        <dc:Bounds x="740" y="500" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_7" bpmnElement="Task_7">
        <dc:Bounds x="740" y="620" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Join_1" bpmnElement="Join_1">
        <dc:Bounds x="945" y="795" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_Start_0__Task_0" bpmnElement="Flow_Start_0__Task_0">
        <di:waypoint x="268" y="820" />
        <di:waypoint x="324" y="820" />
        <di:waypoint x="324" y="140" />
        <di:waypoint x="380" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Task_0__Split_1" bpmnElement="Flow_Task_0__Split_1">
        <di:waypoint x="480" y="140" />
        <di:waypoint x="532" y="140" />
        <di:waypoint x="532" y="820" />
        <di:waypoint x="585" y="820" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Boundary_0__Split_5" bpmnElement="Flow_Boundary_0__Split_5">
        <di:waypoint x="452" y="198" />
        <di:waypoint x="452" y="940" />
        <di:waypoint x="585" y="940" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Split_1__Task_2" bpmnElement="Flow_Split_1__Task_2">
        <di:waypoint x="635" y="820" />
        <di:waypoint x="687" y="820" />
        <di:waypoint x="687" y="300" />
        <di:waypoint x="740" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Split_1__Task_4" bpmnElement="Flow_Split_1__Task_4">
        <di:waypoint x="635" y="820" />
        <di:waypoint x="687" y="820" />
        <di:waypoint x="687" y="420" />
        <di:waypoint x="740" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Task_2__Join_1" bpmnElement="Flow_Task_2__Join_1">
        <di:waypoint x="840" y="300" />
        <di:waypoint x="892" y="300" />
        <di:waypoint x="892" y="820" />
        <di:waypoint x="945" y="820" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Task_4__Join_1" bpmnElement="Flow_Task_4__Join_1">
        <di:waypoint x="840" y="420" />
        <di:waypoint x="892" y="420" />
        <di:waypoint x="892" y="820" />
        <di:waypoint x="945" y="820" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Split_5__Task_6" bpmnElement="Flow_Split_5__Task_6">
        <di:waypoint x="635" y="940" />
        <di:waypoint x="687" y="940" />
        <di:waypoint x="687" y="540" />
        <di:waypoint x="740" y="540" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Split_5__Task_7" bpmnElement="Flow_Split_5__Task_7">
        <di:waypoint x="635" y="940" />
        <di:waypoint x="687" y="940" />
        <di:waypoint x="687" y="660" />
        <di:waypoint x="740" y="660" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Task_6__End_3" bpmnElement="Flow_Task_6__End_3">
        <di:waypoint x="840" y="540" />
        <di:waypoint x="986" y="540" />
        <di:waypoint x="986" y="820" />
        <di:waypoint x="1132" y="820" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Task_7__End_3" bpmnElement="Flow_Task_7__End_3">
        <di:waypoint x="840" y="660" />
        <di:waypoint x="986" y="660" />
        <di:waypoint x="986" y="820" />
        <di:waypoint x="1132" y="820" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Join_1__End_3" bpmnElement="Flow_Join_1__End_3">
        <di:waypoint x="995" y="820" />
        <di:waypoint x="1132" y="820" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
