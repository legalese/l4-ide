<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_advertising_restriction"
                  targetNamespace="https://l4.legalese.com/bpmn"
                  exporter="jl4 (L4.Bpmn)"
                  exporterVersion="1">
  <bpmn:error id="Error_breach" name="Breach" errorCode="BREACH" />
  <bpmn:collaboration id="Collaboration_advertising_restriction">
    <bpmn:participant id="Participant_advertising_restriction" name="advertising restriction" processRef="Process_advertising_restriction" />
  </bpmn:collaboration>
  <bpmn:process id="Process_advertising_restriction" name="advertising restriction" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_1_Issuer" name="Issuer">
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_unassigned" name="(unassigned)">
        <bpmn:flowNodeRef>Start_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Split_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_0" />
    <bpmn:exclusiveGateway id="Split_0" name="one of" gatewayDirection="Diverging">
      <bpmn:documentation>ROR: exactly one branch is entered</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_1" name="Fulfilled" />
    <bpmn:task id="Task_2" name="SHANT advertise the terms of the offering">
      <bpmn:documentation>PARTY Issuer SHANT advertise the terms of the offering — completing this activity means the prohibited act was performed, which is the LEST arm</bpmn:documentation>
    </bpmn:task>
    <bpmn:boundaryEvent id="Boundary_2" name="unreachable: no WITHIN" attachedToRef="Task_2" cancelActivity="true">
      <bpmn:documentation>the prohibition is respected once its deadline passes with the act not performed, so this is the HENCE arm — but the rule sets no WITHIN, so nothing reaches it: a prohibition with no deadline is discharged by neither the clock nor the act</bpmn:documentation>
      <bpmn:conditionalEventDefinition id="Cond_Boundary_2">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">unreachable: no WITHIN</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_3" name="Breach">
      <bpmn:errorEventDefinition id="ErrorDef_End_3" errorRef="Error_breach" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_0__Split_0" sourceRef="Start_0" targetRef="Split_0" />
    <bpmn:sequenceFlow id="Flow_Split_0__End_1" sourceRef="Split_0" targetRef="End_1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">`notice complies with Rule 204(b)` OF notice</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Split_0__Task_2" sourceRef="Split_0" targetRef="Task_2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">NOT (`notice complies with Rule 204(b)` OF notice)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Boundary_2__End_1" sourceRef="Boundary_2" targetRef="End_1" />
    <bpmn:sequenceFlow id="Flow_Task_2__End_3" sourceRef="Task_2" targetRef="End_3" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_advertising_restriction">
      <bpmndi:BPMNShape id="Shape_Participant_advertising_restriction" bpmnElement="Participant_advertising_restriction" isHorizontal="true">
        <dc:Bounds x="130" y="80" width="770" height="440" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_1_Issuer" bpmnElement="Lane_1_Issuer" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="740" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_unassigned" bpmnElement="Lane_unassigned" isHorizontal="true">
        <dc:Bounds x="160" y="240" width="740" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_0" bpmnElement="Start_0">
        <dc:Bounds x="232" y="282" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Split_0" bpmnElement="Split_0">
        <dc:Bounds x="405" y="275" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_1" bpmnElement="End_1">
        <dc:Bounds x="772" y="282" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_2" bpmnElement="Task_2">
        <dc:Bounds x="560" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Boundary_2" bpmnElement="Boundary_2">
        <dc:Bounds x="614" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_3" bpmnElement="End_3">
        <dc:Bounds x="772" y="402" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_Start_0__Split_0" bpmnElement="Flow_Start_0__Split_0">
        <di:waypoint x="268" y="300" />
        <di:waypoint x="314" y="300" />
        <di:waypoint x="405" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Split_0__End_1" bpmnElement="Flow_Split_0__End_1">
        <di:waypoint x="455" y="300" />
        <di:waypoint x="494" y="300" />
        <di:waypoint x="494" y="360" />
        <di:waypoint x="674" y="360" />
        <di:waypoint x="674" y="300" />
        <di:waypoint x="772" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Split_0__Task_2" bpmnElement="Flow_Split_0__Task_2">
        <di:waypoint x="455" y="300" />
        <di:waypoint x="520" y="300" />
        <di:waypoint x="520" y="140" />
        <di:waypoint x="560" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Boundary_2__End_1" bpmnElement="Flow_Boundary_2__End_1">
        <di:waypoint x="632" y="198" />
        <di:waypoint x="700" y="198" />
        <di:waypoint x="700" y="300" />
        <di:waypoint x="772" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Task_2__End_3" bpmnElement="Flow_Task_2__End_3">
        <di:waypoint x="660" y="140" />
        <di:waypoint x="726" y="140" />
        <di:waypoint x="726" y="420" />
        <di:waypoint x="772" y="420" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
