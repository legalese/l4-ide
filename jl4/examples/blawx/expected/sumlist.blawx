mutation><field name="prefix1"></field><field name="prefix2">and</field><field name="prefix3">and</field><field name="prefix4">and</field><field name="postfix">are related as go</field><value name="parameter1"><block type="variable" id="l4b000071"><field name="variable_name">Xs</field></block></value><value name="parameter2"><block type="variable" id="l4b000072"><field name="variable_name">Floor</field></block></value><value name="parameter3"><block type="head_tail" id="l4b000073"><value name="head"><block type="variable" id="l4b000074"><field name="variable_name">Y</field></block></value><value name="tail"><block type="variable" id="l4b000075"><field name="variable_name">Rest</field></block></value></block></value><value name="parameter4"><block type="variable" id="l4b000076"><field name="variable_name">Tmp</field></block></value></block></statement></block>
