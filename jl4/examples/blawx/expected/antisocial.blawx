      #pred holds(Z,-is_a_body,X) :: 'the conclusion in @(Z) that it is not the case that @(X) is a body holds'.
      #pred according_to(Z,is_a_body,X) :: 'according to @(Z), @(X) is a body'.
      #pred according_to(Z,-is_a_body,X) :: 'according to @(Z), it is not the case that @(X) is a body'.
      #pred blawx_defeated(Z,is_a_body,X) :: 'the conclusion in @(Z) that @(X) is a body is defeated'.
      #pred blawx_defeated(Z,-is_a_body,X) :: 'the conclusion in @(Z) that @(X) is a body is defeated'.
      #pred blawx_initially(is_a_body(X)) :: 'that @(X) is a body holds initially'.
      #pred blawx_initially(-is_a_body(X)) :: 'that it is not the case that @(X) is a body holds initially'.
      #pred blawx_ultimately(is_a_body(X)) :: 'that @(X) is a body holds ultimately'.
      #pred blawx_ultimately(-is_a_body(X)) :: 'that it is not the case that @(X) is a body holds ultimately'.
      #pred blawx_as_of(is_a_body(X),T) :: 'that @(X) is a body holds at @(T)'.
      #pred blawx_as_of(-is_a_body(X),T) :: 'that it is not the case that @(X) is a body holds at @(T)'.
      #pred blawx_during(T1,is_a_body(X),T2) :: 'that @(X) is a body held between @(T1) and @(T2)'.
      #pred blawx_during(T1,-is_a_body(X),T2) :: 'that it is not the case that @(X) is a body held between @(T1) and @(T2)'.
      #pred blawx_becomes(is_a_body(X),T) :: 'that @(X) is a body became true at @(T)'.
      #pred blawx_becomes(-is_a_body(X),T) :: 'that it is not the case that @(X) is a body became true at @(T)'.
      #pred blawx_not_interrupted(Start,is_a_body(X),End) :: '@(X) is a body remained the case between @(Start) and @(End)'.
      #pred blawx_not_interrupted(Start,-is_a_body(X),End) :: 'it is not the case that @(X) is a body remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),is_a_body(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-is_a_body(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
