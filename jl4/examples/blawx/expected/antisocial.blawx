      #pred blawx_not_interrupted(Start,-conduct(X,Y),End) :: 'it is not the case that @(X) has conduct of @(Y) remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),conduct(X,Y),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-conduct(X,Y),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
