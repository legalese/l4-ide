      #pred blawx_not_interrupted(Start,-is_authorised(X),End) :: 'it is not the case that @(X) is authorised remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),is_authorised(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-is_authorised(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(Start),-is_authorised(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(is_authorised(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(bot),is_authorised(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(-is_authorised(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(bot),-is_authorised(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(is_authorised(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(Start),is_authorised(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(-is_authorised(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(Start),-is_authorised(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(is_authorised(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(bot),is_authorised(X),datetime(eot)) :- blawx_initially(is_authorised(X)), blawx_ultimately(is_authorised(X)), findall(Time,blawx_becomes(-is_authorised(X),datetime(Time)),[]).
      blawx_not_interrupted(datetime(bot),-is_authorised(X),datetime(eot)) :- blawx_initially(-is_authorised(X)), blawx_ultimately(-is_authorised(X)), findall(Time,blawx_becomes(is_authorised(X),datetime(Time)),[]).
      blawx_as_of(is_authorised(X),datetime(Time)) :- blawx_initially(is_authorised(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),is_authorised(X),datetime(BeforeT)).
      blawx_as_of(is_authorised(X),datetime(Time)) :- blawx_becomes(is_authorised(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),is_authorised(X),datetime(Time)).
      blawx_as_of(-is_authorised(X),datetime(Time)) :- blawx_initially(-is_authorised(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-is_authorised(X),datetime(BeforeT)).
