      blawx_during(datetime(Start),-is_authorised(X),datetime(End)) :- blawx_becomes(-is_authorised(X),datetime(Start)), blawx_becomes(is_authorised(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),-is_authorised(X),datetime(End)).
