      :- dynamic is_a_body/1.
      #pred is_a_body(X) :: '@(X) is a body'.
      #pred holds(user,is_a_body,X) :: 'it is provided as a fact that @(X) is a body'.
      #pred holds(user,-is_a_body,X) :: 'it is provided as a fact that it is not the case that @(X) is a body'.
