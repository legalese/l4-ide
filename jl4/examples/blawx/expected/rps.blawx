      blawx_not_interrupted(datetime(bot),-first_player_wins(X),datetime(eot)) :- blawx_initially(-first_player_wins(X)), blawx_ultimately(-first_player_wins(X)), findall(Time,blawx_becomes(first_player_wins(X),datetime(Time)),[]).
      blawx_as_of(first_player_wins(X),datetime(Time)) :- blawx_initially(first_player_wins(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),first_player_wins(X),datetime(BeforeT)).
