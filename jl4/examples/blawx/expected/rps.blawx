      blawx_during(datetime(Start),beats(X,Y),datetime(eot)) :- blawx_ultimately(beats(X,Y)), blawx_becomes(-beats(X,Y),datetime(Start)), blawx_not_interrupted(datetime(Start),beats(X,Y),datetime(eot)).
      blawx_during(datetime(bot),beats(X,Y),datetime(eot)) :- blawx_initially(beats(X,Y)), blawx_ultimately(beats(X,Y)), blawx_becomes(-beats(X,Y),datetime(Start)), blawx_not_interrupted(datetime(bot),beats(X,Y),datetime(eot)).
      blawx_during(datetime(Start),-beats(X,Y),datetime(End)) :- blawx_becomes(-beats(X,Y),datetime(Start)), blawx_becomes(beats(X,Y),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),-beats(X,Y),datetime(End)).
      blawx_during(datetime(bot),-beats(X,Y),datetime(End)) :- blawx_initially(-beats(X,Y)), blawx_becomes(beats(X,Y),datetime(End)), blawx_not_interrupted(datetime(bot),-beats(X,Y),datetime(End)).
      blawx_during(datetime(Start),-beats(X,Y),datetime(eot)) :- blawx_ultimately(-beats(X,Y)), blawx_becomes(beats(X,Y),datetime(Start)), blawx_not_interrupted(datetime(Start),-beats(X,Y),datetime(eot)).
      blawx_during(datetime(bot),-beats(X,Y),datetime(eot)) :- blawx_initially(-beats(X,Y)), blawx_ultimately(-beats(X,Y)), blawx_becomes(-beats(X,Y),datetime(Start)), blawx_not_interrupted(datetime(bot),-beats(X,Y),datetime(eot)).

      sign(rock).
      sign(paper).
      sign(scissors).
