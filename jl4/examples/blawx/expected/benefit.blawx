      blawx_during(datetime(Start),benefit_amount(X,Y),datetime(eot)) :- blawx_ultimately(benefit_amount(X,Y)), blawx_becomes(-benefit_amount(X,Y),datetime(Start)), blawx_not_interrupted(datetime(Start),benefit_amount(X,Y),datetime(eot)).
      blawx_during(datetime(bot),benefit_amount(X,Y),datetime(eot)) :- blawx_initially(benefit_amount(X,Y)), blawx_ultimately(benefit_amount(X,Y)), blawx_becomes(-benefit_amount(X,Y),datetime(Start)), blawx_not_interrupted(datetime(bot),benefit_amount(X,Y),datetime(eot)).
      blawx_during(datetime(Start),-benefit_amount(X,Y),datetime(End)) :- blawx_becomes(-benefit_amount(X,Y),datetime(Start)), blawx_becomes(benefit_amount(X,Y),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),-benefit_amount(X,Y),datetime(End)).
      blawx_during(datetime(bot),-benefit_amount(X,Y),datetime(End)) :- blawx_initially(-benefit_amount(X,Y)), blawx_becomes(benefit_amount(X,Y),datetime(End)), blawx_not_interrupted(datetime(bot),-benefit_amount(X,Y),datetime(End)).
      blawx_during(datetime(Start),-benefit_amount(X,Y),datetime(eot)) :- blawx_ultimately(-benefit_amount(X,Y)), blawx_becomes(benefit_amount(X,Y),datetime(Start)), blawx_not_interrupted(datetime(Start),-benefit_amount(X,Y),datetime(eot)).
      blawx_during(datetime(bot),-benefit_amount(X,Y),datetime(eot)) :- blawx_initially(-benefit_amount(X,Y)), blawx_ultimately(-benefit_amount(X,Y)), blawx_becomes(-benefit_amount(X,Y),datetime(Start)), blawx_not_interrupted(datetime(bot),-benefit_amount(X,Y),datetime(eot)).
      blawx_attribute(applicant,bonus,number).
      blawx_attribute_nlg(bonus,ov,"","has bonus of","").
      :- dynamic bonus/2.
      #pred bonus(X,Y) :: '@(X) has bonus of @(Y)'.
      #pred holds(user,bonus,X,Y) :: 'it is provided as a fact that @(X) has bonus of @(Y)'.
      #pred holds(user,-bonus,X,Y) :: 'it is provided as a fact that it is not the case that @(X) has bonus of @(Y)'.
      #pred holds(Z,bonus,X,Y) :: 'the conclusion in @(Z) that @(X) has bonus of @(Y) holds'.
      #pred holds(Z,-bonus,X,Y) :: 'the conclusion in @(Z) that it is not the case that @(X) has bonus of @(Y) holds'.
      #pred according_to(Z,bonus,X,Y) :: 'according to @(Z), @(X) has bonus of @(Y)'.
      #pred according_to(Z,-bonus,X,Y) :: 'according to @(Z), it is not the case that @(X) has bonus of @(Y)'.
      #pred blawx_defeated(Z,bonus,X,Y) :: 'the conclusion in @(Z) that @(X) has bonus of @(Y) is defeated'.
      #pred blawx_defeated(Z,-bonus,X,Y) :: 'the conclusion in @(Z) that @(X) has bonus of @(Y) is defeated'.
      #pred blawx_initially(bonus(X,Y)) :: 'that @(X) has bonus of @(Y) holds initially'.
      #pred blawx_initially(-bonus(X,Y)) :: 'that it is not the case that @(X) has bonus of @(Y) holds initially'.
      #pred blawx_ultimately(bonus(X,Y)) :: 'that @(X) has bonus of @(Y) holds ultimately'.
      #pred blawx_ultimately(-bonus(X,Y)) :: 'that it is not the case that @(X) has bonus of @(Y) holds ultimately'.
      #pred blawx_as_of(bonus(X,Y),T) :: 'that @(X) has bonus of @(Y) holds at @(T)'.
      #pred blawx_as_of(-bonus(X,Y),T) :: 'that it is not the case that @(X) has bonus of @(Y) holds at @(T)'.
      #pred blawx_during(T1,bonus(X,Y),T2) :: 'that @(X) has bonus of @(Y) held between @(T1) and @(T2)'.
      #pred blawx_during(T1,-bonus(X,Y),T2) :: 'that it is not the case that @(X) has bonus of @(Y) held between @(T1) and @(T2)'.
      #pred blawx_becomes(bonus(X,Y),T) :: 'that @(X) has bonus of @(Y) became true at @(T)'.
      #pred blawx_becomes(-bonus(X,Y),T) :: 'that it is not the case that @(X) has bonus of @(Y) became true at @(T)'.
      #pred blawx_not_interrupted(Start,bonus(X,Y),End) :: '@(X) has bonus of @(Y) remained the case between @(Start) and @(End)'.
      #pred blawx_not_interrupted(Start,-bonus(X,Y),End) :: 'it is not the case that @(X) has bonus of @(Y) remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),bonus(X,Y),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-bonus(X,Y),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(Start),-bonus(X,Y),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(bonus(X,Y),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(bot),bonus(X,Y),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(-bonus(X,Y),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(bot),-bonus(X,Y),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(bonus(X,Y),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(Start),bonus(X,Y),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(-bonus(X,Y),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(Start),-bonus(X,Y),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(bonus(X,Y),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(bot),bonus(X,Y),datetime(eot)) :- blawx_initially(bonus(X,Y)), blawx_ultimately(bonus(X,Y)), findall(Time,blawx_becomes(-bonus(X,Y),datetime(Time)),[]).
      blawx_not_interrupted(datetime(bot),-bonus(X,Y),datetime(eot)) :- blawx_initially(-bonus(X,Y)), blawx_ultimately(-bonus(X,Y)), findall(Time,blawx_becomes(bonus(X,Y),datetime(Time)),[]).
      blawx_as_of(bonus(X,Y),datetime(Time)) :- blawx_initially(bonus(X,Y)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),bonus(X,Y),datetime(BeforeT)).
      blawx_as_of(bonus(X,Y),datetime(Time)) :- blawx_becomes(bonus(X,Y),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),bonus(X,Y),datetime(Time)).
      blawx_as_of(-bonus(X,Y),datetime(Time)) :- blawx_initially(-bonus(X,Y)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-bonus(X,Y),datetime(BeforeT)).
      blawx_as_of(-bonus(X,Y),datetime(Time)) :- blawx_becomes(-bonus(X,Y),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),-bonus(X,Y),datetime(Time)).
      blawx_during(datetime(Start),bonus(X,Y),datetime(End)) :- blawx_becomes(bonus(X,Y),datetime(Start)), blawx_becomes(-bonus(X,Y),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),bonus(X,Y),datetime(End)).
      blawx_during(datetime(bot),bonus(X,Y),datetime(End)) :- blawx_initially(bonus(X,Y)), blawx_becomes(-bonus(X,Y),datetime(End)), blawx_not_interrupted(datetime(bot),bonus(X,Y),datetime(End)).
      blawx_during(datetime(Start),bonus(X,Y),datetime(eot)) :- blawx_ultimately(bonus(X,Y)), blawx_becomes(-bonus(X,Y),datetime(Start)), blawx_not_interrupted(datetime(Start),bonus(X,Y),datetime(eot)).
      blawx_during(datetime(bot),bonus(X,Y),datetime(eot)) :- blawx_initially(bonus(X,Y)), blawx_ultimately(bonus(X,Y)), blawx_becomes(-bonus(X,Y),datetime(Start)), blawx_not_interrupted(datetime(bot),bonus(X,Y),datetime(eot)).
      blawx_during(datetime(Start),-bonus(X,Y),datetime(End)) :- blawx_becomes(-bonus(X,Y),datetime(Start)), blawx_becomes(bonus(X,Y),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),-bonus(X,Y),datetime(End)).
      blawx_during(datetime(bot),-bonus(X,Y),datetime(End)) :- blawx_initially(-bonus(X,Y)), blawx_becomes(bonus(X,Y),datetime(End)), blawx_not_interrupted(datetime(bot),-bonus(X,Y),datetime(End)).
      blawx_during(datetime(Start),-bonus(X,Y),datetime(eot)) :- blawx_ultimately(-bonus(X,Y)), blawx_becomes(bonus(X,Y),datetime(Start)), blawx_not_interrupted(datetime(Start),-bonus(X,Y),datetime(eot)).
      blawx_during(datetime(bot),-bonus(X,Y),datetime(eot)) :- blawx_initially(-bonus(X,Y)), blawx_ultimately(-bonus(X,Y)), blawx_becomes(-bonus(X,Y),datetime(Start)), blawx_not_interrupted(datetime(bot),-bonus(X,Y),datetime(eot)).
- model: blawx.workspace
  pk: 2
  fields:
    ruledoc: 1
    workspace_name: sec_1_section
    xml_content: |-
      <xml xmlns="https://developers.google.com/blockly/xml">
      <block type="attributed_rule" id="l4b000009" x="40" y="40"><field name="defeasible">FALSE</field><field name="inapplicable">FALSE</field><statement name="conditions"><block type="object_category" id="l4b000010"><value name="object"><block type="variable" id="l4b000011"><field name="variable_name">A</field></block></value><value name="category"><block type="category_selector" id="l4b000012"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="applicant"></mutation><field name="category_name">applicant</field></block></value><next><block type="attribute_selector" id="l4b000013"><mutation xmlns="http://www.w3.org/1999/xhtml" attributename="age" attributetype="number" attributeorder="ov"></mutation><field name="prefix"></field><field name="infix">has age of</field><field name="postfix"></field><value name="first_element"><block type="variable" id="l4b000014"><field name="variable_name">A</field></block></value><value name="second_element"><block type="variable" id="l4b000015"><field name="variable_name">Age</field></block></value><next><block type="numerical_constraint" id="l4b000016"><field name="operator">gte</field><value name="first_comparator"><block type="variable" id="l4b000017"><field name="variable_name">Age</field></block></value><value name="second_comparator"><block type="number_value" id="l4b000018"><field name="value">65</field></block></value><next><block type="attribute_selector" id="l4b000019"><mutation xmlns="http://www.w3.org/1999/xhtml" attributename="income" attributetype="number" attributeorder="ov"></mutation><field name="prefix"></field><field name="infix">has income of</field><field name="postfix"></field><value name="first_element"><block type="variable" id="l4b000020"><field name="variable_name">A</field></block></value><value name="second_element"><block type="variable" id="l4b000021"><field name="variable_name">Income</field></block></value><next><block type="numerical_constraint" id="l4b000022"><field name="operator">lte</field><value name="first_comparator"><block type="variable" id="l4b000023"><field name="variable_name">Income</field></block></value><value name="second_comparator"><block type="number_value" id="l4b000024"><field name="value">100000</field></block></value></block></next></block></next></block></next></block></next></block></statement><value name="source"><block type="doc_selector" id="l4b000025"><mutation xmlns="http://www.w3.org/1999/xhtml" section_reference="sec_1_section"></mutation><field name="doc_part_name">B 1</field></block></value><statement name="conclusion"><block type="unary_attribute_selector" id="l4b000026"><mutation xmlns="http://www.w3.org/1999/xhtml" attributename="eligible_for_benefit" attributetype="boolean"></mutation><field name="prefix"></field><field name="postfix">eligible for benefit</field><value name="first_element"><block type="variable" id="l4b000027"><field name="variable_name">A</field></block></value></block></statement></block>
      <block type="attributed_rule" id="l4b000028" x="40" y="718"><field name="defeasible">FALSE</field><field name="inapplicable">FALSE</field><statement name="conditions"><block type="object_category" id="l4b000029"><value name="object"><block type="variable" id="l4b000030"><field name="variable_name">A</field></block></value><value name="category"><block type="category_selector" id="l4b000031"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="applicant"></mutation><field name="category_name">applicant</field></block></value><next><block type="unary_attribute_selector" id="l4b000032"><mutation xmlns="http://www.w3.org/1999/xhtml" attributename="is_veteran" attributetype="boolean"></mutation><field name="prefix"></field><field name="postfix">is veteran</field><value name="first_element"><block type="variable" id="l4b000033"><field name="variable_name">A</field></block></value><next><block type="attribute_selector" id="l4b000034"><mutation xmlns="http://www.w3.org/1999/xhtml" attributename="income" attributetype="number" attributeorder="ov"></mutation><field name="prefix"></field><field name="infix">has income of</field><field name="postfix"></field><value name="first_element"><block type="variable" id="l4b000035"><field name="variable_name">A</field></block></value><value name="second_element"><block type="variable" id="l4b000036"><field name="variable_name">Income</field></block></value><next><block type="numerical_constraint" id="l4b000037"><field name="operator">lte</field><value name="first_comparator"><block type="variable" id="l4b000038"><field name="variable_name">Income</field></block></value><value name="second_comparator"><block type="number_value" id="l4b000039"><field name="value">100000</field></block></value></block></next></block></next></block></next></block></statement><value name="source"><block type="doc_selector" id="l4b000040"><mutation xmlns="http://www.w3.org/1999/xhtml" section_reference="sec_1_section"></mutation><field name="doc_part_name">B 1</field></block></value><statement name="conclusion"><block type="unary_attribute_selector" id="l4b000041"><mutation xmlns="http://www.w3.org/1999/xhtml" attributename="eligible_for_benefit" attributetype="boolean"></mutation><field name="prefix"></field><field name="postfix">eligible for benefit</field><value name="first_element"><block type="variable" id="l4b000042"><field name="variable_name">A</field></block></value></block></statement></block>
      </xml>
    scasp_encoding: |-
      according_to(sec_1_section,eligible_for_benefit,A) :- applicant(A),
      age(A,Age),
      blawx_comparison(Age,gte,65),
      income(A,Income),
      blawx_comparison(Income,lte,100000).

      % BLAWX CHECK DUPLICATES
      holds(sec_1_section,eligible_for_benefit,A) :- according_to(sec_1_section,eligible_for_benefit,A).

      % BLAWX CHECK DUPLICATES
        eligible_for_benefit(A) :- holds(sec_1_section,eligible_for_benefit,A).

      according_to(sec_1_section,eligible_for_benefit,A) :- applicant(A),
      is_veteran(A),
      income(A,Income),
      blawx_comparison(Income,lte,100000).

      % BLAWX CHECK DUPLICATES
      holds(sec_1_section,eligible_for_benefit,A) :- according_to(sec_1_section,eligible_for_benefit,A).

      % BLAWX CHECK DUPLICATES
        eligible_for_benefit(A) :- holds(sec_1_section,eligible_for_benefit,A).
- model: blawx.workspace
  pk: 3
  fields:
    ruledoc: 1
    workspace_name: sec_2_section
    xml_content: |-
      <xml xmlns="https://developers.google.com/blockly/xml">
      <block type="attributed_rule" id="l4b000043" x="40" y="40"><field name="defeasible">FALSE</field><field name="inapplicable">FALSE</field><statement name="conditions"><block type="object_category" id="l4b000044"><value name="object"><block type="variable" id="l4b000045"><field name="variable_name">A</field></block></value><value name="category"><block type="category_selector" id="l4b000046"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="applicant"></mutation><field name="category_name">applicant</field></block></value><next><block type="unary_attribute_selector" id="l4b000047"><mutation xmlns="http://www.w3.org/1999/xhtml" attributename="eligible_for_benefit" attributetype="boolean"></mutation><field name="prefix"></field><field name="postfix">eligible for benefit</field><value name="first_element"><block type="variable" id="l4b000048"><field name="variable_name">A</field></block></value><next><block type="attribute_selector" id="l4b000049"><mutation xmlns="http://www.w3.org/1999/xhtml" attributename="bonus" attributetype="number" attributeorder="ov"></mutation><field name="prefix"></field><field name="infix">has bonus of</field><field name="postfix"></field><value name="first_element"><block type="variable" id="l4b000050"><field name="variable_name">A</field></block></value><value name="second_element"><block type="variable" id="l4b000051"><field name="variable_name">Bonus</field></block></value><next><block type="calculation" id="l4b000052"><value name="variable"><block type="variable" id="l4b000053"><field name="variable_name">Tmp</field></block></value><value name="calculation"><block type="math_operation" id="l4b000054"><field name="operator">add</field><value name="left_side"><block type="number_value" id="l4b000055"><field name="value">1000</field></block></value><value name="right_side"><block type="variable" id="l4b000056"><field name="variable_name">Bonus</field></block></value></block></value></block></next></block></next></block></next></block></statement><value name="source"><block type="doc_selector" id="l4b000057"><mutation xmlns="http://www.w3.org/1999/xhtml" section_reference="sec_2_section"></mutation><field name="doc_part_name">B 2</field></block></value><statement name="conclusion"><block type="attribute_selector" id="l4b000058"><mutation xmlns="http://www.w3.org/1999/xhtml" attributename="benefit_amount" attributetype="number" attributeorder="ov"></mutation><field name="prefix"></field><field name="infix">has benefit amount of</field><field name="postfix"></field><value name="first_element"><block type="variable" id="l4b000059"><field name="variable_name">A</field></block></value><value name="second_element"><block type="variable" id="l4b000060"><field name="variable_name">Tmp</field></block></value></block></statement></block>
      <block type="attributed_rule" id="l4b000061" x="40" y="688"><field name="defeasible">FALSE</field><field name="inapplicable">FALSE</field><statement name="conditions"><block type="object_category" id="l4b000062"><value name="object"><block type="variable" id="l4b000063"><field name="variable_name">A</field></block></value><value name="category"><block type="category_selector" id="l4b000064"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="applicant"></mutation><field name="category_name">applicant</field></block></value><next><block type="default_negation" id="l4b000065"><statement name="default_negated_statement"><block type="unary_attribute_selector" id="l4b000066"><mutation xmlns="http://www.w3.org/1999/xhtml" attributename="eligible_for_benefit" attributetype="boolean"></mutation><field name="prefix"></field><field name="postfix">eligible for benefit</field><value name="first_element"><block type="variable" id="l4b000067"><field name="variable_name">A</field></block></value></block></statement></block></next></block></statement><value name="source"><block type="doc_selector" id="l4b000068"><mutation xmlns="http://www.w3.org/1999/xhtml" section_reference="sec_2_section"></mutation><field name="doc_part_name">B 2</field></block></value><statement name="conclusion"><block type="attribute_selector" id="l4b000069"><mutation xmlns="http://www.w3.org/1999/xhtml" attributename="benefit_amount" attributetype="number" attributeorder="ov"></mutation><field name="prefix"></field><field name="infix">has benefit amount of</field><field name="postfix"></field><value name="first_element"><block type="variable" id="l4b000070"><field name="variable_name">A</field></block></value><value name="second_element"><block type="number_value" id="l4b000071"><field name="value">0</field></block></value></block></statement></block>
      <block type="attributed_rule" id="l4b000072" x="40" y="1126"><field name="defeasible">FALSE</field><field name="inapplicable">FALSE</field><statement name="conditions"><block type="object_category" id="l4b000073"><value name="object"><block type="variable" id="l4b000074"><field name="variable_name">A</field></block></value><value name="category"><block type="category_selector" id="l4b000075"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="applicant"></mutation><field name="category_name">applicant</field></block></value><next><block type="unary_attribute_selector" id="l4b000076"><mutation xmlns="http://www.w3.org/1999/xhtml" attributename="is_veteran" attributetype="boolean"></mutation><field name="prefix"></field><field name="postfix">is veteran</field><value name="first_element"><block type="variable" id="l4b000077"><field name="variable_name">A</field></block></value></block></next></block></statement><value name="source"><block type="doc_selector" id="l4b000078"><mutation xmlns="http://www.w3.org/1999/xhtml" section_reference="sec_2_section"></mutation><field name="doc_part_name">B 2</field></block></value><statement name="conclusion"><block type="attribute_selector" id="l4b000079"><mutation xmlns="http://www.w3.org/1999/xhtml" attributename="bonus" attributetype="number" attributeorder="ov"></mutation><field name="prefix"></field><field name="infix">has bonus of</field><field name="postfix"></field><value name="first_element"><block type="variable" id="l4b000080"><field name="variable_name">A</field></block></value><value name="second_element"><block type="number_value" id="l4b000081"><field name="value">250</field></block></value></block></statement></block>
      <block type="attributed_rule" id="l4b000082" x="40" y="1534"><field name="defeasible">FALSE</field><field name="inapplicable">FALSE</field><statement name="conditions"><block type="object_category" id="l4b000083"><value name="object"><block type="variable" id="l4b000084"><field name="variable_name">A</field></block></value><value name="category"><block type="category_selector" id="l4b000085"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="applicant"></mutation><field name="category_name">applicant</field></block></value><next><block type="logical_negation" id="l4b000086"><statement name="negated_statement"><block type="unary_attribute_selector" id="l4b000087"><mutation xmlns="http://www.w3.org/1999/xhtml" attributename="is_veteran" attributetype="boolean"></mutation><field name="prefix"></field><field name="postfix">is veteran</field><value name="first_element"><block type="variable" id="l4b000088"><field name="variable_name">A</field></block></value></block></statement></block></next></block></statement><value name="source"><block type="doc_selector" id="l4b000089"><mutation xmlns="http://www.w3.org/1999/xhtml" section_reference="sec_2_section"></mutation><field name="doc_part_name">B 2</field></block></value><statement name="conclusion"><block type="attribute_selector" id="l4b000090"><mutation xmlns="http://www.w3.org/1999/xhtml" attributename="bonus" attributetype="number" attributeorder="ov"></mutation><field name="prefix"></field><field name="infix">has bonus of</field><field name="postfix"></field><value name="first_element"><block type="variable" id="l4b000091"><field name="variable_name">A</field></block></value><value name="second_element"><block type="number_value" id="l4b000092"><field name="value">0</field></block></value></block></statement></block>
      </xml>
    scasp_encoding: |-
      according_to(sec_2_section,benefit_amount,A,Tmp) :- applicant(A),
      eligible_for_benefit(A),
      bonus(A,Bonus),
      Tmp is ( 1000 + Bonus ).

      % BLAWX CHECK DUPLICATES
      holds(sec_2_section,benefit_amount,A,Tmp) :- according_to(sec_2_section,benefit_amount,A,Tmp).

      % BLAWX CHECK DUPLICATES
        benefit_amount(A,Tmp) :- holds(sec_2_section,benefit_amount,A,Tmp).

      according_to(sec_2_section,benefit_amount,A,0) :- applicant(A),
      not eligible_for_benefit(A).

      % BLAWX CHECK DUPLICATES
      holds(sec_2_section,benefit_amount,A,0) :- according_to(sec_2_section,benefit_amount,A,0).

      % BLAWX CHECK DUPLICATES
        benefit_amount(A,0) :- holds(sec_2_section,benefit_amount,A,0).

      according_to(sec_2_section,bonus,A,250) :- applicant(A),
      is_veteran(A).

      % BLAWX CHECK DUPLICATES
      holds(sec_2_section,bonus,A,250) :- according_to(sec_2_section,bonus,A,250).

      % BLAWX CHECK DUPLICATES
        bonus(A,250) :- holds(sec_2_section,bonus,A,250).

      according_to(sec_2_section,bonus,A,0) :- applicant(A),
      -is_veteran(A).

      % BLAWX CHECK DUPLICATES
      holds(sec_2_section,bonus,A,0) :- according_to(sec_2_section,bonus,A,0).

      % BLAWX CHECK DUPLICATES
        bonus(A,0) :- holds(sec_2_section,bonus,A,0).
