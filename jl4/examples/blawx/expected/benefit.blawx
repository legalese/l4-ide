- model: blawx.ruledoc
  pk: 1
  fields:
    ruledoc_name: Benefit
    rule_text: "Benefit\n\n1. Definition of eligible for benefit.\n2. Definition of benefit amount."
    scasp_encoding: ''
    tutorial: ''
    owner: 1
    published: true
- model: blawx.workspace
  pk: 1
  fields:
    ruledoc: 1
    workspace_name: root_section
    xml_content: |-
      <xml xmlns="https://developers.google.com/blockly/xml">
      <block type="unattributed_fact" id="l4b000001" x="40" y="40"><statement name="statements"><block type="new_category_declaration" id="l4b000002"><field name="category_name">applicant</field><field name="prefix"></field><field name="first_element">object</field><field name="postfix">is an applicant</field><next><block type="new_attribute_declaration" id="l4b000003"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="applicant" attribute_type="number"></mutation><field name="category_name">applicant</field><field name="attribute_name">age</field><field name="attribute_type">number</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><field name="infix">has age of</field><field name="second_element">value</field><field name="postfix"></field><next><block type="new_attribute_declaration" id="l4b000004"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="applicant" attribute_type="number"></mutation><field name="category_name">applicant</field><field name="attribute_name">income</field><field name="attribute_type">number</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><field name="infix">has income of</field><field name="second_element">value</field><field name="postfix"></field><next><block type="new_attribute_declaration" id="l4b000005"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="applicant" attribute_type="boolean"></mutation><field name="category_name">applicant</field><field name="attribute_name">is_veteran</field><field name="attribute_type">boolean</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><field name="infix"></field><field name="second_element">value</field><field name="postfix">is veteran</field><next><block type="new_attribute_declaration" id="l4b000006"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="applicant" attribute_type="boolean"></mutation><field name="category_name">applicant</field><field name="attribute_name">eligible_for_benefit</field><field name="attribute_type">boolean</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><field name="infix"></field><field name="second_element">value</field><field name="postfix">eligible for benefit</field><next><block type="new_attribute_declaration" id="l4b000007"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="applicant" attribute_type="number"></mutation><field name="category_name">applicant</field><field name="attribute_name">benefit_amount</field><field name="attribute_type">number</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><field name="infix">has benefit amount of</field><field name="second_element">value</field><field name="postfix"></field><next><block type="new_attribute_declaration" id="l4b000008"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="applicant" attribute_type="number"></mutation><field name="category_name">applicant</field><field name="attribute_name">bonus</field><field name="attribute_type">number</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><field name="infix">has bonus of</field><field name="second_element">value</field><field name="postfix"></field></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block>
      </xml>
    scasp_encoding: |-
      blawx_category(applicant).
      blawx_category_nlg(applicant,"","is an applicant").
      :- dynamic applicant/1.
      #pred applicant(X) :: '@(X) is an applicant'.
      #pred holds(user,applicant,X) :: 'it is provided as a fact that @(X) is an applicant'.
      #pred holds(user,-applicant,X) :: 'it is provided as a fact that it is not the case that @(X) is an applicant'.
      #pred holds(Z,applicant,X) :: 'the conclusion in @(Z) that @(X) is an applicant holds'.
      #pred holds(Z,-applicant,X) :: 'the conclusion in @(Z) that it is not the case that @(X) is an applicant holds'.
      #pred according_to(Z,applicant,X) :: 'according to @(Z), @(X) is an applicant'.
      #pred according_to(Z,-applicant,X) :: 'according to @(Z), it is not the case that @(X) is an applicant'.
      #pred blawx_defeated(Z,applicant,X) :: 'the conclusion in @(Z) that @(X) is an applicant is defeated'.
      #pred blawx_defeated(Z,-applicant,X) :: 'the conclusion in @(Z) that it is not the case that @(X) is an applicant is defeated'.
      #pred blawx_initially(applicant(X)) :: 'that @(X) is an applicant holds initially'.
      #pred blawx_initially(-applicant(X)) :: 'that it is not the case that @(X) is an applicant holds initially'.
      #pred blawx_ultimately(applicant(X)) :: 'that @(X) is an applicant holds ultimately'.
      #pred blawx_ultimately(-applicant(X)) :: 'that it is not the case that @(X) is an applicant holds ultimately'.
      #pred blawx_as_of(applicant(X),T) :: 'that @(X) is an applicant holds at @(T)'.
      #pred blawx_as_of(-applicant(X),T) :: 'that it is not the case that @(X) is an applicant holds at @(T)'.
      #pred blawx_during(T1,applicant(X),T2) :: 'that @(X) is an applicant held between @(T1) and @(T2)'.
      #pred blawx_during(T1,-applicant(X),T2) :: 'that it is not the case that @(X) is an applicant held between @(T1) and @(T2)'.
      #pred blawx_becomes(applicant(X),T) :: 'that @(X) is an applicant became true at @(T)'.
      #pred blawx_becomes(-applicant(X),T) :: 'that it is not the case that @(X) is an applicant became true at @(T)'.
      #pred blawx_not_interrupted(Start,applicant(X),End) :: '@(X) is an applicant remained the case between @(Start) and @(End)'.
      #pred blawx_not_interrupted(Start,-applicant(X),End) :: 'it is not the case that @(X) is an applicant remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),applicant(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-applicant(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(Start),-applicant(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(applicant(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(bot),applicant(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(-applicant(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(bot),-applicant(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(applicant(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(Start),applicant(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(-applicant(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(Start),-applicant(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(applicant(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(bot),applicant(X),datetime(eot)) :- blawx_initially(applicant(X)), blawx_ultimately(applicant(X)), findall(Time,blawx_becomes(-applicant(X),datetime(Time)),[]).
      blawx_not_interrupted(datetime(bot),-applicant(X),datetime(eot)) :- blawx_initially(-applicant(X)), blawx_ultimately(-applicant(X)), findall(Time,blawx_becomes(applicant(X),datetime(Time)),[]).
      blawx_as_of(applicant(X),datetime(Time)) :- blawx_initially(applicant(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),applicant(X),datetime(BeforeT)).
      blawx_as_of(applicant(X),datetime(Time)) :- blawx_becomes(applicant(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),applicant(X),datetime(Time)).
      blawx_as_of(-applicant(X),datetime(Time)) :- blawx_initially(-applicant(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-applicant(X),datetime(BeforeT)).
      blawx_as_of(-applicant(X),datetime(Time)) :- blawx_becomes(-applicant(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),-applicant(X),datetime(Time)).
      blawx_during(datetime(Start),applicant(X),datetime(End)) :- blawx_becomes(applicant(X),datetime(Start)), blawx_becomes(-applicant(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),applicant(X),datetime(End)).
      blawx_during(datetime(bot),applicant(X),datetime(End)) :- blawx_initially(applicant(X)), blawx_becomes(-applicant(X),datetime(End)), blawx_not_interrupted(datetime(bot),applicant(X),datetime(End)).
      blawx_during(datetime(Start),applicant(X),datetime(eot)) :- blawx_ultimately(applicant(X)), blawx_becomes(-applicant(X),datetime(Start)), blawx_not_interrupted(datetime(Start),applicant(X),datetime(eot)).
      blawx_during(datetime(bot),applicant(X),datetime(eot)) :- blawx_initially(applicant(X)), blawx_ultimately(applicant(X)), blawx_becomes(-applicant(X),datetime(Start)), blawx_not_interrupted(datetime(bot),applicant(X),datetime(eot)).
      blawx_during(datetime(Start),-applicant(X),datetime(End)) :- blawx_becomes(-applicant(X),datetime(Start)), blawx_becomes(applicant(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),-applicant(X),datetime(End)).
      blawx_during(datetime(bot),-applicant(X),datetime(End)) :- blawx_initially(-applicant(X)), blawx_becomes(applicant(X),datetime(End)), blawx_not_interrupted(datetime(bot),-applicant(X),datetime(End)).
      blawx_during(datetime(Start),-applicant(X),datetime(eot)) :- blawx_ultimately(-applicant(X)), blawx_becomes(applicant(X),datetime(Start)), blawx_not_interrupted(datetime(Start),-applicant(X),datetime(eot)).
      blawx_during(datetime(bot),-applicant(X),datetime(eot)) :- blawx_initially(-applicant(X)), blawx_ultimately(-applicant(X)), blawx_becomes(-applicant(X),datetime(Start)), blawx_not_interrupted(datetime(bot),-applicant(X),datetime(eot)).
      blawx_attribute(applicant,age,number).
      blawx_attribute_nlg(age,ov,"","has age of","").
      :- dynamic age/2.
      #pred age(X,Y) :: '@(X) has age of @(Y)'.
      #pred holds(user,age,X,Y) :: 'it is provided as a fact that @(X) has age of @(Y)'.
      #pred holds(user,-age,X,Y) :: 'it is provided as a fact that it is not the case that @(X) has age of @(Y)'.
      #pred holds(Z,age,X,Y) :: 'the conclusion in @(Z) that @(X) has age of @(Y) holds'.
      #pred holds(Z,-age,X,Y) :: 'the conclusion in @(Z) that it is not the case that @(X) has age of @(Y) holds'.
      #pred according_to(Z,age,X,Y) :: 'according to @(Z), @(X) has age of @(Y)'.
      #pred according_to(Z,-age,X,Y) :: 'according to @(Z), it is not the case that @(X) has age of @(Y)'.
      #pred blawx_defeated(Z,age,X,Y) :: 'the conclusion in @(Z) that @(X) has age of @(Y) is defeated'.
      #pred blawx_defeated(Z,-age,X,Y) :: 'the conclusion in @(Z) that @(X) has age of @(Y) is defeated'.
      #pred blawx_initially(age(X,Y)) :: 'that @(X) has age of @(Y) holds initially'.
      #pred blawx_initially(-age(X,Y)) :: 'that it is not the case that @(X) has age of @(Y) holds initially'.
      #pred blawx_ultimately(age(X,Y)) :: 'that @(X) has age of @(Y) holds ultimately'.
      #pred blawx_ultimately(-age(X,Y)) :: 'that it is not the case that @(X) has age of @(Y) holds ultimately'.
      #pred blawx_as_of(age(X,Y),T) :: 'that @(X) has age of @(Y) holds at @(T)'.
      #pred blawx_as_of(-age(X,Y),T) :: 'that it is not the case that @(X) has age of @(Y) holds at @(T)'.
      #pred blawx_during(T1,age(X,Y),T2) :: 'that @(X) has age of @(Y) held between @(T1) and @(T2)'.
      #pred blawx_during(T1,-age(X,Y),T2) :: 'that it is not the case that @(X) has age of @(Y) held between @(T1) and @(T2)'.
      #pred blawx_becomes(age(X,Y),T) :: 'that @(X) has age of @(Y) became true at @(T)'.
      #pred blawx_becomes(-age(X,Y),T) :: 'that it is not the case that @(X) has age of @(Y) became true at @(T)'.
      #pred blawx_not_interrupted(Start,age(X,Y),End) :: '@(X) has age of @(Y) remained the case between @(Start) and @(End)'.
      #pred blawx_not_interrupted(Start,-age(X,Y),End) :: 'it is not the case that @(X) has age of @(Y) remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),age(X,Y),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-age(X,Y),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(Start),-age(X,Y),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(age(X,Y),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(bot),age(X,Y),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(-age(X,Y),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(bot),-age(X,Y),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(age(X,Y),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(Start),age(X,Y),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(-age(X,Y),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(Start),-age(X,Y),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(age(X,Y),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(bot),age(X,Y),datetime(eot)) :- blawx_initially(age(X,Y)), blawx_ultimately(age(X,Y)), findall(Time,blawx_becomes(-age(X,Y),datetime(Time)),[]).
      blawx_not_interrupted(datetime(bot),-age(X,Y),datetime(eot)) :- blawx_initially(-age(X,Y)), blawx_ultimately(-age(X,Y)), findall(Time,blawx_becomes(age(X,Y),datetime(Time)),[]).
      blawx_as_of(age(X,Y),datetime(Time)) :- blawx_initially(age(X,Y)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),age(X,Y),datetime(BeforeT)).
      blawx_as_of(age(X,Y),datetime(Time)) :- blawx_becomes(age(X,Y),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),age(X,Y),datetime(Time)).
      blawx_as_of(-age(X,Y),datetime(Time)) :- blawx_initially(-age(X,Y)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-age(X,Y),datetime(BeforeT)).
      blawx_as_of(-age(X,Y),datetime(Time)) :- blawx_becomes(-age(X,Y),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),-age(X,Y),datetime(Time)).
      blawx_during(datetime(Start),age(X,Y),datetime(End)) :- blawx_becomes(age(X,Y),datetime(Start)), blawx_becomes(-age(X,Y),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),age(X,Y),datetime(End)).
      blawx_during(datetime(bot),age(X,Y),datetime(End)) :- blawx_initially(age(X,Y)), blawx_becomes(-age(X,Y),datetime(End)), blawx_not_interrupted(datetime(bot),age(X,Y),datetime(End)).
      blawx_during(datetime(Start),age(X,Y),datetime(eot)) :- blawx_ultimately(age(X,Y)), blawx_becomes(-age(X,Y),datetime(Start)), blawx_not_interrupted(datetime(Start),age(X,Y),datetime(eot)).
      blawx_during(datetime(bot),age(X,Y),datetime(eot)) :- blawx_initially(age(X,Y)), blawx_ultimately(age(X,Y)), blawx_becomes(-age(X,Y),datetime(Start)), blawx_not_interrupted(datetime(bot),age(X,Y),datetime(eot)).
      blawx_during(datetime(Start),-age(X,Y),datetime(End)) :- blawx_becomes(-age(X,Y),datetime(Start)), blawx_becomes(age(X,Y),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),-age(X,Y),datetime(End)).
      blawx_during(datetime(bot),-age(X,Y),datetime(End)) :- blawx_initially(-age(X,Y)), blawx_becomes(age(X,Y),datetime(End)), blawx_not_interrupted(datetime(bot),-age(X,Y),datetime(End)).
      blawx_during(datetime(Start),-age(X,Y),datetime(eot)) :- blawx_ultimately(-age(X,Y)), blawx_becomes(age(X,Y),datetime(Start)), blawx_not_interrupted(datetime(Start),-age(X,Y),datetime(eot)).
      blawx_during(datetime(bot),-age(X,Y),datetime(eot)) :- blawx_initially(-age(X,Y)), blawx_ultimately(-age(X,Y)), blawx_becomes(-age(X,Y),datetime(Start)), blawx_not_interrupted(datetime(bot),-age(X,Y),datetime(eot)).
      blawx_attribute(applicant,income,number).
      blawx_attribute_nlg(income,ov,"","has income of","").
      :- dynamic income/2.
      #pred income(X,Y) :: '@(X) has income of @(Y)'.
      #pred holds(user,income,X,Y) :: 'it is provided as a fact that @(X) has income of @(Y)'.
      #pred holds(user,-income,X,Y) :: 'it is provided as a fact that it is not the case that @(X) has income of @(Y)'.
      #pred holds(Z,income,X,Y) :: 'the conclusion in @(Z) that @(X) has income of @(Y) holds'.
      #pred holds(Z,-income,X,Y) :: 'the conclusion in @(Z) that it is not the case that @(X) has income of @(Y) holds'.
      #pred according_to(Z,income,X,Y) :: 'according to @(Z), @(X) has income of @(Y)'.
      #pred according_to(Z,-income,X,Y) :: 'according to @(Z), it is not the case that @(X) has income of @(Y)'.
      #pred blawx_defeated(Z,income,X,Y) :: 'the conclusion in @(Z) that @(X) has income of @(Y) is defeated'.
      #pred blawx_defeated(Z,-income,X,Y) :: 'the conclusion in @(Z) that @(X) has income of @(Y) is defeated'.
      #pred blawx_initially(income(X,Y)) :: 'that @(X) has income of @(Y) holds initially'.
      #pred blawx_initially(-income(X,Y)) :: 'that it is not the case that @(X) has income of @(Y) holds initially'.
      #pred blawx_ultimately(income(X,Y)) :: 'that @(X) has income of @(Y) holds ultimately'.
      #pred blawx_ultimately(-income(X,Y)) :: 'that it is not the case that @(X) has income of @(Y) holds ultimately'.
      #pred blawx_as_of(income(X,Y),T) :: 'that @(X) has income of @(Y) holds at @(T)'.
      #pred blawx_as_of(-income(X,Y),T) :: 'that it is not the case that @(X) has income of @(Y) holds at @(T)'.
      #pred blawx_during(T1,income(X,Y),T2) :: 'that @(X) has income of @(Y) held between @(T1) and @(T2)'.
      #pred blawx_during(T1,-income(X,Y),T2) :: 'that it is not the case that @(X) has income of @(Y) held between @(T1) and @(T2)'.
      #pred blawx_becomes(income(X,Y),T) :: 'that @(X) has income of @(Y) became true at @(T)'.
      #pred blawx_becomes(-income(X,Y),T) :: 'that it is not the case that @(X) has income of @(Y) became true at @(T)'.
      #pred blawx_not_interrupted(Start,income(X,Y),End) :: '@(X) has income of @(Y) remained the case between @(Start) and @(End)'.
      #pred blawx_not_interrupted(Start,-income(X,Y),End) :: 'it is not the case that @(X) has income of @(Y) remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),income(X,Y),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-income(X,Y),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(Start),-income(X,Y),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(income(X,Y),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(bot),income(X,Y),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(-income(X,Y),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(bot),-income(X,Y),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(income(X,Y),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(Start),income(X,Y),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(-income(X,Y),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(Start),-income(X,Y),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(income(X,Y),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(bot),income(X,Y),datetime(eot)) :- blawx_initially(income(X,Y)), blawx_ultimately(income(X,Y)), findall(Time,blawx_becomes(-income(X,Y),datetime(Time)),[]).
      blawx_not_interrupted(datetime(bot),-income(X,Y),datetime(eot)) :- blawx_initially(-income(X,Y)), blawx_ultimately(-income(X,Y)), findall(Time,blawx_becomes(income(X,Y),datetime(Time)),[]).
      blawx_as_of(income(X,Y),datetime(Time)) :- blawx_initially(income(X,Y)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),income(X,Y),datetime(BeforeT)).
      blawx_as_of(income(X,Y),datetime(Time)) :- blawx_becomes(income(X,Y),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),income(X,Y),datetime(Time)).
      blawx_as_of(-income(X,Y),datetime(Time)) :- blawx_initially(-income(X,Y)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-income(X,Y),datetime(BeforeT)).
      blawx_as_of(-income(X,Y),datetime(Time)) :- blawx_becomes(-income(X,Y),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),-income(X,Y),datetime(Time)).
      blawx_during(datetime(Start),income(X,Y),datetime(End)) :- blawx_becomes(income(X,Y),datetime(Start)), blawx_becomes(-income(X,Y),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),income(X,Y),datetime(End)).
      blawx_during(datetime(bot),income(X,Y),datetime(End)) :- blawx_initially(income(X,Y)), blawx_becomes(-income(X,Y),datetime(End)), blawx_not_interrupted(datetime(bot),income(X,Y),datetime(End)).
      blawx_during(datetime(Start),income(X,Y),datetime(eot)) :- blawx_ultimately(income(X,Y)), blawx_becomes(-income(X,Y),datetime(Start)), blawx_not_interrupted(datetime(Start),income(X,Y),datetime(eot)).
      blawx_during(datetime(bot),income(X,Y),datetime(eot)) :- blawx_initially(income(X,Y)), blawx_ultimately(income(X,Y)), blawx_becomes(-income(X,Y),datetime(Start)), blawx_not_interrupted(datetime(bot),income(X,Y),datetime(eot)).
      blawx_during(datetime(Start),-income(X,Y),datetime(End)) :- blawx_becomes(-income(X,Y),datetime(Start)), blawx_becomes(income(X,Y),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),-income(X,Y),datetime(End)).
      blawx_during(datetime(bot),-income(X,Y),datetime(End)) :- blawx_initially(-income(X,Y)), blawx_becomes(income(X,Y),datetime(End)), blawx_not_interrupted(datetime(bot),-income(X,Y),datetime(End)).
      blawx_during(datetime(Start),-income(X,Y),datetime(eot)) :- blawx_ultimately(-income(X,Y)), blawx_becomes(income(X,Y),datetime(Start)), blawx_not_interrupted(datetime(Start),-income(X,Y),datetime(eot)).
