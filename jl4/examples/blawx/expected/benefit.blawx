      :- dynamic is_veteran/1.
      #pred is_veteran(X) :: '@(X) is veteran'.
      #pred holds(user,is_veteran,X) :: 'it is provided as a fact that @(X) is veteran'.
      #pred holds(user,-is_veteran,X) :: 'it is provided as a fact that it is not the case that @(X) is veteran'.
