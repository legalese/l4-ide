      #pred blawx_during(T1,-is_veteran(X),T2) :: 'that it is not the case that @(X) is veteran held between @(T1) and @(T2)'.
      #pred blawx_becomes(is_veteran(X),T) :: 'that @(X) is veteran became true at @(T)'.
      #pred blawx_becomes(-is_veteran(X),T) :: 'that it is not the case that @(X) is veteran became true at @(T)'.
      #pred blawx_not_interrupted(Start,is_veteran(X),End) :: '@(X) is veteran remained the case between @(Start) and @(End)'.
      #pred blawx_not_interrupted(Start,-is_veteran(X),End) :: 'it is not the case that @(X) is veteran remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),is_veteran(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-is_veteran(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(Start),-is_veteran(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(is_veteran(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(bot),is_veteran(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(-is_veteran(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(bot),-is_veteran(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(is_veteran(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(Start),is_veteran(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(-is_veteran(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(Start),-is_veteran(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(is_veteran(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(bot),is_veteran(X),datetime(eot)) :- blawx_initially(is_veteran(X)), blawx_ultimately(is_veteran(X)), findall(Time,blawx_becomes(-is_veteran(X),datetime(Time)),[]).
      blawx_not_interrupted(datetime(bot),-is_veteran(X),datetime(eot)) :- blawx_initially(-is_veteran(X)), blawx_ultimately(-is_veteran(X)), findall(Time,blawx_becomes(is_veteran(X),datetime(Time)),[]).
      blawx_as_of(is_veteran(X),datetime(Time)) :- blawx_initially(is_veteran(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),is_veteran(X),datetime(BeforeT)).
      blawx_as_of(is_veteran(X),datetime(Time)) :- blawx_becomes(is_veteran(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),is_veteran(X),datetime(Time)).
      blawx_as_of(-is_veteran(X),datetime(Time)) :- blawx_initially(-is_veteran(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-is_veteran(X),datetime(BeforeT)).
      blawx_as_of(-is_veteran(X),datetime(Time)) :- blawx_becomes(-is_veteran(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),-is_veteran(X),datetime(Time)).
      blawx_during(datetime(Start),is_veteran(X),datetime(End)) :- blawx_becomes(is_veteran(X),datetime(Start)), blawx_becomes(-is_veteran(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),is_veteran(X),datetime(End)).
