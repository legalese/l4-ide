      #pred blawx_initially(-is_veteran(X)) :: 'that it is not the case that @(X) is veteran holds initially'.
      #pred blawx_ultimately(is_veteran(X)) :: 'that @(X) is veteran holds ultimately'.
      #pred blawx_ultimately(-is_veteran(X)) :: 'that it is not the case that @(X) is veteran holds ultimately'.
