n in relation to an application for a licence under an enactment</field><next><block type="new_attribute_declaration" id="l4b000010"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="person" attribute_type="boolean"></mutation><field name="category_name">person</field><field name="attribute_name">the_person_has_an_alcohol_banning_order</field><field name="attribute_type">boolean</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><field name="infix"></field><field name="second_element">value</field><field name="postfix">the person has an alcohol banning order</field><next><block type="new_attribute_declaration" id="l4b000011"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="premises" attribute_type="boolean"></mutation><field name="category_name">premises</field><field name="attribute_name">a_price_list_for_alcohol_is_displayed_on_the_premises</field><field name="attribute_type">boolean</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><field name="infix"></field><field name="second_element">value</field><field name="postfix">a price list for alcohol is displayed on the premises</field><next><block type="new_attribute_declaration" id="l4b000012"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="premises" attribute_type="boolean"></mutation><field name="category_name">premises</field><field name="attribute_name">the_premises_are_registered_as_a_hotel</field><field name="attribute_type">boolean</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><field name="infix"></field><field name="second_element">value</field><field name="postfix">the premises are registered as a hotel</field><next><block type="new_attribute_declaration" id="l4b000013"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="premises" attribute_type="boolean"></mutation><field name="categ