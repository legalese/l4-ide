    scasp_encoding: |-
      blawx_category(person).
      blawx_category_nlg(person,"","is a person").
      :- dynamic person/1.
      #pred person(X) :: '@(X) is a person'.
      #pred holds(user,person,X) :: 'it is provided as a fact that @(X) is a person'.
      #pred holds(user,-person,X) :: 'it is provided as a fact that it is not the case that @(X) is a person'.
      #pred holds(Z,person,X) :: 'the conclusion in @(Z) that @(X) is a person holds'.
      #pred holds(Z,-person,X) :: 'the conclusion in @(Z) that it is not the case that @(X) is a person holds'.
      #pred according_to(Z,person,X) :: 'according to @(Z), @(X) is a person'.
      #pred according_to(Z,-person,X) :: 'according to @(Z), it is not the case that @(X) is a person'.
      #pred blawx_defeated(Z,person,X) :: 'the conclusion in @(Z) that @(X) is a person is defeated'.
      #pred blawx_defeated(Z,-person,X) :: 'the conclusion in @(Z) that it is not the case that @(X) is a person is defeated'.
      #pred blawx_initially(person(X)) :: 'that @(X) is a person holds initially'.
      #pred blawx_initially(-person(X)) :: 'that it is not the case that @(X) is a person holds initially'.
      #pred blawx_ultimately(person(X)) :: 'that @(X) is a person holds ultimately'.
      #pred blawx_ultimately(-person(X)) :: 'that it is not the case that @(X) is a person holds ultimately'.
      #pred blawx_as_of(person(X),T) :: 'that @(X) is a person holds at @(T)'.
      #pred blawx_as_of(-person(X),T) :: 'that it is not the case that @(X) is a person holds at @(T)'.
      #pred blawx_during(T1,person(X),T2) :: 'that @(X) is a person held between @(T1) and @(T2)'.
      #pred blawx_during(T1,-person(X),T2) :: 'that it is not the case that @(X) is a person held between @(T1) and @(T2)'.
      #pred blawx_becomes(person(X),T) :: 'that @(X) is a person became true at @(T)'.
      #pred blawx_becomes(-person(X),T) :: 'that it is not the case that @(X) is a person became true at @(T)'.
      #pred blawx_not_interrupted(Start,person(X),End) :: '@(X) is a person remained the case between @(Start) and @(End)'.
      #pred blawx_not_interrupted(Start,-person(X),End) :: 'it is not the case that @(X) is a person remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),person(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-person(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(Start),-person(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(person(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(bot),person(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(-person(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(bot),-person(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(person(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(Start),person(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(-person(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(Start),-person(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(person(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(bot),person(X),datetime(eot)) :- blawx_initially(person(X)), blawx_ultimately(person(X)), findall(Time,blawx_becomes(-person(X),datetime(Time)),[]).
      blawx_not_interrupted(datetime(bot),-person(X),datetime(eot)) :- blawx_initially(-person(X)), blawx_ultimately(-person(X)), findall(Time,blawx_becomes(person(X),datetime(Time)),[]).
      blawx_as_of(person(X),datetime(Time)) :- blawx_initially(person(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),person(X),datetime(BeforeT)).
      blawx_as_of(person(X),datetime(Time)) :- blawx_becomes(person(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),person(X),datetime(Time)).
      blawx_as_of(-person(X),datetime(Time)) :- blawx_initially(-person(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-person(X),datetime(BeforeT)).
      blawx_as_of(-person(X),datetime(Time)) :- blawx_becomes(-person(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),-person(X),datetime(Time)).
      blawx_during(datetime(Start),person(X),datetime(End)) :- blawx_becomes(person(X),datetime(Start)), blawx_becomes(-person(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),person(X),datetime(End)).
      blawx_during(datetime(bot),person(X),datetime(End)) :- blawx_initially(person(X)), blawx_becomes(-person(X),datetime(End)), blawx_not_interrupted(datetime(bot),person(X),datetime(End)).
      blawx_during(datetime(Start),person(X),datetime(eot)) :- blawx_ultimately(person(X)), blawx_becomes(-person(X),datetime(Start)), blawx_not_interrupted(datetime(Start),person(X),datetime(eot)).
      blawx_during(datetime(bot),person(X),datetime(eot)) :- blawx_initially(person(X)), blawx_ultimately(person(X)), blawx_becomes(-person(X),datetime(Start)), blawx_not_interrupted(datetime(bot),person(X),datetime(eot)).
      blawx_during(datetime(Start),-person(X),datetime(End)) :- blawx_becomes(-person(X),datetime(Start)), blawx_becomes(person(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),-person(X),datetime(End)).
      blawx_during(datetime(bot),-person(X),datetime(End)) :- blawx_initially(-person(X)), blawx_becomes(person(X),datetime(End)), blawx_not_interrupted(datetime(bot),-person(X),datetime(End)).
      blawx_during(datetime(Start),-person(X),datetime(eot)) :- blawx_ultimately(-person(X)), blawx_becomes(person(X),datetime(Start)), blawx_not_interrupted(datetime(Start),-person(X),datetime(eot)).
      blawx_during(datetime(bot),-person(X),datetime(eot)) :- blawx_initially(-person(X)), blawx_ultimately(-person(X)), blawx_becomes(-person(X),datetime(Start)), blawx_not_interrupted(datetime(bot),-person(X),datetime(eot)).
      blawx_category(premises).
      blawx_category_nlg(premises,"","is a premises").
      :- dynamic premises/1.
      #pred premises(X) :: '@(X) is a premises'.
      #pred holds(user,premises,X) :: 'it is provided as a fact that @(X) is a premises'.
      #pred holds(user,-premises,X) :: 'it is provided as a fact that it is not the case that @(X) is a premises'.
      #pred holds(Z,premises,X) :: 'the conclusion in @(Z) that @(X) is a premises holds'.
      #pred holds(Z,-premises,X) :: 'the conclusion in @(Z) that it is not the case that @(X) is a premises holds'.
      #pred according_to(Z,premises,X) :: 'according to @(Z), @(X) is a premises'.
      #pred according_to(Z,-premises,X) :: 'according to @(Z), it is not the case that @(X) is a premises'.
      #pred blawx_defeated(Z,premises,X) :: 'the conclusion in @(Z) that @(X) is a premises is defeated'.
      #pred blawx_defeated(Z,-premises,X) :: 'the conclusion in @(Z) that it is not the case that @(X) is a premises is defeated'.
      #pred blawx_initially(premises(X)) :: 'that @(X) is a premises holds initially'.
      #pred blawx_initially(-premises(X)) :: 'that it is not the case that @(X) is a premises holds initially'.
      #pred blawx_ultimately(premises(X)) :: 'that @(X) is a premises holds ultimately'.
      #pred blawx_ultimately(-premises(X)) :: 'that it is not the case that @(X) is a premises holds ultimately'.
      #pred blawx_as_of(premises(X),T) :: 'that @(X) is a premises holds at @(T)'.
      #pred blawx_as_of(-premises(X),T) :: 'that it is not the case that @(X) is a premises holds at @(T)'.
      #pred blawx_during(T1,premises(X),T2) :: 'that @(X) is a premises held between @(T1) and @(T2)'.
      #pred blawx_during(T1,-premises(X),T2) :: 'that it is not the case that @(X) is a premises held between @(T1) and @(T2)'.
      #pred blawx_becomes(premises(X),T) :: 'that @(X) is a premises became true at @(T)'.
      #pred blawx_becomes(-premises(X),T) :: 'that it is not the case that @(X) is a premises became true at @(T)'.
      #pred blawx_not_interrupted(Start,premises(X),End) :: '@(X) is a premises remained the case between @(Start) and @(End)'.
      #pred blawx_not_interrupted(Start,-premises(X),End) :: 'it is not the case that @(X) is a premises remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),premises(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-premises(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(Start),-premises(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(premises(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(bot),premises(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(-premises(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(bot),-premises(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(premises(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(Start),premises(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(-premises(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(Start),-premises(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(premises(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(bot),premises(X),datetime(eot)) :- blawx_initially(premises(X)), blawx_ultimately(premises(X)), findall(Time,blawx_becomes(-premises(X),datetime(Time)),[]).
      blawx_not_interrupted(datetime(bot),-premises(X),datetime(eot)) :- blawx_initially(-premises(X)), blawx_ultimately(-premises(X)), findall(Time,blawx_becomes(premises(X),datetime(Time)),[]).
      blawx_as_of(premises(X),datetime(Time)) :- blawx_initially(premises(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),premises(X),datetime(BeforeT)).
      blawx_as_of(premises(X),datetime(Time)) :- blawx_becomes(premises(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),premises(X),datetime(Time)).
      blawx_as_of(-premises(X),datetime(Time)) :- blawx_initially(-premises(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-premises(X),datetime(BeforeT)).
      blawx_as_of(-premises(X),datetime(Time)) :- blawx_becomes(-premises(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),-premises(X),datetime(Time)).
      blawx_during(datetime(Start),premises(X),datetime(End)) :- blawx_becomes(premises(X),datetime(Start)), blawx_becomes(-premises(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),premises(X),datetime(End)).
      blawx_during(datetime(bot),premises(X),datetime(End)) :- blawx_initially(premises(X)), blawx_becomes(-premises(X),datetime(End)), blawx_not_interrupted(datetime(bot),premises(X),datetime(End)).
      blawx_during(datetime(Start),premises(X),datetime(eot)) :- blawx_ultimately(premises(X)), blawx_becomes(-premises(X),datetime(Start)), blawx_not_interrupted(datetime(Start),premises(X),datetime(eot)).
      blawx_during(datetime(bot),premises(X),datetime(eot)) :- blawx_initially(premises(X)), blawx_ultimately(premises(X)), blawx_becomes(-premises(X),datetime(Start)), blawx_not_interrupted(datetime(bot),premises(X),datetime(eot)).
      blawx_during(datetime(Start),-premises(X),datetime(End)) :- blawx_becomes(-premises(X),datetime(Start)), blawx_becomes(premises(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),-premises(X),datetime(End)).
      blawx_during(datetime(bot),-premises(X),datetime(End)) :- blawx_initially(-premises(X)), blawx_becomes(premises(X),datetime(End)), blawx_not_interrupted(datetime(bot),-premises(X),datetime(End)).
      blawx_during(datetime(Start),-premises(X),datetime(eot)) :- blawx_ultimately(-premises(X)), blawx_becomes(premises(X),datetime(Start)), blawx_not_interrupted(datetime(Start),-premises(X),datetime(eot)).
      blawx_during(datetime(bot),-premises(X),datetime(eot)) :- blawx_initially(-premises(X)), blawx_ultimately(-premises(X)), blawx_becomes(-premises(X),datetime(Start)), blawx_not_interrupted(datetime(bot),-premises(X),datetime(eot)).
      blawx_attribute(person,the_person_is_a_body_corporate,boolean).
