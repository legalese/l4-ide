field name="attribute_type">boolean</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><field name="infix"></field><field name="second_element">value</field><field name="postfix">the proprietor does so to the satisfaction of the enforcement officer</field><next><block type="new_attribute_declaration" id="l4b000017"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="premises" attribute_type="boolean"></mutation><field name="category_name">premises</field><field name="attribute_name">the_proprietor_does_so_within_5_days_after_the_warning_was_issued</field><field name="attribute_type">boolean</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><field name="infix"></field><field name="second_element">value</field><field name="postfix">the proprietor does so within 5 days after the warning was issued</field><next><block type="new_attribute_declaration" id="l4b000018"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="person" attribute_type="boolean"></mutation><field name="category_name">person</field><field name="attribute_name">the_person_must_not_sell_alcohol</field><field name="attribute_type">boolean</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><field name="infix"></field><field name="second_element">value</field><field name="postfix">the person must not sell alcohol</field><next><block type="new_attribute_declaration" id="l4b000019"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="premises" attribute_type="boolean"></mutation><field name="category_name">premises</field><field name="attribute_name">the_enforcement_officer_may_issue_a_warning_to_the_proprietor_of_premises</field><field name="attribute_type">boolean</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><field name="infix"></field><field name