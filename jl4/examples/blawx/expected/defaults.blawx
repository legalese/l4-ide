      <block type="assume" id="l4b000062" x="40" y="208"><statement name="statements"><block type="attribute_selector" id="l4b000063"><mutation xmlns="http://www.w3.org/1999/xhtml" attributename="timeout" attributetype="number" attributeorder="ov"></mutation><field name="prefix"></field><field name="infix">has timeout of</field><field name="postfix"></field><value name="first_element"><block type="variable" id="l4b000064"><field name="variable_name">X</field></block></value><value name="second_element"><block type="variable" id="l4b000065"><field name="variable_name">Y</field></block></value></block></statement></block>
