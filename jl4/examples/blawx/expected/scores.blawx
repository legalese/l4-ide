    xml_content: |-
      <xml xmlns="https://developers.google.com/blockly/xml">
      <block type="attributed_rule" id="l4b000055" x="40" y="40"><field name="defeasible">FALSE</field><field name="inapplicable">FALSE</field><statement name="conditions"><block type="object_category" id="l4b000056"><value name="object"><block type="variable" id="l4b000057"><field name="variable_name">S</field></block></value><value name="category"><block type="category_selector" id="l4b000058"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="student"></mutation><field name="category_name">student</field></block></value><next><block type="attribute_selector" id="l4b000059"><mutation xmlns="http://www.w3.org/1999/xhtml" attributename="average_score" attributetype="number" attributeorder="ov"></mutation><field name="prefix"></field><field name="infix">has average score of</field><field name="postfix"></field><value name="first_element"><block type="variable" id="l4b000060"><field name="variable_name">S</field></block></value><value name="second_element"><block type="variable" id="l4b000061"><field name="variable_name">Averagescore</field></block></value><next><block type="numerical_constraint" id="l4b000062"><field name="operator">gte</field><value name="first_comparator"><block type="variable" id="l4b000063"><field name="variable_name">Averagescore</field></block></value><value name="second_comparator"><block type="number_value" id="l4b000064"><field name="value">50</field></block></value></block></next></block></next></block></statement><value name="source"><block type="doc_selector" id="l4b000065"><mutation xmlns="http://www.w3.org/1999/xhtml" section_reference="sec_4_section"></mutation><field name="doc_part_name">S 4</field></block></value><statement name="conclusion"><block type="unary_attribute_selector" id="l4b000066"><mutation xmlns="http://www.w3.org/1999/xhtml" attributename="passes" attributetype="boolean"></mutation><field name="prefix"></field><field name="postfix">passes</field><value name="first_element"><block type="variable" id="l4b000067"><field name="variable_name">S</field></block></value></block></statement></block>
      </xml>
    scasp_encoding: |-
      according_to(sec_4_section,passes,S) :- student(S),
      average_score(S,Averagescore),
      blawx_comparison(Averagescore,gte,50).

