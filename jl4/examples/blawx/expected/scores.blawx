      :- dynamic passes/1.
      #pred passes(X) :: '@(X) passes'.
      #pred holds(user,passes,X) :: 'it is provided as a fact that @(X) passes'.
      #pred holds(user,-passes,X) :: 'it is provided as a fact that it is not the case that @(X) passes'.
      #pred holds(Z,passes,X) :: 'the conclusion in @(Z) that @(X) passes holds'.
