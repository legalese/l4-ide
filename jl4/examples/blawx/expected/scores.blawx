      :- dynamic price/2.
      #pred price(X,Y) :: '@(X) has price of @(Y)'.
      #pred holds(user,price,X,Y) :: 'it is provided as a fact that @(X) has price of @(Y)'.
      #pred holds(user,-price,X,Y) :: 'it is provided as a fact that it is not the case that @(X) has price of @(Y)'.
      #pred holds(Z,price,X,Y) :: 'the conclusion in @(Z) that @(X) has price of @(Y) holds'.
      #pred holds(Z,-price,X,Y) :: 'the conclusion in @(Z) that it is not the case that @(X) has price of @(Y) holds'.
      #pred according_to(Z,price,X,Y) :: 'according to @(Z), @(X) has price of @(Y)'.
      #pred according_to(Z,-price,X,Y) :: 'according to @(Z), it is not the case that @(X) has price of @(Y)'.
      #pred blawx_defeated(Z,price,X,Y) :: 'the conclusion in @(Z) that @(X) has price of @(Y) is defeated'.
      #pred blawx_defeated(Z,-price,X,Y) :: 'the conclusion in @(Z) that @(X) has price of @(Y) is defeated'.
      #pred blawx_initially(price(X,Y)) :: 'that @(X) has price of @(Y) holds initially'.
      #pred blawx_initially(-price(X,Y)) :: 'that it is not the case that @(X) has price of @(Y) holds initially'.
      #pred blawx_ultimately(price(X,Y)) :: 'that @(X) has price of @(Y) holds ultimately'.
      #pred blawx_ultimately(-price(X,Y)) :: 'that it is not the case that @(X) has price of @(Y) holds ultimately'.
      #pred blawx_as_of(price(X,Y),T) :: 'that @(X) has price of @(Y) holds at @(T)'.
      #pred blawx_as_of(-price(X,Y),T) :: 'that it is not the case that @(X) has price of @(Y) holds at @(T)'.
      #pred blawx_during(T1,price(X,Y),T2) :: 'that @(X) has price of @(Y) held between @(T1) and @(T2)'.
      #pred blawx_during(T1,-price(X,Y),T2) :: 'that it is not the case that @(X) has price of @(Y) held between @(T1) and @(T2)'.
      #pred blawx_becomes(price(X,Y),T) :: 'that @(X) has price of @(Y) became true at @(T)'.
      #pred blawx_becomes(-price(X,Y),T) :: 'that it is not the case that @(X) has price of @(Y) became true at @(T)'.
      #pred blawx_not_interrupted(Start,price(X,Y),End) :: '@(X) has price of @(Y) remained the case between @(Start) and @(End)'.
      #pred blawx_not_interrupted(Start,-price(X,Y),End) :: 'it is not the case that @(X) has price of @(Y) remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),price(X,Y),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-price(X,Y),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(Start),-price(X,Y),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(price(X,Y),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(bot),price(X,Y),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(-price(X,Y),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(bot),-price(X,Y),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(price(X,Y),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(Start),price(X,Y),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(-price(X,Y),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(Start),-price(X,Y),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(price(X,Y),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(bot),price(X,Y),datetime(eot)) :- blawx_initially(price(X,Y)), blawx_ultimately(price(X,Y)), findall(Time,blawx_becomes(-price(X,Y),datetime(Time)),[]).
      blawx_not_interrupted(datetime(bot),-price(X,Y),datetime(eot)) :- blawx_initially(-price(X,Y)), blawx_ultimately(-price(X,Y)), findall(Time,blawx_becomes(price(X,Y),datetime(Time)),[]).
      blawx_as_of(price(X,Y),datetime(Time)) :- blawx_initially(price(X,Y)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),price(X,Y),datetime(BeforeT)).
      blawx_as_of(price(X,Y),datetime(Time)) :- blawx_becomes(price(X,Y),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),price(X,Y),datetime(Time)).
      blawx_as_of(-price(X,Y),datetime(Time)) :- blawx_initially(-price(X,Y)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-price(X,Y),datetime(BeforeT)).
      blawx_as_of(-price(X,Y),datetime(Time)) :- blawx_becomes(-price(X,Y),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),-price(X,Y),datetime(Time)).
      blawx_during(datetime(Start),price(X,Y),datetime(End)) :- blawx_becomes(price(X,Y),datetime(Start)), blawx_becomes(-price(X,Y),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),price(X,Y),datetime(End)).
      blawx_during(datetime(bot),price(X,Y),datetime(End)) :- blawx_initially(price(X,Y)), blawx_becomes(-price(X,Y),datetime(End)), blawx_not_interrupted(datetime(bot),price(X,Y),datetime(End)).
      blawx_during(datetime(Start),price(X,Y),datetime(eot)) :- blawx_ultimately(price(X,Y)), blawx_becomes(-price(X,Y),datetime(Start)), blawx_not_interrupted(datetime(Start),price(X,Y),datetime(eot)).
      blawx_during(datetime(bot),price(X,Y),datetime(eot)) :- blawx_initially(price(X,Y)), blawx_ultimately(price(X,Y)), blawx_becomes(-price(X,Y),datetime(Start)), blawx_not_interrupted(datetime(bot),price(X,Y),datetime(eot)).
