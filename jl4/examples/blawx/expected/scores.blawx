- model: blawx.ruledoc
  pk: 1
  fields:
    ruledoc_name: Scores
    rule_text: "Scores\n\n1. Definition of total score.\n2. Definition of best score.\n3. Definition of average score.\n4. Definition of passes.\n5. Definition of basket total."
    scasp_encoding: ''
    tutorial: ''
    owner: 1
    published: true
- model: blawx.workspace
  pk: 1
  fields:
    ruledoc: 1
    workspace_name: root_section
    xml_content: ''
    scasp_encoding: |-
      blawx_category(student).
      blawx_category_nlg(student,"","is a student").
      :- dynamic student/1.
      #pred student(X) :: '@(X) is a student'.
      #pred holds(user,student,X) :: 'it is provided as a fact that @(X) is a student'.
      #pred holds(user,-student,X) :: 'it is provided as a fact that it is not the case that @(X) is a student'.
      #pred holds(Z,student,X) :: 'the conclusion in @(Z) that @(X) is a student holds'.
      #pred holds(Z,-student,X) :: 'the conclusion in @(Z) that it is not the case that @(X) is a student holds'.
      #pred according_to(Z,student,X) :: 'according to @(Z), @(X) is a student'.
      #pred according_to(Z,-student,X) :: 'according to @(Z), it is not the case that @(X) is a student'.
      #pred blawx_defeated(Z,student,X) :: 'the conclusion in @(Z) that @(X) is a student is defeated'.
      #pred blawx_defeated(Z,-student,X) :: 'the conclusion in @(Z) that it is not the case that @(X) is a student is defeated'.
      #pred blawx_initially(student(X)) :: 'that @(X) is a student holds initially'.
      #pred blawx_initially(-student(X)) :: 'that it is not the case that @(X) is a student holds initially'.
      #pred blawx_ultimately(student(X)) :: 'that @(X) is a student holds ultimately'.
      #pred blawx_ultimately(-student(X)) :: 'that it is not the case that @(X) is a student holds ultimately'.
      #pred blawx_as_of(student(X),T) :: 'that @(X) is a student holds at @(T)'.
      #pred blawx_as_of(-student(X),T) :: 'that it is not the case that @(X) is a student holds at @(T)'.
      #pred blawx_during(T1,student(X),T2) :: 'that @(X) is a student held between @(T1) and @(T2)'.
      #pred blawx_during(T1,-student(X),T2) :: 'that it is not the case that @(X) is a student held between @(T1) and @(T2)'.
      #pred blawx_becomes(student(X),T) :: 'that @(X) is a student became true at @(T)'.
      #pred blawx_becomes(-student(X),T) :: 'that it is not the case that @(X) is a student became true at @(T)'.
      #pred blawx_not_interrupted(Start,student(X),End) :: '@(X) is a student remained the case between @(Start) and @(End)'.
      #pred blawx_not_interrupted(Start,-student(X),End) :: 'it is not the case that @(X) is a student remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),student(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-student(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(Start),-student(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(student(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(bot),student(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(-student(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(bot),-student(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(student(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(Start),student(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(-student(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(Start),-student(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(student(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(bot),student(X),datetime(eot)) :- blawx_initially(student(X)), blawx_ultimately(student(X)), findall(Time,blawx_becomes(-student(X),datetime(Time)),[]).
      blawx_not_interrupted(datetime(bot),-student(X),datetime(eot)) :- blawx_initially(-student(X)), blawx_ultimately(-student(X)), findall(Time,blawx_becomes(student(X),datetime(Time)),[]).
      blawx_as_of(student(X),datetime(Time)) :- blawx_initially(student(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),student(X),datetime(BeforeT)).
      blawx_as_of(student(X),datetime(Time)) :- blawx_becomes(student(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),student(X),datetime(Time)).
      blawx_as_of(-student(X),datetime(Time)) :- blawx_initially(-student(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-student(X),datetime(BeforeT)).
      blawx_as_of(-student(X),datetime(Time)) :- blawx_becomes(-student(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),-student(X),datetime(Time)).
      blawx_during(datetime(Start),student(X),datetime(End)) :- blawx_becomes(student(X),datetime(Start)), blawx_becomes(-student(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),student(X),datetime(End)).
      blawx_during(datetime(bot),student(X),datetime(End)) :- blawx_initially(student(X)), blawx_becomes(-student(X),datetime(End)), blawx_not_interrupted(datetime(bot),student(X),datetime(End)).
      blawx_during(datetime(Start),student(X),datetime(eot)) :- blawx_ultimately(student(X)), blawx_becomes(-student(X),datetime(Start)), blawx_not_interrupted(datetime(Start),student(X),datetime(eot)).
      blawx_during(datetime(bot),student(X),datetime(eot)) :- blawx_initially(student(X)), blawx_ultimately(student(X)), blawx_becomes(-student(X),datetime(Start)), blawx_not_interrupted(datetime(bot),student(X),datetime(eot)).
      blawx_during(datetime(Start),-student(X),datetime(End)) :- blawx_becomes(-student(X),datetime(Start)), blawx_becomes(student(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),-student(X),datetime(End)).
      blawx_during(datetime(bot),-student(X),datetime(End)) :- blawx_initially(-student(X)), blawx_becomes(student(X),datetime(End)), blawx_not_interrupted(datetime(bot),-student(X),datetime(End)).
      blawx_during(datetime(Start),-student(X),datetime(eot)) :- blawx_ultimately(-student(X)), blawx_becomes(student(X),datetime(Start)), blawx_not_interrupted(datetime(Start),-student(X),datetime(eot)).
      blawx_during(datetime(bot),-student(X),datetime(eot)) :- blawx_initially(-student(X)), blawx_ultimately(-student(X)), blawx_becomes(-student(X),datetime(Start)), blawx_not_interrupted(datetime(bot),-student(X),datetime(eot)).
      blawx_category(item).
      blawx_category_nlg(item,"","is an item").
      :- dynamic item/1.
      #pred item(X) :: '@(X) is an item'.
      #pred holds(user,item,X) :: 'it is provided as a fact that @(X) is an item'.
      #pred holds(user,-item,X) :: 'it is provided as a fact that it is not the case that @(X) is an item'.
      #pred holds(Z,item,X) :: 'the conclusion in @(Z) that @(X) is an item holds'.
      #pred holds(Z,-item,X) :: 'the conclusion in @(Z) that it is not the case that @(X) is an item holds'.
      #pred according_to(Z,item,X) :: 'according to @(Z), @(X) is an item'.
      #pred according_to(Z,-item,X) :: 'according to @(Z), it is not the case that @(X) is an item'.
      #pred blawx_defeated(Z,item,X) :: 'the conclusion in @(Z) that @(X) is an item is defeated'.
      #pred blawx_defeated(Z,-item,X) :: 'the conclusion in @(Z) that it is not the case that @(X) is an item is defeated'.
      #pred blawx_initially(item(X)) :: 'that @(X) is an item holds initially'.
      #pred blawx_initially(-item(X)) :: 'that it is not the case that @(X) is an item holds initially'.
      #pred blawx_ultimately(item(X)) :: 'that @(X) is an item holds ultimately'.
      #pred blawx_ultimately(-item(X)) :: 'that it is not the case that @(X) is an item holds ultimately'.
      #pred blawx_as_of(item(X),T) :: 'that @(X) is an item holds at @(T)'.
      #pred blawx_as_of(-item(X),T) :: 'that it is not the case that @(X) is an item holds at @(T)'.
      #pred blawx_during(T1,item(X),T2) :: 'that @(X) is an item held between @(T1) and @(T2)'.
      #pred blawx_during(T1,-item(X),T2) :: 'that it is not the case that @(X) is an item held between @(T1) and @(T2)'.
      #pred blawx_becomes(item(X),T) :: 'that @(X) is an item became true at @(T)'.
      #pred blawx_becomes(-item(X),T) :: 'that it is not the case that @(X) is an item became true at @(T)'.
      #pred blawx_not_interrupted(Start,item(X),End) :: '@(X) is an item remained the case between @(Start) and @(End)'.
      #pred blawx_not_interrupted(Start,-item(X),End) :: 'it is not the case that @(X) is an item remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),item(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-item(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(Start),-item(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(item(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(bot),item(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(-item(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(bot),-item(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(item(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(Start),item(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(-item(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(Start),-item(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(item(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(bot),item(X),datetime(eot)) :- blawx_initially(item(X)), blawx_ultimately(item(X)), findall(Time,blawx_becomes(-item(X),datetime(Time)),[]).
      blawx_not_interrupted(datetime(bot),-item(X),datetime(eot)) :- blawx_initially(-item(X)), blawx_ultimately(-item(X)), findall(Time,blawx_becomes(item(X),datetime(Time)),[]).
      blawx_as_of(item(X),datetime(Time)) :- blawx_initially(item(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),item(X),datetime(BeforeT)).
      blawx_as_of(item(X),datetime(Time)) :- blawx_becomes(item(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),item(X),datetime(Time)).
      blawx_as_of(-item(X),datetime(Time)) :- blawx_initially(-item(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-item(X),datetime(BeforeT)).
      blawx_as_of(-item(X),datetime(Time)) :- blawx_becomes(-item(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),-item(X),datetime(Time)).
      blawx_during(datetime(Start),item(X),datetime(End)) :- blawx_becomes(item(X),datetime(Start)), blawx_becomes(-item(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),item(X),datetime(End)).
      blawx_during(datetime(bot),item(X),datetime(End)) :- blawx_initially(item(X)), blawx_becomes(-item(X),datetime(End)), blawx_not_interrupted(datetime(bot),item(X),datetime(End)).
      blawx_during(datetime(Start),item(X),datetime(eot)) :- blawx_ultimately(item(X)), blawx_becomes(-item(X),datetime(Start)), blawx_not_interrupted(datetime(Start),item(X),datetime(eot)).
      blawx_during(datetime(bot),item(X),datetime(eot)) :- blawx_initially(item(X)), blawx_ultimately(item(X)), blawx_becomes(-item(X),datetime(Start)), blawx_not_interrupted(datetime(bot),item(X),datetime(eot)).
      blawx_during(datetime(Start),-item(X),datetime(End)) :- blawx_becomes(-item(X),datetime(Start)), blawx_becomes(item(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),-item(X),datetime(End)).
      blawx_during(datetime(bot),-item(X),datetime(End)) :- blawx_initially(-item(X)), blawx_becomes(item(X),datetime(End)), blawx_not_interrupted(datetime(bot),-item(X),datetime(End)).
      blawx_during(datetime(Start),-item(X),datetime(eot)) :- blawx_ultimately(-item(X)), blawx_becomes(item(X),datetime(Start)), blawx_not_interrupted(datetime(Start),-item(X),datetime(eot)).
      blawx_during(datetime(bot),-item(X),datetime(eot)) :- blawx_initially(-item(X)), blawx_ultimately(-item(X)), blawx_becomes(-item(X),datetime(Start)), blawx_not_interrupted(datetime(bot),-item(X),datetime(eot)).
      blawx_category(basket).
      blawx_category_nlg(basket,"","is a basket").
      :- dynamic basket/1.
      #pred basket(X) :: '@(X) is a basket'.
      #pred holds(user,basket,X) :: 'it is provided as a fact that @(X) is a basket'.
      #pred holds(user,-basket,X) :: 'it is provided as a fact that it is not the case that @(X) is a basket'.
      #pred holds(Z,basket,X) :: 'the conclusion in @(Z) that @(X) is a basket holds'.
      #pred holds(Z,-basket,X) :: 'the conclusion in @(Z) that it is not the case that @(X) is a basket holds'.
      #pred according_to(Z,basket,X) :: 'according to @(Z), @(X) is a basket'.
      #pred according_to(Z,-basket,X) :: 'according to @(Z), it is not the case that @(X) is a basket'.
      #pred blawx_defeated(Z,basket,X) :: 'the conclusion in @(Z) that @(X) is a basket is defeated'.
      #pred blawx_defeated(Z,-basket,X) :: 'the conclusion in @(Z) that it is not the case that @(X) is a basket is defeated'.
      #pred blawx_initially(basket(X)) :: 'that @(X) is a basket holds initially'.
      #pred blawx_initially(-basket(X)) :: 'that it is not the case that @(X) is a basket holds initially'.
      #pred blawx_ultimately(basket(X)) :: 'that @(X) is a basket holds ultimately'.
      #pred blawx_ultimately(-basket(X)) :: 'that it is not the case that @(X) is a basket holds ultimately'.
      #pred blawx_as_of(basket(X),T) :: 'that @(X) is a basket holds at @(T)'.
      #pred blawx_as_of(-basket(X),T) :: 'that it is not the case that @(X) is a basket holds at @(T)'.
      #pred blawx_during(T1,basket(X),T2) :: 'that @(X) is a basket held between @(T1) and @(T2)'.
      #pred blawx_during(T1,-basket(X),T2) :: 'that it is not the case that @(X) is a basket held between @(T1) and @(T2)'.
      #pred blawx_becomes(basket(X),T) :: 'that @(X) is a basket became true at @(T)'.
      #pred blawx_becomes(-basket(X),T) :: 'that it is not the case that @(X) is a basket became true at @(T)'.
      #pred blawx_not_interrupted(Start,basket(X),End) :: '@(X) is a basket remained the case between @(Start) and @(End)'.
      #pred blawx_not_interrupted(Start,-basket(X),End) :: 'it is not the case that @(X) is a basket remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),basket(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-basket(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(Start),-basket(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(basket(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(bot),basket(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(-basket(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(bot),-basket(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(basket(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(Start),basket(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(-basket(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(Start),-basket(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(basket(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(bot),basket(X),datetime(eot)) :- blawx_initially(basket(X)), blawx_ultimately(basket(X)), findall(Time,blawx_becomes(-basket(X),datetime(Time)),[]).
      blawx_not_interrupted(datetime(bot),-basket(X),datetime(eot)) :- blawx_initially(-basket(X)), blawx_ultimately(-basket(X)), findall(Time,blawx_becomes(basket(X),datetime(Time)),[]).
      blawx_as_of(basket(X),datetime(Time)) :- blawx_initially(basket(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),basket(X),datetime(BeforeT)).
      blawx_as_of(basket(X),datetime(Time)) :- blawx_becomes(basket(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),basket(X),datetime(Time)).
      blawx_as_of(-basket(X),datetime(Time)) :- blawx_initially(-basket(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-basket(X),datetime(BeforeT)).
      blawx_as_of(-basket(X),datetime(Time)) :- blawx_becomes(-basket(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),-basket(X),datetime(Time)).
      blawx_during(datetime(Start),basket(X),datetime(End)) :- blawx_becomes(basket(X),datetime(Start)), blawx_becomes(-basket(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),basket(X),datetime(End)).
      blawx_during(datetime(bot),basket(X),datetime(End)) :- blawx_initially(basket(X)), blawx_becomes(-basket(X),datetime(End)), blawx_not_interrupted(datetime(bot),basket(X),datetime(End)).
      blawx_during(datetime(Start),basket(X),datetime(eot)) :- blawx_ultimately(basket(X)), blawx_becomes(-basket(X),datetime(Start)), blawx_not_interrupted(datetime(Start),basket(X),datetime(eot)).
      blawx_during(datetime(bot),basket(X),datetime(eot)) :- blawx_initially(basket(X)), blawx_ultimately(basket(X)), blawx_becomes(-basket(X),datetime(Start)), blawx_not_interrupted(datetime(bot),basket(X),datetime(eot)).
      blawx_during(datetime(Start),-basket(X),datetime(End)) :- blawx_becomes(-basket(X),datetime(Start)), blawx_becomes(basket(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),-basket(X),datetime(End)).
      blawx_during(datetime(bot),-basket(X),datetime(End)) :- blawx_initially(-basket(X)), blawx_becomes(basket(X),datetime(End)), blawx_not_interrupted(datetime(bot),-basket(X),datetime(End)).
      blawx_during(datetime(Start),-basket(X),datetime(eot)) :- blawx_ultimately(-basket(X)), blawx_becomes(basket(X),datetime(Start)), blawx_not_interrupted(datetime(Start),-basket(X),datetime(eot)).
      blawx_during(datetime(bot),-basket(X),datetime(eot)) :- blawx_initially(-basket(X)), blawx_ultimately(-basket(X)), blawx_becomes(-basket(X),datetime(Start)), blawx_not_interrupted(datetime(bot),-basket(X),datetime(eot)).
      blawx_attribute(student,scores,list).
      blawx_attribute_nlg(scores,ov,"","has scores of","").
      :- dynamic scores/2.
      #pred scores(X,Y) :: '@(X) has scores of @(Y)'.
      #pred holds(user,scores,X,Y) :: 'it is provided as a fact that @(X) has scores of @(Y)'.
      #pred holds(user,-scores,X,Y) :: 'it is provided as a fact that it is not the case that @(X) has scores of @(Y)'.
      #pred holds(Z,scores,X,Y) :: 'the conclusion in @(Z) that @(X) has scores of @(Y) holds'.
      #pred holds(Z,-scores,X,Y) :: 'the conclusion in @(Z) that it is not the case that @(X) has scores of @(Y) holds'.
      #pred according_to(Z,scores,X,Y) :: 'according to @(Z), @(X) has scores of @(Y)'.
      #pred according_to(Z,-scores,X,Y) :: 'according to @(Z), it is not the case that @(X) has scores of @(Y)'.
      #pred blawx_defeated(Z,scores,X,Y) :: 'the conclusion in @(Z) that @(X) has scores of @(Y) is defeated'.
      #pred blawx_defeated(Z,-scores,X,Y) :: 'the conclusion in @(Z) that @(X) has scores of @(Y) is defeated'.
      #pred blawx_initially(scores(X,Y)) :: 'that @(X) has scores of @(Y) holds initially'.
      #pred blawx_initially(-scores(X,Y)) :: 'that it is not the case that @(X) has scores of @(Y) holds initially'.
      #pred blawx_ultimately(scores(X,Y)) :: 'that @(X) has scores of @(Y) holds ultimately'.
      #pred blawx_ultimately(-scores(X,Y)) :: 'that it is not the case that @(X) has scores of @(Y) holds ultimately'.
      #pred blawx_as_of(scores(X,Y),T) :: 'that @(X) has scores of @(Y) holds at @(T)'.
      #pred blawx_as_of(-scores(X,Y),T) :: 'that it is not the case that @(X) has scores of @(Y) holds at @(T)'.
      #pred blawx_during(T1,scores(X,Y),T2) :: 'that @(X) has scores of @(Y) held between @(T1) and @(T2)'.
      #pred blawx_during(T1,-scores(X,Y),T2) :: 'that it is not the case that @(X) has scores of @(Y) held between @(T1) and @(T2)'.
      #pred blawx_becomes(scores(X,Y),T) :: 'that @(X) has scores of @(Y) became true at @(T)'.
      #pred blawx_becomes(-scores(X,Y),T) :: 'that it is not the case that @(X) has scores of @(Y) became true at @(T)'.
      #pred blawx_not_interrupted(Start,scores(X,Y),End) :: '@(X) has scores of @(Y) remained the case between @(Start) and @(End)'.
      #pred blawx_not_interrupted(Start,-scores(X,Y),End) :: 'it is not the case that @(X) has scores of @(Y) remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),scores(X,Y),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-scores(X,Y),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(Start),-scores(X,Y),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(scores(X,Y),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(bot),scores(X,Y),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(-scores(X,Y),datetime(Time)),Times),blawx_list_not_before(Times,End).
