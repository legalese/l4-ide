      blawx_not_interrupted(datetime(Start),items(X,Y),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-items(X,Y),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
