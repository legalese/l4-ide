      #pred according_to(Z,-passes,X) :: 'according to @(Z), it is not the case that @(X) passes'.
      #pred blawx_defeated(Z,passes,X) :: 'the conclusion in @(Z) that @(X) passes is defeated'.
      #pred blawx_defeated(Z,-passes,X) :: 'the conclusion in @(Z) that @(X) passes is defeated'.
      #pred blawx_initially(passes(X)) :: 'that @(X) passes holds initially'.
      #pred blawx_initially(-passes(X)) :: 'that it is not the case that @(X) passes holds initially'.
      #pred blawx_ultimately(passes(X)) :: 'that @(X) passes holds ultimately'.
      #pred blawx_ultimately(-passes(X)) :: 'that it is not the case that @(X) passes holds ultimately'.
      #pred blawx_as_of(passes(X),T) :: 'that @(X) passes holds at @(T)'.
      #pred blawx_as_of(-passes(X),T) :: 'that it is not the case that @(X) passes holds at @(T)'.
      #pred blawx_during(T1,passes(X),T2) :: 'that @(X) passes held between @(T1) and @(T2)'.
      #pred blawx_during(T1,-passes(X),T2) :: 'that it is not the case that @(X) passes held between @(T1) and @(T2)'.
      #pred blawx_becomes(passes(X),T) :: 'that @(X) passes became true at @(T)'.
      #pred blawx_becomes(-passes(X),T) :: 'that it is not the case that @(X) passes became true at @(T)'.
      #pred blawx_not_interrupted(Start,passes(X),End) :: '@(X) passes remained the case between @(Start) and @(End)'.
      #pred blawx_not_interrupted(Start,-passes(X),End) :: 'it is not the case that @(X) passes remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),passes(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-passes(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(Start),-passes(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(passes(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(bot),passes(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(-passes(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(bot),-passes(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(passes(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(Start),passes(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(-passes(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(Start),-passes(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(passes(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(bot),passes(X),datetime(eot)) :- blawx_initially(passes(X)), blawx_ultimately(passes(X)), findall(Time,blawx_becomes(-passes(X),datetime(Time)),[]).
      blawx_not_interrupted(datetime(bot),-passes(X),datetime(eot)) :- blawx_initially(-passes(X)), blawx_ultimately(-passes(X)), findall(Time,blawx_becomes(passes(X),datetime(Time)),[]).
      blawx_as_of(passes(X),datetime(Time)) :- blawx_initially(passes(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),passes(X),datetime(BeforeT)).
      blawx_as_of(passes(X),datetime(Time)) :- blawx_becomes(passes(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),passes(X),datetime(Time)).
      blawx_as_of(-passes(X),datetime(Time)) :- blawx_initially(-passes(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-passes(X),datetime(BeforeT)).
      blawx_as_of(-passes(X),datetime(Time)) :- blawx_becomes(-passes(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),-passes(X),datetime(Time)).
      blawx_during(datetime(Start),passes(X),datetime(End)) :- blawx_becomes(passes(X),datetime(Start)), blawx_becomes(-passes(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),passes(X),datetime(End)).
      blawx_during(datetime(bot),passes(X),datetime(End)) :- blawx_initially(passes(X)), blawx_becomes(-passes(X),datetime(End)), blawx_not_interrupted(datetime(bot),passes(X),datetime(End)).
      blawx_during(datetime(Start),passes(X),datetime(eot)) :- blawx_ultimately(passes(X)), blawx_becomes(-passes(X),datetime(Start)), blawx_not_interrupted(datetime(Start),passes(X),datetime(eot)).
      blawx_during(datetime(bot),passes(X),datetime(eot)) :- blawx_initially(passes(X)), blawx_ultimately(passes(X)), blawx_becomes(-passes(X),datetime(Start)), blawx_not_interrupted(datetime(bot),passes(X),datetime(eot)).
      blawx_during(datetime(Start),-passes(X),datetime(End)) :- blawx_becomes(-passes(X),datetime(Start)), blawx_becomes(passes(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),-passes(X),datetime(End)).
      blawx_during(datetime(bot),-passes(X),datetime(End)) :- blawx_initially(-passes(X)), blawx_becomes(passes(X),datetime(End)), blawx_not_interrupted(datetime(bot),-passes(X),datetime(End)).
      blawx_during(datetime(Start),-passes(X),datetime(eot)) :- blawx_ultimately(-passes(X)), blawx_becomes(passes(X),datetime(Start)), blawx_not_interrupted(datetime(Start),-passes(X),datetime(eot)).
      blawx_during(datetime(bot),-passes(X),datetime(eot)) :- blawx_initially(-passes(X)), blawx_ultimately(-passes(X)), blawx_becomes(-passes(X),datetime(Start)), blawx_not_interrupted(datetime(bot),-passes(X),datetime(eot)).
      blawx_attribute(basket,basket_total,number).
      blawx_attribute_nlg(basket_total,ov,"","has basket total of","").
      :- dynamic basket_total/2.
      #pred basket_total(X,Y) :: '@(X) has basket total of @(Y)'.
      #pred holds(user,basket_total,X,Y) :: 'it is provided as a fact that @(X) has basket total of @(Y)'.
      #pred holds(user,-basket_total,X,Y) :: 'it is provided as a fact that it is not the case that @(X) has basket total of @(Y)'.
      #pred holds(Z,basket_total,X,Y) :: 'the conclusion in @(Z) that @(X) has basket total of @(Y) holds'.
      #pred holds(Z,-basket_total,X,Y) :: 'the conclusion in @(Z) that it is not the case that @(X) has basket total of @(Y) holds'.
      #pred according_to(Z,basket_total,X,Y) :: 'according to @(Z), @(X) has basket total of @(Y)'.
      #pred according_to(Z,-basket_total,X,Y) :: 'according to @(Z), it is not the case that @(X) has basket total of @(Y)'.
      #pred blawx_defeated(Z,basket_total,X,Y) :: 'the conclusion in @(Z) that @(X) has basket total of @(Y) is defeated'.
      #pred blawx_defeated(Z,-basket_total,X,Y) :: 'the conclusion in @(Z) that @(X) has basket total of @(Y) is defeated'.
      #pred blawx_initially(basket_total(X,Y)) :: 'that @(X) has basket total of @(Y) holds initially'.
      #pred blawx_initially(-basket_total(X,Y)) :: 'that it is not the case that @(X) has basket total of @(Y) holds initially'.
      #pred blawx_ultimately(basket_total(X,Y)) :: 'that @(X) has basket total of @(Y) holds ultimately'.
      #pred blawx_ultimately(-basket_total(X,Y)) :: 'that it is not the case that @(X) has basket total of @(Y) holds ultimately'.
      #pred blawx_as_of(basket_total(X,Y),T) :: 'that @(X) has basket total of @(Y) holds at @(T)'.
      #pred blawx_as_of(-basket_total(X,Y),T) :: 'that it is not the case that @(X) has basket total of @(Y) holds at @(T)'.
      #pred blawx_during(T1,basket_total(X,Y),T2) :: 'that @(X) has basket total of @(Y) held between @(T1) and @(T2)'.
      #pred blawx_during(T1,-basket_total(X,Y),T2) :: 'that it is not the case that @(X) has basket total of @(Y) held between @(T1) and @(T2)'.
      #pred blawx_becomes(basket_total(X,Y),T) :: 'that @(X) has basket total of @(Y) became true at @(T)'.
      #pred blawx_becomes(-basket_total(X,Y),T) :: 'that it is not the case that @(X) has basket total of @(Y) became true at @(T)'.
      #pred blawx_not_interrupted(Start,basket_total(X,Y),End) :: '@(X) has basket total of @(Y) remained the case between @(Start) and @(End)'.
      #pred blawx_not_interrupted(Start,-basket_total(X,Y),End) :: 'it is not the case that @(X) has basket total of @(Y) remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),basket_total(X,Y),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-basket_total(X,Y),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(Start),-basket_total(X,Y),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(basket_total(X,Y),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(bot),basket_total(X,Y),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(-basket_total(X,Y),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(bot),-basket_total(X,Y),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(basket_total(X,Y),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(Start),basket_total(X,Y),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(-basket_total(X,Y),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(Start),-basket_total(X,Y),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(basket_total(X,Y),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(bot),basket_total(X,Y),datetime(eot)) :- blawx_initially(basket_total(X,Y)), blawx_ultimately(basket_total(X,Y)), findall(Time,blawx_becomes(-basket_total(X,Y),datetime(Time)),[]).
      blawx_not_interrupted(datetime(bot),-basket_total(X,Y),datetime(eot)) :- blawx_initially(-basket_total(X,Y)), blawx_ultimately(-basket_total(X,Y)), findall(Time,blawx_becomes(basket_total(X,Y),datetime(Time)),[]).
      blawx_as_of(basket_total(X,Y),datetime(Time)) :- blawx_initially(basket_total(X,Y)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),basket_total(X,Y),datetime(BeforeT)).
      blawx_as_of(basket_total(X,Y),datetime(Time)) :- blawx_becomes(basket_total(X,Y),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),basket_total(X,Y),datetime(Time)).
      blawx_as_of(-basket_total(X,Y),datetime(Time)) :- blawx_initially(-basket_total(X,Y)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-basket_total(X,Y),datetime(BeforeT)).
      blawx_as_of(-basket_total(X,Y),datetime(Time)) :- blawx_becomes(-basket_total(X,Y),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),-basket_total(X,Y),datetime(Time)).
      blawx_during(datetime(Start),basket_total(X,Y),datetime(End)) :- blawx_becomes(basket_total(X,Y),datetime(Start)), blawx_becomes(-basket_total(X,Y),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),basket_total(X,Y),datetime(End)).
      blawx_during(datetime(bot),basket_total(X,Y),datetime(End)) :- blawx_initially(basket_total(X,Y)), blawx_becomes(-basket_total(X,Y),datetime(End)), blawx_not_interrupted(datetime(bot),basket_total(X,Y),datetime(End)).
      blawx_during(datetime(Start),basket_total(X,Y),datetime(eot)) :- blawx_ultimately(basket_total(X,Y)), blawx_becomes(-basket_total(X,Y),datetime(Start)), blawx_not_interrupted(datetime(Start),basket_total(X,Y),datetime(eot)).
      blawx_during(datetime(bot),basket_total(X,Y),datetime(eot)) :- blawx_initially(basket_total(X,Y)), blawx_ultimately(basket_total(X,Y)), blawx_becomes(-basket_total(X,Y),datetime(Start)), blawx_not_interrupted(datetime(bot),basket_total(X,Y),datetime(eot)).
      blawx_during(datetime(Start),-basket_total(X,Y),datetime(End)) :- blawx_becomes(-basket_total(X,Y),datetime(Start)), blawx_becomes(basket_total(X,Y),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),-basket_total(X,Y),datetime(End)).
      blawx_during(datetime(bot),-basket_total(X,Y),datetime(End)) :- blawx_initially(-basket_total(X,Y)), blawx_becomes(basket_total(X,Y),datetime(End)), blawx_not_interrupted(datetime(bot),-basket_total(X,Y),datetime(End)).
      blawx_during(datetime(Start),-basket_total(X,Y),datetime(eot)) :- blawx_ultimately(-basket_total(X,Y)), blawx_becomes(basket_total(X,Y),datetime(Start)), blawx_not_interrupted(datetime(Start),-basket_total(X,Y),datetime(eot)).
      blawx_during(datetime(bot),-basket_total(X,Y),datetime(eot)) :- blawx_initially(-basket_total(X,Y)), blawx_ultimately(-basket_total(X,Y)), blawx_becomes(-basket_total(X,Y),datetime(Start)), blawx_not_interrupted(datetime(bot),-basket_total(X,Y),datetime(eot)).
- model: blawx.workspace
  pk: 2
  fields:
    ruledoc: 1
    workspace_name: sec_1_section
    xml_content: |-
      <xml xmlns="https://developers.google.com/blockly/xml">
      <block type="attributed_rule" id="l4b000013" x="40" y="40"><field name="defeasible">FALSE</field><field name="inapplicable">FALSE</field><statement name="conditions"><block type="object_category" id="l4b000014"><value name="object"><block type="variable" id="l4b000015"><field name="variable_name">S</field></block></value><value name="category"><block type="category_selector" id="l4b000016"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="student"></mutation><field name="category_name">student</field></block></value><next><block type="attribute_selector" id="l4b000017"><mutation xmlns="http://www.w3.org/1999/xhtml" attributename="scores" attributetype="list" attributeorder="ov"></mutation><field name="prefix"></field><field name="infix">has scores of</field><field name="postfix"></field><value name="first_element"><block type="variable" id="l4b000018"><field name="variable_name">S</field></block></value><value name="second_element"><block type="variable" id="l4b000019"><field name="variable_name">Scores</field></block></value><next><block type="list_aggregation" id="l4b000020"><field name="aggregation">sum</field><value name="output"><block type="variable" id="l4b000021"><field name="variable_name">Sum</field></block></value><value name="list"><block type="variable" id="l4b000022"><field name="variable_name">Scores</field></block></value></block></next></block></next></block></statement><value name="source"><block type="doc_selector" id="l4b000023"><mutation xmlns="http://www.w3.org/1999/xhtml" section_reference="sec_1_section"></mutation><field name="doc_part_name">S 1</field></block></value><statement name="conclusion"><block type="attribute_selector" id="l4b000024"><mutation xmlns="http://www.w3.org/1999/xhtml" attributename="total_score" attributetype="number" attributeorder="ov"></mutation><field name="prefix"></field><field name="infix">has total score of</field><field name="postfix"></field><value name="first_element"><block type="variable" id="l4b000025"><field name="variable_name">S</field></block></value><value name="second_element"><block type="variable" id="l4b000026"><field name="variable_name">Sum</field></block></value></block></statement></block>
      </xml>
    scasp_encoding: |-
      according_to(sec_1_section,total_score,S,Sum) :- student(S),
      scores(S,Scores),
      sum_blawx_list(Scores , Sum).

      % BLAWX CHECK DUPLICATES
      holds(sec_1_section,total_score,S,Sum) :- according_to(sec_1_section,total_score,S,Sum).

      % BLAWX CHECK DUPLICATES
        total_score(S,Sum) :- holds(sec_1_section,total_score,S,Sum).
