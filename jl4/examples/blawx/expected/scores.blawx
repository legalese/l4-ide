      #pred blawx_not_interrupted(Start,-scores(X,Y),End) :: 'it is not the case that @(X) has scores of @(Y) remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),scores(X,Y),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-scores(X,Y),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(Start),-scores(X,Y),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(scores(X,Y),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(bot),scores(X,Y),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(-scores(X,Y),datetime(Time)),Times),blawx_list_not_before(Times,End).
