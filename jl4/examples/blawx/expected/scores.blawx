      #pred blawx_not_interrupted(Start,-total_score(X,Y),End) :: 'it is not the case that @(X) has total score of @(Y) remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),total_score(X,Y),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-total_score(X,Y),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
