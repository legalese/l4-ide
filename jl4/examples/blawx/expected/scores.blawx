      blawx_not_interrupted(datetime(bot),-scores(X,Y),datetime(eot)) :- blawx_initially(-scores(X,Y)), blawx_ultimately(-scores(X,Y)), findall(Time,blawx_becomes(scores(X,Y),datetime(Time)),[]).
      blawx_as_of(scores(X,Y),datetime(Time)) :- blawx_initially(scores(X,Y)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),scores(X,Y),datetime(BeforeT)).
      blawx_as_of(scores(X,Y),datetime(Time)) :- blawx_becomes(scores(X,Y),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),scores(X,Y),datetime(Time)).
      blawx_as_of(-scores(X,Y),datetime(Time)) :- blawx_initially(-scores(X,Y)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-scores(X,Y),datetime(BeforeT)).
