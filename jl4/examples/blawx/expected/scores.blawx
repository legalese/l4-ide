      :- dynamic scores/2.
      #pred scores(X,Y) :: '@(X) has scores of @(Y)'.
      #pred holds(user,scores,X,Y) :: 'it is provided as a fact that @(X) has scores of @(Y)'.
      #pred holds(user,-scores,X,Y) :: 'it is provided as a fact that it is not the case that @(X) has scores of @(Y)'.
      #pred holds(Z,scores,X,Y) :: 'the conclusion in @(Z) that @(X) has scores of @(Y) holds'.
      #pred holds(Z,-scores,X,Y) :: 'the conclusion in @(Z) that it is not the case that @(X) has scores of @(Y) holds'.
      #pred according_to(Z,scores,X,Y) :: 'according to @(Z), @(X) has scores of @(Y)'.
      #pred according_to(Z,-scores,X,Y) :: 'according to @(Z), it is not the case that @(X) has scores of @(Y)'.
      #pred blawx_defeated(Z,scores,X,Y) :: 'the conclusion in @(Z) that @(X) has scores of @(Y) is defeated'.
      #pred blawx_defeated(Z,-scores,X,Y) :: 'the conclusion in @(Z) that @(X) has scores of @(Y) is defeated'.
      #pred blawx_initially(scores(X,Y)) :: 'that @(X) has scores of @(Y) holds initially'.
