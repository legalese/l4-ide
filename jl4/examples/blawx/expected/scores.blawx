      blawx_not_interrupted(datetime(Start),average_score(X,Y),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-average_score(X,Y),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
