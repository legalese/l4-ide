      <block type="attributed_rule" id="l4b000104" x="40" y="1384"><field name="defeasible">FALSE</field><field name="inapplicable">FALSE</field><statement name="conditions"><block type="attribute_selector" id="l4b000105"><mutation xmlns="http://www.w3.org/1999/xhtml" attributename="member" attributetype="object" attributeorder="ov"></mutation><field name="prefix"></field><field name="infix">member</field><field name="postfix"></field><value name="first_element"><block type="variable" id="l4b000106"><field name="variable_name">I</field></block></value><value name="second_element"><block type="variable" id="l4b000107"><field name="variable_name">Items</field></block></value><next><block type="attribute_selector" id="l4b000108"><mutation xmlns="http://www.w3.org/1999/xhtml" attributename="price" attributetype="number" attributeorder="ov"></mutation><field name="prefix"></field><field name="infix">has price of</field><field name="postfix"></field><value name="first_element"><block type="variable" id="l4b000109"><field name="variable_name">I</field></block></value><value name="second_element"><block type="variable" id="l4b000110"><field name="variable_name">Price</field></block></value></block></next></block></statement><value name="source"><block type="doc_selector" id="l4b000111"><mutation xmlns="http://www.w3.org/1999/xhtml" section_reference="sec_5_section"></mutation><field name="doc_part_name">S 5</field></block></value><statement name="conclusion"><block type="attribute_selector" id="l4b000112"><mutation xmlns="http://www.w3.org/1999/xhtml" attributename="basket_total_generator" attributetype="object" attributeorder="ov"></mutation><field name="prefix"></field><field name="infix">basket_total_generator</field><field name="postfix"></field><value name="first_element"><block type="variable" id="l4b000113"><field name="variable_name">Items</field></block></value><value name="second_element"><block type="variable" id="l4b000114"><field name="variable_name">Price</field></block></value></block></statement></block>
      </xml>
    scasp_encoding: |-
      according_to(sec_5_section,basket_total,B,Sum) :- basket(B),
      items(B,Items),
      findall(Price ,   basket_total_generator(Items,Price) , L),
      sum_blawx_list(L , Sum).

      % BLAWX CHECK DUPLICATES
      holds(sec_5_section,basket_total,B,Sum) :- according_to(sec_5_section,basket_total,B,Sum).

      % BLAWX CHECK DUPLICATES
        basket_total(B,Sum) :- holds(sec_5_section,basket_total,B,Sum).

      member(X,[X | Rest]).

      according_to(sec_5_section,member,X,[Head | Rest]) :- member(X,Rest).

      % BLAWX CHECK DUPLICATES
      holds(sec_5_section,member,X,[Head | Rest]) :- according_to(sec_5_section,member,X,[Head | Rest]).

      % BLAWX CHECK DUPLICATES
        member(X,[Head | Rest]) :- holds(sec_5_section,member,X,[Head | Rest]).

      according_to(sec_5_section,basket_total_generator,Items,Price) :- member(I,Items),
      price(I,Price).

      % BLAWX CHECK DUPLICATES
      holds(sec_5_section,basket_total_generator,Items,Price) :- according_to(sec_5_section,basket_total_generator,Items,Price).

      % BLAWX CHECK DUPLICATES
        basket_total_generator(Items,Price) :- holds(sec_5_section,basket_total_generator,Items,Price).
