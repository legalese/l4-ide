      :- dynamic best_score/2.
      #pred best_score(X,Y) :: '@(X) has best score of @(Y)'.
      #pred holds(user,best_score,X,Y) :: 'it is provided as a fact that @(X) has best score of @(Y)'.
      #pred holds(user,-best_score,X,Y) :: 'it is provided as a fact that it is not the case that @(X) has best score of @(Y)'.
      #pred holds(Z,best_score,X,Y) :: 'the conclusion in @(Z) that @(X) has best score of @(Y) holds'.
      #pred holds(Z,-best_score,X,Y) :: 'the conclusion in @(Z) that it is not the case that @(X) has best score of @(Y) holds'.
      #pred according_to(Z,best_score,X,Y) :: 'according to @(Z), @(X) has best score of @(Y)'.
      #pred according_to(Z,-best_score,X,Y) :: 'according to @(Z), it is not the case that @(X) has best score of @(Y)'.
      #pred blawx_defeated(Z,best_score,X,Y) :: 'the conclusion in @(Z) that @(X) has best score of @(Y) is defeated'.
      #pred blawx_defeated(Z,-best_score,X,Y) :: 'the conclusion in @(Z) that @(X) has best score of @(Y) is defeated'.
      #pred blawx_initially(best_score(X,Y)) :: 'that @(X) has best score of @(Y) holds initially'.
      #pred blawx_initially(-best_score(X,Y)) :: 'that it is not the case that @(X) has best score of @(Y) holds initially'.
      #pred blawx_ultimately(best_score(X,Y)) :: 'that @(X) has best score of @(Y) holds ultimately'.
      #pred blawx_ultimately(-best_score(X,Y)) :: 'that it is not the case that @(X) has best score of @(Y) holds ultimately'.
      #pred blawx_as_of(best_score(X,Y),T) :: 'that @(X) has best score of @(Y) holds at @(T)'.
      #pred blawx_as_of(-best_score(X,Y),T) :: 'that it is not the case that @(X) has best score of @(Y) holds at @(T)'.
      #pred blawx_during(T1,best_score(X,Y),T2) :: 'that @(X) has best score of @(Y) held between @(T1) and @(T2)'.
      #pred blawx_during(T1,-best_score(X,Y),T2) :: 'that it is not the case that @(X) has best score of @(Y) held between @(T1) and @(T2)'.
      #pred blawx_becomes(best_score(X,Y),T) :: 'that @(X) has best score of @(Y) became true at @(T)'.
      #pred blawx_becomes(-best_score(X,Y),T) :: 'that it is not the case that @(X) has best score of @(Y) became true at @(T)'.
      #pred blawx_not_interrupted(Start,best_score(X,Y),End) :: '@(X) has best score of @(Y) remained the case between @(Start) and @(End)'.
      #pred blawx_not_interrupted(Start,-best_score(X,Y),End) :: 'it is not the case that @(X) has best score of @(Y) remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),best_score(X,Y),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-best_score(X,Y),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(Start),-best_score(X,Y),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(best_score(X,Y),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(bot),best_score(X,Y),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(-best_score(X,Y),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(bot),-best_score(X,Y),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(best_score(X,Y),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(Start),best_score(X,Y),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(-best_score(X,Y),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(Start),-best_score(X,Y),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(best_score(X,Y),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(bot),best_score(X,Y),datetime(eot)) :- blawx_initially(best_score(X,Y)), blawx_ultimately(best_score(X,Y)), findall(Time,blawx_becomes(-best_score(X,Y),datetime(Time)),[]).
      blawx_not_interrupted(datetime(bot),-best_score(X,Y),datetime(eot)) :- blawx_initially(-best_score(X,Y)), blawx_ultimately(-best_score(X,Y)), findall(Time,blawx_becomes(best_score(X,Y),datetime(Time)),[]).
      blawx_as_of(best_score(X,Y),datetime(Time)) :- blawx_initially(best_score(X,Y)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),best_score(X,Y),datetime(BeforeT)).
      blawx_as_of(best_score(X,Y),datetime(Time)) :- blawx_becomes(best_score(X,Y),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),best_score(X,Y),datetime(Time)).
      blawx_as_of(-best_score(X,Y),datetime(Time)) :- blawx_initially(-best_score(X,Y)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-best_score(X,Y),datetime(BeforeT)).
      blawx_as_of(-best_score(X,Y),datetime(Time)) :- blawx_becomes(-best_score(X,Y),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),-best_score(X,Y),datetime(Time)).
      blawx_during(datetime(Start),best_score(X,Y),datetime(End)) :- blawx_becomes(best_score(X,Y),datetime(Start)), blawx_becomes(-best_score(X,Y),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),best_score(X,Y),datetime(End)).
      blawx_during(datetime(bot),best_score(X,Y),datetime(End)) :- blawx_initially(best_score(X,Y)), blawx_becomes(-best_score(X,Y),datetime(End)), blawx_not_interrupted(datetime(bot),best_score(X,Y),datetime(End)).
      blawx_during(datetime(Start),best_score(X,Y),datetime(eot)) :- blawx_ultimately(best_score(X,Y)), blawx_becomes(-best_score(X,Y),datetime(Start)), blawx_not_interrupted(datetime(Start),best_score(X,Y),datetime(eot)).
      blawx_during(datetime(bot),best_score(X,Y),datetime(eot)) :- blawx_initially(best_score(X,Y)), blawx_ultimately(best_score(X,Y)), blawx_becomes(-best_score(X,Y),datetime(Start)), blawx_not_interrupted(datetime(bot),best_score(X,Y),datetime(eot)).
      blawx_during(datetime(Start),-best_score(X,Y),datetime(End)) :- blawx_becomes(-best_score(X,Y),datetime(Start)), blawx_becomes(best_score(X,Y),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),-best_score(X,Y),datetime(End)).
      blawx_during(datetime(bot),-best_score(X,Y),datetime(End)) :- blawx_initially(-best_score(X,Y)), blawx_becomes(best_score(X,Y),datetime(End)), blawx_not_interrupted(datetime(bot),-best_score(X,Y),datetime(End)).
      blawx_during(datetime(Start),-best_score(X,Y),datetime(eot)) :- blawx_ultimately(-best_score(X,Y)), blawx_becomes(best_score(X,Y),datetime(Start)), blawx_not_interrupted(datetime(Start),-best_score(X,Y),datetime(eot)).
      blawx_during(datetime(bot),-best_score(X,Y),datetime(eot)) :- blawx_initially(-best_score(X,Y)), blawx_ultimately(-best_score(X,Y)), blawx_becomes(-best_score(X,Y),datetime(Start)), blawx_not_interrupted(datetime(bot),-best_score(X,Y),datetime(eot)).
