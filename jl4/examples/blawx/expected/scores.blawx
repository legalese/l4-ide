      blawx_as_of(scores(X,Y),datetime(Time)) :- blawx_initially(scores(X,Y)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),scores(X,Y),datetime(BeforeT)).
      blawx_as_of(scores(X,Y),datetime(Time)) :- blawx_becomes(scores(X,Y),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),scores(X,Y),datetime(Time)).
      blawx_as_of(-scores(X,Y),datetime(Time)) :- blawx_initially(-scores(X,Y)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-scores(X,Y),datetime(BeforeT)).
      blawx_as_of(-scores(X,Y),datetime(Time)) :- blawx_becomes(-scores(X,Y),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),-scores(X,Y),datetime(Time)).
      blawx_during(datetime(Start),scores(X,Y),datetime(End)) :- blawx_becomes(scores(X,Y),datetime(Start)), blawx_becomes(-scores(X,Y),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),scores(X,Y),datetime(End)).
      blawx_during(datetime(bot),scores(X,Y),datetime(End)) :- blawx_initially(scores(X,Y)), blawx_becomes(-scores(X,Y),datetime(End)), blawx_not_interrupted(datetime(bot),scores(X,Y),datetime(End)).
      blawx_during(datetime(Start),scores(X,Y),datetime(eot)) :- blawx_ultimately(scores(X,Y)), blawx_becomes(-scores(X,Y),datetime(Start)), blawx_not_interrupted(datetime(Start),scores(X,Y),datetime(eot)).
      blawx_during(datetime(bot),scores(X,Y),datetime(eot)) :- blawx_initially(scores(X,Y)), blawx_ultimately(scores(X,Y)), blawx_becomes(-scores(X,Y),datetime(Start)), blawx_not_interrupted(datetime(bot),scores(X,Y),datetime(eot)).
      blawx_during(datetime(Start),-scores(X,Y),datetime(End)) :- blawx_becomes(-scores(X,Y),datetime(Start)), blawx_becomes(scores(X,Y),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),-scores(X,Y),datetime(End)).
