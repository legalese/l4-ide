aste_neglect_or_default</field><field name="attribute_type">boolean</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><field name="infix"></field><field name="second_element">value</field><field name="postfix">lodger or sub tenant removal proviso waste neglect or default</field><next><block type="new_attribute_declaration" id="l4b000027"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="ground15_claim" attribute_type="boolean"></mutation><field name="category_name">ground15_claim</field><field name="attribute_name">ground_15_made_out</field><field name="attribute_type">boolean</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><field name="infix"></field><field name="second_element">value</field><field name="postfix">ground 15 made out</field><next><block type="new_attribute_declaration" id="l4b000028"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="ground15_claim" attribute_type="boolean"></mutation><field name="category_name">ground15_claim</field><field name="attribute_name">furniture_deteriorated_owing_to_ill_treatment</field><field name="attribute_type">boolean</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><field name="infix"></field><field name="second_element">value</field><field name="postfix">furniture deteriorated owing to ill treatment</field><next><block type="new_attribute_declaration" id="l4b000029"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="ground15_claim" attribute_type="boolean"></mutation><field name="category_name">ground15_claim</field><field name="attribute_name">lodger_or_sub_tenant_removal_proviso_ill_treatment</field><field name="attribute_type">boolean</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><field name="infix"></field><field name="second_element">value</field><field name="postfix">lodger or sub tenant removal proviso ill treatment</field><next><block type="new_attribute_declaration" id="l4b000030"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="ground17_claim" attribute_type="boolean"></mutation><field name="category_name">ground17_claim</field><field name="attribute_name">ground_17_made_out</field><field name="attribute_type">boolean</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><field name="infix"></field><field name="second_element">value</field><field name="postfix">ground 17 made out</field><next><block type="new_attribute_declaration" id="l4b000031"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="ground17_claim" attribute_type="boolean"></mutation><field name="category_name">ground17_claim</field><field name="attribute_name">tenant_is_a_grantee_of_the_tenancy</field><field name="attribute_type">boolean</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><field name="infix"></field><field name="second_element">value</field><field name="postfix">tenant is a grantee of the tenancy</field><next><block type="new_attribute_declaration" id="l4b000032"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="ground17_claim" attribute_type="boolean"></mutation><field name="category_name">ground17_claim</field><field name="attribute_name">landlord_induced_by_a_false_statement</field><field name="attribute_type">boolean</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><field name="infix"></field><field name="second_element">value</field><field name="postfix">landlord induced by a false statement</field><next><block type="new_attribute_declaration" id="l4b000033"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="ground17_claim" attribute_type="boolean"></mutation><field name="category_name">ground17_claim</field><field name="attribute_name">statement_made_by_the_tenant_or_at_the_tenant_s_instigation</field><field name="attribute_type">boolean</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><field name="infix"></field><field name="second_element">value</field><field name="postfix">statement made by the tenant or at the tenant s instigation</field></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block>
      <block type="unattributed_fact" id="l4b000034" x="40" y="2998"><statement name="statements"><block type="object_category" id="l4b000035"><value name="object"><block type="object_selector" id="l4b000036"><mutation xmlns="http://www.w3.org/1999/xhtml" objectname="weekly_or_fortnightly"></mutation><field name="object_name">weekly_or_fortnightly</field></block></value><value name="category"><block type="category_selector" id="l4b000037"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="rent_period"></mutation><field name="category_name">rent_period</field></block></value><next><block type="object_category" id="l4b000038"><value name="object"><block type="object_selector" id="l4b000039"><mutation xmlns="http://www.w3.org/1999/xhtml" objectname="monthly"></mutation><field name="object_name">monthly</field></block></value><value name="category"><block type="category_selector" id="l4b000040"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="rent_period"></mutation><field name="category_name">rent_period</field></block></value><next><block type="object_category" id="l4b000041"><value name="object"><block type="object_selector" id="l4b000042"><mutation xmlns="http://www.w3.org/1999/xhtml" objectname="other"></mutation><field name="object_name">other</field></block></value><value name="category"><block type="category_selector" id="l4b000043"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="rent_period"></mutation><field name="category_name">rent_period</field></block></value></block></next></block></next></block></statement></block>
