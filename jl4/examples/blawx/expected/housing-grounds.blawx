pe="boolean"></mutation><field name="category_name">ground15_claim</field><field name="attribute_name">the_condition_of_furniture_provided_for_use_under_the_tenancy_has_in_the_opinion_of_the_court_deteriorated_owing_to_ill_treatment_by_the_tenant_or_any_other_person_residing_in_the_dwelling_house</field><field name="attribute_type">boolean</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><field name="infix"></field><field name="second_element">value</field><field name="postfix">the condition of furniture provided for use under the tenancy has in the opinion of the court deteriorated owing to ill treatment by the tenant or any other person residing in the dwelling house</field><next><block type="new_attribute_declaration" id="l4b000015"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="ground15_claim" attribute_type="boolean"></mutation><field name="category_name">ground15_claim</field><field name="attribute_name">the_person_ill_treating_the_furniture_is_a_person_lodging_with_the_tenant_or_a_sub_tenant_of_his</field><field name="attribute_type">boolean</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><field name="infix"></field><field name="second_element">value</field><field name="postfix">the person ill treating the furniture is a person lodging with the tenant or a sub tenant of his</field><next><block type="new_attribute_declaration" id="l4b000016"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="ground15_claim" attribute_type="boolean"></mutation><field name="category_name">ground15_claim</field><field name="attribute_name">the_tenant_has_not_taken_such_steps_as_he_ought_reasonably_to_have_taken_for_the_removal_of_the_lodger_or_sub_tenant_who_ill_treated_the_furniture</field><field name="attribute_type">boolean</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><fie