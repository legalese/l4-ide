      <block type="assume" id="l4b001161" x="40" y="1936"><statement name="statements"><block type="unary_attribute_selector" id="l4b001162"><mutation xmlns="http://www.w3.org/1999/xhtml" attributename="the_person_ill_treating_the_furniture_is_a_person_lodging_with_the_tenant_or_a_sub_tenant_of_his" attributetype="boolean"></mutation><field name="prefix"></field><field name="postfix">the person ill treating the furniture is a person lodging with the tenant or a sub tenant of his</field><value name="first_element"><block type="variable" id="l4b001163"><field name="variable_name">X</field></block></value></block></statement></block>
      <block type="assume" id="l4b001164" x="40" y="2074"><statement name="statements"><block type="unary_attribute_selector" id="l4b001165"><mutation xmlns="http://www.w3.org/1999/xhtml" attributename="the_tenant_has_not_taken_such_steps_as_he_ought_reasonably_to_have_taken_for_the_removal_of_the_lodger_or_sub_tenant_who_ill_treated_the_furniture" attributetype="boolean"></mutation><field name="prefix"></field><field name="postfix">the tenant has not taken such steps as he ought reasonably to have taken for the removal of the lodger or sub tenant who ill treated the furniture</field><value name="first_element"><block type="variable" id="l4b001166"><field name="variable_name">X</field></block></value></block></statement></block>
      <block type="assume" id="l4b001167" x="40" y="2212"><statement name="statements"><block type="unary_attribute_selector" id="l4b001168"><mutation xmlns="http://www.w3.org/1999/xhtml" attributename="the_tenant_is_the_person_or_one_of_the_persons_to_whom_the_tenancy_was_granted" attributetype="boolean"></mutation><field name="prefix"></field><field name="postfix">the tenant is the person or one of the persons to whom the tenancy was granted</field><value name="first_element"><block type="variable" id="l4b001169"><field name="variable_name">X</field></block></value></block></statement></block>
      <block type="assume" id="l4b001170" x="40" y="2350"><statement name="statements"><block type="unary_attribute_selector" id="l4b001171"><mutation xmlns="http://www.w3.org/1999/xhtml" attributename="the_landlord_was_induced_to_grant_the_tenancy_by_a_false_statement_made_knowingly_or_recklessly" attributetype="boolean"></mutation><field name="prefix"></field><field name="postfix">the landlord was induced to grant the tenancy by a false statement made knowingly or recklessly</field><value name="first_element"><block type="variable" id="l4b001172"><field name="variable_name">X</field></block></value></block></statement></block>
      <block type="assume" id="l4b001173" x="40" y="2488"><statement name="statements"><block type="unary_attribute_selector" id="l4b001174"><mutation xmlns="http://www.w3.org/1999/xhtml" attributename="the_false_statement_was_made_by_the_tenant" attributetype="boolean"></mutation><field name="prefix"></field><field name="postfix">the false statement was made by the tenant</field><value name="first_element"><block type="variable" id="l4b001175"><field name="variable_name">X</field></block></value></block></statement></block>
      <block type="assume" id="l4b001176" x="40" y="2626"><statement name="statements"><block type="unary_attribute_selector" id="l4b001177"><mutation xmlns="http://www.w3.org/1999/xhtml" attributename="the_false_statement_was_made_by_a_person_acting_at_the_tenant_s_instigation" attributetype="boolean"></mutation><field name="prefix"></field><field name="postfix">the false statement was made by a person acting at the tenant s instigation</field><value name="first_element"><block type="variable" id="l4b001178"><field name="variable_name">X</field></block></value></block></statement></block>
