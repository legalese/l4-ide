    scasp_encoding: |-
      blawx_category(ground8_claim).
      blawx_category_nlg(ground8_claim,"","is a ground8 claim").
      :- dynamic ground8_claim/1.
      #pred ground8_claim(X) :: '@(X) is a ground8 claim'.
      #pred holds(user,ground8_claim,X) :: 'it is provided as a fact that @(X) is a ground8 claim'.
      #pred holds(user,-ground8_claim,X) :: 'it is provided as a fact that it is not the case that @(X) is a ground8 claim'.
      #pred holds(Z,ground8_claim,X) :: 'the conclusion in @(Z) that @(X) is a ground8 claim holds'.
      #pred holds(Z,-ground8_claim,X) :: 'the conclusion in @(Z) that it is not the case that @(X) is a ground8 claim holds'.
      #pred according_to(Z,ground8_claim,X) :: 'according to @(Z), @(X) is a ground8 claim'.
      #pred according_to(Z,-ground8_claim,X) :: 'according to @(Z), it is not the case that @(X) is a ground8 claim'.
      #pred blawx_defeated(Z,ground8_claim,X) :: 'the conclusion in @(Z) that @(X) is a ground8 claim is defeated'.
      #pred blawx_defeated(Z,-ground8_claim,X) :: 'the conclusion in @(Z) that it is not the case that @(X) is a ground8 claim is defeated'.
      #pred blawx_initially(ground8_claim(X)) :: 'that @(X) is a ground8 claim holds initially'.
      #pred blawx_initially(-ground8_claim(X)) :: 'that it is not the case that @(X) is a ground8 claim holds initially'.
      #pred blawx_ultimately(ground8_claim(X)) :: 'that @(X) is a ground8 claim holds ultimately'.
      #pred blawx_ultimately(-ground8_claim(X)) :: 'that it is not the case that @(X) is a ground8 claim holds ultimately'.
      #pred blawx_as_of(ground8_claim(X),T) :: 'that @(X) is a ground8 claim holds at @(T)'.
      #pred blawx_as_of(-ground8_claim(X),T) :: 'that it is not the case that @(X) is a ground8 claim holds at @(T)'.
      #pred blawx_during(T1,ground8_claim(X),T2) :: 'that @(X) is a ground8 claim held between @(T1) and @(T2)'.
      #pred blawx_during(T1,-ground8_claim(X),T2) :: 'that it is not the case that @(X) is a ground8 claim held between @(T1) and @(T2)'.
      #pred blawx_becomes(ground8_claim(X),T) :: 'that @(X) is a ground8 claim became true at @(T)'.
      #pred blawx_becomes(-ground8_claim(X),T) :: 'that it is not the case that @(X) is a ground8 claim became true at @(T)'.
      #pred blawx_not_interrupted(Start,ground8_claim(X),End) :: '@(X) is a ground8 claim remained the case between @(Start) and @(End)'.
      #pred blawx_not_interrupted(Start,-ground8_claim(X),End) :: 'it is not the case that @(X) is a ground8 claim remained the case between @(Start) and @(End)'.
