- model: blawx.ruledoc
  pk: 1
  fields:
    ruledoc_name: "Anti-social Behaviour, Crime and Policing Act 2014 - section 43 (record spelling)"
    rule_text: "Anti-social Behaviour, Crime and Policing Act 2014 - section 43 (record spelling)\n\n1. Anti-social Behaviour, Crime and Policing Act 2014 s.43(1): an authorised person may issue a community protection notice to an individual aged 16 or over, or to a body, if satisfied on reasonable grounds that (a) the conduct of the individual or body is having a detrimental effect, of a persistent or continuing nature, on the quality of life of those in the locality, and (b) the conduct is unreasonable.\n2. s.43(1): the notice may be given \"to an individual aged 16 or over, or to a body\". The two limbs are alternatives, and nothing else is a permissible recipient.\n3. s.43(1)(a): the conduct of the individual or body \"is having a detrimental effect, of a persistent or continuing nature, on the quality of life of those in the locality\".\n4. s.43(1)(a), of the effect itself: it must be \"detrimental\", \"of a persistent or continuing nature\", and on \"the quality of life of those in the locality\" - all three, of the same effect.\n5. Anti-social Behaviour, Crime and Policing Act 2014, s.43(1)(b)"
    scasp_encoding: ''
    tutorial: ''
    owner: 1
    published: true
- model: blawx.workspace
  pk: 1
  fields:
    ruledoc: 1
    workspace_name: root_section
    xml_content: |-
      <xml xmlns="https://developers.google.com/blockly/xml">
      <block type="unattributed_fact" id="l4b000001" x="40" y="40"><statement name="statements"><block type="new_category_declaration" id="l4b000002"><field name="category_name">person</field><field name="prefix"></field><field name="first_element">object</field><field name="postfix">is a person</field><next><block type="new_category_declaration" id="l4b000003"><field name="category_name">receiver</field><field name="prefix"></field><field name="first_element">object</field><field name="postfix">is a receiver</field><next><block type="new_category_declaration" id="l4b000004"><field name="category_name">behaviour</field><field name="prefix"></field><field name="first_element">object</field><field name="postfix">is a behaviour</field><next><block type="new_category_declaration" id="l4b000005"><field name="category_name">consequence</field><field name="prefix"></field><field name="first_element">object</field><field name="postfix">is a consequence</field><next><block type="new_attribute_declaration" id="l4b000006"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="person" attribute_type="boolean"></mutation><field name="category_name">person</field><field name="attribute_name">is_authorised</field><field name="attribute_type">boolean</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><field name="infix"></field><field name="second_element">value</field><field name="postfix">is authorised</field><next><block type="new_attribute_declaration" id="l4b000007"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="receiver" attribute_type="boolean"></mutation><field name="category_name">receiver</field><field name="attribute_name">is_an_individual_aged_16_or_over</field><field name="attribute_type">boolean</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><field name="infix"></field><field name="second_element">value</field><field name="postfix">is an individual aged 16 or over</field><next><block type="new_attribute_declaration" id="l4b000008"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="receiver" attribute_type="boolean"></mutation><field name="category_name">receiver</field><field name="attribute_name">is_a_body</field><field name="attribute_type">boolean</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><field name="infix"></field><field name="second_element">value</field><field name="postfix">is a body</field><next><block type="new_attribute_declaration" id="l4b000009"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="receiver" attribute_type="behaviour"></mutation><field name="category_name">receiver</field><field name="attribute_name">conduct</field><field name="attribute_type">behaviour</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><field name="infix">has conduct of</field><field name="second_element">value</field><field name="postfix"></field><next><block type="new_attribute_declaration" id="l4b000010"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="behaviour" attribute_type="consequence"></mutation><field name="category_name">behaviour</field><field name="attribute_name">effect</field><field name="attribute_type">consequence</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><field name="infix">has effect of</field><field name="second_element">value</field><field name="postfix"></field><next><block type="new_attribute_declaration" id="l4b000011"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="behaviour" attribute_type="boolean"></mutation><field name="category_name">behaviour</field><field name="attribute_name">is_unreasonable</field><field name="attribute_type">boolean</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><field name="infix"></field><field name="second_element">value</field><field name="postfix">is unreasonable</field><next><block type="new_attribute_declaration" id="l4b000012"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="consequence" attribute_type="boolean"></mutation><field name="category_name">consequence</field><field name="attribute_name">is_detrimental</field><field name="attribute_type">boolean</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><field name="infix"></field><field name="second_element">value</field><field name="postfix">is detrimental</field><next><block type="new_attribute_declaration" id="l4b000013"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="consequence" attribute_type="boolean"></mutation><field name="category_name">consequence</field><field name="attribute_name">is_of_a_persistent_or_continuing_nature</field><field name="attribute_type">boolean</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><field name="infix"></field><field name="second_element">value</field><field name="postfix">is of a persistent or continuing nature</field><next><block type="new_attribute_declaration" id="l4b000014"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="consequence" attribute_type="boolean"></mutation><field name="category_name">consequence</field><field name="attribute_name">affects_the_quality_of_life_of_those_in_the_locality</field><field name="attribute_type">boolean</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><field name="infix"></field><field name="second_element">value</field><field name="postfix">affects the quality of life of those in the locality</field><next><block type="new_attribute_declaration" id="l4b000015"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="receiver" attribute_type="boolean"></mutation><field name="category_name">receiver</field><field name="attribute_name">the_recipient_is_a_person_to_whom_a_notice_may_be_given</field><field name="attribute_type">boolean</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><field name="infix"></field><field name="second_element">value</field><field name="postfix">the recipient is a person to whom a notice may be given</field><next><block type="new_attribute_declaration" id="l4b000016"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="receiver" attribute_type="boolean"></mutation><field name="category_name">receiver</field><field name="attribute_name">the_conduct_is_having_a_detrimental_effect_of_a_persistent_or_continuing_nature</field><field name="attribute_type">boolean</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><field name="infix"></field><field name="second_element">value</field><field name="postfix">the conduct is having a detrimental effect of a persistent or continuing nature</field><next><block type="new_attribute_declaration" id="l4b000017"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="consequence" attribute_type="boolean"></mutation><field name="category_name">consequence</field><field name="attribute_name">the_effect_is_detrimental_persistent_and_affects_the_quality_of_life_in_the_locality</field><field name="attribute_type">boolean</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><field name="infix"></field><field name="second_element">value</field><field name="postfix">the effect is detrimental persistent and affects the quality of life in the locality</field><next><block type="new_attribute_declaration" id="l4b000018"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="receiver" attribute_type="boolean"></mutation><field name="category_name">receiver</field><field name="attribute_name">the_conduct_is_unreasonable</field><field name="attribute_type">boolean</field><field name="order">ov</field><field name="prefix"></field><field name="first_element">object</field><field name="infix"></field><field name="second_element">value</field><field name="postfix">the conduct is unreasonable</field></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block>
      </xml>
    scasp_encoding: |-
      blawx_category(person).
      blawx_category_nlg(person,"","is a person").
      :- dynamic person/1.
      #pred person(X) :: '@(X) is a person'.
      #pred holds(user,person,X) :: 'it is provided as a fact that @(X) is a person'.
      #pred holds(user,-person,X) :: 'it is provided as a fact that it is not the case that @(X) is a person'.
      #pred holds(Z,person,X) :: 'the conclusion in @(Z) that @(X) is a person holds'.
      #pred holds(Z,-person,X) :: 'the conclusion in @(Z) that it is not the case that @(X) is a person holds'.
      #pred according_to(Z,person,X) :: 'according to @(Z), @(X) is a person'.
      #pred according_to(Z,-person,X) :: 'according to @(Z), it is not the case that @(X) is a person'.
      #pred blawx_defeated(Z,person,X) :: 'the conclusion in @(Z) that @(X) is a person is defeated'.
      #pred blawx_defeated(Z,-person,X) :: 'the conclusion in @(Z) that it is not the case that @(X) is a person is defeated'.
      #pred blawx_initially(person(X)) :: 'that @(X) is a person holds initially'.
      #pred blawx_initially(-person(X)) :: 'that it is not the case that @(X) is a person holds initially'.
      #pred blawx_ultimately(person(X)) :: 'that @(X) is a person holds ultimately'.
      #pred blawx_ultimately(-person(X)) :: 'that it is not the case that @(X) is a person holds ultimately'.
      #pred blawx_as_of(person(X),T) :: 'that @(X) is a person holds at @(T)'.
      #pred blawx_as_of(-person(X),T) :: 'that it is not the case that @(X) is a person holds at @(T)'.
      #pred blawx_during(T1,person(X),T2) :: 'that @(X) is a person held between @(T1) and @(T2)'.
      #pred blawx_during(T1,-person(X),T2) :: 'that it is not the case that @(X) is a person held between @(T1) and @(T2)'.
      #pred blawx_becomes(person(X),T) :: 'that @(X) is a person became true at @(T)'.
      #pred blawx_becomes(-person(X),T) :: 'that it is not the case that @(X) is a person became true at @(T)'.
      #pred blawx_not_interrupted(Start,person(X),End) :: '@(X) is a person remained the case between @(Start) and @(End)'.
      #pred blawx_not_interrupted(Start,-person(X),End) :: 'it is not the case that @(X) is a person remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),person(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-person(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(Start),-person(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(person(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(bot),person(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(-person(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(bot),-person(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(person(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(Start),person(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(-person(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(Start),-person(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(person(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(bot),person(X),datetime(eot)) :- blawx_initially(person(X)), blawx_ultimately(person(X)), findall(Time,blawx_becomes(-person(X),datetime(Time)),[]).
      blawx_not_interrupted(datetime(bot),-person(X),datetime(eot)) :- blawx_initially(-person(X)), blawx_ultimately(-person(X)), findall(Time,blawx_becomes(person(X),datetime(Time)),[]).
      blawx_as_of(person(X),datetime(Time)) :- blawx_initially(person(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),person(X),datetime(BeforeT)).
      blawx_as_of(person(X),datetime(Time)) :- blawx_becomes(person(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),person(X),datetime(Time)).
      blawx_as_of(-person(X),datetime(Time)) :- blawx_initially(-person(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-person(X),datetime(BeforeT)).
      blawx_as_of(-person(X),datetime(Time)) :- blawx_becomes(-person(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),-person(X),datetime(Time)).
      blawx_during(datetime(Start),person(X),datetime(End)) :- blawx_becomes(person(X),datetime(Start)), blawx_becomes(-person(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),person(X),datetime(End)).
      blawx_during(datetime(bot),person(X),datetime(End)) :- blawx_initially(person(X)), blawx_becomes(-person(X),datetime(End)), blawx_not_interrupted(datetime(bot),person(X),datetime(End)).
      blawx_during(datetime(Start),person(X),datetime(eot)) :- blawx_ultimately(person(X)), blawx_becomes(-person(X),datetime(Start)), blawx_not_interrupted(datetime(Start),person(X),datetime(eot)).
      blawx_during(datetime(bot),person(X),datetime(eot)) :- blawx_initially(person(X)), blawx_ultimately(person(X)), blawx_becomes(-person(X),datetime(Start)), blawx_not_interrupted(datetime(bot),person(X),datetime(eot)).
      blawx_during(datetime(Start),-person(X),datetime(End)) :- blawx_becomes(-person(X),datetime(Start)), blawx_becomes(person(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),-person(X),datetime(End)).
      blawx_during(datetime(bot),-person(X),datetime(End)) :- blawx_initially(-person(X)), blawx_becomes(person(X),datetime(End)), blawx_not_interrupted(datetime(bot),-person(X),datetime(End)).
      blawx_during(datetime(Start),-person(X),datetime(eot)) :- blawx_ultimately(-person(X)), blawx_becomes(person(X),datetime(Start)), blawx_not_interrupted(datetime(Start),-person(X),datetime(eot)).
      blawx_during(datetime(bot),-person(X),datetime(eot)) :- blawx_initially(-person(X)), blawx_ultimately(-person(X)), blawx_becomes(-person(X),datetime(Start)), blawx_not_interrupted(datetime(bot),-person(X),datetime(eot)).
      blawx_category(receiver).
      blawx_category_nlg(receiver,"","is a receiver").
      :- dynamic receiver/1.
      #pred receiver(X) :: '@(X) is a receiver'.
      #pred holds(user,receiver,X) :: 'it is provided as a fact that @(X) is a receiver'.
      #pred holds(user,-receiver,X) :: 'it is provided as a fact that it is not the case that @(X) is a receiver'.
      #pred holds(Z,receiver,X) :: 'the conclusion in @(Z) that @(X) is a receiver holds'.
      #pred holds(Z,-receiver,X) :: 'the conclusion in @(Z) that it is not the case that @(X) is a receiver holds'.
      #pred according_to(Z,receiver,X) :: 'according to @(Z), @(X) is a receiver'.
      #pred according_to(Z,-receiver,X) :: 'according to @(Z), it is not the case that @(X) is a receiver'.
      #pred blawx_defeated(Z,receiver,X) :: 'the conclusion in @(Z) that @(X) is a receiver is defeated'.
      #pred blawx_defeated(Z,-receiver,X) :: 'the conclusion in @(Z) that it is not the case that @(X) is a receiver is defeated'.
      #pred blawx_initially(receiver(X)) :: 'that @(X) is a receiver holds initially'.
      #pred blawx_initially(-receiver(X)) :: 'that it is not the case that @(X) is a receiver holds initially'.
      #pred blawx_ultimately(receiver(X)) :: 'that @(X) is a receiver holds ultimately'.
      #pred blawx_ultimately(-receiver(X)) :: 'that it is not the case that @(X) is a receiver holds ultimately'.
      #pred blawx_as_of(receiver(X),T) :: 'that @(X) is a receiver holds at @(T)'.
      #pred blawx_as_of(-receiver(X),T) :: 'that it is not the case that @(X) is a receiver holds at @(T)'.
      #pred blawx_during(T1,receiver(X),T2) :: 'that @(X) is a receiver held between @(T1) and @(T2)'.
      #pred blawx_during(T1,-receiver(X),T2) :: 'that it is not the case that @(X) is a receiver held between @(T1) and @(T2)'.
      #pred blawx_becomes(receiver(X),T) :: 'that @(X) is a receiver became true at @(T)'.
      #pred blawx_becomes(-receiver(X),T) :: 'that it is not the case that @(X) is a receiver became true at @(T)'.
      #pred blawx_not_interrupted(Start,receiver(X),End) :: '@(X) is a receiver remained the case between @(Start) and @(End)'.
      #pred blawx_not_interrupted(Start,-receiver(X),End) :: 'it is not the case that @(X) is a receiver remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),receiver(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-receiver(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(Start),-receiver(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(receiver(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(bot),receiver(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(-receiver(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(bot),-receiver(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(receiver(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(Start),receiver(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(-receiver(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(Start),-receiver(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(receiver(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(bot),receiver(X),datetime(eot)) :- blawx_initially(receiver(X)), blawx_ultimately(receiver(X)), findall(Time,blawx_becomes(-receiver(X),datetime(Time)),[]).
      blawx_not_interrupted(datetime(bot),-receiver(X),datetime(eot)) :- blawx_initially(-receiver(X)), blawx_ultimately(-receiver(X)), findall(Time,blawx_becomes(receiver(X),datetime(Time)),[]).
      blawx_as_of(receiver(X),datetime(Time)) :- blawx_initially(receiver(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),receiver(X),datetime(BeforeT)).
      blawx_as_of(receiver(X),datetime(Time)) :- blawx_becomes(receiver(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),receiver(X),datetime(Time)).
      blawx_as_of(-receiver(X),datetime(Time)) :- blawx_initially(-receiver(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-receiver(X),datetime(BeforeT)).
      blawx_as_of(-receiver(X),datetime(Time)) :- blawx_becomes(-receiver(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),-receiver(X),datetime(Time)).
      blawx_during(datetime(Start),receiver(X),datetime(End)) :- blawx_becomes(receiver(X),datetime(Start)), blawx_becomes(-receiver(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),receiver(X),datetime(End)).
      blawx_during(datetime(bot),receiver(X),datetime(End)) :- blawx_initially(receiver(X)), blawx_becomes(-receiver(X),datetime(End)), blawx_not_interrupted(datetime(bot),receiver(X),datetime(End)).
      blawx_during(datetime(Start),receiver(X),datetime(eot)) :- blawx_ultimately(receiver(X)), blawx_becomes(-receiver(X),datetime(Start)), blawx_not_interrupted(datetime(Start),receiver(X),datetime(eot)).
      blawx_during(datetime(bot),receiver(X),datetime(eot)) :- blawx_initially(receiver(X)), blawx_ultimately(receiver(X)), blawx_becomes(-receiver(X),datetime(Start)), blawx_not_interrupted(datetime(bot),receiver(X),datetime(eot)).
      blawx_during(datetime(Start),-receiver(X),datetime(End)) :- blawx_becomes(-receiver(X),datetime(Start)), blawx_becomes(receiver(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),-receiver(X),datetime(End)).
      blawx_during(datetime(bot),-receiver(X),datetime(End)) :- blawx_initially(-receiver(X)), blawx_becomes(receiver(X),datetime(End)), blawx_not_interrupted(datetime(bot),-receiver(X),datetime(End)).
      blawx_during(datetime(Start),-receiver(X),datetime(eot)) :- blawx_ultimately(-receiver(X)), blawx_becomes(receiver(X),datetime(Start)), blawx_not_interrupted(datetime(Start),-receiver(X),datetime(eot)).
      blawx_during(datetime(bot),-receiver(X),datetime(eot)) :- blawx_initially(-receiver(X)), blawx_ultimately(-receiver(X)), blawx_becomes(-receiver(X),datetime(Start)), blawx_not_interrupted(datetime(bot),-receiver(X),datetime(eot)).
      blawx_category(behaviour).
      blawx_category_nlg(behaviour,"","is a behaviour").
      :- dynamic behaviour/1.
      #pred behaviour(X) :: '@(X) is a behaviour'.
      #pred holds(user,behaviour,X) :: 'it is provided as a fact that @(X) is a behaviour'.
      #pred holds(user,-behaviour,X) :: 'it is provided as a fact that it is not the case that @(X) is a behaviour'.
      #pred holds(Z,behaviour,X) :: 'the conclusion in @(Z) that @(X) is a behaviour holds'.
      #pred holds(Z,-behaviour,X) :: 'the conclusion in @(Z) that it is not the case that @(X) is a behaviour holds'.
      #pred according_to(Z,behaviour,X) :: 'according to @(Z), @(X) is a behaviour'.
      #pred according_to(Z,-behaviour,X) :: 'according to @(Z), it is not the case that @(X) is a behaviour'.
      #pred blawx_defeated(Z,behaviour,X) :: 'the conclusion in @(Z) that @(X) is a behaviour is defeated'.
      #pred blawx_defeated(Z,-behaviour,X) :: 'the conclusion in @(Z) that it is not the case that @(X) is a behaviour is defeated'.
      #pred blawx_initially(behaviour(X)) :: 'that @(X) is a behaviour holds initially'.
      #pred blawx_initially(-behaviour(X)) :: 'that it is not the case that @(X) is a behaviour holds initially'.
      #pred blawx_ultimately(behaviour(X)) :: 'that @(X) is a behaviour holds ultimately'.
      #pred blawx_ultimately(-behaviour(X)) :: 'that it is not the case that @(X) is a behaviour holds ultimately'.
      #pred blawx_as_of(behaviour(X),T) :: 'that @(X) is a behaviour holds at @(T)'.
      #pred blawx_as_of(-behaviour(X),T) :: 'that it is not the case that @(X) is a behaviour holds at @(T)'.
      #pred blawx_during(T1,behaviour(X),T2) :: 'that @(X) is a behaviour held between @(T1) and @(T2)'.
      #pred blawx_during(T1,-behaviour(X),T2) :: 'that it is not the case that @(X) is a behaviour held between @(T1) and @(T2)'.
      #pred blawx_becomes(behaviour(X),T) :: 'that @(X) is a behaviour became true at @(T)'.
      #pred blawx_becomes(-behaviour(X),T) :: 'that it is not the case that @(X) is a behaviour became true at @(T)'.
      #pred blawx_not_interrupted(Start,behaviour(X),End) :: '@(X) is a behaviour remained the case between @(Start) and @(End)'.
      #pred blawx_not_interrupted(Start,-behaviour(X),End) :: 'it is not the case that @(X) is a behaviour remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),behaviour(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-behaviour(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(Start),-behaviour(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(behaviour(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(bot),behaviour(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(-behaviour(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(bot),-behaviour(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(behaviour(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(Start),behaviour(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(-behaviour(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(Start),-behaviour(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(behaviour(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(bot),behaviour(X),datetime(eot)) :- blawx_initially(behaviour(X)), blawx_ultimately(behaviour(X)), findall(Time,blawx_becomes(-behaviour(X),datetime(Time)),[]).
      blawx_not_interrupted(datetime(bot),-behaviour(X),datetime(eot)) :- blawx_initially(-behaviour(X)), blawx_ultimately(-behaviour(X)), findall(Time,blawx_becomes(behaviour(X),datetime(Time)),[]).
      blawx_as_of(behaviour(X),datetime(Time)) :- blawx_initially(behaviour(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),behaviour(X),datetime(BeforeT)).
      blawx_as_of(behaviour(X),datetime(Time)) :- blawx_becomes(behaviour(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),behaviour(X),datetime(Time)).
      blawx_as_of(-behaviour(X),datetime(Time)) :- blawx_initially(-behaviour(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-behaviour(X),datetime(BeforeT)).
      blawx_as_of(-behaviour(X),datetime(Time)) :- blawx_becomes(-behaviour(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),-behaviour(X),datetime(Time)).
      blawx_during(datetime(Start),behaviour(X),datetime(End)) :- blawx_becomes(behaviour(X),datetime(Start)), blawx_becomes(-behaviour(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),behaviour(X),datetime(End)).
      blawx_during(datetime(bot),behaviour(X),datetime(End)) :- blawx_initially(behaviour(X)), blawx_becomes(-behaviour(X),datetime(End)), blawx_not_interrupted(datetime(bot),behaviour(X),datetime(End)).
      blawx_during(datetime(Start),behaviour(X),datetime(eot)) :- blawx_ultimately(behaviour(X)), blawx_becomes(-behaviour(X),datetime(Start)), blawx_not_interrupted(datetime(Start),behaviour(X),datetime(eot)).
      blawx_during(datetime(bot),behaviour(X),datetime(eot)) :- blawx_initially(behaviour(X)), blawx_ultimately(behaviour(X)), blawx_becomes(-behaviour(X),datetime(Start)), blawx_not_interrupted(datetime(bot),behaviour(X),datetime(eot)).
      blawx_during(datetime(Start),-behaviour(X),datetime(End)) :- blawx_becomes(-behaviour(X),datetime(Start)), blawx_becomes(behaviour(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),-behaviour(X),datetime(End)).
      blawx_during(datetime(bot),-behaviour(X),datetime(End)) :- blawx_initially(-behaviour(X)), blawx_becomes(behaviour(X),datetime(End)), blawx_not_interrupted(datetime(bot),-behaviour(X),datetime(End)).
      blawx_during(datetime(Start),-behaviour(X),datetime(eot)) :- blawx_ultimately(-behaviour(X)), blawx_becomes(behaviour(X),datetime(Start)), blawx_not_interrupted(datetime(Start),-behaviour(X),datetime(eot)).
      blawx_during(datetime(bot),-behaviour(X),datetime(eot)) :- blawx_initially(-behaviour(X)), blawx_ultimately(-behaviour(X)), blawx_becomes(-behaviour(X),datetime(Start)), blawx_not_interrupted(datetime(bot),-behaviour(X),datetime(eot)).
      blawx_category(consequence).
      blawx_category_nlg(consequence,"","is a consequence").
      :- dynamic consequence/1.
      #pred consequence(X) :: '@(X) is a consequence'.
      #pred holds(user,consequence,X) :: 'it is provided as a fact that @(X) is a consequence'.
      #pred holds(user,-consequence,X) :: 'it is provided as a fact that it is not the case that @(X) is a consequence'.
      #pred holds(Z,consequence,X) :: 'the conclusion in @(Z) that @(X) is a consequence holds'.
      #pred holds(Z,-consequence,X) :: 'the conclusion in @(Z) that it is not the case that @(X) is a consequence holds'.
      #pred according_to(Z,consequence,X) :: 'according to @(Z), @(X) is a consequence'.
      #pred according_to(Z,-consequence,X) :: 'according to @(Z), it is not the case that @(X) is a consequence'.
      #pred blawx_defeated(Z,consequence,X) :: 'the conclusion in @(Z) that @(X) is a consequence is defeated'.
      #pred blawx_defeated(Z,-consequence,X) :: 'the conclusion in @(Z) that it is not the case that @(X) is a consequence is defeated'.
      #pred blawx_initially(consequence(X)) :: 'that @(X) is a consequence holds initially'.
      #pred blawx_initially(-consequence(X)) :: 'that it is not the case that @(X) is a consequence holds initially'.
      #pred blawx_ultimately(consequence(X)) :: 'that @(X) is a consequence holds ultimately'.
      #pred blawx_ultimately(-consequence(X)) :: 'that it is not the case that @(X) is a consequence holds ultimately'.
      #pred blawx_as_of(consequence(X),T) :: 'that @(X) is a consequence holds at @(T)'.
      #pred blawx_as_of(-consequence(X),T) :: 'that it is not the case that @(X) is a consequence holds at @(T)'.
      #pred blawx_during(T1,consequence(X),T2) :: 'that @(X) is a consequence held between @(T1) and @(T2)'.
      #pred blawx_during(T1,-consequence(X),T2) :: 'that it is not the case that @(X) is a consequence held between @(T1) and @(T2)'.
      #pred blawx_becomes(consequence(X),T) :: 'that @(X) is a consequence became true at @(T)'.
      #pred blawx_becomes(-consequence(X),T) :: 'that it is not the case that @(X) is a consequence became true at @(T)'.
      #pred blawx_not_interrupted(Start,consequence(X),End) :: '@(X) is a consequence remained the case between @(Start) and @(End)'.
      #pred blawx_not_interrupted(Start,-consequence(X),End) :: 'it is not the case that @(X) is a consequence remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),consequence(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-consequence(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(Start),-consequence(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(consequence(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(bot),consequence(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(-consequence(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(bot),-consequence(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(consequence(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(Start),consequence(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(-consequence(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(Start),-consequence(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(consequence(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(bot),consequence(X),datetime(eot)) :- blawx_initially(consequence(X)), blawx_ultimately(consequence(X)), findall(Time,blawx_becomes(-consequence(X),datetime(Time)),[]).
      blawx_not_interrupted(datetime(bot),-consequence(X),datetime(eot)) :- blawx_initially(-consequence(X)), blawx_ultimately(-consequence(X)), findall(Time,blawx_becomes(consequence(X),datetime(Time)),[]).
      blawx_as_of(consequence(X),datetime(Time)) :- blawx_initially(consequence(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),consequence(X),datetime(BeforeT)).
      blawx_as_of(consequence(X),datetime(Time)) :- blawx_becomes(consequence(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),consequence(X),datetime(Time)).
      blawx_as_of(-consequence(X),datetime(Time)) :- blawx_initially(-consequence(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-consequence(X),datetime(BeforeT)).
      blawx_as_of(-consequence(X),datetime(Time)) :- blawx_becomes(-consequence(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),-consequence(X),datetime(Time)).
      blawx_during(datetime(Start),consequence(X),datetime(End)) :- blawx_becomes(consequence(X),datetime(Start)), blawx_becomes(-consequence(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),consequence(X),datetime(End)).
      blawx_during(datetime(bot),consequence(X),datetime(End)) :- blawx_initially(consequence(X)), blawx_becomes(-consequence(X),datetime(End)), blawx_not_interrupted(datetime(bot),consequence(X),datetime(End)).
      blawx_during(datetime(Start),consequence(X),datetime(eot)) :- blawx_ultimately(consequence(X)), blawx_becomes(-consequence(X),datetime(Start)), blawx_not_interrupted(datetime(Start),consequence(X),datetime(eot)).
      blawx_during(datetime(bot),consequence(X),datetime(eot)) :- blawx_initially(consequence(X)), blawx_ultimately(consequence(X)), blawx_becomes(-consequence(X),datetime(Start)), blawx_not_interrupted(datetime(bot),consequence(X),datetime(eot)).
      blawx_during(datetime(Start),-consequence(X),datetime(End)) :- blawx_becomes(-consequence(X),datetime(Start)), blawx_becomes(consequence(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),-consequence(X),datetime(End)).
      blawx_during(datetime(bot),-consequence(X),datetime(End)) :- blawx_initially(-consequence(X)), blawx_becomes(consequence(X),datetime(End)), blawx_not_interrupted(datetime(bot),-consequence(X),datetime(End)).
      blawx_during(datetime(Start),-consequence(X),datetime(eot)) :- blawx_ultimately(-consequence(X)), blawx_becomes(consequence(X),datetime(Start)), blawx_not_interrupted(datetime(Start),-consequence(X),datetime(eot)).
      blawx_during(datetime(bot),-consequence(X),datetime(eot)) :- blawx_initially(-consequence(X)), blawx_ultimately(-consequence(X)), blawx_becomes(-consequence(X),datetime(Start)), blawx_not_interrupted(datetime(bot),-consequence(X),datetime(eot)).
