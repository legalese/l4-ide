      #pred blawx_during(T1,-is_unreasonable(X),T2) :: 'that it is not the case that @(X) is unreasonable held between @(T1) and @(T2)'.
      #pred blawx_becomes(is_unreasonable(X),T) :: 'that @(X) is unreasonable became true at @(T)'.
      #pred blawx_becomes(-is_unreasonable(X),T) :: 'that it is not the case that @(X) is unreasonable became true at @(T)'.
      #pred blawx_not_interrupted(Start,is_unreasonable(X),End) :: '@(X) is unreasonable remained the case between @(Start) and @(End)'.
      #pred blawx_not_interrupted(Start,-is_unreasonable(X),End) :: 'it is not the case that @(X) is unreasonable remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),is_unreasonable(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-is_unreasonable(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
