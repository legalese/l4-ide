      blawx_during(datetime(Start),-effect(X,Y),datetime(eot)) :- blawx_ultimately(-effect(X,Y)), blawx_becomes(effect(X,Y),datetime(Start)), blawx_not_interrupted(datetime(Start),-effect(X,Y),datetime(eot)).
