      #pred blawx_not_interrupted(Start,-effect(X,Y),End) :: 'it is not the case that @(X) has effect of @(Y) remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),effect(X,Y),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-effect(X,Y),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(Start),-effect(X,Y),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(effect(X,Y),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(bot),effect(X,Y),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(-effect(X,Y),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(bot),-effect(X,Y),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(effect(X,Y),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(Start),effect(X,Y),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(-effect(X,Y),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(Start),-effect(X,Y),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(effect(X,Y),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(bot),effect(X,Y),datetime(eot)) :- blawx_initially(effect(X,Y)), blawx_ultimately(effect(X,Y)), findall(Time,blawx_becomes(-effect(X,Y),datetime(Time)),[]).
      blawx_not_interrupted(datetime(bot),-effect(X,Y),datetime(eot)) :- blawx_initially(-effect(X,Y)), blawx_ultimately(-effect(X,Y)), findall(Time,blawx_becomes(effect(X,Y),datetime(Time)),[]).
      blawx_as_of(effect(X,Y),datetime(Time)) :- blawx_initially(effect(X,Y)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),effect(X,Y),datetime(BeforeT)).
      blawx_as_of(effect(X,Y),datetime(Time)) :- blawx_becomes(effect(X,Y),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),effect(X,Y),datetime(Time)).
      blawx_as_of(-effect(X,Y),datetime(Time)) :- blawx_initially(-effect(X,Y)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-effect(X,Y),datetime(BeforeT)).
      blawx_as_of(-effect(X,Y),datetime(Time)) :- blawx_becomes(-effect(X,Y),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),-effect(X,Y),datetime(Time)).
      blawx_during(datetime(Start),effect(X,Y),datetime(End)) :- blawx_becomes(effect(X,Y),datetime(Start)), blawx_becomes(-effect(X,Y),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),effect(X,Y),datetime(End)).
      blawx_during(datetime(bot),effect(X,Y),datetime(End)) :- blawx_initially(effect(X,Y)), blawx_becomes(-effect(X,Y),datetime(End)), blawx_not_interrupted(datetime(bot),effect(X,Y),datetime(End)).
      blawx_during(datetime(Start),effect(X,Y),datetime(eot)) :- blawx_ultimately(effect(X,Y)), blawx_becomes(-effect(X,Y),datetime(Start)), blawx_not_interrupted(datetime(Start),effect(X,Y),datetime(eot)).
      blawx_during(datetime(bot),effect(X,Y),datetime(eot)) :- blawx_initially(effect(X,Y)), blawx_ultimately(effect(X,Y)), blawx_becomes(-effect(X,Y),datetime(Start)), blawx_not_interrupted(datetime(bot),effect(X,Y),datetime(eot)).
      blawx_during(datetime(Start),-effect(X,Y),datetime(End)) :- blawx_becomes(-effect(X,Y),datetime(Start)), blawx_becomes(effect(X,Y),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),-effect(X,Y),datetime(End)).
