      blawx_not_interrupted(datetime(Start),is_unreasonable(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(-is_unreasonable(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(Start),-is_unreasonable(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(is_unreasonable(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(bot),is_unreasonable(X),datetime(eot)) :- blawx_initially(is_unreasonable(X)), blawx_ultimately(is_unreasonable(X)), findall(Time,blawx_becomes(-is_unreasonable(X),datetime(Time)),[]).
      blawx_not_interrupted(datetime(bot),-is_unreasonable(X),datetime(eot)) :- blawx_initially(-is_unreasonable(X)), blawx_ultimately(-is_unreasonable(X)), findall(Time,blawx_becomes(is_unreasonable(X),datetime(Time)),[]).
      blawx_as_of(is_unreasonable(X),datetime(Time)) :- blawx_initially(is_unreasonable(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),is_unreasonable(X),datetime(BeforeT)).
      blawx_as_of(is_unreasonable(X),datetime(Time)) :- blawx_becomes(is_unreasonable(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),is_unreasonable(X),datetime(Time)).
      blawx_as_of(-is_unreasonable(X),datetime(Time)) :- blawx_initially(-is_unreasonable(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-is_unreasonable(X),datetime(BeforeT)).
      blawx_as_of(-is_unreasonable(X),datetime(Time)) :- blawx_becomes(-is_unreasonable(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),-is_unreasonable(X),datetime(Time)).
      blawx_during(datetime(Start),is_unreasonable(X),datetime(End)) :- blawx_becomes(is_unreasonable(X),datetime(Start)), blawx_becomes(-is_unreasonable(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),is_unreasonable(X),datetime(End)).
