      blawx_during(datetime(bot),conduct(X,Y),datetime(End)) :- blawx_initially(conduct(X,Y)), blawx_becomes(-conduct(X,Y),datetime(End)), blawx_not_interrupted(datetime(bot),conduct(X,Y),datetime(End)).
