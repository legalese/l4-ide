      blawx_not_interrupted(datetime(bot),-ensuing_covered_loss(X),datetime(eot)) :- blawx_initially(-ensuing_covered_loss(X)), blawx_ultimately(-ensuing_covered_loss(X)), findall(Time,blawx_becomes(ensuing_covered_loss(X),datetime(Time)),[]).
      blawx_as_of(ensuing_covered_loss(X),datetime(Time)) :- blawx_initially(ensuing_covered_loss(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),ensuing_covered_loss(X),datetime(BeforeT)).
      blawx_as_of(ensuing_covered_loss(X),datetime(Time)) :- blawx_becomes(ensuing_covered_loss(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),ensuing_covered_loss(X),datetime(Time)).
      blawx_as_of(-ensuing_covered_loss(X),datetime(Time)) :- blawx_initially(-ensuing_covered_loss(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-ensuing_covered_loss(X),datetime(BeforeT)).
      blawx_as_of(-ensuing_covered_loss(X),datetime(Time)) :- blawx_becomes(-ensuing_covered_loss(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),-ensuing_covered_loss(X),datetime(Time)).
      blawx_during(datetime(Start),ensuing_covered_loss(X),datetime(End)) :- blawx_becomes(ensuing_covered_loss(X),datetime(Start)), blawx_becomes(-ensuing_covered_loss(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),ensuing_covered_loss(X),datetime(End)).
      blawx_during(datetime(bot),ensuing_covered_loss(X),datetime(End)) :- blawx_initially(ensuing_covered_loss(X)), blawx_becomes(-ensuing_covered_loss(X),datetime(End)), blawx_not_interrupted(datetime(bot),ensuing_covered_loss(X),datetime(End)).
      blawx_during(datetime(Start),ensuing_covered_loss(X),datetime(eot)) :- blawx_ultimately(ensuing_covered_loss(X)), blawx_becomes(-ensuing_covered_loss(X),datetime(Start)), blawx_not_interrupted(datetime(Start),ensuing_covered_loss(X),datetime(eot)).
      blawx_during(datetime(bot),ensuing_covered_loss(X),datetime(eot)) :- blawx_initially(ensuing_covered_loss(X)), blawx_ultimately(ensuing_covered_loss(X)), blawx_becomes(-ensuing_covered_loss(X),datetime(Start)), blawx_not_interrupted(datetime(bot),ensuing_covered_loss(X),datetime(eot)).
      blawx_during(datetime(Start),-ensuing_covered_loss(X),datetime(End)) :- blawx_becomes(-ensuing_covered_loss(X),datetime(Start)), blawx_becomes(ensuing_covered_loss(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),-ensuing_covered_loss(X),datetime(End)).
      blawx_during(datetime(bot),-ensuing_covered_loss(X),datetime(End)) :- blawx_initially(-ensuing_covered_loss(X)), blawx_becomes(ensuing_covered_loss(X),datetime(End)), blawx_not_interrupted(datetime(bot),-ensuing_covered_loss(X),datetime(End)).
      blawx_during(datetime(Start),-ensuing_covered_loss(X),datetime(eot)) :- blawx_ultimately(-ensuing_covered_loss(X)), blawx_becomes(ensuing_covered_loss(X),datetime(Start)), blawx_not_interrupted(datetime(Start),-ensuing_covered_loss(X),datetime(eot)).
      blawx_during(datetime(bot),-ensuing_covered_loss(X),datetime(eot)) :- blawx_initially(-ensuing_covered_loss(X)), blawx_ultimately(-ensuing_covered_loss(X)), blawx_becomes(-ensuing_covered_loss(X),datetime(Start)), blawx_not_interrupted(datetime(bot),-ensuing_covered_loss(X),datetime(eot)).
      blawx_attribute(inputs,an_exclusion_applies,boolean).
      blawx_attribute_nlg(an_exclusion_applies,not_applicable,"",not_applicable,"an exclusion applies").
      :- dynamic an_exclusion_applies/1.
      #pred an_exclusion_applies(X) :: '@(X) an exclusion applies'.
      #pred holds(user,an_exclusion_applies,X) :: 'it is provided as a fact that @(X) an exclusion applies'.
      #pred holds(user,-an_exclusion_applies,X) :: 'it is provided as a fact that it is not the case that @(X) an exclusion applies'.
      #pred holds(Z,an_exclusion_applies,X) :: 'the conclusion in @(Z) that @(X) an exclusion applies holds'.
      #pred holds(Z,-an_exclusion_applies,X) :: 'the conclusion in @(Z) that it is not the case that @(X) an exclusion applies holds'.
      #pred according_to(Z,an_exclusion_applies,X) :: 'according to @(Z), @(X) an exclusion applies'.
      #pred according_to(Z,-an_exclusion_applies,X) :: 'according to @(Z), it is not the case that @(X) an exclusion applies'.
      #pred blawx_defeated(Z,an_exclusion_applies,X) :: 'the conclusion in @(Z) that @(X) an exclusion applies is defeated'.
      #pred blawx_defeated(Z,-an_exclusion_applies,X) :: 'the conclusion in @(Z) that @(X) an exclusion applies is defeated'.
      #pred blawx_initially(an_exclusion_applies(X)) :: 'that @(X) an exclusion applies holds initially'.
      #pred blawx_initially(-an_exclusion_applies(X)) :: 'that it is not the case that @(X) an exclusion applies holds initially'.
      #pred blawx_ultimately(an_exclusion_applies(X)) :: 'that @(X) an exclusion applies holds ultimately'.
      #pred blawx_ultimately(-an_exclusion_applies(X)) :: 'that it is not the case that @(X) an exclusion applies holds ultimately'.
      #pred blawx_as_of(an_exclusion_applies(X),T) :: 'that @(X) an exclusion applies holds at @(T)'.
      #pred blawx_as_of(-an_exclusion_applies(X),T) :: 'that it is not the case that @(X) an exclusion applies holds at @(T)'.
      #pred blawx_during(T1,an_exclusion_applies(X),T2) :: 'that @(X) an exclusion applies held between @(T1) and @(T2)'.
      #pred blawx_during(T1,-an_exclusion_applies(X),T2) :: 'that it is not the case that @(X) an exclusion applies held between @(T1) and @(T2)'.
      #pred blawx_becomes(an_exclusion_applies(X),T) :: 'that @(X) an exclusion applies became true at @(T)'.
      #pred blawx_becomes(-an_exclusion_applies(X),T) :: 'that it is not the case that @(X) an exclusion applies became true at @(T)'.
      #pred blawx_not_interrupted(Start,an_exclusion_applies(X),End) :: '@(X) an exclusion applies remained the case between @(Start) and @(End)'.
      #pred blawx_not_interrupted(Start,-an_exclusion_applies(X),End) :: 'it is not the case that @(X) an exclusion applies remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),an_exclusion_applies(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-an_exclusion_applies(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(Start),-an_exclusion_applies(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(an_exclusion_applies(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(bot),an_exclusion_applies(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(-an_exclusion_applies(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(bot),-an_exclusion_applies(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(an_exclusion_applies(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(Start),an_exclusion_applies(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(-an_exclusion_applies(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(Start),-an_exclusion_applies(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(an_exclusion_applies(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(bot),an_exclusion_applies(X),datetime(eot)) :- blawx_initially(an_exclusion_applies(X)), blawx_ultimately(an_exclusion_applies(X)), findall(Time,blawx_becomes(-an_exclusion_applies(X),datetime(Time)),[]).
      blawx_not_interrupted(datetime(bot),-an_exclusion_applies(X),datetime(eot)) :- blawx_initially(-an_exclusion_applies(X)), blawx_ultimately(-an_exclusion_applies(X)), findall(Time,blawx_becomes(an_exclusion_applies(X),datetime(Time)),[]).
      blawx_as_of(an_exclusion_applies(X),datetime(Time)) :- blawx_initially(an_exclusion_applies(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),an_exclusion_applies(X),datetime(BeforeT)).
      blawx_as_of(an_exclusion_applies(X),datetime(Time)) :- blawx_becomes(an_exclusion_applies(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),an_exclusion_applies(X),datetime(Time)).
      blawx_as_of(-an_exclusion_applies(X),datetime(Time)) :- blawx_initially(-an_exclusion_applies(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-an_exclusion_applies(X),datetime(BeforeT)).
      blawx_as_of(-an_exclusion_applies(X),datetime(Time)) :- blawx_becomes(-an_exclusion_applies(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),-an_exclusion_applies(X),datetime(Time)).
      blawx_during(datetime(Start),an_exclusion_applies(X),datetime(End)) :- blawx_becomes(an_exclusion_applies(X),datetime(Start)), blawx_becomes(-an_exclusion_applies(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),an_exclusion_applies(X),datetime(End)).
      blawx_during(datetime(bot),an_exclusion_applies(X),datetime(End)) :- blawx_initially(an_exclusion_applies(X)), blawx_becomes(-an_exclusion_applies(X),datetime(End)), blawx_not_interrupted(datetime(bot),an_exclusion_applies(X),datetime(End)).
      blawx_during(datetime(Start),an_exclusion_applies(X),datetime(eot)) :- blawx_ultimately(an_exclusion_applies(X)), blawx_becomes(-an_exclusion_applies(X),datetime(Start)), blawx_not_interrupted(datetime(Start),an_exclusion_applies(X),datetime(eot)).
      blawx_during(datetime(bot),an_exclusion_applies(X),datetime(eot)) :- blawx_initially(an_exclusion_applies(X)), blawx_ultimately(an_exclusion_applies(X)), blawx_becomes(-an_exclusion_applies(X),datetime(Start)), blawx_not_interrupted(datetime(bot),an_exclusion_applies(X),datetime(eot)).
      blawx_during(datetime(Start),-an_exclusion_applies(X),datetime(End)) :- blawx_becomes(-an_exclusion_applies(X),datetime(Start)), blawx_becomes(an_exclusion_applies(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),-an_exclusion_applies(X),datetime(End)).
      blawx_during(datetime(bot),-an_exclusion_applies(X),datetime(End)) :- blawx_initially(-an_exclusion_applies(X)), blawx_becomes(an_exclusion_applies(X),datetime(End)), blawx_not_interrupted(datetime(bot),-an_exclusion_applies(X),datetime(End)).
      blawx_during(datetime(Start),-an_exclusion_applies(X),datetime(eot)) :- blawx_ultimately(-an_exclusion_applies(X)), blawx_becomes(an_exclusion_applies(X),datetime(Start)), blawx_not_interrupted(datetime(Start),-an_exclusion_applies(X),datetime(eot)).
      blawx_during(datetime(bot),-an_exclusion_applies(X),datetime(eot)) :- blawx_initially(-an_exclusion_applies(X)), blawx_ultimately(-an_exclusion_applies(X)), blawx_becomes(-an_exclusion_applies(X),datetime(Start)), blawx_not_interrupted(datetime(bot),-an_exclusion_applies(X),datetime(eot)).
