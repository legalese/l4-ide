    scasp_encoding: |-
      blawx_category(inputs).
      blawx_category_nlg(inputs,"","is an inputs").
      :- dynamic inputs/1.
      #pred inputs(X) :: '@(X) is an inputs'.
      #pred holds(user,inputs,X) :: 'it is provided as a fact that @(X) is an inputs'.
      #pred holds(user,-inputs,X) :: 'it is provided as a fact that it is not the case that @(X) is an inputs'.
      #pred holds(Z,inputs,X) :: 'the conclusion in @(Z) that @(X) is an inputs holds'.
      #pred holds(Z,-inputs,X) :: 'the conclusion in @(Z) that it is not the case that @(X) is an inputs holds'.
      #pred according_to(Z,inputs,X) :: 'according to @(Z), @(X) is an inputs'.
      #pred according_to(Z,-inputs,X) :: 'according to @(Z), it is not the case that @(X) is an inputs'.
      #pred blawx_defeated(Z,inputs,X) :: 'the conclusion in @(Z) that @(X) is an inputs is defeated'.
      #pred blawx_defeated(Z,-inputs,X) :: 'the conclusion in @(Z) that it is not the case that @(X) is an inputs is defeated'.
      #pred blawx_initially(inputs(X)) :: 'that @(X) is an inputs holds initially'.
      #pred blawx_initially(-inputs(X)) :: 'that it is not the case that @(X) is an inputs holds initially'.
      #pred blawx_ultimately(inputs(X)) :: 'that @(X) is an inputs holds ultimately'.
      #pred blawx_ultimately(-inputs(X)) :: 'that it is not the case that @(X) is an inputs holds ultimately'.
      #pred blawx_as_of(inputs(X),T) :: 'that @(X) is an inputs holds at @(T)'.
      #pred blawx_as_of(-inputs(X),T) :: 'that it is not the case that @(X) is an inputs holds at @(T)'.
      #pred blawx_during(T1,inputs(X),T2) :: 'that @(X) is an inputs held between @(T1) and @(T2)'.
      #pred blawx_during(T1,-inputs(X),T2) :: 'that it is not the case that @(X) is an inputs held between @(T1) and @(T2)'.
      #pred blawx_becomes(inputs(X),T) :: 'that @(X) is an inputs became true at @(T)'.
      #pred blawx_becomes(-inputs(X),T) :: 'that it is not the case that @(X) is an inputs became true at @(T)'.
      #pred blawx_not_interrupted(Start,inputs(X),End) :: '@(X) is an inputs remained the case between @(Start) and @(End)'.
      #pred blawx_not_interrupted(Start,-inputs(X),End) :: 'it is not the case that @(X) is an inputs remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),inputs(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-inputs(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(Start),-inputs(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(inputs(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(bot),inputs(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(-inputs(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(bot),-inputs(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(inputs(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(Start),inputs(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(-inputs(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(Start),-inputs(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(inputs(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(bot),inputs(X),datetime(eot)) :- blawx_initially(inputs(X)), blawx_ultimately(inputs(X)), findall(Time,blawx_becomes(-inputs(X),datetime(Time)),[]).
      blawx_not_interrupted(datetime(bot),-inputs(X),datetime(eot)) :- blawx_initially(-inputs(X)), blawx_ultimately(-inputs(X)), findall(Time,blawx_becomes(inputs(X),datetime(Time)),[]).
      blawx_as_of(inputs(X),datetime(Time)) :- blawx_initially(inputs(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),inputs(X),datetime(BeforeT)).
      blawx_as_of(inputs(X),datetime(Time)) :- blawx_becomes(inputs(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),inputs(X),datetime(Time)).
      blawx_as_of(-inputs(X),datetime(Time)) :- blawx_initially(-inputs(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-inputs(X),datetime(BeforeT)).
      blawx_as_of(-inputs(X),datetime(Time)) :- blawx_becomes(-inputs(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),-inputs(X),datetime(Time)).
      blawx_during(datetime(Start),inputs(X),datetime(End)) :- blawx_becomes(inputs(X),datetime(Start)), blawx_becomes(-inputs(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),inputs(X),datetime(End)).
      blawx_during(datetime(bot),inputs(X),datetime(End)) :- blawx_initially(inputs(X)), blawx_becomes(-inputs(X),datetime(End)), blawx_not_interrupted(datetime(bot),inputs(X),datetime(End)).
      blawx_during(datetime(Start),inputs(X),datetime(eot)) :- blawx_ultimately(inputs(X)), blawx_becomes(-inputs(X),datetime(Start)), blawx_not_interrupted(datetime(Start),inputs(X),datetime(eot)).
      blawx_during(datetime(bot),inputs(X),datetime(eot)) :- blawx_initially(inputs(X)), blawx_ultimately(inputs(X)), blawx_becomes(-inputs(X),datetime(Start)), blawx_not_interrupted(datetime(bot),inputs(X),datetime(eot)).
      blawx_during(datetime(Start),-inputs(X),datetime(End)) :- blawx_becomes(-inputs(X),datetime(Start)), blawx_becomes(inputs(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),-inputs(X),datetime(End)).
      blawx_during(datetime(bot),-inputs(X),datetime(End)) :- blawx_initially(-inputs(X)), blawx_becomes(inputs(X),datetime(End)), blawx_not_interrupted(datetime(bot),-inputs(X),datetime(End)).
      blawx_during(datetime(Start),-inputs(X),datetime(eot)) :- blawx_ultimately(-inputs(X)), blawx_becomes(inputs(X),datetime(Start)), blawx_not_interrupted(datetime(Start),-inputs(X),datetime(eot)).
      blawx_during(datetime(bot),-inputs(X),datetime(eot)) :- blawx_initially(-inputs(X)), blawx_ultimately(-inputs(X)), blawx_becomes(-inputs(X),datetime(Start)), blawx_not_interrupted(datetime(bot),-inputs(X),datetime(eot)).
      blawx_attribute(inputs,loss_or_damage_caused_by_rodents,boolean).
      blawx_attribute_nlg(loss_or_damage_caused_by_rodents,not_applicable,"",not_applicable,"loss or damage caused by rodents").
      :- dynamic loss_or_damage_caused_by_rodents/1.
      #pred loss_or_damage_caused_by_rodents(X) :: '@(X) loss or damage caused by rodents'.
      #pred holds(user,loss_or_damage_caused_by_rodents,X) :: 'it is provided as a fact that @(X) loss or damage caused by rodents'.
      #pred holds(user,-loss_or_damage_caused_by_rodents,X) :: 'it is provided as a fact that it is not the case that @(X) loss or damage caused by rodents'.
      #pred holds(Z,loss_or_damage_caused_by_rodents,X) :: 'the conclusion in @(Z) that @(X) loss or damage caused by rodents holds'.
      #pred holds(Z,-loss_or_damage_caused_by_rodents,X) :: 'the conclusion in @(Z) that it is not the case that @(X) loss or damage caused by rodents holds'.
      #pred according_to(Z,loss_or_damage_caused_by_rodents,X) :: 'according to @(Z), @(X) loss or damage caused by rodents'.
      #pred according_to(Z,-loss_or_damage_caused_by_rodents,X) :: 'according to @(Z), it is not the case that @(X) loss or damage caused by rodents'.
      #pred blawx_defeated(Z,loss_or_damage_caused_by_rodents,X) :: 'the conclusion in @(Z) that @(X) loss or damage caused by rodents is defeated'.
      #pred blawx_defeated(Z,-loss_or_damage_caused_by_rodents,X) :: 'the conclusion in @(Z) that @(X) loss or damage caused by rodents is defeated'.
      #pred blawx_initially(loss_or_damage_caused_by_rodents(X)) :: 'that @(X) loss or damage caused by rodents holds initially'.
      #pred blawx_initially(-loss_or_damage_caused_by_rodents(X)) :: 'that it is not the case that @(X) loss or damage caused by rodents holds initially'.
      #pred blawx_ultimately(loss_or_damage_caused_by_rodents(X)) :: 'that @(X) loss or damage caused by rodents holds ultimately'.
      #pred blawx_ultimately(-loss_or_damage_caused_by_rodents(X)) :: 'that it is not the case that @(X) loss or damage caused by rodents holds ultimately'.
      #pred blawx_as_of(loss_or_damage_caused_by_rodents(X),T) :: 'that @(X) loss or damage caused by rodents holds at @(T)'.
      #pred blawx_as_of(-loss_or_damage_caused_by_rodents(X),T) :: 'that it is not the case that @(X) loss or damage caused by rodents holds at @(T)'.
      #pred blawx_during(T1,loss_or_damage_caused_by_rodents(X),T2) :: 'that @(X) loss or damage caused by rodents held between @(T1) and @(T2)'.
      #pred blawx_during(T1,-loss_or_damage_caused_by_rodents(X),T2) :: 'that it is not the case that @(X) loss or damage caused by rodents held between @(T1) and @(T2)'.
      #pred blawx_becomes(loss_or_damage_caused_by_rodents(X),T) :: 'that @(X) loss or damage caused by rodents became true at @(T)'.
      #pred blawx_becomes(-loss_or_damage_caused_by_rodents(X),T) :: 'that it is not the case that @(X) loss or damage caused by rodents became true at @(T)'.
      #pred blawx_not_interrupted(Start,loss_or_damage_caused_by_rodents(X),End) :: '@(X) loss or damage caused by rodents remained the case between @(Start) and @(End)'.
      #pred blawx_not_interrupted(Start,-loss_or_damage_caused_by_rodents(X),End) :: 'it is not the case that @(X) loss or damage caused by rodents remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),loss_or_damage_caused_by_rodents(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-loss_or_damage_caused_by_rodents(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(Start),-loss_or_damage_caused_by_rodents(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(loss_or_damage_caused_by_rodents(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(bot),loss_or_damage_caused_by_rodents(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(-loss_or_damage_caused_by_rodents(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(bot),-loss_or_damage_caused_by_rodents(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(loss_or_damage_caused_by_rodents(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(Start),loss_or_damage_caused_by_rodents(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(-loss_or_damage_caused_by_rodents(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(Start),-loss_or_damage_caused_by_rodents(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(loss_or_damage_caused_by_rodents(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(bot),loss_or_damage_caused_by_rodents(X),datetime(eot)) :- blawx_initially(loss_or_damage_caused_by_rodents(X)), blawx_ultimately(loss_or_damage_caused_by_rodents(X)), findall(Time,blawx_becomes(-loss_or_damage_caused_by_rodents(X),datetime(Time)),[]).
      blawx_not_interrupted(datetime(bot),-loss_or_damage_caused_by_rodents(X),datetime(eot)) :- blawx_initially(-loss_or_damage_caused_by_rodents(X)), blawx_ultimately(-loss_or_damage_caused_by_rodents(X)), findall(Time,blawx_becomes(loss_or_damage_caused_by_rodents(X),datetime(Time)),[]).
      blawx_as_of(loss_or_damage_caused_by_rodents(X),datetime(Time)) :- blawx_initially(loss_or_damage_caused_by_rodents(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),loss_or_damage_caused_by_rodents(X),datetime(BeforeT)).
      blawx_as_of(loss_or_damage_caused_by_rodents(X),datetime(Time)) :- blawx_becomes(loss_or_damage_caused_by_rodents(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),loss_or_damage_caused_by_rodents(X),datetime(Time)).
      blawx_as_of(-loss_or_damage_caused_by_rodents(X),datetime(Time)) :- blawx_initially(-loss_or_damage_caused_by_rodents(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-loss_or_damage_caused_by_rodents(X),datetime(BeforeT)).
      blawx_as_of(-loss_or_damage_caused_by_rodents(X),datetime(Time)) :- blawx_becomes(-loss_or_damage_caused_by_rodents(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),-loss_or_damage_caused_by_rodents(X),datetime(Time)).
      blawx_during(datetime(Start),loss_or_damage_caused_by_rodents(X),datetime(End)) :- blawx_becomes(loss_or_damage_caused_by_rodents(X),datetime(Start)), blawx_becomes(-loss_or_damage_caused_by_rodents(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),loss_or_damage_caused_by_rodents(X),datetime(End)).
      blawx_during(datetime(bot),loss_or_damage_caused_by_rodents(X),datetime(End)) :- blawx_initially(loss_or_damage_caused_by_rodents(X)), blawx_becomes(-loss_or_damage_caused_by_rodents(X),datetime(End)), blawx_not_interrupted(datetime(bot),loss_or_damage_caused_by_rodents(X),datetime(End)).
