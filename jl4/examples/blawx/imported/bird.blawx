      blawx_during(datetime(Start),thing(X),datetime(eot)) :- blawx_ultimately(thing(X)), blawx_becomes(-thing(X),datetime(Start)), blawx_not_interrupted(datetime(Start),thing(X),datetime(eot)).
      blawx_during(datetime(bot),thing(X),datetime(eot)) :- blawx_initially(thing(X)), blawx_ultimately(thing(X)), blawx_becomes(-thing(X),datetime(Start)), blawx_not_interrupted(datetime(bot),thing(X),datetime(eot)).
      blawx_during(datetime(Start),-thing(X),datetime(End)) :- blawx_becomes(-thing(X),datetime(Start)), blawx_becomes(thing(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),-thing(X),datetime(End)).
      blawx_during(datetime(bot),-thing(X),datetime(End)) :- blawx_initially(-thing(X)), blawx_becomes(thing(X),datetime(End)), blawx_not_interrupted(datetime(bot),-thing(X),datetime(End)).
      blawx_during(datetime(Start),-thing(X),datetime(eot)) :- blawx_ultimately(-thing(X)), blawx_becomes(thing(X),datetime(Start)), blawx_not_interrupted(datetime(Start),-thing(X),datetime(eot)).
      blawx_during(datetime(bot),-thing(X),datetime(eot)) :- blawx_initially(-thing(X)), blawx_ultimately(-thing(X)), blawx_becomes(-thing(X),datetime(Start)), blawx_not_interrupted(datetime(bot),-thing(X),datetime(eot)).
      blawx_attribute(thing,flies,boolean).
      blawx_attribute_nlg(flies,not_applicable,"",not_applicable,"can fly").
      :- dynamic flies/1.
      #pred flies(X) :: '@(X) can fly'.
      #pred holds(user,flies,X) :: 'it is provided as a fact that @(X) can fly'.
      #pred holds(user,-flies,X) :: 'it is provided as a fact that it is not the case that @(X) can fly'.
      #pred holds(Z,flies,X) :: 'the conclusion in @(Z) that @(X) can fly holds'.
      #pred holds(Z,-flies,X) :: 'the conclusion in @(Z) that it is not the case that @(X) can fly holds'.
      #pred according_to(Z,flies,X) :: 'according to @(Z), @(X) can fly'.
      #pred according_to(Z,-flies,X) :: 'according to @(Z), it is not the case that @(X) can fly'.
      #pred blawx_defeated(Z,flies,X) :: 'the conclusion in @(Z) that @(X) can fly is defeated'.
      #pred blawx_defeated(Z,-flies,X) :: 'the conclusion in @(Z) that @(X) can fly is defeated'.
      #pred blawx_initially(flies(X)) :: 'that @(X) can fly holds initially'.
      #pred blawx_initially(-flies(X)) :: 'that it is not the case that @(X) can fly holds initially'.
      #pred blawx_ultimately(flies(X)) :: 'that @(X) can fly holds ultimately'.
      #pred blawx_ultimately(-flies(X)) :: 'that it is not the case that @(X) can fly holds ultimately'.
      #pred blawx_as_of(flies(X),T) :: 'that @(X) can fly holds at @(T)'.
      #pred blawx_as_of(-flies(X),T) :: 'that it is not the case that @(X) can fly holds at @(T)'.
      #pred blawx_during(T1,flies(X),T2) :: 'that @(X) can fly held between @(T1) and @(T2)'.
      #pred blawx_during(T1,-flies(X),T2) :: 'that it is not the case that @(X) can fly held between @(T1) and @(T2)'.
      #pred blawx_becomes(flies(X),T) :: 'that @(X) can fly became true at @(T)'.
      #pred blawx_becomes(-flies(X),T) :: 'that it is not the case that @(X) can fly became true at @(T)'.
      #pred blawx_not_interrupted(Start,flies(X),End) :: '@(X) can fly remained the case between @(Start) and @(End)'.
      #pred blawx_not_interrupted(Start,-flies(X),End) :: 'it is not the case that @(X) can fly remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),flies(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-flies(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(Start),-flies(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(flies(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(bot),flies(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(-flies(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(bot),-flies(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(flies(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(Start),flies(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(-flies(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(Start),-flies(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(flies(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(bot),flies(X),datetime(eot)) :- blawx_initially(flies(X)), blawx_ultimately(flies(X)), findall(Time,blawx_becomes(-flies(X),datetime(Time)),[]).
      blawx_not_interrupted(datetime(bot),-flies(X),datetime(eot)) :- blawx_initially(-flies(X)), blawx_ultimately(-flies(X)), findall(Time,blawx_becomes(flies(X),datetime(Time)),[]).
      blawx_as_of(flies(X),datetime(Time)) :- blawx_initially(flies(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),flies(X),datetime(BeforeT)).
      blawx_as_of(flies(X),datetime(Time)) :- blawx_becomes(flies(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),flies(X),datetime(Time)).
      blawx_as_of(-flies(X),datetime(Time)) :- blawx_initially(-flies(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-flies(X),datetime(BeforeT)).
      blawx_as_of(-flies(X),datetime(Time)) :- blawx_becomes(-flies(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),-flies(X),datetime(Time)).
      blawx_during(datetime(Start),flies(X),datetime(End)) :- blawx_becomes(flies(X),datetime(Start)), blawx_becomes(-flies(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),flies(X),datetime(End)).
      blawx_during(datetime(bot),flies(X),datetime(End)) :- blawx_initially(flies(X)), blawx_becomes(-flies(X),datetime(End)), blawx_not_interrupted(datetime(bot),flies(X),datetime(End)).
      blawx_during(datetime(Start),flies(X),datetime(eot)) :- blawx_ultimately(flies(X)), blawx_becomes(-flies(X),datetime(Start)), blawx_not_interrupted(datetime(Start),flies(X),datetime(eot)).
      blawx_during(datetime(bot),flies(X),datetime(eot)) :- blawx_initially(flies(X)), blawx_ultimately(flies(X)), blawx_becomes(-flies(X),datetime(Start)), blawx_not_interrupted(datetime(bot),flies(X),datetime(eot)).
      blawx_during(datetime(Start),-flies(X),datetime(End)) :- blawx_becomes(-flies(X),datetime(Start)), blawx_becomes(flies(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),-flies(X),datetime(End)).
      blawx_during(datetime(bot),-flies(X),datetime(End)) :- blawx_initially(-flies(X)), blawx_becomes(flies(X),datetime(End)), blawx_not_interrupted(datetime(bot),-flies(X),datetime(End)).
      blawx_during(datetime(Start),-flies(X),datetime(eot)) :- blawx_ultimately(-flies(X)), blawx_becomes(flies(X),datetime(Start)), blawx_not_interrupted(datetime(Start),-flies(X),datetime(eot)).
      blawx_during(datetime(bot),-flies(X),datetime(eot)) :- blawx_initially(-flies(X)), blawx_ultimately(-flies(X)), blawx_becomes(-flies(X),datetime(Start)), blawx_not_interrupted(datetime(bot),-flies(X),datetime(eot)).

      according_to(sec_2_section,flies,A) :- bird(A).

      % BLAWX CHECK DUPLICATES
      holds(sec_2_section,flies,A) :- according_to(sec_2_section,flies,A), not blawx_defeated(sec_2_section,flies,A).

      % BLAWX CHECK DUPLICATES
        flies(A) :- holds(sec_2_section,flies,A).
