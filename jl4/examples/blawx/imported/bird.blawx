      <block type="unattributed_fact" id="l4b000057" x="40" y="208"><statement name="statements"><block type="overrules" id="l4b000058"><value name="defeating_rule"><block type="doc_selector" id="l4b000059"><mutation xmlns="http://www.w3.org/1999/xhtml" section_reference="sec_5_section"></mutation><field name="doc_part_name">NBA 5</field></block></value><statement name="defeating_statement"><block type="unary_attribute_selector" id="l4b000060"><mutation xmlns="http://www.w3.org/1999/xhtml" attributename="flies" attributetype="boolean"></mutation><field name="prefix"></field><field name="postfix">can fly</field><value name="first_element"><block type="variable" id="l4b000061"><field name="variable_name">A</field></block></value></block></statement><value name="defeated_rule"><block type="doc_selector" id="l4b000062"><mutation xmlns="http://www.w3.org/1999/xhtml" section_reference="sec_3_section"></mutation><field name="doc_part_name">NBA 3</field></block></value><statement name="defeated_statement"><block type="logical_negation" id="l4b000063"><statement name="negated_statement"><block type="unary_attribute_selector" id="l4b000064"><mutation xmlns="http://www.w3.org/1999/xhtml" attributename="flies" attributetype="boolean"></mutation><field name="prefix"></field><field name="postfix">can fly</field><value name="first_element"><block type="variable" id="l4b000065"><field name="variable_name">A</field></block></value></block></statement></block></statement></block></statement></block>
      <block type="unattributed_rule" id="l4b000066" x="40" y="526"><statement name="conditions"><block type="default_negation" id="l4b000067"><statement name="default_negated_statement"><block type="logical_negation" id="l4b000068"><statement name="negated_statement"><block type="applies" id="l4b000069"><value name="applicable_rule"><block type="doc_selector" id="l4b000070"><mutation xmlns="http://www.w3.org/1999/xhtml" section_reference="sec_5_section"></mutation><field name="doc_part_name">NBA 5</field></block></value><value name="object"><block type="variable" id="l4b000071"><field name="variable_name">A</field></block></value></block></statement></block></statement></block></statement><statement name="conclusion"><block type="applies" id="l4b000072"><value name="applicable_rule"><block type="doc_selector" id="l4b000073"><mutation xmlns="http://www.w3.org/1999/xhtml" section_reference="sec_5_section"></mutation><field name="doc_part_name">NBA 5</field></block></value><value name="object"><block type="variable" id="l4b000074"><field name="variable_name">A</field></block></value></block></statement></block>
      <block type="attributed_rule" id="l4b000075" x="40" y="844"><field name="defeasible">FALSE</field><field name="inapplicable">TRUE</field><statement name="conditions"><block type="new_object_category" id="l4b000076"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="penguin"></mutation><field name="category_name">penguin</field><value name="object"><block type="variable" id="l4b000077"><field name="variable_name">A</field></block></value><next><block type="unary_attribute_selector" id="l4b000078"><mutation xmlns="http://www.w3.org/1999/xhtml" attributename="cartoon_jetpack" attributetype="boolean"></mutation><field name="prefix"></field><field name="postfix">is a cartoon with a jetpack</field><value name="first_element"><block type="variable" id="l4b000079"><field name="variable_name">A</field></block></value></block></next></block></statement><value name="source"><block type="doc_selector" id="l4b000080"><mutation xmlns="http://www.w3.org/1999/xhtml" section_reference="sec_5_section"></mutation><field name="doc_part_name">NBA 5</field></block></value><statement name="conclusion"><block type="unary_attribute_selector" id="l4b000081"><mutation xmlns="http://www.w3.org/1999/xhtml" attributename="flies" attributetype="boolean"></mutation><field name="prefix"></field><field name="postfix">can fly</field><value name="first_element"><block type="variable" id="l4b000082"><field name="variable_name">A</field></block></value></block></statement></block>
      </xml>
    scasp_encoding: |-
      blawx_attribute(penguin,cartoon_jetpack,boolean).
      blawx_attribute_nlg(cartoon_jetpack,not_applicable,"",not_applicable,"is a cartoon with a jetpack").
      :- dynamic cartoon_jetpack/1.
      #pred cartoon_jetpack(X) :: '@(X) is a cartoon with a jetpack'.
      #pred holds(user,cartoon_jetpack,X) :: 'it is provided as a fact that @(X) is a cartoon with a jetpack'.
      #pred holds(user,-cartoon_jetpack,X) :: 'it is provided as a fact that it is not the case that @(X) is a cartoon with a jetpack'.
      #pred holds(Z,cartoon_jetpack,X) :: 'the conclusion in @(Z) that @(X) is a cartoon with a jetpack holds'.
      #pred holds(Z,-cartoon_jetpack,X) :: 'the conclusion in @(Z) that it is not the case that @(X) is a cartoon with a jetpack holds'.
      #pred according_to(Z,cartoon_jetpack,X) :: 'according to @(Z), @(X) is a cartoon with a jetpack'.
      #pred according_to(Z,-cartoon_jetpack,X) :: 'according to @(Z), it is not the case that @(X) is a cartoon with a jetpack'.
      #pred blawx_defeated(Z,cartoon_jetpack,X) :: 'the conclusion in @(Z) that @(X) is a cartoon with a jetpack is defeated'.
      #pred blawx_defeated(Z,-cartoon_jetpack,X) :: 'the conclusion in @(Z) that @(X) is a cartoon with a jetpack is defeated'.
      #pred blawx_initially(cartoon_jetpack(X)) :: 'that @(X) is a cartoon with a jetpack holds initially'.
      #pred blawx_initially(-cartoon_jetpack(X)) :: 'that it is not the case that @(X) is a cartoon with a jetpack holds initially'.
      #pred blawx_ultimately(cartoon_jetpack(X)) :: 'that @(X) is a cartoon with a jetpack holds ultimately'.
      #pred blawx_ultimately(-cartoon_jetpack(X)) :: 'that it is not the case that @(X) is a cartoon with a jetpack holds ultimately'.
      #pred blawx_as_of(cartoon_jetpack(X),T) :: 'that @(X) is a cartoon with a jetpack holds at @(T)'.
      #pred blawx_as_of(-cartoon_jetpack(X),T) :: 'that it is not the case that @(X) is a cartoon with a jetpack holds at @(T)'.
      #pred blawx_during(T1,cartoon_jetpack(X),T2) :: 'that @(X) is a cartoon with a jetpack held between @(T1) and @(T2)'.
      #pred blawx_during(T1,-cartoon_jetpack(X),T2) :: 'that it is not the case that @(X) is a cartoon with a jetpack held between @(T1) and @(T2)'.
      #pred blawx_becomes(cartoon_jetpack(X),T) :: 'that @(X) is a cartoon with a jetpack became true at @(T)'.
      #pred blawx_becomes(-cartoon_jetpack(X),T) :: 'that it is not the case that @(X) is a cartoon with a jetpack became true at @(T)'.
      #pred blawx_not_interrupted(Start,cartoon_jetpack(X),End) :: '@(X) is a cartoon with a jetpack remained the case between @(Start) and @(End)'.
      #pred blawx_not_interrupted(Start,-cartoon_jetpack(X),End) :: 'it is not the case that @(X) is a cartoon with a jetpack remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),cartoon_jetpack(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-cartoon_jetpack(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(Start),-cartoon_jetpack(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(cartoon_jetpack(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(bot),cartoon_jetpack(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(-cartoon_jetpack(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(bot),-cartoon_jetpack(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(cartoon_jetpack(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(Start),cartoon_jetpack(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(-cartoon_jetpack(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(Start),-cartoon_jetpack(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(cartoon_jetpack(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(bot),cartoon_jetpack(X),datetime(eot)) :- blawx_initially(cartoon_jetpack(X)), blawx_ultimately(cartoon_jetpack(X)), findall(Time,blawx_becomes(-cartoon_jetpack(X),datetime(Time)),[]).
      blawx_not_interrupted(datetime(bot),-cartoon_jetpack(X),datetime(eot)) :- blawx_initially(-cartoon_jetpack(X)), blawx_ultimately(-cartoon_jetpack(X)), findall(Time,blawx_becomes(cartoon_jetpack(X),datetime(Time)),[]).
      blawx_as_of(cartoon_jetpack(X),datetime(Time)) :- blawx_initially(cartoon_jetpack(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),cartoon_jetpack(X),datetime(BeforeT)).
      blawx_as_of(cartoon_jetpack(X),datetime(Time)) :- blawx_becomes(cartoon_jetpack(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),cartoon_jetpack(X),datetime(Time)).
      blawx_as_of(-cartoon_jetpack(X),datetime(Time)) :- blawx_initially(-cartoon_jetpack(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-cartoon_jetpack(X),datetime(BeforeT)).
      blawx_as_of(-cartoon_jetpack(X),datetime(Time)) :- blawx_becomes(-cartoon_jetpack(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),-cartoon_jetpack(X),datetime(Time)).
      blawx_during(datetime(Start),cartoon_jetpack(X),datetime(End)) :- blawx_becomes(cartoon_jetpack(X),datetime(Start)), blawx_becomes(-cartoon_jetpack(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),cartoon_jetpack(X),datetime(End)).
      blawx_during(datetime(bot),cartoon_jetpack(X),datetime(End)) :- blawx_initially(cartoon_jetpack(X)), blawx_becomes(-cartoon_jetpack(X),datetime(End)), blawx_not_interrupted(datetime(bot),cartoon_jetpack(X),datetime(End)).
      blawx_during(datetime(Start),cartoon_jetpack(X),datetime(eot)) :- blawx_ultimately(cartoon_jetpack(X)), blawx_becomes(-cartoon_jetpack(X),datetime(Start)), blawx_not_interrupted(datetime(Start),cartoon_jetpack(X),datetime(eot)).
      blawx_during(datetime(bot),cartoon_jetpack(X),datetime(eot)) :- blawx_initially(cartoon_jetpack(X)), blawx_ultimately(cartoon_jetpack(X)), blawx_becomes(-cartoon_jetpack(X),datetime(Start)), blawx_not_interrupted(datetime(bot),cartoon_jetpack(X),datetime(eot)).
      blawx_during(datetime(Start),-cartoon_jetpack(X),datetime(End)) :- blawx_becomes(-cartoon_jetpack(X),datetime(Start)), blawx_becomes(cartoon_jetpack(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),-cartoon_jetpack(X),datetime(End)).
      blawx_during(datetime(bot),-cartoon_jetpack(X),datetime(End)) :- blawx_initially(-cartoon_jetpack(X)), blawx_becomes(cartoon_jetpack(X),datetime(End)), blawx_not_interrupted(datetime(bot),-cartoon_jetpack(X),datetime(End)).
      blawx_during(datetime(Start),-cartoon_jetpack(X),datetime(eot)) :- blawx_ultimately(-cartoon_jetpack(X)), blawx_becomes(cartoon_jetpack(X),datetime(Start)), blawx_not_interrupted(datetime(Start),-cartoon_jetpack(X),datetime(eot)).
      blawx_during(datetime(bot),-cartoon_jetpack(X),datetime(eot)) :- blawx_initially(-cartoon_jetpack(X)), blawx_ultimately(-cartoon_jetpack(X)), blawx_becomes(-cartoon_jetpack(X),datetime(Start)), blawx_not_interrupted(datetime(bot),-cartoon_jetpack(X),datetime(eot)).

      blawx_defeated(sec_3_section,-flies,A) :- holds(sec_5_section,flies,A).

      blawx_applies(sec_5_section,A) :-
      not -blawx_applies(sec_5_section,A).

      according_to(sec_5_section,flies,A) :- penguin(A),
      blawx_applies(sec_5_section,A),
      cartoon_jetpack(A).

      % BLAWX CHECK DUPLICATES
      holds(sec_5_section,flies,A) :- according_to(sec_5_section,flies,A).

      % BLAWX CHECK DUPLICATES
        flies(A) :- holds(sec_5_section,flies,A).
