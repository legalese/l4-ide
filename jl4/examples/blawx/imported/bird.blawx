- model: blawx.ruledoc
  pk: 1
  fields:
    ruledoc_name: New Bird Act
    rule_text: "New Bird Act\n\n1. Penguins are birds.\n2. Birds fly.\n3. Despite 2, penguins do not fly, subject to 4.\n4. Penguins on planes can fly.\n5. Despite 3, cartoon penguins with jetpacks can fly, [pingu]{except for pingu}."
    scasp_encoding: ''
    tutorial: ''
    owner: 1
    published: true
- model: blawx.workspace
  pk: 1
  fields:
    ruledoc: 1
    workspace_name: root_section
    xml_content: ''
    scasp_encoding: ''
- model: blawx.workspace
  pk: 2
  fields:
    ruledoc: 1
    workspace_name: sec_1_section
    xml_content: |-
      <xml xmlns="https://developers.google.com/blockly/xml">
      <block type="unattributed_fact" id="l4b000001" x="40" y="40"><statement name="statements"><block type="new_category_declaration" id="l4b000002"><field name="category_name">penguin</field><field name="prefix"></field><field name="first_element">object</field><field name="postfix">is a penguin</field><next><block type="new_category_declaration" id="l4b000003"><field name="category_name">bird</field><field name="prefix"></field><field name="first_element">object</field><field name="postfix">is a bird</field></block></next></block></statement></block>
      <block type="attributed_rule" id="l4b000004" x="40" y="298"><field name="defeasible">FALSE</field><field name="inapplicable">FALSE</field><statement name="conditions"><block type="new_object_category" id="l4b000005"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="penguin"></mutation><field name="category_name">penguin</field><value name="object"><block type="variable" id="l4b000006"><field name="variable_name">A</field></block></value></block></statement><value name="source"><block type="doc_selector" id="l4b000007"><mutation xmlns="http://www.w3.org/1999/xhtml" section_reference="sec_1_section"></mutation><field name="doc_part_name">NBA 1</field></block></value><statement name="conclusion"><block type="object_category" id="l4b000008"><value name="object"><block type="variable" id="l4b000009"><field name="variable_name">A</field></block></value><value name="category"><block type="category_selector" id="l4b000010"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="bird"></mutation><field name="category_name">bird</field></block></value></block></statement></block>
      </xml>
    scasp_encoding: |-
      blawx_category(penguin).
      blawx_category_nlg(penguin,"","is a penguin").
      :- dynamic penguin/1.
      #pred penguin(X) :: '@(X) is a penguin'.
      #pred holds(user,penguin,X) :: 'it is provided as a fact that @(X) is a penguin'.
      #pred holds(user,-penguin,X) :: 'it is provided as a fact that it is not the case that @(X) is a penguin'.
      #pred holds(Z,penguin,X) :: 'the conclusion in @(Z) that @(X) is a penguin holds'.
      #pred holds(Z,-penguin,X) :: 'the conclusion in @(Z) that it is not the case that @(X) is a penguin holds'.
      #pred according_to(Z,penguin,X) :: 'according to @(Z), @(X) is a penguin'.
      #pred according_to(Z,-penguin,X) :: 'according to @(Z), it is not the case that @(X) is a penguin'.
      #pred blawx_defeated(Z,penguin,X) :: 'the conclusion in @(Z) that @(X) is a penguin is defeated'.
      #pred blawx_defeated(Z,-penguin,X) :: 'the conclusion in @(Z) that it is not the case that @(X) is a penguin is defeated'.
      #pred blawx_initially(penguin(X)) :: 'that @(X) is a penguin holds initially'.
      #pred blawx_initially(-penguin(X)) :: 'that it is not the case that @(X) is a penguin holds initially'.
      #pred blawx_ultimately(penguin(X)) :: 'that @(X) is a penguin holds ultimately'.
      #pred blawx_ultimately(-penguin(X)) :: 'that it is not the case that @(X) is a penguin holds ultimately'.
      #pred blawx_as_of(penguin(X),T) :: 'that @(X) is a penguin holds at @(T)'.
      #pred blawx_as_of(-penguin(X),T) :: 'that it is not the case that @(X) is a penguin holds at @(T)'.
      #pred blawx_during(T1,penguin(X),T2) :: 'that @(X) is a penguin held between @(T1) and @(T2)'.
      #pred blawx_during(T1,-penguin(X),T2) :: 'that it is not the case that @(X) is a penguin held between @(T1) and @(T2)'.
      #pred blawx_becomes(penguin(X),T) :: 'that @(X) is a penguin became true at @(T)'.
      #pred blawx_becomes(-penguin(X),T) :: 'that it is not the case that @(X) is a penguin became true at @(T)'.
      #pred blawx_not_interrupted(Start,penguin(X),End) :: '@(X) is a penguin remained the case between @(Start) and @(End)'.
      #pred blawx_not_interrupted(Start,-penguin(X),End) :: 'it is not the case that @(X) is a penguin remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),penguin(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-penguin(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(Start),-penguin(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(penguin(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(bot),penguin(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(-penguin(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(bot),-penguin(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(penguin(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(Start),penguin(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(-penguin(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(Start),-penguin(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(penguin(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(bot),penguin(X),datetime(eot)) :- blawx_initially(penguin(X)), blawx_ultimately(penguin(X)), findall(Time,blawx_becomes(-penguin(X),datetime(Time)),[]).
      blawx_not_interrupted(datetime(bot),-penguin(X),datetime(eot)) :- blawx_initially(-penguin(X)), blawx_ultimately(-penguin(X)), findall(Time,blawx_becomes(penguin(X),datetime(Time)),[]).
      blawx_as_of(penguin(X),datetime(Time)) :- blawx_initially(penguin(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),penguin(X),datetime(BeforeT)).
      blawx_as_of(penguin(X),datetime(Time)) :- blawx_becomes(penguin(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),penguin(X),datetime(Time)).
      blawx_as_of(-penguin(X),datetime(Time)) :- blawx_initially(-penguin(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-penguin(X),datetime(BeforeT)).
      blawx_as_of(-penguin(X),datetime(Time)) :- blawx_becomes(-penguin(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),-penguin(X),datetime(Time)).
      blawx_during(datetime(Start),penguin(X),datetime(End)) :- blawx_becomes(penguin(X),datetime(Start)), blawx_becomes(-penguin(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),penguin(X),datetime(End)).
      blawx_during(datetime(bot),penguin(X),datetime(End)) :- blawx_initially(penguin(X)), blawx_becomes(-penguin(X),datetime(End)), blawx_not_interrupted(datetime(bot),penguin(X),datetime(End)).
      blawx_during(datetime(Start),penguin(X),datetime(eot)) :- blawx_ultimately(penguin(X)), blawx_becomes(-penguin(X),datetime(Start)), blawx_not_interrupted(datetime(Start),penguin(X),datetime(eot)).
      blawx_during(datetime(bot),penguin(X),datetime(eot)) :- blawx_initially(penguin(X)), blawx_ultimately(penguin(X)), blawx_becomes(-penguin(X),datetime(Start)), blawx_not_interrupted(datetime(bot),penguin(X),datetime(eot)).
      blawx_during(datetime(Start),-penguin(X),datetime(End)) :- blawx_becomes(-penguin(X),datetime(Start)), blawx_becomes(penguin(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),-penguin(X),datetime(End)).
      blawx_during(datetime(bot),-penguin(X),datetime(End)) :- blawx_initially(-penguin(X)), blawx_becomes(penguin(X),datetime(End)), blawx_not_interrupted(datetime(bot),-penguin(X),datetime(End)).
      blawx_during(datetime(Start),-penguin(X),datetime(eot)) :- blawx_ultimately(-penguin(X)), blawx_becomes(penguin(X),datetime(Start)), blawx_not_interrupted(datetime(Start),-penguin(X),datetime(eot)).
      blawx_during(datetime(bot),-penguin(X),datetime(eot)) :- blawx_initially(-penguin(X)), blawx_ultimately(-penguin(X)), blawx_becomes(-penguin(X),datetime(Start)), blawx_not_interrupted(datetime(bot),-penguin(X),datetime(eot)).
      blawx_category(bird).
      blawx_category_nlg(bird,"","is a bird").
      :- dynamic bird/1.
      #pred bird(X) :: '@(X) is a bird'.
      #pred holds(user,bird,X) :: 'it is provided as a fact that @(X) is a bird'.
      #pred holds(user,-bird,X) :: 'it is provided as a fact that it is not the case that @(X) is a bird'.
      #pred holds(Z,bird,X) :: 'the conclusion in @(Z) that @(X) is a bird holds'.
      #pred holds(Z,-bird,X) :: 'the conclusion in @(Z) that it is not the case that @(X) is a bird holds'.
      #pred according_to(Z,bird,X) :: 'according to @(Z), @(X) is a bird'.
      #pred according_to(Z,-bird,X) :: 'according to @(Z), it is not the case that @(X) is a bird'.
      #pred blawx_defeated(Z,bird,X) :: 'the conclusion in @(Z) that @(X) is a bird is defeated'.
      #pred blawx_defeated(Z,-bird,X) :: 'the conclusion in @(Z) that it is not the case that @(X) is a bird is defeated'.
      #pred blawx_initially(bird(X)) :: 'that @(X) is a bird holds initially'.
      #pred blawx_initially(-bird(X)) :: 'that it is not the case that @(X) is a bird holds initially'.
      #pred blawx_ultimately(bird(X)) :: 'that @(X) is a bird holds ultimately'.
      #pred blawx_ultimately(-bird(X)) :: 'that it is not the case that @(X) is a bird holds ultimately'.
      #pred blawx_as_of(bird(X),T) :: 'that @(X) is a bird holds at @(T)'.
      #pred blawx_as_of(-bird(X),T) :: 'that it is not the case that @(X) is a bird holds at @(T)'.
      #pred blawx_during(T1,bird(X),T2) :: 'that @(X) is a bird held between @(T1) and @(T2)'.
      #pred blawx_during(T1,-bird(X),T2) :: 'that it is not the case that @(X) is a bird held between @(T1) and @(T2)'.
      #pred blawx_becomes(bird(X),T) :: 'that @(X) is a bird became true at @(T)'.
      #pred blawx_becomes(-bird(X),T) :: 'that it is not the case that @(X) is a bird became true at @(T)'.
      #pred blawx_not_interrupted(Start,bird(X),End) :: '@(X) is a bird remained the case between @(Start) and @(End)'.
      #pred blawx_not_interrupted(Start,-bird(X),End) :: 'it is not the case that @(X) is a bird remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),bird(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-bird(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(Start),-bird(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(bird(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(bot),bird(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(-bird(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(bot),-bird(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(bird(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(Start),bird(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(-bird(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(Start),-bird(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(bird(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(bot),bird(X),datetime(eot)) :- blawx_initially(bird(X)), blawx_ultimately(bird(X)), findall(Time,blawx_becomes(-bird(X),datetime(Time)),[]).
      blawx_not_interrupted(datetime(bot),-bird(X),datetime(eot)) :- blawx_initially(-bird(X)), blawx_ultimately(-bird(X)), findall(Time,blawx_becomes(bird(X),datetime(Time)),[]).
      blawx_as_of(bird(X),datetime(Time)) :- blawx_initially(bird(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),bird(X),datetime(BeforeT)).
      blawx_as_of(bird(X),datetime(Time)) :- blawx_becomes(bird(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),bird(X),datetime(Time)).
      blawx_as_of(-bird(X),datetime(Time)) :- blawx_initially(-bird(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-bird(X),datetime(BeforeT)).
      blawx_as_of(-bird(X),datetime(Time)) :- blawx_becomes(-bird(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),-bird(X),datetime(Time)).
      blawx_during(datetime(Start),bird(X),datetime(End)) :- blawx_becomes(bird(X),datetime(Start)), blawx_becomes(-bird(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),bird(X),datetime(End)).
      blawx_during(datetime(bot),bird(X),datetime(End)) :- blawx_initially(bird(X)), blawx_becomes(-bird(X),datetime(End)), blawx_not_interrupted(datetime(bot),bird(X),datetime(End)).
      blawx_during(datetime(Start),bird(X),datetime(eot)) :- blawx_ultimately(bird(X)), blawx_becomes(-bird(X),datetime(Start)), blawx_not_interrupted(datetime(Start),bird(X),datetime(eot)).
      blawx_during(datetime(bot),bird(X),datetime(eot)) :- blawx_initially(bird(X)), blawx_ultimately(bird(X)), blawx_becomes(-bird(X),datetime(Start)), blawx_not_interrupted(datetime(bot),bird(X),datetime(eot)).
      blawx_during(datetime(Start),-bird(X),datetime(End)) :- blawx_becomes(-bird(X),datetime(Start)), blawx_becomes(bird(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),-bird(X),datetime(End)).
      blawx_during(datetime(bot),-bird(X),datetime(End)) :- blawx_initially(-bird(X)), blawx_becomes(bird(X),datetime(End)), blawx_not_interrupted(datetime(bot),-bird(X),datetime(End)).
      blawx_during(datetime(Start),-bird(X),datetime(eot)) :- blawx_ultimately(-bird(X)), blawx_becomes(bird(X),datetime(Start)), blawx_not_interrupted(datetime(Start),-bird(X),datetime(eot)).
      blawx_during(datetime(bot),-bird(X),datetime(eot)) :- blawx_initially(-bird(X)), blawx_ultimately(-bird(X)), blawx_becomes(-bird(X),datetime(Start)), blawx_not_interrupted(datetime(bot),-bird(X),datetime(eot)).

      according_to(sec_1_section,bird,A) :- penguin(A).

      % BLAWX CHECK DUPLICATES
      holds(sec_1_section,bird,A) :- according_to(sec_1_section,bird,A).

      % BLAWX CHECK DUPLICATES
        bird(A) :- holds(sec_1_section,bird,A).
