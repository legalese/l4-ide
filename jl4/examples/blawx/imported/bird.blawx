      #pred blawx_initially(-on_plane(X)) :: 'that it is not the case that @(X) is on a plane holds initially'.
      #pred blawx_ultimately(on_plane(X)) :: 'that @(X) is on a plane holds ultimately'.
      #pred blawx_ultimately(-on_plane(X)) :: 'that it is not the case that @(X) is on a plane holds ultimately'.
