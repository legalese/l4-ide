      #pred blawx_during(T1,-on_plane(X),T2) :: 'that it is not the case that @(X) is on a plane held between @(T1) and @(T2)'.
      #pred blawx_becomes(on_plane(X),T) :: 'that @(X) is on a plane became true at @(T)'.
      #pred blawx_becomes(-on_plane(X),T) :: 'that it is not the case that @(X) is on a plane became true at @(T)'.
      #pred blawx_not_interrupted(Start,on_plane(X),End) :: '@(X) is on a plane remained the case between @(Start) and @(End)'.
      #pred blawx_not_interrupted(Start,-on_plane(X),End) :: 'it is not the case that @(X) is on a plane remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),on_plane(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-on_plane(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(Start),-on_plane(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(on_plane(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(bot),on_plane(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(-on_plane(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(bot),-on_plane(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(on_plane(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(Start),on_plane(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(-on_plane(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(Start),-on_plane(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(on_plane(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(bot),on_plane(X),datetime(eot)) :- blawx_initially(on_plane(X)), blawx_ultimately(on_plane(X)), findall(Time,blawx_becomes(-on_plane(X),datetime(Time)),[]).
      blawx_not_interrupted(datetime(bot),-on_plane(X),datetime(eot)) :- blawx_initially(-on_plane(X)), blawx_ultimately(-on_plane(X)), findall(Time,blawx_becomes(on_plane(X),datetime(Time)),[]).
      blawx_as_of(on_plane(X),datetime(Time)) :- blawx_initially(on_plane(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),on_plane(X),datetime(BeforeT)).
      blawx_as_of(on_plane(X),datetime(Time)) :- blawx_becomes(on_plane(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),on_plane(X),datetime(Time)).
      blawx_as_of(-on_plane(X),datetime(Time)) :- blawx_initially(-on_plane(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-on_plane(X),datetime(BeforeT)).
      blawx_as_of(-on_plane(X),datetime(Time)) :- blawx_becomes(-on_plane(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),-on_plane(X),datetime(Time)).
      blawx_during(datetime(Start),on_plane(X),datetime(End)) :- blawx_becomes(on_plane(X),datetime(Start)), blawx_becomes(-on_plane(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),on_plane(X),datetime(End)).
      blawx_during(datetime(bot),on_plane(X),datetime(End)) :- blawx_initially(on_plane(X)), blawx_becomes(-on_plane(X),datetime(End)), blawx_not_interrupted(datetime(bot),on_plane(X),datetime(End)).
      blawx_during(datetime(Start),on_plane(X),datetime(eot)) :- blawx_ultimately(on_plane(X)), blawx_becomes(-on_plane(X),datetime(Start)), blawx_not_interrupted(datetime(Start),on_plane(X),datetime(eot)).
