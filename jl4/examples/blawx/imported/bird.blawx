      blawx_during(datetime(Start),-on_plane(X),datetime(eot)) :- blawx_ultimately(-on_plane(X)), blawx_becomes(on_plane(X),datetime(Start)), blawx_not_interrupted(datetime(Start),-on_plane(X),datetime(eot)).
