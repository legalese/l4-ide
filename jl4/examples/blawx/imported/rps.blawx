- model: blawx.ruledoc
  pk: 1
  fields:
    ruledoc_name: Rock Paper Scissors Act
    rule_text: "Rock Paper Scissors Act\n\nPlayers\n1. A game of rock paper scissors has two players.\n2. There are three signs:\n  (a) Rock,\n  (b) Paper, and\n  (c) Scissors.\n\nDefeating Relationships\n3. The signs are related in the following ways:\n  (a) Rock beats Scissors,\n  (b) Scissors beats Paper, and\n  (c) Paper beats Rock.\n\nWinner\n4. The winner of a game is the player who throws\na sign that beats the sign of the other player.\n"
    scasp_encoding: ''
    tutorial: ''
    owner: 1
    published: true
- model: blawx.workspace
  pk: 1
  fields:
    ruledoc: 1
    workspace_name: root_section
    xml_content: ''
    scasp_encoding: ''
- model: blawx.workspace
  pk: 2
  fields:
    ruledoc: 1
    workspace_name: sec_1_section
    xml_content: |-
      <xml xmlns="https://developers.google.com/blockly/xml">
      <block type="unattributed_fact" id="l4b000001" x="40" y="40"><statement name="statements"><block type="new_category_declaration" id="l4b000002"><field name="category_name">game</field><field name="prefix"></field><field name="first_element">object</field><field name="postfix">is a game</field><next><block type="new_category_declaration" id="l4b000003"><field name="category_name">player</field><field name="prefix"></field><field name="first_element">object</field><field name="postfix">is a player</field><next><block type="new_attribute_declaration" id="l4b000004"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="game" attribute_type="player"></mutation><field name="category_name">game</field><field name="attribute_name">player</field><field name="attribute_type">player</field><field name="order">vo</field><field name="prefix"></field><field name="first_element">value</field><field name="infix">played in</field><field name="second_element">object</field><field name="postfix"></field></block></next></block></next></block></statement></block>
      </xml>
    scasp_encoding: |-
      blawx_category(game).
      blawx_category_nlg(game,"","is a game").
      :- dynamic game/1.
      #pred game(X) :: '@(X) is a game'.
      #pred holds(user,game,X) :: 'it is provided as a fact that @(X) is a game'.
      #pred holds(user,-game,X) :: 'it is provided as a fact that it is not the case that @(X) is a game'.
      #pred holds(Z,game,X) :: 'the conclusion in @(Z) that @(X) is a game holds'.
      #pred holds(Z,-game,X) :: 'the conclusion in @(Z) that it is not the case that @(X) is a game holds'.
      #pred according_to(Z,game,X) :: 'according to @(Z), @(X) is a game'.
      #pred according_to(Z,-game,X) :: 'according to @(Z), it is not the case that @(X) is a game'.
      #pred blawx_defeated(Z,game,X) :: 'the conclusion in @(Z) that @(X) is a game is defeated'.
      #pred blawx_defeated(Z,-game,X) :: 'the conclusion in @(Z) that it is not the case that @(X) is a game is defeated'.
      #pred blawx_initially(game(X)) :: 'that @(X) is a game holds initially'.
      #pred blawx_initially(-game(X)) :: 'that it is not the case that @(X) is a game holds initially'.
      #pred blawx_ultimately(game(X)) :: 'that @(X) is a game holds ultimately'.
      #pred blawx_ultimately(-game(X)) :: 'that it is not the case that @(X) is a game holds ultimately'.
      #pred blawx_as_of(game(X),T) :: 'that @(X) is a game holds at @(T)'.
      #pred blawx_as_of(-game(X),T) :: 'that it is not the case that @(X) is a game holds at @(T)'.
      #pred blawx_during(T1,game(X),T2) :: 'that @(X) is a game held between @(T1) and @(T2)'.
      #pred blawx_during(T1,-game(X),T2) :: 'that it is not the case that @(X) is a game held between @(T1) and @(T2)'.
      #pred blawx_becomes(game(X),T) :: 'that @(X) is a game became true at @(T)'.
      #pred blawx_becomes(-game(X),T) :: 'that it is not the case that @(X) is a game became true at @(T)'.
      #pred blawx_not_interrupted(Start,game(X),End) :: '@(X) is a game remained the case between @(Start) and @(End)'.
      #pred blawx_not_interrupted(Start,-game(X),End) :: 'it is not the case that @(X) is a game remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),game(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-game(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(Start),-game(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(game(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(bot),game(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(-game(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(bot),-game(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(game(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(Start),game(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(-game(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(Start),-game(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(game(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(bot),game(X),datetime(eot)) :- blawx_initially(game(X)), blawx_ultimately(game(X)), findall(Time,blawx_becomes(-game(X),datetime(Time)),[]).
      blawx_not_interrupted(datetime(bot),-game(X),datetime(eot)) :- blawx_initially(-game(X)), blawx_ultimately(-game(X)), findall(Time,blawx_becomes(game(X),datetime(Time)),[]).
      blawx_as_of(game(X),datetime(Time)) :- blawx_initially(game(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),game(X),datetime(BeforeT)).
      blawx_as_of(game(X),datetime(Time)) :- blawx_becomes(game(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),game(X),datetime(Time)).
      blawx_as_of(-game(X),datetime(Time)) :- blawx_initially(-game(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-game(X),datetime(BeforeT)).
      blawx_as_of(-game(X),datetime(Time)) :- blawx_becomes(-game(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),-game(X),datetime(Time)).
      blawx_during(datetime(Start),game(X),datetime(End)) :- blawx_becomes(game(X),datetime(Start)), blawx_becomes(-game(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),game(X),datetime(End)).
      blawx_during(datetime(bot),game(X),datetime(End)) :- blawx_initially(game(X)), blawx_becomes(-game(X),datetime(End)), blawx_not_interrupted(datetime(bot),game(X),datetime(End)).
      blawx_during(datetime(Start),game(X),datetime(eot)) :- blawx_ultimately(game(X)), blawx_becomes(-game(X),datetime(Start)), blawx_not_interrupted(datetime(Start),game(X),datetime(eot)).
      blawx_during(datetime(bot),game(X),datetime(eot)) :- blawx_initially(game(X)), blawx_ultimately(game(X)), blawx_becomes(-game(X),datetime(Start)), blawx_not_interrupted(datetime(bot),game(X),datetime(eot)).
      blawx_during(datetime(Start),-game(X),datetime(End)) :- blawx_becomes(-game(X),datetime(Start)), blawx_becomes(game(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),-game(X),datetime(End)).
      blawx_during(datetime(bot),-game(X),datetime(End)) :- blawx_initially(-game(X)), blawx_becomes(game(X),datetime(End)), blawx_not_interrupted(datetime(bot),-game(X),datetime(End)).
      blawx_during(datetime(Start),-game(X),datetime(eot)) :- blawx_ultimately(-game(X)), blawx_becomes(game(X),datetime(Start)), blawx_not_interrupted(datetime(Start),-game(X),datetime(eot)).
      blawx_during(datetime(bot),-game(X),datetime(eot)) :- blawx_initially(-game(X)), blawx_ultimately(-game(X)), blawx_becomes(-game(X),datetime(Start)), blawx_not_interrupted(datetime(bot),-game(X),datetime(eot)).
      blawx_category(player).
      blawx_category_nlg(player,"","is a player").
      :- dynamic player/1.
      #pred player(X) :: '@(X) is a player'.
      #pred holds(user,player,X) :: 'it is provided as a fact that @(X) is a player'.
      #pred holds(user,-player,X) :: 'it is provided as a fact that it is not the case that @(X) is a player'.
      #pred holds(Z,player,X) :: 'the conclusion in @(Z) that @(X) is a player holds'.
      #pred holds(Z,-player,X) :: 'the conclusion in @(Z) that it is not the case that @(X) is a player holds'.
      #pred according_to(Z,player,X) :: 'according to @(Z), @(X) is a player'.
      #pred according_to(Z,-player,X) :: 'according to @(Z), it is not the case that @(X) is a player'.
      #pred blawx_defeated(Z,player,X) :: 'the conclusion in @(Z) that @(X) is a player is defeated'.
      #pred blawx_defeated(Z,-player,X) :: 'the conclusion in @(Z) that it is not the case that @(X) is a player is defeated'.
      #pred blawx_initially(player(X)) :: 'that @(X) is a player holds initially'.
      #pred blawx_initially(-player(X)) :: 'that it is not the case that @(X) is a player holds initially'.
      #pred blawx_ultimately(player(X)) :: 'that @(X) is a player holds ultimately'.
      #pred blawx_ultimately(-player(X)) :: 'that it is not the case that @(X) is a player holds ultimately'.
      #pred blawx_as_of(player(X),T) :: 'that @(X) is a player holds at @(T)'.
      #pred blawx_as_of(-player(X),T) :: 'that it is not the case that @(X) is a player holds at @(T)'.
      #pred blawx_during(T1,player(X),T2) :: 'that @(X) is a player held between @(T1) and @(T2)'.
      #pred blawx_during(T1,-player(X),T2) :: 'that it is not the case that @(X) is a player held between @(T1) and @(T2)'.
      #pred blawx_becomes(player(X),T) :: 'that @(X) is a player became true at @(T)'.
      #pred blawx_becomes(-player(X),T) :: 'that it is not the case that @(X) is a player became true at @(T)'.
      #pred blawx_not_interrupted(Start,player(X),End) :: '@(X) is a player remained the case between @(Start) and @(End)'.
      #pred blawx_not_interrupted(Start,-player(X),End) :: 'it is not the case that @(X) is a player remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),player(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-player(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(Start),-player(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(player(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(bot),player(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(-player(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(bot),-player(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(player(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(Start),player(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(-player(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(Start),-player(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(player(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(bot),player(X),datetime(eot)) :- blawx_initially(player(X)), blawx_ultimately(player(X)), findall(Time,blawx_becomes(-player(X),datetime(Time)),[]).
      blawx_not_interrupted(datetime(bot),-player(X),datetime(eot)) :- blawx_initially(-player(X)), blawx_ultimately(-player(X)), findall(Time,blawx_becomes(player(X),datetime(Time)),[]).
      blawx_as_of(player(X),datetime(Time)) :- blawx_initially(player(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),player(X),datetime(BeforeT)).
      blawx_as_of(player(X),datetime(Time)) :- blawx_becomes(player(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),player(X),datetime(Time)).
      blawx_as_of(-player(X),datetime(Time)) :- blawx_initially(-player(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-player(X),datetime(BeforeT)).
      blawx_as_of(-player(X),datetime(Time)) :- blawx_becomes(-player(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),-player(X),datetime(Time)).
      blawx_during(datetime(Start),player(X),datetime(End)) :- blawx_becomes(player(X),datetime(Start)), blawx_becomes(-player(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),player(X),datetime(End)).
      blawx_during(datetime(bot),player(X),datetime(End)) :- blawx_initially(player(X)), blawx_becomes(-player(X),datetime(End)), blawx_not_interrupted(datetime(bot),player(X),datetime(End)).
      blawx_during(datetime(Start),player(X),datetime(eot)) :- blawx_ultimately(player(X)), blawx_becomes(-player(X),datetime(Start)), blawx_not_interrupted(datetime(Start),player(X),datetime(eot)).
      blawx_during(datetime(bot),player(X),datetime(eot)) :- blawx_initially(player(X)), blawx_ultimately(player(X)), blawx_becomes(-player(X),datetime(Start)), blawx_not_interrupted(datetime(bot),player(X),datetime(eot)).
      blawx_during(datetime(Start),-player(X),datetime(End)) :- blawx_becomes(-player(X),datetime(Start)), blawx_becomes(player(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),-player(X),datetime(End)).
      blawx_during(datetime(bot),-player(X),datetime(End)) :- blawx_initially(-player(X)), blawx_becomes(player(X),datetime(End)), blawx_not_interrupted(datetime(bot),-player(X),datetime(End)).
      blawx_during(datetime(Start),-player(X),datetime(eot)) :- blawx_ultimately(-player(X)), blawx_becomes(player(X),datetime(Start)), blawx_not_interrupted(datetime(Start),-player(X),datetime(eot)).
      blawx_during(datetime(bot),-player(X),datetime(eot)) :- blawx_initially(-player(X)), blawx_ultimately(-player(X)), blawx_becomes(-player(X),datetime(Start)), blawx_not_interrupted(datetime(bot),-player(X),datetime(eot)).
      blawx_attribute(game,player,player).
      blawx_attribute_nlg(player,vo,"","played in","").
      :- dynamic player/2.
      #pred player(Y,X) :: '@(X) played in @(Y)'.
      #pred holds(user,player,Y,X) :: 'it is provided as a fact that @(X) played in @(Y)'.
      #pred holds(user,-player,Y,X) :: 'it is provided as a fact that it is not the case that @(X) played in @(Y)'.
      #pred holds(Z,player,Y,X) :: 'the conclusion in @(Z) that @(X) played in @(Y) holds'.
      #pred holds(Z,-player,Y,X) :: 'the conclusion in @(Z) that it is not the case that @(X) played in @(Y) holds'.
      #pred according_to(Z,player,Y,X) :: 'according to @(Z), @(X) played in @(Y)'.
      #pred according_to(Z,-player,Y,X) :: 'according to @(Z), it is not the case that @(X) played in @(Y)'.
      #pred blawx_defeated(Z,player,Y,X) :: 'the conclusion in @(Z) that @(X) played in @(Y) is defeated'.
      #pred blawx_defeated(Z,-player,Y,X) :: 'the conclusion in @(Z) that @(X) played in @(Y) is defeated'.
      #pred blawx_initially(player(Y,X)) :: 'that @(X) played in @(Y) holds initially'.
      #pred blawx_initially(-player(Y,X)) :: 'that it is not the case that @(X) played in @(Y) holds initially'.
      #pred blawx_ultimately(player(Y,X)) :: 'that @(X) played in @(Y) holds ultimately'.
      #pred blawx_ultimately(-player(Y,X)) :: 'that it is not the case that @(X) played in @(Y) holds ultimately'.
      #pred blawx_as_of(player(Y,X),T) :: 'that @(X) played in @(Y) holds at @(T)'.
      #pred blawx_as_of(-player(Y,X),T) :: 'that it is not the case that @(X) played in @(Y) holds at @(T)'.
      #pred blawx_during(T1,player(Y,X),T2) :: 'that @(X) played in @(Y) held between @(T1) and @(T2)'.
      #pred blawx_during(T1,-player(Y,X),T2) :: 'that it is not the case that @(X) played in @(Y) held between @(T1) and @(T2)'.
      #pred blawx_becomes(player(Y,X),T) :: 'that @(X) played in @(Y) became true at @(T)'.
      #pred blawx_becomes(-player(Y,X),T) :: 'that it is not the case that @(X) played in @(Y) became true at @(T)'.
      #pred blawx_not_interrupted(Start,player(Y,X),End) :: '@(X) played in @(Y) remained the case between @(Start) and @(End)'.
      #pred blawx_not_interrupted(Start,-player(Y,X),End) :: 'it is not the case that @(X) played in @(Y) remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),player(Y,X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-player(Y,X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(Start),-player(Y,X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(player(Y,X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(bot),player(Y,X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(-player(Y,X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(bot),-player(Y,X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(player(Y,X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(Start),player(Y,X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(-player(Y,X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(Start),-player(Y,X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(player(Y,X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(bot),player(Y,X),datetime(eot)) :- blawx_initially(player(Y,X)), blawx_ultimately(player(Y,X)), findall(Time,blawx_becomes(-player(Y,X),datetime(Time)),[]).
      blawx_not_interrupted(datetime(bot),-player(Y,X),datetime(eot)) :- blawx_initially(-player(Y,X)), blawx_ultimately(-player(Y,X)), findall(Time,blawx_becomes(player(Y,X),datetime(Time)),[]).
      blawx_as_of(player(Y,X),datetime(Time)) :- blawx_initially(player(Y,X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),player(Y,X),datetime(BeforeT)).
      blawx_as_of(player(Y,X),datetime(Time)) :- blawx_becomes(player(Y,X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),player(Y,X),datetime(Time)).
      blawx_as_of(-player(Y,X),datetime(Time)) :- blawx_initially(-player(Y,X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-player(Y,X),datetime(BeforeT)).
      blawx_as_of(-player(Y,X),datetime(Time)) :- blawx_becomes(-player(Y,X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),-player(Y,X),datetime(Time)).
      blawx_during(datetime(Start),player(Y,X),datetime(End)) :- blawx_becomes(player(Y,X),datetime(Start)), blawx_becomes(-player(Y,X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),player(Y,X),datetime(End)).
      blawx_during(datetime(bot),player(Y,X),datetime(End)) :- blawx_initially(player(Y,X)), blawx_becomes(-player(Y,X),datetime(End)), blawx_not_interrupted(datetime(bot),player(Y,X),datetime(End)).
      blawx_during(datetime(Start),player(Y,X),datetime(eot)) :- blawx_ultimately(player(Y,X)), blawx_becomes(-player(Y,X),datetime(Start)), blawx_not_interrupted(datetime(Start),player(Y,X),datetime(eot)).
      blawx_during(datetime(bot),player(Y,X),datetime(eot)) :- blawx_initially(player(Y,X)), blawx_ultimately(player(Y,X)), blawx_becomes(-player(Y,X),datetime(Start)), blawx_not_interrupted(datetime(bot),player(Y,X),datetime(eot)).
      blawx_during(datetime(Start),-player(Y,X),datetime(End)) :- blawx_becomes(-player(Y,X),datetime(Start)), blawx_becomes(player(Y,X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),-player(Y,X),datetime(End)).
      blawx_during(datetime(bot),-player(Y,X),datetime(End)) :- blawx_initially(-player(Y,X)), blawx_becomes(player(Y,X),datetime(End)), blawx_not_interrupted(datetime(bot),-player(Y,X),datetime(End)).
      blawx_during(datetime(Start),-player(Y,X),datetime(eot)) :- blawx_ultimately(-player(Y,X)), blawx_becomes(player(Y,X),datetime(Start)), blawx_not_interrupted(datetime(Start),-player(Y,X),datetime(eot)).
      blawx_during(datetime(bot),-player(Y,X),datetime(eot)) :- blawx_initially(-player(Y,X)), blawx_ultimately(-player(Y,X)), blawx_becomes(-player(Y,X),datetime(Start)), blawx_not_interrupted(datetime(bot),-player(Y,X),datetime(eot)).
- model: blawx.workspace
  pk: 3
  fields:
    ruledoc: 1
    workspace_name: sec_2_section
    xml_content: |-
      <xml xmlns="https://developers.google.com/blockly/xml">
      <block type="unattributed_fact" id="l4b000005" x="40" y="40"><statement name="statements"><block type="new_category_declaration" id="l4b000006"><field name="category_name">sign</field><field name="prefix"></field><field name="first_element">object</field><field name="postfix">is a sign</field></block></statement></block>
      </xml>
    scasp_encoding: |-
      blawx_category(sign).
      blawx_category_nlg(sign,"","is a sign").
      :- dynamic sign/1.
      #pred sign(X) :: '@(X) is a sign'.
      #pred holds(user,sign,X) :: 'it is provided as a fact that @(X) is a sign'.
      #pred holds(user,-sign,X) :: 'it is provided as a fact that it is not the case that @(X) is a sign'.
      #pred holds(Z,sign,X) :: 'the conclusion in @(Z) that @(X) is a sign holds'.
      #pred holds(Z,-sign,X) :: 'the conclusion in @(Z) that it is not the case that @(X) is a sign holds'.
      #pred according_to(Z,sign,X) :: 'according to @(Z), @(X) is a sign'.
      #pred according_to(Z,-sign,X) :: 'according to @(Z), it is not the case that @(X) is a sign'.
      #pred blawx_defeated(Z,sign,X) :: 'the conclusion in @(Z) that @(X) is a sign is defeated'.
      #pred blawx_defeated(Z,-sign,X) :: 'the conclusion in @(Z) that it is not the case that @(X) is a sign is defeated'.
      #pred blawx_initially(sign(X)) :: 'that @(X) is a sign holds initially'.
      #pred blawx_initially(-sign(X)) :: 'that it is not the case that @(X) is a sign holds initially'.
      #pred blawx_ultimately(sign(X)) :: 'that @(X) is a sign holds ultimately'.
      #pred blawx_ultimately(-sign(X)) :: 'that it is not the case that @(X) is a sign holds ultimately'.
      #pred blawx_as_of(sign(X),T) :: 'that @(X) is a sign holds at @(T)'.
      #pred blawx_as_of(-sign(X),T) :: 'that it is not the case that @(X) is a sign holds at @(T)'.
      #pred blawx_during(T1,sign(X),T2) :: 'that @(X) is a sign held between @(T1) and @(T2)'.
      #pred blawx_during(T1,-sign(X),T2) :: 'that it is not the case that @(X) is a sign held between @(T1) and @(T2)'.
      #pred blawx_becomes(sign(X),T) :: 'that @(X) is a sign became true at @(T)'.
      #pred blawx_becomes(-sign(X),T) :: 'that it is not the case that @(X) is a sign became true at @(T)'.
      #pred blawx_not_interrupted(Start,sign(X),End) :: '@(X) is a sign remained the case between @(Start) and @(End)'.
      #pred blawx_not_interrupted(Start,-sign(X),End) :: 'it is not the case that @(X) is a sign remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),sign(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-sign(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(Start),-sign(X),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(sign(X),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(bot),sign(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(-sign(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(bot),-sign(X),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(sign(X),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(Start),sign(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(-sign(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(Start),-sign(X),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(sign(X),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(bot),sign(X),datetime(eot)) :- blawx_initially(sign(X)), blawx_ultimately(sign(X)), findall(Time,blawx_becomes(-sign(X),datetime(Time)),[]).
      blawx_not_interrupted(datetime(bot),-sign(X),datetime(eot)) :- blawx_initially(-sign(X)), blawx_ultimately(-sign(X)), findall(Time,blawx_becomes(sign(X),datetime(Time)),[]).
      blawx_as_of(sign(X),datetime(Time)) :- blawx_initially(sign(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),sign(X),datetime(BeforeT)).
      blawx_as_of(sign(X),datetime(Time)) :- blawx_becomes(sign(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),sign(X),datetime(Time)).
      blawx_as_of(-sign(X),datetime(Time)) :- blawx_initially(-sign(X)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-sign(X),datetime(BeforeT)).
      blawx_as_of(-sign(X),datetime(Time)) :- blawx_becomes(-sign(X),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),-sign(X),datetime(Time)).
      blawx_during(datetime(Start),sign(X),datetime(End)) :- blawx_becomes(sign(X),datetime(Start)), blawx_becomes(-sign(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),sign(X),datetime(End)).
      blawx_during(datetime(bot),sign(X),datetime(End)) :- blawx_initially(sign(X)), blawx_becomes(-sign(X),datetime(End)), blawx_not_interrupted(datetime(bot),sign(X),datetime(End)).
      blawx_during(datetime(Start),sign(X),datetime(eot)) :- blawx_ultimately(sign(X)), blawx_becomes(-sign(X),datetime(Start)), blawx_not_interrupted(datetime(Start),sign(X),datetime(eot)).
      blawx_during(datetime(bot),sign(X),datetime(eot)) :- blawx_initially(sign(X)), blawx_ultimately(sign(X)), blawx_becomes(-sign(X),datetime(Start)), blawx_not_interrupted(datetime(bot),sign(X),datetime(eot)).
      blawx_during(datetime(Start),-sign(X),datetime(End)) :- blawx_becomes(-sign(X),datetime(Start)), blawx_becomes(sign(X),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),-sign(X),datetime(End)).
      blawx_during(datetime(bot),-sign(X),datetime(End)) :- blawx_initially(-sign(X)), blawx_becomes(sign(X),datetime(End)), blawx_not_interrupted(datetime(bot),-sign(X),datetime(End)).
      blawx_during(datetime(Start),-sign(X),datetime(eot)) :- blawx_ultimately(-sign(X)), blawx_becomes(sign(X),datetime(Start)), blawx_not_interrupted(datetime(Start),-sign(X),datetime(eot)).
      blawx_during(datetime(bot),-sign(X),datetime(eot)) :- blawx_initially(-sign(X)), blawx_ultimately(-sign(X)), blawx_becomes(-sign(X),datetime(Start)), blawx_not_interrupted(datetime(bot),-sign(X),datetime(eot)).
