      <block type="attributed_rule" id="l4b000030" x="40" y="298"><field name="defeasible">FALSE</field><field name="inapplicable">FALSE</field><statement name="conditions"><block type="new_object_category" id="l4b000031"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="game"></mutation><field name="category_name">game</field><value name="object"><block type="variable" id="l4b000032"><field name="variable_name">Game</field></block></value><next><block type="new_object_category" id="l4b000033"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="player"></mutation><field name="category_name">player</field><value name="object"><block type="variable" id="l4b000034"><field name="variable_name">Player1</field></block></value><next><block type="new_object_category" id="l4b000035"><mutation xmlns="http://www.w3.org/1999/xhtml" category_name="player"></mutation><field name="category_name">player</field><value name="object"><block type="variable" id="l4b000036"><field name="variable_name">Player2</field></block></value><next><block type="object_disequality" id="l4b000037"><value name="first_object"><block type="variable" id="l4b000038"><field name="variable_name">Player1</field></block></value><value name="second_object"><block type="variable" id="l4b000039"><field name="variable_name">Player2</field></block></value><next><block type="attribute_selector" id="l4b000040"><mutation xmlns="http://www.w3.org/1999/xhtml" attributename="player" attributetype="player" attributeorder="ov"></mutation><field name="prefix"></field><field name="infix">played in</field><field name="postfix"></field><value name="first_element"><block type="variable" id="l4b000041"><field name="variable_name">Game</field></block></value><value name="second_element"><block type="variable" id="l4b000042"><field name="variable_name">Player1</field></block></value><next><block type="attribute_selector" id="l4b000043"><mutation xmlns="http://www.w3.org/1999/xhtml" attributename="player" att