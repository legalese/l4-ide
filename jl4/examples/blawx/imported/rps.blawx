ld name="postfix"></field><value name="first_element"><block type="variable" id="l4b000055"><field name="variable_name">Throw1</field></block></value><value name="second_element"><block type="variable" id="l4b000056"><field name="variable_name">Throw2</field></block></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement><value name="source"><block type="doc_selector" id="l4b000057"><mutation xmlns="http://www.w3.org/1999/xhtml" section_reference="sec_4_section"></mutation><field name="doc_part_name">RPSA 4</field></block></value><statement name="conclusion"><block type="attribute_selector" id="l4b000058"><mutation xmlns="http://www.w3.org/1999/xhtml" attributename="winner" attributetype="player" attributeorder="ov"></mutation><field name="prefix">the winner of</field><field name="infix">is</field><field name="postfix"></field><value name="first_element"><block type="variable" id="l4b000059"><field name="variable_name">Game</field></block></value><value name="second_element"><block type="variable" id="l4b000060"><field name="variable_name">Player1</field></block></value></block></statement></block>
      </xml>
    scasp_encoding: |-
      blawx_attribute(game,winner,player).
      blawx_attribute_nlg(winner,ov,"the winner of","is","").
      :- dynamic winner/2.
      #pred winner(X,Y) :: 'the winner of @(X) is @(Y)'.
      #pred holds(user,winner,X,Y) :: 'it is provided as a fact that the winner of @(X) is @(Y)'.
      #pred holds(user,-winner,X,Y) :: 'it is provided as a fact that it is not the case that the winner of @(X) is @(Y)'.
      #pred holds(Z,winner,X,Y) :: 'the conclusion in @(Z) that the winner of @(X) is @(Y) holds'.
      #pred holds(Z,-winner,X,Y) :: 'the conclusion in @(Z) that it is not the case that the winner of @(X) is @(Y) holds'.
      #pred according_to(Z,winner,X,Y) :: 'according to @(Z), the winner of @(X) is @(Y)'.
      #pred according_to(Z,-winner,X,Y) :: 'according to @(Z), it is not the case that the winner of @(X) is @(Y)'.
      #pred blawx_defeated(Z,winner,X,Y) :: 'the conclusion in @(Z) that the winner of @(X) is @(Y) is defeated'.
      #pred blawx_defeated(Z,-winner,X,Y) :: 'the conclusion in @(Z) that the winner of @(X) is @(Y) is defeated'.
      #pred blawx_initially(winner(X,Y)) :: 'that the winner of @(X) is @(Y) holds initially'.
      #pred blawx_initially(-winner(X,Y)) :: 'that it is not the case that the winner of @(X) is @(Y) holds initially'.
      #pred blawx_ultimately(winner(X,Y)) :: 'that the winner of @(X) is @(Y) holds ultimately'.
      #pred blawx_ultimately(-winner(X,Y)) :: 'that it is not the case that the winner of @(X) is @(Y) holds ultimately'.
      #pred blawx_as_of(winner(X,Y),T) :: 'that the winner of @(X) is @(Y) holds at @(T)'.
      #pred blawx_as_of(-winner(X,Y),T) :: 'that it is not the case that the winner of @(X) is @(Y) holds at @(T)'.
      #pred blawx_during(T1,winner(X,Y),T2) :: 'that the winner of @(X) is @(Y) held between @(T1) and @(T2)'.
      #pred blawx_during(T1,-winner(X,Y),T2) :: 'that it is not the case that the winner of @(X) is @(Y) held between @(T1) and @(T2)'.
      #pred blawx_becomes(winner(X,Y),T) :: 'that the winner of @(X) is @(Y) became true at @(T)'.
      #pred blawx_becomes(-winner(X,Y),T) :: 'that it is not the case that the winner of @(X) is @(Y) became true at @(T)'.
      #pred blawx_not_interrupted(Start,winner(X,Y),End) :: 'the winner of @(X) is @(Y) remained the case between @(Start) and @(End)'.
      #pred blawx_not_interrupted(Start,-winner(X,Y),End) :: 'it is not the case that the winner of @(X) is @(Y) remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),winner(X,Y),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-winner(X,Y),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(Start),-winner(X,Y),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(winner(X,Y),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(bot),winner(X,Y),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(-winner(X,Y),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(bot),-winner(X,Y),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(winner(X,Y),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(Start),winner(X,Y),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(-winner(X,Y),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(Start),-winner(X,Y),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(winner(X,Y),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(bot),winner(X,Y),datetime(eot)) :- blawx_initially(winner(X,Y)), blawx_ultimately(winner(X,Y)), findall(Time,blawx_becomes(-winner(X,Y),datetime(Time)),[]).
      blawx_not_interrupted(datetime(bot),-winner(X,Y),datetime(eot)) :- blawx_initially(-winner(X,Y)), blawx_ultimately(-winner(X,Y)), findall(Time,blawx_becomes(winner(X,Y),datetime(Time)),[]).
      blawx_as_of(winner(X,Y),datetime(Time)) :- blawx_initially(winner(X,Y)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),winner(X,Y),datetime(BeforeT)).
      blawx_as_of(winner(X,Y),datetime(Time)) :- blawx_becomes(winner(X,Y),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),winner(X,Y),datetime(Time)).
      blawx_as_of(-winner(X,Y),datetime(Time)) :- blawx_initially(-winner(X,Y)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-winner(X,Y),datetime(BeforeT)).
      blawx_as_of(-winner(X,Y),datetime(Time)) :- blawx_becomes(-winner(X,Y),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),-winner(X,Y),datetime(Time)).
      blawx_during(datetime(Start),winner(X,Y),datetime(End)) :- blawx_becomes(winner(X,Y),datetime(Start)), blawx_becomes(-winner(X,Y),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),winner(X,Y),datetime(End)).
      blawx_during(datetime(bot),winner(X,Y),datetime(End)) :- blawx_initially(winner(X,Y)), blawx_becomes(-winner(X,Y),datetime(End)), blawx_not_interrupted(datetime(bot),winner(X,Y),datetime(End)).
      blawx_during(datetime(Start),winner(X,Y),datetime(eot)) :- blawx_ultimately(winner(X,Y)), blawx_becomes(-winner(X,Y),datetime(Start)), blawx_not_interrupted(datetime(Start),winner(X,Y),datetime(eot)).
      blawx_during(datetime(bot),winner(X,Y),datetime(eot)) :- blawx_initially(winner(X,Y)), blawx_ultimately(winner(X,Y)), blawx_becomes(-winner(X,Y),datetime(Start)), blawx_not_interrupted(datetime(bot),winner(X,Y),datetime(eot)).
      blawx_during(datetime(Start),-winner(X,Y),datetime(End)) :- blawx_becomes(-winner(X,Y),datetime(Start)), blawx_becomes(winner(X,Y),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),-winner(X,Y),datetime(End)).
      blawx_during(datetime(bot),-winner(X,Y),datetime(End)) :- blawx_initially(-winner(X,Y)), blawx_becomes(winner(X,Y),datetime(End)), blawx_not_interrupted(datetime(bot),-winner(X,Y),datetime(End)).
      blawx_during(datetime(Start),-winner(X,Y),datetime(eot)) :- blawx_ultimately(-winner(X,Y)), blawx_becomes(winner(X,Y),datetime(Start)), blawx_not_interrupted(datetime(Start),-winner(X,Y),datetime(eot)).
      blawx_during(datetime(bot),-winner(X,Y),datetime(eot)) :- blawx_initially(-winner(X,Y)), blawx_ultimately(-winner(X,Y)), blawx_becomes(-winner(X,Y),datetime(Start)), blawx_not_interrupted(datetime(bot),-winner(X,Y),datetime(eot)).
      blawx_relationship(throw,player,sign,game).
      blawx_relationship_nlg(throw,"","threw","in","").
      :- dynamic throw/3.
      #pred throw(A,B,C) :: '@(A) threw @(B) in @(C)'.
      #pred holds(user,throw,A,B,C) :: 'it is provided as a fact that @(A) threw @(B) in @(C)'.
      #pred holds(user,-throw,A,B,C) :: 'it is provided as a fact that it is not the case that @(A) threw @(B) in @(C)'.
      #pred holds(Z,throw,A,B,C) :: 'the conclusion in @(Z) that @(A) threw @(B) in @(C) holds'.
      #pred holds(Z,-throw,A,B,C) :: 'the conclusion in @(Z) that it is not the case that @(A) threw @(B) in @(C) holds'.
      #pred according_to(Z,throw,A,B,C) :: 'according to @(Z), @(A) threw @(B) in @(C)'.
      #pred according_to(Z,-throw,A,B,C) :: 'according to @(Z), it is not the case that @(A) threw @(B) in @(C)'.
      #pred blawx_defeated(Z,throw,A,B,C) :: 'the conclusion in @(Z) that @(A) threw @(B) in @(C) is defeated'.
      #pred blawx_defeated(Z,-throw,A,B,C) :: 'the conclusion in @(Z) that @(A) threw @(B) in @(C) is defeated'.
      #pred blawx_initially(throw(A,B,C)) :: 'that @(A) threw @(B) in @(C) holds initially'.
      #pred blawx_initially(-throw(A,B,C)) :: 'that it is not the case that @(A) threw @(B) in @(C) holds initially'.
      #pred blawx_ultimately(throw(A,B,C)) :: 'that @(A) threw @(B) in @(C) holds ultimately'.
      #pred blawx_ultimately(-throw(A,B,C)) :: 'that it is not the case that @(A) threw @(B) in @(C) holds ultimately'.
      #pred blawx_as_of(throw(A,B,C),T) :: 'that @(A) threw @(B) in @(C) holds at @(T)'.
      #pred blawx_as_of(-throw(A,B,C),T) :: 'that it is not the case that @(A) threw @(B) in @(C) holds at @(T)'.
      #pred blawx_during(T1,throw(A,B,C),T2) :: 'that @(A) threw @(B) in @(C) held between @(T1) and @(T2)'.
      #pred blawx_during(T1,-throw(A,B,C),T2) :: 'that it is not the case that @(A) threw @(B) in @(C) held between @(T1) and @(T2)'.
      #pred blawx_becomes(throw(A,B,C),T) :: 'that @(A) threw @(B) in @(C) became true at @(T)'.
      #pred blawx_becomes(-throw(A,B,C),T) :: 'that it is not the case that @(A) threw @(B) in @(C) became true at @(T)'.
      #pred blawx_not_interrupted(Start,throw(A,B,C),End) :: '@(A) threw @(B) in @(C) remained the case between @(Start) and @(End)'.
      #pred blawx_not_interrupted(Start,-throw(A,B,C),End) :: 'it is not the case that @(A) threw @(B) in @(C) remained the case between @(Start) and @(End)'.
      blawx_not_interrupted(datetime(Start),throw(A,B,C),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(-throw(A,B,C),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(Start),-throw(A,B,C),datetime(End)) :- Start \= bot, End \= eot, findall(Time,blawx_becomes(throw(A,B,C),datetime(Time)),Times),blawx_list_not_between(Times,Start,End).
      blawx_not_interrupted(datetime(bot),throw(A,B,C),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(-throw(A,B,C),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(bot),-throw(A,B,C),datetime(End)) :- End \= eot, findall(Time,blawx_becomes(throw(A,B,C),datetime(Time)),Times),blawx_list_not_before(Times,End).
      blawx_not_interrupted(datetime(Start),throw(A,B,C),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(-throw(A,B,C),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(Start),-throw(A,B,C),datetime(eot)) :- Start \= bot, findall(Time,blawx_becomes(throw(A,B,C),datetime(Time)),Times),blawx_list_not_after(Times,Start).
      blawx_not_interrupted(datetime(bot),throw(A,B,C),datetime(eot)) :- blawx_initially(throw(A,B,C)), blawx_ultimately(throw(A,B,C)), findall(Time,blawx_becomes(-throw(A,B,C),datetime(Time)),[]).
      blawx_not_interrupted(datetime(bot),-throw(A,B,C),datetime(eot)) :- blawx_initially(-throw(A,B,C)), blawx_ultimately(-throw(A,B,C)), findall(Time,blawx_becomes(throw(A,B,C),datetime(Time)),[]).
      blawx_as_of(throw(A,B,C),datetime(Time)) :- blawx_initially(throw(A,B,C)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),throw(A,B,C),datetime(BeforeT)).
      blawx_as_of(throw(A,B,C),datetime(Time)) :- blawx_becomes(throw(A,B,C),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),throw(A,B,C),datetime(Time)).
      blawx_as_of(-throw(A,B,C),datetime(Time)) :- blawx_initially(-throw(A,B,C)), BeforeT #< Time,blawx_not_interrupted(datetime(bot),-throw(A,B,C),datetime(BeforeT)).
      blawx_as_of(-throw(A,B,C),datetime(Time)) :- blawx_becomes(-throw(A,B,C),datetime(BeforeT)),BeforeT #< Time,blawx_not_interrupted(datetime(BeforeT),-throw(A,B,C),datetime(Time)).
      blawx_during(datetime(Start),throw(A,B,C),datetime(End)) :- blawx_becomes(throw(A,B,C),datetime(Start)), blawx_becomes(-throw(A,B,C),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),throw(A,B,C),datetime(End)).
      blawx_during(datetime(bot),throw(A,B,C),datetime(End)) :- blawx_initially(throw(A,B,C)), blawx_becomes(-throw(A,B,C),datetime(End)), blawx_not_interrupted(datetime(bot),throw(A,B,C),datetime(End)).
      blawx_during(datetime(Start),throw(A,B,C),datetime(eot)) :- blawx_ultimately(throw(A,B,C)), blawx_becomes(-throw(A,B,C),datetime(Start)), blawx_not_interrupted(datetime(Start),throw(A,B,C),datetime(eot)).
      blawx_during(datetime(bot),throw(A,B,C),datetime(eot)) :- blawx_initially(throw(A,B,C)), blawx_ultimately(throw(A,B,C)), blawx_becomes(-throw(A,B,C),datetime(Start)), blawx_not_interrupted(datetime(bot),throw(A,B,C),datetime(eot)).
      blawx_during(datetime(Start),-throw(A,B,C),datetime(End)) :- blawx_becomes(-throw(A,B,C),datetime(Start)), blawx_becomes(throw(A,B,C),datetime(End)), Start #< End, blawx_not_interrupted(datetime(Start),-throw(A,B,C),datetime(End)).
      blawx_during(datetime(bot),-throw(A,B,C),datetime(End)) :- blawx_initially(-throw(A,B,C)), blawx_becomes(throw(A,B,C),datetime(End)), blawx_not_interrupted(datetime(bot),-throw(A,B,C),datetime(End)).
      blawx_during(datetime(Start),-throw(A,B,C),datetime(eot)) :- blawx_ultimately(-throw(A,B,C)), blawx_becomes(throw(A,B,C),datetime(Start)), blawx_not_interrupted(datetime(Start),-throw(A,B,C),datetime(eot)).
      blawx_during(datetime(bot),-throw(A,B,C),datetime(eot)) :- blawx_initially(-throw(A,B,C)), blawx_ultimately(-throw(A,B,C)), blawx_becomes(-throw(A,B,C),datetime(Start)), blawx_not_interrupted(datetime(bot),-throw(A,B,C),datetime(eot)).

      according_to(sec_4_section,winner,Game,Player1) :- game(Game),
      player(Player1),
      player(Player2),
      blawx_diseq(Player1,Player2),
      player(Game,Player1),
      player(Game,Player2),
      throw(Player1,Throw1,Game),
      throw(Player2,Throw2,Game),
      beats(Throw1,Throw2).

      % BLAWX CHECK DUPLICATES
      holds(sec_4_section,winner,Game,Player1) :- according_to(sec_4_section,winner,Game,Player1).

      % BLAWX CHECK DUPLICATES
        winner(Game,Player1) :- holds(sec_4_section,winner,Game,Player1).
- model: blawx.blawxtest
  pk: 1
  fields:
    ruledoc: 1
    test_name: bobjane
    xml_content: |-
