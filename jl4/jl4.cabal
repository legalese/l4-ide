cabal-version: 3.0
name: jl4
version: 0.1
build-type: Simple
tested-with: GHC==9.10.2

common defaults
  default-language: GHC2021
  ghc-options: -Wall -Wderiving-typeable -Wunused-packages -Werror
  default-extensions:
    BlockArguments
    DefaultSignatures
    DeriveAnyClass
    DerivingStrategies
    DerivingVia
    DuplicateRecordFields
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings
    OverloadedLabels
    LambdaCase
    -- This is annoying with fourmolu
    NoImportQualifiedPost
  build-depends:
    base

-- The command line of `l4`, as a library, so that another package can build a
-- command line that is `l4` plus commands of its own (L4.Cli.Extensions).
-- `executable l4` below is this library with nothing added.
--
-- `l4`'s own `Main` is in `l4/` and not in `app/`: an executable whose source
-- path holds the library's modules compiles them again into itself instead of
-- using the library. `jl4-schema` still has `app` on its path and is safe only
-- because Schema.hs imports nothing from L4.Cli.
library l4-cli
  import: defaults
  visibility: public
  hs-source-dirs: app
  build-depends:
    jl4-core,
    jl4-lsp,
    jl4-query-plan,
    aeson,
    aeson-pretty,
    attoparsec,
    bytestring,
    cassava,
    containers,
    crypton,
    directory,
    filepath,
    hls-graph,
    http-client,
    http-client-tls,
    http-types,
    lsp-types,
    network-uri,
    process,
    text,
    time,
    optparse-applicative,
    pretty-simple,
    unordered-containers,
    vector,
    yaml,
    zip-archive,
  if !os(windows)
    build-depends: unix
  exposed-modules:
    L4.Cli.Ast
    L4.Cli.Batch
    L4.Cli.Blawx
    L4.Cli.Catala
    L4.Cli.Check
    L4.Cli.Cloud
    L4.Cli.Common
    L4.Cli.Deploy
    L4.Cli.Docassemble
    L4.Cli.Explore
    L4.Cli.Export
    L4.Cli.Extensions
    L4.Cli.Format
    L4.Cli.Install
    L4.Cli.Lts
    L4.Cli.Main
    L4.Cli.Nlg
    L4.Cli.OpenFisca
    L4.Cli.Render
    L4.Cli.Run
    L4.Cli.StateGraph
    L4.Cli.Trace
    L4.Cli.Verify
    L4.Cli.Yscript

executable l4
  import: defaults
  hs-source-dirs: l4
  build-depends:
    jl4:l4-cli,
  main-is: Main.hs

-- The M3 gate measurement: does information-gain question ordering ask fewer
-- questions than L4 declaration order? Its own executable rather than a mode on
-- `l4`, because it is not a user-facing operation on a document -- it is an
-- experiment over a corpus, it takes a seed and a sampling budget, and bolting
-- that onto a CLI verb would put an experiment's knobs in a user's --help.
-- It takes L4.Cli.Common's oneshot pipeline loader from the l4-cli library.
executable m3-measure
  import: defaults
  hs-source-dirs: measure
  build-depends:
    jl4:l4-cli,
    jl4-core,
    jl4-lsp,
    jl4-query-plan,
    aeson,
    bytestring,
    containers,
    lsp-types,
    optparse-applicative,
  main-is: M3Measure.hs

executable jl4-schema
  import: defaults
  hs-source-dirs: app
  build-depends:
    jl4-core,
    jl4-lsp,
    aeson-pretty,
    bytestring,
    containers,
    directory,
    lsp-types,
    optparse-applicative,
  main-is: Schema.hs

test-suite jl4-test
  import: defaults
  ghc-options: -threaded -rtsopts
  type: exitcode-stdio-1.0
  hs-source-dirs: tests
  main-is: Main.hs
  other-modules:
    BpmnExport
    LtsExplore
    LtsList
    Hover
    SemanticTokens
    VizAutoRefresh
    VizImplies
    VizInline
    VizGuardedRows
    DmnExport
    RelationalExport
    Paths_jl4
  autogen-modules:
    Paths_jl4
  build-depends:
    aeson-pretty,
    bytestring,
    containers,
    Glob,
    filepath,
    hspec,
    hspec-golden,
    directory,
    jl4-core,
    jl4-lsp,
    parser-regex,
    optics,
    silently,
    transformers,
    time,
    lsp-types,
    text,

test-suite l4-cli-test
  import: defaults
  ghc-options: -threaded -rtsopts
  type: exitcode-stdio-1.0
  hs-source-dirs: tests-cli
  main-is: Main.hs
  other-modules:
    CliTest.Blawx
    CliTest.BuildIdentity
    CliTest.BuildVersion
    CliTest.Catala
    CliTest.Common
    CliTest.DmnBpmn
    CliTest.Docassemble
    CliTest.Ledger
    CliTest.Explore
    CliTest.OpenFisca
    CliTest.Yscript
    Paths_jl4
  autogen-modules:
    Paths_jl4
  build-tool-depends:
    jl4:l4,
    jl4-lsp:jl4-lsp,
    jl4-repl:jl4-repl
  build-depends:
    aeson,
    bytestring,
    directory,
    filepath,
    hspec,
    jl4-core,
    process,
    temporary,
    text,
