-- positional.l4 with the ledger reader called as a genitive; it must explore
-- as positional.l4 does (5 states).

IMPORT prelude

DECLARE Actor IS ONE OF Bob
DECLARE Mode IS ONE OF peek, skip
DECLARE Act IS ONE OF
    go HAS mode IS A Mode
    buy

GIVEN who IS AN Actor
GIVETH A BOOLEAN
`taken by` who MEANS fromMaybe FALSE (RECALL OFFICIAL's `taken`)

GIVETH A BOOLEAN
`taken now` MEANS Bob's `taken by`

GIVETH A DEONTIC Actor Act
`shop` MEANS
    PARTY Bob
    MAY buy PROVIDED NOT `taken now`
    WITHIN 10
    HENCE COMMIT `taken` IS TRUE HENCE `shop`
    LEST FULFILLED

GIVETH A DEONTIC Actor Act
`start` MEANS
    PARTY Bob
    MAY go m
    WITHIN 10
    HENCE COMMIT `taken` IS (IF m EQUALS peek THEN NOT `taken now` ELSE TRUE) HENCE `shop`
    LEST FULFILLED

#TRACE `start` AT 0 WITH
    PARTY Bob DOES go peek AT 1
    PARTY Bob DOES buy AT 2

#TRACE `start` AT 0 WITH
    PARTY Bob DOES go skip AT 1
    PARTY Bob DOES buy AT 2
