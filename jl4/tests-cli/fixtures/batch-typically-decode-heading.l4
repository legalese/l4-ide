-- l4 batch over records declared under a heading that needs backticks
-- (`Part 1. Fees`), decoded by the rules. The decode entry names the record
-- behind the heading, quoted as the WITH entry of the same record is
-- (assumed, not ruled: the review of the combined branch, 2026-10-12, following
-- overnight card O6). `partial decode` also pins that a decode which fills a
-- bare MAYBE field with NOTHING lists it, in both modes.

§ `Part 1. Fees`

DECLARE Settings HAS
  limit  IS A NUMBER TYPICALLY 10
  strict IS A BOOLEAN TYPICALLY FALSE

DECLARE Partial HAS
  cap  IS A NUMBER TYPICALLY 7
  note IS A MAYBE STRING

GIVEN s IS A STRING
GIVETH AN EITHER STRING Settings
parseSettings s MEANS JSONDECODE s

GIVEN s IS A STRING
GIVETH AN EITHER STRING Partial
parsePartial s MEANS JSONDECODE s

@export default `same defaults`
GIVEN amount IS A NUMBER
GIVETH A BOOLEAN
DECIDE `same defaults` amount IF
  CONSIDER parseSettings "{}"
    WHEN RIGHT st THEN st EQUALS (Settings WITHAL)
    WHEN LEFT e THEN FALSE

@export `partial decode`
GIVEN amount IS A NUMBER
GIVETH A BOOLEAN
DECIDE `partial decode` amount IF
  CONSIDER parsePartial "{}"
    WHEN RIGHT p THEN p EQUALS (Partial WITH cap IS 7, note IS NOTHING)
    WHEN LEFT e THEN FALSE
