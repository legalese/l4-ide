<?xml version="1.0" encoding="UTF-8"?>
<!--
  PROBE D4. THE SHAPE EVERY PHASE 5 CORPUS FILE WILL HAVE, and unmeasured
  anywhere before this file: a GROUPING-ONLY <decisionService> whose ENCAPSULATED
  decisions carry knowledgeRequirements to BKMs.

  Section 13.7 emits decisionServices for BOTH flavors and BKMs for BOTH flavors,
  so the two features meet in every emitted file the moment Phase 5 lands. D1
  measured a service over plain decisions; A1/A3 measured BKMs called from plain
  decisions; nothing measured a BKM reached from INSIDE a service.

      bkm  rate(band)   : a table, string -> number
      bkm  fee(amount, r): a literal expression
      decision  band    = if n >= 100 then "big" else "small"   (encapsulated)
      decision  charge  = fee(n, rate(band))                    (OUTPUT), KRs to
                          BOTH bkms and an informationRequirement on `band`
      decisionService `pricing` = { output: charge, encapsulated: band, input: n }

  On KIE this additionally exercises evaluateDecisionService resolving a BKM
  reached from within the service body, which is a different code path from
  evaluateAll; KieDmnCheck runs both (KieDmnCheck.java:418-430) and any ERROR it
  raises is counted, so a service-local resolution failure cannot pass quietly.

  WHAT A FLIP MEANS. A failure here is as fatal as B1's: it would mean Phase 5's
  BKMs and section 2.3's section-as-service cannot coexist in one document, and the
  emitter would have to choose one of the two, on the flavor where the other is
  the point.

  MEASURED 2026-07-31: 6/6 values on BOTH engines, KIE validator and build
  clean, Camunda parse clean, and KIE's evaluateDecisionService resolves the two
  BKMs from inside the service (`SVC pricing -> {n=200, charge=5.00}`) with no
  message. The shape every Phase 5 corpus file will have is portable.

-->
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="definitions_svc_plus_bkm" name="svc_plus_bkm" namespace="https://legalese.com/l4/dmn/svc_plus_bkm" exporter="hand">
  <businessKnowledgeModel id="bkm_rate" name="rate">
    <variable id="bkm_rate_var" name="rate" typeRef="number"/>
    <encapsulatedLogic id="bkm_rate_logic">
      <formalParameter id="bkm_rate_p1" name="band" typeRef="string"/>
      <decisionTable id="bkm_rate_dt" hitPolicy="UNIQUE">
        <input id="bkm_rate_in">
          <inputExpression id="bkm_rate_in_e" typeRef="string">
            <text>band</text>
          </inputExpression>
        </input>
        <output id="bkm_rate_out"/>
        <rule id="bkm_rate_r1">
          <inputEntry id="bkm_rate_r1_i"><text>"big"</text></inputEntry>
          <outputEntry id="bkm_rate_r1_o"><text>0.02</text></outputEntry>
        </rule>
        <rule id="bkm_rate_r2">
          <inputEntry id="bkm_rate_r2_i"><text>"small"</text></inputEntry>
          <outputEntry id="bkm_rate_r2_o"><text>0.05</text></outputEntry>
        </rule>
      </decisionTable>
    </encapsulatedLogic>
  </businessKnowledgeModel>
  <businessKnowledgeModel id="bkm_fee" name="fee">
    <variable id="bkm_fee_var" name="fee" typeRef="number"/>
    <encapsulatedLogic id="bkm_fee_logic">
      <formalParameter id="bkm_fee_p1" name="amount" typeRef="number"/>
      <formalParameter id="bkm_fee_p2" name="r" typeRef="number"/>
      <literalExpression id="bkm_fee_lit">
        <text>amount * r + 1</text>
      </literalExpression>
    </encapsulatedLogic>
  </businessKnowledgeModel>
  <inputData id="input_n" name="n">
    <variable id="input_n_var" name="n" typeRef="number"/>
  </inputData>
  <decision id="decision_band" name="band">
    <variable id="decision_band_var" name="band" typeRef="string"/>
    <informationRequirement id="ir_band_n">
      <requiredInput href="#input_n"/>
    </informationRequirement>
    <literalExpression id="decision_band_lit">
      <text>if n &gt;= 100 then "big" else "small"</text>
    </literalExpression>
  </decision>
  <decision id="decision_charge" name="charge">
    <variable id="decision_charge_var" name="charge" typeRef="number"/>
    <informationRequirement id="ir_charge_n">
      <requiredInput href="#input_n"/>
    </informationRequirement>
    <informationRequirement id="ir_charge_band">
      <requiredDecision href="#decision_band"/>
    </informationRequirement>
    <knowledgeRequirement id="kr_charge_rate">
      <requiredKnowledge href="#bkm_rate"/>
    </knowledgeRequirement>
    <knowledgeRequirement id="kr_charge_fee">
      <requiredKnowledge href="#bkm_fee"/>
    </knowledgeRequirement>
    <literalExpression id="decision_charge_lit">
      <text>fee(n, rate(band))</text>
    </literalExpression>
  </decision>
  <decisionService id="svc_pricing" name="pricing">
    <variable id="svc_pricing_var" name="pricing" typeRef="number"/>
    <outputDecision href="#decision_charge"/>
    <encapsulatedDecision href="#decision_band"/>
    <inputData href="#input_n"/>
  </decisionService>
</definitions>
