<?xml version="1.0" encoding="UTF-8"?>
<!--
  PROBE E7. E1's question asked so that EVERY wrong answer is a plausible,
  non-null, differently-sized number, and asked against a DECISION name as well
  as an inputData name.

  This file exists because of the section 13.6 amendment: neither harness's null
  rule and neither harness's failure rule catches a WRONG NON-NULL VALUE. Only
  `expect` does. A shadowing probe whose failure mode is null would therefore be
  measuring the harness rather than the engine.

      inputData x      = 7
      decision  y      = 70
      bkm  tenx(x) = x * 10      parameter shadows an INPUT DATA name
      bkm  teny(y) = y * 10      parameter shadows a DECISION name
      decision  shadow_input    = tenx(1000)   -> 10000 right, 70  wrong
      decision  shadow_decision = teny(1000)   -> 10000 right, 700 wrong

  Three distinct non-null outcomes per decision, all of them numbers an engine
  could plausibly produce, none of them zero, and the right one two orders of
  magnitude away from either wrong one.

  It also carries the half of probe E3 that E3 cannot measure on KIE: E3's BKM
  that READS a decision is a whole-model compile error on KIE, so E3's KIE leg
  never reaches the shadowing question. Here there is no such BKM, and both
  legs run.

  MEASURED 2026-07-31: 6/6 values on BOTH engines, KIE validator and build
  clean, Camunda parse clean. Both shadowed answers stay at 10000 while the
  outer names move, so a formalParameter shadows an inputData name AND a
  decision name, on both engines, with the wrong answers being plausible
  non-null numbers that did not appear. Together with E1 and E2 this is the full
  measurement behind Lower.hs:3712-3716's second claim, which STANDS.

-->
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="definitions_collide_param_shadow_visible" name="collide_param_shadow_visible" namespace="https://legalese.com/l4/dmn/collide_param_shadow_visible" exporter="hand">
  <inputData id="input_x" name="x">
    <variable id="input_x_var" name="x" typeRef="number"/>
  </inputData>
  <decision id="decision_y" name="y">
    <variable id="decision_y_var" name="y" typeRef="number"/>
    <informationRequirement id="ir_y_x">
      <requiredInput href="#input_x"/>
    </informationRequirement>
    <literalExpression id="decision_y_lit">
      <text>x * 10</text>
    </literalExpression>
  </decision>
  <businessKnowledgeModel id="bkm_tenx" name="tenx">
    <variable id="bkm_tenx_var" name="tenx" typeRef="number"/>
    <encapsulatedLogic id="bkm_tenx_logic">
      <formalParameter id="bkm_tenx_p1" name="x" typeRef="number"/>
      <literalExpression id="bkm_tenx_lit">
        <text>x * 10</text>
      </literalExpression>
    </encapsulatedLogic>
  </businessKnowledgeModel>
  <businessKnowledgeModel id="bkm_teny" name="teny">
    <variable id="bkm_teny_var" name="teny" typeRef="number"/>
    <encapsulatedLogic id="bkm_teny_logic">
      <formalParameter id="bkm_teny_p1" name="y" typeRef="number"/>
      <literalExpression id="bkm_teny_lit">
        <text>y * 10</text>
      </literalExpression>
    </encapsulatedLogic>
  </businessKnowledgeModel>
  <decision id="decision_shadow_input" name="shadow_input">
    <variable id="decision_shadow_input_var" name="shadow_input" typeRef="number"/>
    <informationRequirement id="ir_shadow_input_x">
      <requiredInput href="#input_x"/>
    </informationRequirement>
    <knowledgeRequirement id="kr_shadow_input">
      <requiredKnowledge href="#bkm_tenx"/>
    </knowledgeRequirement>
    <literalExpression id="decision_shadow_input_lit">
      <text>tenx(1000)</text>
    </literalExpression>
  </decision>
  <decision id="decision_shadow_decision" name="shadow_decision">
    <variable id="decision_shadow_decision_var" name="shadow_decision" typeRef="number"/>
    <informationRequirement id="ir_shadow_decision_y">
      <requiredDecision href="#decision_y"/>
    </informationRequirement>
    <knowledgeRequirement id="kr_shadow_decision">
      <requiredKnowledge href="#bkm_teny"/>
    </knowledgeRequirement>
    <literalExpression id="decision_shadow_decision_lit">
      <text>teny(1000)</text>
    </literalExpression>
  </decision>
</definitions>
