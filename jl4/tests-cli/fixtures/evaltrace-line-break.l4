§ EvalTraceLineBreakFixture

-- A #EVALTRACE over a string holding a line break and a tab. The trace prints
-- each step as source code, so the literal appears spelled with escapes
-- ("line\nnext"), which is how the source spells it.

GIVEN x IS A NUMBER
GIVETH A STRING
DECIDE s x IS
    IF x > 0
    THEN "line\nnext"
    ELSE "tab\there"

#EVALTRACE s 1
