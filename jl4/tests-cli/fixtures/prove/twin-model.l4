-- l4 prove fixture (smucclaw/l4-ide#1098): a counterexample whose two fields
-- can hold equal records, which cvc5 prints with `let` unless told not to.
DECLARE Shade IS ONE OF light, dark

DECLARE Tile
  HAS width IS A NUMBER
      shade IS A Shade

DECLARE Twin
  HAS first  IS A Tile
      second IS A Tile

§ `Twins`
    GIVEN t IS A Twin

#ASSERT t's first's width GREATER THAN 0 OR t's second's width GREATER THAN 0
