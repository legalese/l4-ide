-- A deliberate ENCODING DEFECT, kept as the positive control for R-V5's replay.
-- The encoding treats a constructor's fields as strict, so it believes the
-- record below raises when p is 0. The evaluator is lazy, never reads that
-- field, and says TRUE there. `l4 prove` must report the disagreement as a
-- defect in itself, never as a counterexample to the rule.
DECLARE Item
  HAS price IS A NUMBER
      paid  IS A BOOLEAN

§ `Lazy fields`
    GIVEN p IS A NUMBER

#ASSERT p GREATER THAN 0 OR (Item OF (1 DIVIDED BY p), p AT MOST 0)'s paid
