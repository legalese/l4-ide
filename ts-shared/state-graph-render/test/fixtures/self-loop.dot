digraph {
    graph [rankdir=TB
          ,label="the monthly cycle"
          ,labelloc=t
          ,fontname=Helvetica
          ,fontsize=14];
    node [fontname=Helvetica
         ,fontsize=11];
    edge [fontname=Helvetica
         ,fontsize=10];
    0 [label=initial
      ,fillcolor=white
      ,style=filled
      ,shape=ellipse
      ,fillcolor="#e8f4fd"];
    1 [label="`The Landlord` must serve notice"
      ,fillcolor=white
      ,style=filled
      ,shape=ellipse
      ,fillcolor="#ffffff"];
    2 [label=Fulfilled
      ,fillcolor=white
      ,style=filled
      ,shape=doublecircle
      ,fillcolor="#d4edda"];
    3 [label=Breach
      ,fillcolor=white
      ,style=filled
      ,shape=doublecircle
      ,fillcolor="#f8d7da"];
    0 -> 0 [label="`The Tenant` MUST pay the rent [30]"
           ,color="#28a745"
           ,style=solid];
    0 -> 1 [label=timeout
           ,color="#dc3545"
           ,style=dashed];
    1 -> 2 [label="`The Landlord` MUST serve notice [7]"
           ,color="#28a745"
           ,style=solid];
    1 -> 3 [label=timeout
           ,color="#dc3545"
           ,style=dashed];
}
