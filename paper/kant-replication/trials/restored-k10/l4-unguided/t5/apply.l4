    `wellness visit occurred within six months of the effective date` IS TRUE
    `wellness confirmation submission month`                          IS JUST 6.5
    `fraud or misrepresentation`                                      IS FALSE
    `confined in a hospital in the United States`                     IS TRUE
    `days of continuous confinement`                                  IS 1
    `claim made to the Company`                                       IS TRUE
    `injury arose from skydiving`                                     IS TRUE
    `injury arose from military service`                              IS FALSE
    `injury arose from firefighter service`                           IS FALSE
    `injury arose from police service`                                IS FALSE
#EVAL `covered` q6

