IMPORT policy

-- Standing preamble (queries-blind.md): "Assuming all other conditions are met
-- and no other exclusions apply (where by 'other,' I mean anything not
-- referenced in the query that follows)." Signing and timely premium payment
-- are likewise assumed throughout (policy.l4 does not model them).
--
-- For every fact not mentioned by a given query, a value is chosen that keeps
-- every OTHER condition/exclusion satisfied/inapplicable, so that only the
-- facts the query actually states can determine the result. Judgement calls
-- made in choosing those values are recorded in NOTES.md.

-- Q1: hospitalized by burns suffered while doing my duty as a firefighter.
q1 MEANS Claim WITH
    `cause of hospitalization`                                          IS `Accidental Injury`
    `excluded activity`                                                 IS JUST `Firefighter Service`
    `age at hospitalization`                                            IS 40
    `hospital located in the United States`                             IS TRUE
    `days confined in hospital`                                         IS 1
    `hospitalization months after the effective date`                   IS 1
    `wellness visit occurred months after the effective date`           IS JUST 1
    `wellness visit confirmation given months after the effective date` IS JUST 2
    `fraud misrepresentation or material withholding of information`    IS FALSE

#EVAL `covered` q1

-- Q2: 78 years old at the time of hospitalization.
q2 MEANS Claim WITH
    `cause of hospitalization`                                          IS Sickness
    `excluded activity`                                                 IS NOTHING
    `age at hospitalization`                                            IS 78
    `hospital located in the United States`                             IS TRUE
    `days confined in hospital`                                         IS 1
    `hospitalization months after the effective date`                   IS 1
    `wellness visit occurred months after the effective date`           IS JUST 1
    `wellness visit confirmation given months after the effective date` IS JUST 2
    `fraud misrepresentation or material withholding of information`    IS FALSE

#EVAL `covered` q2

