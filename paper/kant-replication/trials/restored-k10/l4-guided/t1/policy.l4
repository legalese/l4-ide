IMPORT prelude

-- =============================================================================
-- Codex Insurance Limited -- Hospital Confinement Policy
-- Encoded from inputs/chubb-policy.txt. Section references in comments below
-- (SS1, SS2, ...) refer to the numbered sections of that contract.
-- =============================================================================

-- -----------------------------------------------------------------------------
-- Fact schema, from inputs/schema.md, verbatim.
-- -----------------------------------------------------------------------------

DECLARE Ground IS ONE OF Sickness, `Accidental injury`, Neither

DECLARE Cause IS ONE OF
  Skydiving, `Military service`, Firefighting, `Police service`, Other

DECLARE Claim
  HAS `agreement signed`                           IS A BOOLEAN
      `premium paid month`                         IS A MAYBE NUMBER
      `hospitalization month`                      IS A NUMBER
      `hospitalization ground`                     IS A Ground
      `age at hospitalization`                     IS A NUMBER
      `causes`                                     IS A LIST OF Cause
      `fraud month`                                IS A MAYBE NUMBER
      `misrepresentation month`                    IS A MAYBE NUMBER
      `wellness visit month`                       IS A MAYBE NUMBER
      `wellness visit provider qualified`          IS A BOOLEAN
      `written confirmation month`                 IS A MAYBE NUMBER
      `dispute arisen`                             IS A BOOLEAN
      `unable to settle month`                     IS A MAYBE NUMBER
      `arbitration commenced month`                IS A MAYBE NUMBER
      `valid arbitration award issued`             IS A BOOLEAN
      `written proof of claim month`               IS A MAYBE NUMBER
      `recovery sought month`                      IS A MAYBE NUMBER
      `policy term months`                         IS A NUMBER
      `confined in us hospital`                    IS A BOOLEAN
      `continuous confinement days`                IS A MAYBE NUMBER
      `claim made setting out basis`               IS A BOOLEAN

-- Supporting helpers, from inputs/schema.md, verbatim -- do not redefine.

GIVEN  `event month` IS A MAYBE NUMBER
       `limit month` IS A NUMBER
GIVETH A BOOLEAN
`no later than` MEANS
  CONSIDER `event month`
    WHEN NOTHING THEN FALSE
    WHEN JUST m  THEN m AT MOST `limit month`

GIVEN  cs IS A LIST OF Cause
       c  IS A Cause
GIVETH A BOOLEAN
`arose out of` MEANS elem c cs

-- -----------------------------------------------------------------------------
§ `1. Policy in effect and conditions`
-- -----------------------------------------------------------------------------

-- SS1.3: the wellness visit itself must occur no later than the 6th month
-- anniversary, with a qualified provider.
GIVEN claim IS A Claim
GIVETH A BOOLEAN
`wellness visit timely` claim MEANS
    `no later than` (claim's `wellness visit month`) 6

-- SS1.3: written confirmation of that visit must reach the company no later
-- than the 7th month anniversary.
GIVEN claim IS A Claim
GIVETH A BOOLEAN
`written confirmation timely` claim MEANS
    `no later than` (claim's `written confirmation month`) 7

-- SS1.3 taken as a whole: visit timely, provider qualified, confirmation timely.
GIVEN claim IS A Claim
GIVETH A BOOLEAN
`wellness confirmation obligation timely satisfied` claim MEANS
    `wellness visit timely` claim
    AND claim's `wellness visit provider qualified`
    AND `written confirmation timely` claim

-- SS1.1(3): the SS1.3 condition is fine if it has been satisfied already, OR if
-- it is "still pending" -- read literally, it cannot yet have failed before the
-- earlier of its own two sub-deadlines (month 6) has passed, so a hospitalization
-- at or before month 6 always finds the condition still pending.
GIVEN claim IS A Claim
GIVETH A BOOLEAN
`section 1.3 satisfied or still pending` claim MEANS
    claim's `hospitalization month` AT MOST 6
    OR `wellness confirmation obligation timely satisfied` claim

-- SS1.2: events that deem the policy canceled -- fraud, misrepresentation, an
-- untimely SS1.3, or the policy term having already run out.
GIVEN claim IS A Claim
GIVETH A BOOLEAN
`policy canceled` claim MEANS
    isJust (claim's `fraud month`)
    OR isJust (claim's `misrepresentation month`)
    OR NOT (`section 1.3 satisfied or still pending` claim)
    OR claim's `hospitalization month` GREATER THAN claim's `policy term months`

-- SS1.1: the policy is in effect at the time of hospitalization only if the
-- agreement is signed, the premium has been paid, and the policy has not been
-- canceled (SS1.1(3) is folded into `policy canceled` above, since SS1.2 defines
-- an untimely SS1.3 as a cancellation event).
GIVEN claim IS A Claim
GIVETH A BOOLEAN
`policy in effect` claim MEANS
    claim's `agreement signed`
    AND isJust (claim's `premium paid month`)
    AND NOT (`policy canceled` claim)

-- -----------------------------------------------------------------------------
§ `2. Benefits`
-- -----------------------------------------------------------------------------

-- SS2.1: the hospitalization itself must be for sickness or accidental injury.
GIVEN claim IS A Claim
GIVETH A BOOLEAN
`hospitalization ground covered` claim MEANS
    CONSIDER claim's `hospitalization ground`
    WHEN Sickness THEN TRUE
    WHEN `Accidental injury` THEN TRUE
    WHEN Neither THEN FALSE

-- SS2.2: the benefit is payable per day of continuous confinement in a US
-- hospital, from the first day, for up to 365 days.
GIVEN claim IS A Claim
GIVETH A BOOLEAN
`confinement duration in range` claim MEANS
    CONSIDER claim's `continuous confinement days`
    WHEN NOTHING THEN FALSE
    WHEN JUST d THEN (d GREATER THAN 0) AND (d AT MOST 365)

-- SS2.1-SS2.3 together: what has to be true for any benefit to trigger at all.
GIVEN claim IS A Claim
GIVETH A BOOLEAN
`benefit trigger conditions met` claim MEANS
    `hospitalization ground covered` claim
    AND claim's `confined in us hospital`
    AND `confinement duration in range` claim
    AND claim's `claim made setting out basis`

-- -----------------------------------------------------------------------------
§ `3. General exclusions`
-- -----------------------------------------------------------------------------

-- SS3.1: five listed exclusion grounds -- four causal, one age-based. Any one
-- of them, if it applies, bars the claim outright.
GIVEN claim IS A Claim
GIVETH A BOOLEAN
`general exclusion applies` claim MEANS
    (`arose out of` (claim's `causes`) Skydiving)
    OR (`arose out of` (claim's `causes`) `Military service`)
    OR (`arose out of` (claim's `causes`) Firefighting)
    OR (`arose out of` (claim's `causes`) `Police service`)
    OR claim's `age at hospitalization` AT LEAST 80

-- -----------------------------------------------------------------------------
§ `4. General conditions`
-- -----------------------------------------------------------------------------

-- SS4.2.1: where a dispute has arisen, arbitration must be commenced within 3
-- months of the parties becoming unable to settle.
GIVEN claim IS A Claim
GIVETH A BOOLEAN
`arbitration commenced timely` claim MEANS
    CONSIDER claim's `unable to settle month`
    WHEN NOTHING THEN FALSE
    WHEN JUST u THEN `no later than` (claim's `arbitration commenced month`) (u PLUS 3)

-- SS4.2.1: a valid arbitration award is a condition precedent to liability, but
-- only where a dispute has actually arisen -- absent a dispute this clause does
-- not bite.
GIVEN claim IS A Claim
GIVETH A BOOLEAN
`arbitration condition satisfied` claim MEANS
    IF NOT (claim's `dispute arisen`)
    THEN TRUE
    ELSE claim's `valid arbitration award issued` AND `arbitration commenced timely` claim

-- SS4.2.1: in no case may recovery be sought before the expiration of 60 days
-- after written proof of claim has been submitted. This schema counts time in
-- months, so 60 days is approximated as 2 months.
GIVEN claim IS A Claim
GIVETH A BOOLEAN
`sixty day waiting period observed` claim MEANS
    CONSIDER claim's `recovery sought month`
    WHEN NOTHING THEN TRUE
    WHEN JUST r THEN
        CONSIDER claim's `written proof of claim month`
        WHEN NOTHING THEN FALSE
        WHEN JUST p THEN r AT LEAST (p PLUS 2)

-- -----------------------------------------------------------------------------
§ `Coverage decision`
-- -----------------------------------------------------------------------------

GIVEN claim IS A Claim
GIVETH A BOOLEAN
covered MEANS
    `policy in effect` claim
    AND `benefit trigger conditions met` claim
    AND NOT (`general exclusion applies` claim)
    AND `arbitration condition satisfied` claim
    AND `sixty day waiting period observed` claim
