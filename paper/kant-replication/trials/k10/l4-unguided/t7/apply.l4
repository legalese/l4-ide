    `claimant committed fraud`                              IS FALSE
    `claimant made a misrepresentation`                     IS FALSE
    `claimant materially withheld information`              IS FALSE
    `dispute exists between the parties`                    IS FALSE
    `valid arbitration award has been issued`               IS FALSE

#EVAL `covered` q6


