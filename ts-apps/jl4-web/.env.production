# Production builds (vite build) run the LSP in the browser from WASM, and
# fall back to the WebSocket server at VITE_SOCKET_URL only if WASM fails.
# nix/jl4-web/package.nix puts jl4-core.wasm and jl4-core.mjs in static/wasm/
# and sets VITE_WASM_VERSION to the release they came from.
VITE_PREFER_WASM=true
