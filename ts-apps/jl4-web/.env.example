# L4 Web IDE Environment Configuration
# Copy this file to .env.local and customize as needed

# The language server runs in the browser from WASM (jl4-core). Release
# builds serve both files from /wasm/<release>/ (see main-tag.yml).
VITE_WASM_URL=/wasm/jl4-core.wasm
VITE_WASM_JS_URL=/wasm/jl4-core.mjs
VITE_WASM_VERSION=dev

# Share links. Without a session service the Share button is hidden;
# play.legalese.com uses /session (terraform/web-editor/).
# VITE_SESSION_URL=/session
# Cloudflare Turnstile site key the session service checks shares against
# VITE_TURNSTILE_SITE_KEY=
