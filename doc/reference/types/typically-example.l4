-- TYPICALLY: default values (rebuttable presumptions)

-- Fields of a record, with defaults
DECLARE Person HAS
  name IS A STRING
  has_capacity IS A BOOLEAN TYPICALLY TRUE
  is_under_duress IS A BOOLEAN TYPICALLY FALSE
  jurisdiction IS A STRING TYPICALLY "Singapore"

-- A rule's own inputs, with defaults
GIVEN
  age IS A NUMBER TYPICALLY 18
  married IS A BOOLEAN TYPICALLY FALSE
GIVETH A BOOLEAN
DECIDE `may purchase alcohol` IF age >= 18

-- Given by position, a rule gets every input, defaulted or not.
#EVAL `may purchase alcohol` 21 FALSE

-- Given by name, an input with a default may be left out: `married` takes FALSE.
#EVAL `may purchase alcohol` WITH age IS 21

-- A record built by name may leave out a field with a default.
GIVETH A Person
`a new person` MEANS Person WITH name IS "Alex"

#EVAL `a new person`'s jurisdiction

-- A section GIVEN with a default: one name for every rule in the section
§ `Part 3 -- Capacity`
    GIVEN `governing law` IS A STRING TYPICALLY "Singapore"
          `person has capacity` IS A BOOLEAN TYPICALLY TRUE

DECIDE `contract is binding` IF
      `person has capacity`
  AND `governing law` EQUALS "Singapore"

#CHECK `contract is binding`

-- A default may be worked out. It can name a definition or another section GIVEN,
-- and a compound expression is written in parentheses.
§ `Part 4 -- Pricing`
    GIVEN `list price` IS A NUMBER TYPICALLY 100
          discount IS A NUMBER TYPICALLY (`list price` DIVIDED BY 10)

GIVETH A NUMBER
`final price` MEANS `list price` MINUS discount

-- 90: the default for `discount` is a tenth of the 100 ...
#EVAL `final price`

-- ... and 180 here, because it is a tenth of the 200 the call gives.
#EVAL `final price` WITH `list price` IS 200
