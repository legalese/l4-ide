-- NOT keyword examples

§ `NOT keyword examples`
    GIVEN hasCriminalRecord IS A BOOLEAN
          personAge IS A NUMBER
          isBlocked IS A BOOLEAN

-- Basic NOT Operations

#EVAL NOT TRUE
#EVAL NOT FALSE

-- Double Negation

#EVAL NOT NOT TRUE
#EVAL NOT NOT FALSE

-- In Conditional Logic

DECIDE isClean IS NOT hasCriminalRecord

#CHECK isClean

-- With AND

DECIDE canAccess IS personAge >= 18 AND NOT isBlocked

#CHECK canAccess

-- With OR

GIVEN isAdmin IS A BOOLEAN, isRestricted IS A BOOLEAN
hasAccess isAdmin isRestricted MEANS isAdmin OR NOT isRestricted

#EVAL hasAccess FALSE FALSE
#EVAL hasAccess FALSE TRUE

-- How Far NOT Reaches

GIVEN a IS A BOOLEAN, b IS A BOOLEAN

-- NOT reaches forward over the AND, so this is the WIDE reading:
-- it means NOT (a AND b), even though it reads like "not-a, and b".
wideByDefault a b MEANS NOT a AND b -- NOT-REACH-OK: the wide reading is the point

-- Spelling the wide reading out. Same rule as wideByDefault.
notBoth a b MEANS NOT (a AND b)

-- Brackets around the OPERAND do NOT narrow it -- still NOT (a AND b).
looksCareful a b MEANS NOT (a) AND b -- NOT-REACH-OK: shows the bracket trap

-- Brackets around the NOT itself DO narrow it. This is (NOT a) AND b.
narrowedProperly a b MEANS (NOT a) AND b

-- The first three are all the same rule. The fourth is the one you probably
-- meant. With a = FALSE and b = FALSE the first three give TRUE and the
-- fourth gives FALSE; with a = TRUE and b = TRUE all four agree on FALSE.
#EVAL wideByDefault FALSE FALSE
#EVAL notBoth FALSE FALSE
#EVAL looksCareful FALSE FALSE
#EVAL narrowedProperly FALSE FALSE

#EVAL wideByDefault TRUE TRUE
#EVAL notBoth TRUE TRUE
#EVAL looksCareful TRUE TRUE
#EVAL narrowedProperly TRUE TRUE

-- NOT with Comparisons

GIVEN n IS A NUMBER
isNotZero n MEANS NOT (n EQUALS 0)
isNotPositive n MEANS NOT (n > 0)

#EVAL isNotZero 5
#EVAL isNotZero 0
#EVAL isNotPositive 5
#EVAL isNotPositive (-3)

-- In IF Expressions

GIVEN flag IS A BOOLEAN
invertedMessage flag MEANS
  IF NOT flag
  THEN "flag is off"
  ELSE "flag is on"

#EVAL invertedMessage TRUE
#EVAL invertedMessage FALSE
