-- NOT examples

-- Basic NOT

#EVAL NOT TRUE
#EVAL NOT FALSE
#EVAL NOT NOT TRUE

-- With AND, on separate lines: NOT applies to its own line only

GIVEN age IS A NUMBER
      `is blocked` IS A BOOLEAN
GIVETH A BOOLEAN
`may access` age `is blocked` MEANS
      age >= 18
  AND NOT `is blocked`

#EVAL `may access` 30 FALSE
#EVAL `may access` 30 TRUE

-- How far NOT reaches

-- On one line, NOT reaches forward over everything after it, so
-- `NOT a AND b` would mean NOT (a AND b) even though it reads like
-- "not-a, and b". L4 refuses that spelling: the file does not check until
-- you say which reading you meant. Both of these are refused --
--
--     wide a b MEANS NOT a AND b
--     looksCareful a b MEANS NOT (a) AND b   -- the bracket closes around a,
--                                            -- not around the NOT
--
-- and these are the spellings that are accepted.

-- Brackets around the whole group: the WIDE reading, NOT (a AND b).
GIVEN a IS A BOOLEAN
      b IS A BOOLEAN
GIVETH A BOOLEAN
`not both` a b MEANS NOT (a AND b)

-- Brackets around the NOT itself: the NARROW reading, (NOT a) AND b.
GIVEN a IS A BOOLEAN
      b IS A BOOLEAN
GIVETH A BOOLEAN
`not a, and b` a b MEANS (NOT a) AND b

-- Over several lines nothing is refused, and the columns decide. An AND
-- that starts further right than the NOT is reached over: the wide reading.
GIVEN a IS A BOOLEAN
      b IS A BOOLEAN
GIVETH A BOOLEAN
swallowed a b MEANS
    NOT a
        AND b

-- An AND that starts in the NOT's column, or further left, stops it: the
-- narrow reading.
GIVEN a IS A BOOLEAN
      b IS A BOOLEAN
GIVETH A BOOLEAN
stopped a b MEANS
    NOT a
    AND b

-- With a = FALSE and b = FALSE the wide reading gives TRUE and the narrow
-- reading gives FALSE; with a = TRUE and b = TRUE all four agree on FALSE.
#EVAL `not both` FALSE FALSE
#EVAL swallowed FALSE FALSE
#EVAL `not a, and b` FALSE FALSE
#EVAL stopped FALSE FALSE

#EVAL `not both` TRUE TRUE
#EVAL swallowed TRUE TRUE
#EVAL `not a, and b` TRUE TRUE
#EVAL stopped TRUE TRUE

-- With comparisons: no parentheses needed

GIVEN n IS A NUMBER
GIVETH A BOOLEAN
`is not zero` n MEANS NOT n EQUALS 0

#EVAL `is not zero` 5
#EVAL `is not zero` 0

-- In IF expressions

GIVEN flag IS A BOOLEAN
GIVETH A STRING
`flag message` flag MEANS
  IF NOT flag
  THEN "flag is off"
  ELSE "flag is on"

#EVAL `flag message` TRUE
#EVAL `flag message` FALSE
