cabal-version: 3.0
name: jl4-service
version: 0.1.0.0
build-type: Simple
tested-with: GHC==9.10.2

source-repository head
  type: git
  location: https://github.com/legalese/l4-ide/tree/main/jl4-service

common defaults
  default-language: GHC2021
  ghc-options:
    -Wall
    -Wderiving-typeable
    -Wunused-packages
    -Werror
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints

  default-extensions:
    BlockArguments
    DefaultSignatures
    DeriveAnyClass
    DerivingStrategies
    DerivingVia
    DuplicateRecordFields
    LambdaCase
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings
    NoImportQualifiedPost

  build-depends:
    base >=4.7 && <5

library
  import: defaults
  hs-source-dirs: src
  exposed-modules:
    Application
    Backend.Api
    Backend.CodeGen
    Backend.DecisionQueryPlan
    Backend.DirectiveFilter
    Backend.Jl4
    Backend.MaybeLift
    BundleStore
    Compatibility
    Compiler
    ControlPlane
    DataPlane
    DeploymentLoader
    FileBrowser
    ExplorerPage
    Logging
    McpServer
    OpenApiDoc
    Options
    Schema
    Shared
    Types
    Version
    WebMCPPage

  build-depends:
    -- Core L4 packages
    jl4-core,
    jl4-query-plan,
    jl4-lsp,
    -- Web stack
    servant >=0.20.2 && <0.21,
    servant-multipart,
    servant-openapi3,
    servant-server >=0.20.2 && <0.21,
    openapi3,
    warp,
    wai,
    wai-cors,
    http-media,
    http-types,
    -- JSON / data
    aeson,
    scientific,
    vector,
    -- Concurrency / state
    async,
    stm,
    -- Serialization (CBOR)
    serialise,
    -- Crypto / archiving
    cryptohash-sha256,
    zip-archive,
    -- Utilities
    bytestring,
    containers,
    directory,
    filepath,
    lens,
    lsp-types,
    optics,
    optparse-applicative,
    template-haskell,
    text,
    time,
    transformers,
    uuid,

executable jl4-service
  import: defaults
  main-is: Main.hs
  hs-source-dirs: app
  -- The threaded RTS on every core. A batch runs as many of its cases at once
  -- as there are capabilities (DataPlane.batchFunctionHandler), so this is what
  -- lets a batch use more than one core; -rtsopts lets an operator say
  -- +RTS -N2 -RTS (or GHCRTS=-N2) to use fewer.
  ghc-options: -threaded -rtsopts "-with-rtsopts=-N"
  build-depends:
    jl4-service

test-suite jl4-service-test
  import: defaults
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
    ApiSpec
    BooleanDecisionQuerySpec
    BundleStoreSpec
    CodeGenSpec
    CompatibilitySpec
    DecisionQueryCacheKeySpec
    DeploymentIdSpec
    IntegrationSpec
    LoggingSpec
    MaybeLiftSpec
    PutGuardSpec
    QueryPlanSpec
    SchemaSpec
    SanitizationSpec
    SerialisationSpec
    TestData

  hs-source-dirs:
    test

  -- The threaded RTS, as the executable runs, so that System.Timeout takes the
  -- timer-manager path it takes in production. But ONE capability (no -N), so
  -- that a batch test's forty cases share one core on any machine, and the
  -- test still fails if a batch starts more cases at once than it has cores.
  ghc-options: -threaded

  build-tool-depends:
    hspec-discover:hspec-discover

  build-depends:
    aeson,
    async,
    bytestring,
    containers,
    directory,
    filepath,
    hspec,
    http-client,
    http-types,
    jl4-core,
    jl4-lsp,
    jl4-query-plan,
    jl4-service,
    lsp-types,
    QuickCheck,
    quickcheck-instances,
    serialise,
    servant >=0.20.2 && <0.21,
    servant-server >=0.20.2 && <0.21,
    stm,
    string-interpolate,
    text,
    time,
    transformers,
    warp,
    zip-archive,
