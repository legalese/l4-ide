cabal-version: 3.0
name: jl4-service
version: 0.1.0.0
build-type: Simple
tested-with: GHC==9.10.2

source-repository head
  type: git
  location: https://github.com/legalese/l4-ide/tree/main/jl4-service

-- Off by default because postgresql-simple links libpq dynamically, and the
-- binaries this repository ships do not carry it: the Dockerfile's runtime
-- stage installs no libpq, and main-tag.yml builds the published Linux
-- jl4-service after installing only pkg-config, liblzma-dev and libgmp-dev,
-- so every machine that runs it would need libpq too. The sqlite default
-- needs nothing: direct-sqlite compiles sqlite in. Without the flag,
-- `--ledger-store postgres` refuses to start, naming it.
flag postgres
  description: Build the Postgres adapter of the instance ledger's store (Ledger.Store.Postgres). Needs libpq at build and run time.
  default: False
  manual: True

common defaults
  default-language: GHC2021
  ghc-options:
    -Wall
    -Wderiving-typeable
    -Wunused-packages
    -Werror
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints

  default-extensions:
    BlockArguments
    DefaultSignatures
    DeriveAnyClass
    DerivingStrategies
    DerivingVia
    DuplicateRecordFields
    LambdaCase
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings
    NoImportQualifiedPost

  build-depends:
    base >=4.7 && <5

library
  import: defaults
  hs-source-dirs: src
  exposed-modules:
    Application
    Backend.Api
    Backend.CodeGen
    Backend.DecisionQueryPlan
    Backend.DirectiveFilter
    Backend.Jl4
    Backend.MaybeLift
    BundleStore
    CheckStore
    Compatibility
    Compiler
    ControlPlane
    DataPlane
    DeonticTrace
    DeploymentLoader
    EvalLimits
    FileBrowser
    ExplorerPage
    Ledger
    Ledger.Mcp
    Ledger.Service
    Ledger.Store.Config
    Ledger.Store.Postgres
    Ledger.Store.Sql
    Ledger.Store.Sqlite
    Logging
    McpServer
    OpenApiDoc
    Options
    Schema
    Shared
    Types
    Version
    WebMCPPage

  build-depends:
    -- Core L4 packages
    jl4-core,
    jl4-query-plan,
    jl4-lsp,
    -- Web stack
    servant >=0.20.2 && <0.21,
    servant-multipart,
    servant-openapi3,
    servant-server >=0.20.2 && <0.21,
    openapi3,
    warp,
    wai,
    wai-cors,
    http-media,
    http-types,
    -- JSON / data
    aeson,
    scientific,
    vector,
    -- Concurrency / state
    async,
    deepseq,
    stm,
    -- The instance ledger's default store (bundles its own sqlite)
    sqlite-simple,
    -- Crypto / archiving
    cryptohash-sha256,
    zip-archive,
    -- Utilities
    bytestring,
    containers,
    directory,
    filepath,
    lens,
    lsp-types,
    optics,
    optparse-applicative,
    template-haskell,
    text,
    time,
    transformers,
    uuid,

  if flag(postgres)
    build-depends: postgresql-simple
    cpp-options: -DLEDGER_POSTGRES

executable jl4-service
  import: defaults
  main-is: Main.hs
  hs-source-dirs: app
  -- The threaded RTS on every core. The service runs as many batch cases at
  -- once, across all batches, as there are capabilities (Types.batchSlots),
  -- so this is what lets batches use more than one core; -rtsopts lets an
  -- operator say +RTS -N2 -RTS (or GHCRTS=-N2) to use fewer.
  ghc-options: -threaded -rtsopts "-with-rtsopts=-N"
  build-depends:
    jl4-service

test-suite jl4-service-test
  import: defaults
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
    ApiSpec
    BooleanDecisionQuerySpec
    BundleStoreSpec
    CheckStoreSpec
    CodeGenSpec
    CompatibilitySpec
    DecisionQueryCacheKeySpec
    DeploymentIdSpec
    IntegrationSpec
    LedgerMcpSpec
    LedgerRoutesSpec
    LedgerStoreSpec
    LoggingSpec
    MaybeLiftSpec
    PutGuardSpec
    QueryPlanSpec
    SchemaSpec
    SanitizationSpec
    StdlibResolutionSpec
    TestData
    TestStoreDir
    UnresolvedImportSpec

  hs-source-dirs:
    test

  -- The threaded RTS, as the executable runs, so that System.Timeout takes the
  -- timer-manager path it takes in production. No -N: a test that depends on
  -- the capability count sets it itself (setNumCapabilities), so that GHCRTS
  -- cannot change it underneath the test.
  ghc-options: -threaded

  build-tool-depends:
    hspec-discover:hspec-discover

  build-depends:
    aeson,
    async,
    bytestring,
    containers,
    directory,
    filepath,
    hspec,
    http-client,
    http-types,
    jl4-core,
    jl4-lsp,
    jl4-query-plan,
    jl4-service,
    lsp-types,
    optparse-applicative,
    QuickCheck,
    quickcheck-instances,
    servant >=0.20.2 && <0.21,
    servant-server >=0.20.2 && <0.21,
    stm,
    string-interpolate,
    temporary,
    text,
    time,
    transformers,
    warp,
    zip-archive

  -- LedgerStoreSpec runs the store items against a live server when
  -- JL4_LEDGER_TEST_POSTGRES_URL names one, and needs the driver to make
  -- its own schema.
  if flag(postgres)
    build-depends: postgresql-simple
    cpp-options: -DLEDGER_POSTGRES
